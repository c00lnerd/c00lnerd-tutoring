        @media (max-width: 768px) {
            .container {
                margin: 10px;
                padding: 15px;
            }
            
            .module-header h1 {
                font-size: 2rem;
            }
            
            .module-header h2 {
                font-size: 1.2rem;
            }
            
            .content-section {
                padding: 0 10px;
            }
            
            .content-section h3 {
                font-size: 1.5rem;
            }
        }
    </style>
</Layout>
