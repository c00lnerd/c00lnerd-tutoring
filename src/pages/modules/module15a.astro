        }

        .highlight-box h4 {
            color: #27ae60;
            margin-top: 0;
        }

        .tips-box {
            background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
            border: 2px solid #f39c12;
            border-radius: 10px;
            padding: 20px;
            margin: 25px 0;
        }

        .tips-box h5 {
            color: #d68910;
            margin-top: 0;
        }

        .good-practices {
            background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
            border-left: 5px solid #28a745;
            padding: 20px;
            margin: 20px 0;
            border-radius: 5px;
        }

        .bad-practices {
            background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
            border-left: 5px solid #dc3545;
            padding: 20px;
            margin: 20px 0;
            border-radius: 5px;
        }

        .example-comparison {
            margin: 15px 0;
        }

        .bad-example {
            background: #f8d7da;
            border: 1px solid #f5c6cb;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 10px;
