---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Interactive Lissajous Curve Explorer - C00lnerd Simulations">
    <div class="min-h-screen bg-gradient-to-br from-purple-900 via-blue-900 to-indigo-900">
        <!-- Header -->
        <div class="bg-black bg-opacity-50 backdrop-blur-sm border-b border-purple-500">
            <div class="max-w-7xl mx-auto px-4 py-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-4">
                        <a href="/simulations.html" class="text-purple-300 hover:text-purple-100 font-medium">
                            ← Back to Simulations
                        </a>
                        <div class="text-purple-500">|</div>
                        <h1 class="text-2xl font-bold text-white">Interactive Lissajous Curve Explorer</h1>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="max-w-7xl mx-auto px-4 py-8">
            <!-- Introduction -->
            <div class="bg-black bg-opacity-30 backdrop-blur-sm rounded-xl p-6 mb-8 border border-purple-500">
                <h2 class="text-2xl font-bold text-white mb-4">Explore Mathematical Beauty</h2>
                <p class="text-purple-100 mb-4">
                    Lissajous curves are created by combining two perpendicular oscillations with different frequencies. 
                    These beautiful patterns appear in physics, engineering, and nature - from oscilloscope displays to planetary orbits!
                </p>
                <div class="grid md:grid-cols-2 gap-4 text-sm text-purple-200">
                    <div>
                        <strong class="text-cyan-300">Mathematical Equations:</strong><br>
                        x = A × sin(a×t + φ)<br>
                        y = B × sin(b×t)
                    </div>
                    <div>
                        <strong class="text-yellow-300">Where:</strong><br>
                        A, B = amplitudes | a, b = frequencies | φ = phase shift | t = time
                    </div>
                </div>
            </div>

            <!-- Simulation Container -->
            <div class="grid lg:grid-cols-4 gap-6">
                <!-- Canvas Area -->
                <div class="lg:col-span-3">
                    <div class="bg-black bg-opacity-50 backdrop-blur-sm rounded-xl p-6 border border-purple-500">
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="text-xl font-bold text-white">Live Curve Generation</h3>
                            <div class="space-x-2">
                                <button id="clearBtn" class="bg-orange-600 hover:bg-orange-700 text-white px-4 py-2 rounded-lg font-medium transition-colors">
                                    Clear Trail
                                </button>
                                <button id="resetBtn" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg font-medium transition-colors">
                                    Reset
                                </button>
                            </div>
                        </div>
                        <canvas id="lissajousCanvas" width="800" height="600" 
                                class="border border-gray-600 rounded-lg bg-black w-full max-w-full h-auto">
                        </canvas>
                        <div id="equationDisplay" class="mt-4 text-center">
                            <div class="text-cyan-300 font-mono text-sm" id="currentEquation"></div>
                            <div class="text-yellow-300 font-mono text-sm" id="frequencyRatio"></div>
                        </div>
                    </div>
                </div>

                <!-- Controls Panel -->
                <div class="lg:col-span-1">
                    <div class="bg-black bg-opacity-50 backdrop-blur-sm rounded-xl p-6 border border-purple-500 space-y-6">
                        <!-- Frequency Controls -->
                        <div>
                            <h4 class="text-lg font-bold text-cyan-300 mb-3">Frequency Ratios</h4>
                            <div class="space-y-3">
                                <div>
                                    <label class="block text-white text-sm font-medium mb-1">X Frequency (a)</label>
                                    <input type="range" id="freqA" min="0.1" max="10" step="0.1" value="2" 
                                           class="w-full h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer slider">
                                    <span id="freqAValue" class="text-purple-300 text-sm">2.0</span>
                                </div>
                                <div>
                                    <label class="block text-white text-sm font-medium mb-1">Y Frequency (b)</label>
                                    <input type="range" id="freqB" min="0.1" max="10" step="0.1" value="3" 
                                           class="w-full h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer slider">
                                    <span id="freqBValue" class="text-purple-300 text-sm">3.0</span>
                                </div>
                            </div>
                        </div>

                        <!-- Amplitude Controls -->
                        <div>
                            <h4 class="text-lg font-bold text-yellow-300 mb-3">Amplitudes</h4>
                            <div class="space-y-3">
                                <div>
                                    <label class="block text-white text-sm font-medium mb-1">X Amplitude</label>
                                    <input type="range" id="ampX" min="50" max="300" step="10" value="200" 
                                           class="w-full h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer slider">
                                    <span id="ampXValue" class="text-purple-300 text-sm">200</span>
                                </div>
                                <div>
                                    <label class="block text-white text-sm font-medium mb-1">Y Amplitude</label>
                                    <input type="range" id="ampY" min="50" max="300" step="10" value="200" 
                                           class="w-full h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer slider">
                                    <span id="ampYValue" class="text-purple-300 text-sm">200</span>
                                </div>
                            </div>
                        </div>

                        <!-- Animation Controls -->
                        <div>
                            <h4 class="text-lg font-bold text-lime-300 mb-3">Animation</h4>
                            <div class="space-y-3">
                                <div>
                                    <label class="block text-white text-sm font-medium mb-1">Phase Shift (φ)</label>
                                    <input type="range" id="phase" min="0" max="6.28" step="0.1" value="0" 
                                           class="w-full h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer slider">
                                    <span id="phaseValue" class="text-purple-300 text-sm">0.0</span>
                                </div>
                                <div>
                                    <label class="block text-white text-sm font-medium mb-1">Speed</label>
                                    <input type="range" id="speed" min="0.1" max="3" step="0.1" value="1" 
                                           class="w-full h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer slider">
                                    <span id="speedValue" class="text-purple-300 text-sm">1.0</span>
                                </div>
                                <div>
                                    <label class="block text-white text-sm font-medium mb-1">Trail Length</label>
                                    <input type="range" id="trailLength" min="50" max="1000" step="50" value="500" 
                                           class="w-full h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer slider">
                                    <span id="trailValue" class="text-purple-300 text-sm">500</span>
                                </div>
                            </div>
                        </div>

                        <!-- Presets -->
                        <div>
                            <h4 class="text-lg font-bold text-magenta-300 mb-3">Presets</h4>
                            <div class="grid grid-cols-2 gap-2">
                                <button class="preset-btn bg-purple-600 hover:bg-purple-700 text-white px-3 py-2 rounded text-sm font-medium transition-colors" 
                                        data-preset="circle">Circle</button>
                                <button class="preset-btn bg-purple-600 hover:bg-purple-700 text-white px-3 py-2 rounded text-sm font-medium transition-colors" 
                                        data-preset="figure8">Figure-8</button>
                                <button class="preset-btn bg-purple-600 hover:bg-purple-700 text-white px-3 py-2 rounded text-sm font-medium transition-colors" 
                                        data-preset="flower">Flower</button>
                                <button class="preset-btn bg-purple-600 hover:bg-purple-700 text-white px-3 py-2 rounded text-sm font-medium transition-colors" 
                                        data-preset="complex">Complex</button>
                            </div>
                        </div>

                        <!-- Instructions -->
                        <div>
                            <h4 class="text-lg font-bold text-orange-300 mb-3">Instructions</h4>
                            <ul class="text-white text-sm space-y-1">
                                <li>• Adjust sliders for real-time changes</li>
                                <li>• Use 'Clear Trail' to see immediate effects</li>
                                <li>• Try different frequency ratios</li>
                                <li>• Use presets for classic patterns</li>
                                <li>• Watch how phase shift rotates patterns</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Educational Information -->
            <div class="mt-8 grid md:grid-cols-2 gap-6">
                <div class="bg-black bg-opacity-30 backdrop-blur-sm rounded-xl p-6 border border-purple-500">
                    <h3 class="text-xl font-bold text-cyan-300 mb-4">Real-World Applications</h3>
                    <ul class="text-purple-100 space-y-2">
                        <li><strong>Oscilloscopes:</strong> Display electrical waveforms</li>
                        <li><strong>Astronomy:</strong> Planetary orbital patterns</li>
                        <li><strong>Music:</strong> Harmonic frequency relationships</li>
                        <li><strong>Engineering:</strong> Vibration analysis</li>
                        <li><strong>Art:</strong> Mathematical beauty in design</li>
                    </ul>
                </div>
                <div class="bg-black bg-opacity-30 backdrop-blur-sm rounded-xl p-6 border border-purple-500">
                    <h3 class="text-xl font-bold text-yellow-300 mb-4">Pattern Types</h3>
                    <ul class="text-purple-100 space-y-2">
                        <li><strong>1:1 Ratio:</strong> Circle or ellipse</li>
                        <li><strong>1:2 Ratio:</strong> Figure-eight pattern</li>
                        <li><strong>2:3 Ratio:</strong> Three-lobed pattern</li>
                        <li><strong>Integer Ratios:</strong> Closed, repeating curves</li>
                        <li><strong>Irrational Ratios:</strong> Never-repeating patterns</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
    .slider::-webkit-slider-thumb {
        appearance: none;
        height: 20px;
        width: 20px;
        border-radius: 50%;
        background: #8b5cf6;
        cursor: pointer;
        border: 2px solid #ffffff;
    }

    .slider::-moz-range-thumb {
        height: 20px;
        width: 20px;
        border-radius: 50%;
        background: #8b5cf6;
        cursor: pointer;
        border: 2px solid #ffffff;
    }

    .magenta-300 {
        color: #f0abfc;
    }

    canvas {
        image-rendering: pixelated;
    }
</style>

<script>
class LissajousExplorer {
    constructor() {
        this.canvas = document.getElementById('lissajousCanvas');
        this.ctx = this.canvas.getContext('2d');
        this.points = [];
        this.startTime = Date.now();
        this.animationId = null;
        
        // Parameters
        this.params = {
            freqA: 2.0,
            freqB: 3.0,
            ampX: 200,
            ampY: 200,
            phase: 0,
            speed: 1.0,
            trailLength: 500
        };
        
        this.setupControls();
        this.setupPresets();
        this.setupButtons();
        this.startAnimation();
    }
    
    setupControls() {
        const controls = ['freqA', 'freqB', 'ampX', 'ampY', 'phase', 'speed', 'trailLength'];
        
        controls.forEach(control => {
            const slider = document.getElementById(control);
            const valueDisplay = document.getElementById(control + 'Value');
            
            slider.addEventListener('input', (e) => {
                const value = parseFloat(e.target.value);
                this.params[control] = value;
                valueDisplay.textContent = control === 'trailLength' ? value.toString() : value.toFixed(1);
                this.updateEquationDisplay();
            });
        });
    }
    
    setupPresets() {
        const presets = {
            circle: { freqA: 1, freqB: 1, phase: 1.57, ampX: 200, ampY: 200 },
            figure8: { freqA: 1, freqB: 2, phase: 0, ampX: 200, ampY: 200 },
            flower: { freqA: 3, freqB: 4, phase: 0, ampX: 200, ampY: 200 },
            complex: { freqA: 5, freqB: 6, phase: 0, ampX: 200, ampY: 200 }
        };
        
        document.querySelectorAll('.preset-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const preset = presets[btn.dataset.preset];
                Object.keys(preset).forEach(key => {
                    this.params[key] = preset[key];
                    const slider = document.getElementById(key);
                    const valueDisplay = document.getElementById(key + 'Value');
                    slider.value = preset[key];
                    valueDisplay.textContent = key === 'trailLength' ? preset[key].toString() : preset[key].toFixed(1);
                });
                this.updateEquationDisplay();
            });
        });
    }
    
    setupButtons() {
        document.getElementById('clearBtn').addEventListener('click', () => {
            this.points = [];
        });
        
        document.getElementById('resetBtn').addEventListener('click', () => {
            this.points = [];
            this.startTime = Date.now();
        });
    }
    
    updateEquationDisplay() {
        const eq1 = `x = ${this.params.ampX} × sin(${this.params.freqA.toFixed(1)}t + ${this.params.phase.toFixed(2)})`;
        const eq2 = `y = ${this.params.ampY} × sin(${this.params.freqB.toFixed(1)}t)`;
        const ratio = `Frequency Ratio: ${this.params.freqA.toFixed(1)}:${this.params.freqB.toFixed(1)}`;
        
        document.getElementById('currentEquation').innerHTML = `${eq1}<br>${eq2}`;
        document.getElementById('frequencyRatio').textContent = ratio;
    }
    
    animate() {
        const currentTime = Date.now();
        const t = ((currentTime - this.startTime) / 1000) * this.params.speed;
        
        // Calculate current point
        const centerX = this.canvas.width / 2;
        const centerY = this.canvas.height / 2;
        
        const x = centerX + this.params.ampX * Math.sin(this.params.freqA * t + this.params.phase);
        const y = centerY + this.params.ampY * Math.sin(this.params.freqB * t);
        
        // Add to points history
        this.points.push({ x, y, time: currentTime });
        
        // Limit trail length
        if (this.points.length > this.params.trailLength) {
            this.points.shift();
        }
        
        this.draw();
        this.animationId = requestAnimationFrame(() => this.animate());
    }
    
    draw() {
        // Clear canvas
        this.ctx.fillStyle = '#000000';
        this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);
        
        // Draw center axes
        this.ctx.strokeStyle = '#333333';
        this.ctx.lineWidth = 1;
        this.ctx.beginPath();
        this.ctx.moveTo(0, this.canvas.height / 2);
        this.ctx.lineTo(this.canvas.width, this.canvas.height / 2);
        this.ctx.moveTo(this.canvas.width / 2, 0);
        this.ctx.lineTo(this.canvas.width / 2, this.canvas.height);
        this.ctx.stroke();
        
        // Draw trail with fading effect
        if (this.points.length > 1) {
            for (let i = 1; i < this.points.length; i++) {
                const fade = i / this.points.length;
                const r = Math.floor(255 * fade);
                const g = Math.floor(100 + 155 * fade);
                const b = Math.floor(200 * fade);
                
                this.ctx.strokeStyle = `rgb(${r}, ${g}, ${b})`;
                this.ctx.lineWidth = 2;
                this.ctx.beginPath();
                this.ctx.moveTo(this.points[i-1].x, this.points[i-1].y);
                this.ctx.lineTo(this.points[i].x, this.points[i].y);
                this.ctx.stroke();
            }
        }
        
        // Draw current point
        if (this.points.length > 0) {
            const current = this.points[this.points.length - 1];
            this.ctx.fillStyle = '#ffffff';
            this.ctx.strokeStyle = '#ffff00';
            this.ctx.lineWidth = 2;
            this.ctx.beginPath();
            this.ctx.arc(current.x, current.y, 5, 0, 2 * Math.PI);
            this.ctx.fill();
            this.ctx.stroke();
        }
    }
    
    startAnimation() {
        this.updateEquationDisplay();
        this.animate();
    }
    
    stop() {
        if (this.animationId) {
            cancelAnimationFrame(this.animationId);
        }
    }
}

// Initialize when page loads
document.addEventListener('DOMContentLoaded', () => {
    new LissajousExplorer();
});
</script>
