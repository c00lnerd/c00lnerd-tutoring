<body>
    <h1>🌍 Solar System Orbital Mechanics - Earth, Moon, Mars & Moons</h1>
    
    <div class="container">
        <div class="simulation-area">
            <canvas id="canvas" width="800" height="600"></canvas>
        </div>
        
            <div class="control-group">
                <h3>⏱️ Simulation Controls</h3>
                
                <div class="slider-container">
                    <label>Time Speed (days/frame)</label>
                    <input type="range" id="timeSpeed" min="0.01" max="10" step="0.01" value="2" class="slider">
                    <span class="slider-value" id="timeSpeedValue">2.00</span>
                </div>
                
                <div class="slider-container">
                    <label>Zoom Level</label>
                    <input type="range" id="zoom" min="0.3" max="3" step="0.1" value="1" class="slider">
                    <div class="value-display" id="zoomValue">1.0</div>
                </div>
                
                <div class="slider-container">
                    <label>Trail Length</label>
                    <input type="range" id="trailLength" min="50" max="1000" step="50" value="500">
                    <div class="value-display" id="trailLengthValue">500</div>
                </div>
            </div>
            
            <div class="control-group">
                <h3>👁️ Visibility Controls</h3>
                <div class="button-grid">
                    <button class="control-button earth-btn" id="earthBtn">Earth: ON</button>
                    <button class="control-button moon-btn" id="moonBtn">Moon: ON</button>
                    <button class="control-button earth-trail-btn" id="earthTrailBtn">Earth Trail: ON</button>
                    <button class="control-button moon-trail-btn" id="moonTrailBtn">Moon Trail: ON</button>
                </div>
                
                <h3 style="color: #ff6600; margin: 15px 0 10px 0; font-size: 14px;">🔴 Mars System</h3>
                <div class="button-grid">
                    <button class="control-button mars-btn" id="marsBtn">Mars: ON</button>
                    <button class="control-button phobos-btn" id="phobosBtn">Phobos: ON</button>
                    <button class="control-button deimos-btn" id="deimosBtn">Deimos: ON</button>
                    <button class="control-button mars-trail-btn" id="marsTrailBtn">Mars Trail: ON</button>
                    <button class="control-button phobos-trail-btn" id="phobosTrailBtn">Phobos Trail: ON</button>
                    <button class="control-button deimos-trail-btn" id="deimosTrailBtn">Deimos Trail: ON</button>
                    <button class="control-button reset-btn full-width" id="resetBtn">Reset Simulation</button>
                    <button class="control-button pause-btn full-width" id="pauseBtn">Pause</button>
                </div>
            </div>
            
            <div class="info-panel">
                <h3 style="color: #00ffff; margin-bottom: 10px;">📊 Simulation Data</h3>
                <div class="info-item">
                    <span class="info-label">Day:</span>
                    <span class="info-value" id="dayValue">0.0</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Year:</span>
                    <span class="info-value" id="yearValue">0.000</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Moon Orbits:</span>
                    <span class="info-value" id="moonOrbitsValue">0.0</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Mars Year:</span>
                    <span class="info-value" id="marsYearValue">0.000</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Phobos Orbits:</span>
                    <span class="info-value" id="phobosOrbitsValue">0</span>
                </div>
            </div>
            
            <div class="description">
                <h3 style="color: #ffff00; margin-bottom: 10px;">🔬 Orbital Mechanics</h3>
                <ul>
                    <li><strong>Earth:</strong> Orbits Sun in 365.25 days</li>
                    <li><strong>Moon:</strong> Orbits Earth in 27.3 days</li>
                    <li><strong>Mars:</strong> Orbits Sun in 687 days (1.88 Earth years)</li>
                    <li><strong>Phobos:</strong> Orbits Mars in 0.32 days (7.6 hours)</li>
                    <li><strong>Deimos:</strong> Orbits Mars in 1.26 days (30.3 hours)</li>
                    <li><strong>Math:</strong> Pure trigonometric calculations</li>
                    <li><strong>Accuracy:</strong> Astronomically correct periods</li>
                </ul>
                
                <p><strong>Educational Focus:</strong> Use visibility controls to compare Earth-Moon and Mars-moons systems! See how different orbital periods create unique patterns in space.</p>
            </div>
            
            <div class="advanced-insights">
                <h3 style="color: #ff6600; margin-bottom: 15px;">🚀 Advanced Astronomical Insights</h3>
                
                <div class="insight-box">
                    <h4>🌙 Moon's Complex Orbit</h4>
                    <p>The Moon's orbit is <strong>elliptical and constantly changing</strong> due to the Sun's gravity! The orbital ellipse rotates completely every <strong>8.85 years</strong> (apsidal precession), and the eccentricity varies cyclically. The Sun's influence changes the Moon's distance from Earth by several thousand kilometers!</p>
                </div>
                
                <div class="insight-box">
                    <h4>🔴 Martian Moon Speed Champions</h4>
                    <p><strong>Phobos is one of the fastest-orbiting moons</strong> in our solar system! At just 7.6 hours per orbit, it actually orbits Mars <strong>faster than Mars rotates</strong> (24.6 hours). From Mars' surface, Phobos would rise in the west and set in the east - backwards compared to our Moon!</p>
                </div>
                
                <div class="insight-box">
                    <h4>🌌 Three-Body Dynamics</h4>
                    <p>This simulation demonstrates the famous <strong>"three-body problem"</strong> in celestial mechanics. The Moon's path around the Sun is always <strong>concave toward the Sun</strong> - it never loops backward! It's more accurate to think of the Moon as orbiting the Sun with Earth, rather than simply orbiting Earth.</p>
                </div>
                
                <div class="insight-box">
                    <h4>📏 Scale Perspective</h4>
                    <p>If Earth were the size of a basketball, the Moon would be a tennis ball <strong>23 feet away</strong>. Mars would be another basketball <strong>1.3 miles away</strong>, with Phobos and Deimos as tiny marbles just inches from Mars. The vast scales of space are mind-boggling!</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Canvas and context
        const canvas = document.getElementById('canvas');
        const ctx = canvas.getContext('2d');
        
        // Constants
        const AU = 200; // Earth-Sun distance in pixels
        const earthOrbitalPeriod = 365.25; // days
        const moonOrbitalPeriod = 27.3; // days
        const moonOrbitRadius = AU * 0.08; // Moon-Earth distance
        
        // Mars system constants
        const marsOrbitalPeriod = 687.0; // days (Mars year)
        const marsDistance = AU * 1.52; // Mars-Sun distance (1.52 AU)
        const phobosOrbitalPeriod = 0.32; // days (7.6 hours)
        const deimosOrbitalPeriod = 1.26; // days (30.3 hours)
        const phobosOrbitRadius = AU * 0.02; // Phobos-Mars distance
        const deimosOrbitRadius = AU * 0.035; // Deimos-Mars distance
        
        // Simulation state
        let currentDay = 0;
        let paused = false;
        let animationId;
        
        // Trails
        let earthTrail = [];
        let moonTrail = [];
        let marsTrail = [];
        let phobosTrail = [];
        let deimosTrail = [];
        
        // Visibility toggles
        let showEarth = true;
        let showMoon = true;
        let showEarthTrail = true;
        let showMoonTrail = true;
        let showMars = true;
        let showPhobos = true;
        let showDeimos = true;
        let showMarsTrail = true;
        let showPhobosTrail = true;
        let showDeimosTrail = true;
        
        // Control elements
        const timeSpeedSlider = document.getElementById('timeSpeed');
        const zoomSlider = document.getElementById('zoom');
        const trailLengthSlider = document.getElementById('trailLength');
        
        const earthBtn = document.getElementById('earthBtn');
        const moonBtn = document.getElementById('moonBtn');
        const earthTrailBtn = document.getElementById('earthTrailBtn');
        const moonTrailBtn = document.getElementById('moonTrailBtn');
        const marsBtn = document.getElementById('marsBtn');
        const phobosBtn = document.getElementById('phobosBtn');
        const deimosBtn = document.getElementById('deimosBtn');
        const marsTrailBtn = document.getElementById('marsTrailBtn');
        const phobosTrailBtn = document.getElementById('phobosTrailBtn');
        const deimosTrailBtn = document.getElementById('deimosTrailBtn');
        const resetBtn = document.getElementById('resetBtn');
        const pauseBtn = document.getElementById('pauseBtn');
        
        // Value displays
        const timeSpeedValue = document.getElementById('timeSpeedValue');
        const zoomValue = document.getElementById('zoomValue');
        const trailLengthValue = document.getElementById('trailLengthValue');
        const dayValue = document.getElementById('dayValue');
        const yearValue = document.getElementById('yearValue');
        const moonOrbitsValue = document.getElementById('moonOrbitsValue');
        const marsYearValue = document.getElementById('marsYearValue');
        const phobosOrbitsValue = document.getElementById('phobosOrbitsValue');
        
        // Update slider value displays
        timeSpeedSlider.addEventListener('input', () => {
            timeSpeedValue.textContent = parseFloat(timeSpeedSlider.value).toFixed(2);
        });
        
        zoomSlider.addEventListener('input', () => {
            zoomValue.textContent = parseFloat(zoomSlider.value).toFixed(1);
        });
        
        trailLengthSlider.addEventListener('input', () => {
            trailLengthValue.textContent = trailLengthSlider.value;
        });
        
        // Calculate positions using trigonometry
        function calculatePositions(day) {
            // Earth position around Sun
            const earthAngle = 2 * Math.PI * day / earthOrbitalPeriod;
            const earthX = AU * Math.cos(earthAngle);
            const earthY = AU * Math.sin(earthAngle);
            
            // Moon position relative to Earth
            const moonAngle = 2 * Math.PI * day / moonOrbitalPeriod;
            const moonXRel = moonOrbitRadius * Math.cos(moonAngle);
            const moonYRel = moonOrbitRadius * Math.sin(moonAngle);
            
            // Moon absolute position
            const moonX = earthX + moonXRel;
            const moonY = earthY + moonYRel;
            
            // Mars position around Sun
            const marsAngle = 2 * Math.PI * day / marsOrbitalPeriod;
            const marsX = marsDistance * Math.cos(marsAngle);
            const marsY = marsDistance * Math.sin(marsAngle);
            
            // Phobos position relative to Mars
            const phobosAngle = 2 * Math.PI * day / phobosOrbitalPeriod;
            const phobosXRel = phobosOrbitRadius * Math.cos(phobosAngle);
            const phobosYRel = phobosOrbitRadius * Math.sin(phobosAngle);
            
            // Phobos absolute position
            const phobosX = marsX + phobosXRel;
            const phobosY = marsY + phobosYRel;
            
            // Deimos position relative to Mars
            const deimosAngle = 2 * Math.PI * day / deimosOrbitalPeriod;
            const deimosXRel = deimosOrbitRadius * Math.cos(deimosAngle);
            const deimosYRel = deimosOrbitRadius * Math.sin(deimosAngle);
            
            // Deimos absolute position
            const deimosX = marsX + deimosXRel;
            const deimosY = marsY + deimosYRel;
            
            return { earthX, earthY, moonX, moonY, marsX, marsY, phobosX, phobosY, deimosX, deimosY };
        }
        
        // Draw trail with fading effect
        function drawTrail(trail, color, width) {
            if (trail.length < 2) return;
            
            for (let i = 1; i < trail.length; i++) {
                const fade = i / trail.length;
                if (fade > 0.3) {
                    ctx.strokeStyle = `rgba(${color.r}, ${color.g}, ${color.b}, ${fade})`;
                    ctx.lineWidth = width;
                    ctx.beginPath();
                    ctx.moveTo(trail[i-1].x, trail[i-1].y);
                    ctx.lineTo(trail[i].x, trail[i].y);
                    ctx.stroke();
                }
            }
        }
        
        // Main animation loop
        function animate() {
            if (!paused) {
                currentDay += parseFloat(timeSpeedSlider.value);
            }
            
            // Clear canvas
            ctx.fillStyle = '#000';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            
            // Get current positions
            const positions = calculatePositions(currentDay);
            const zoom = parseFloat(zoomSlider.value);
            const centerX = canvas.width / 2;
            const centerY = canvas.height / 2;
            
            // Add to trails
            earthTrail.push({
                x: centerX + positions.earthX * zoom,
                y: centerY + positions.earthY * zoom
            });
            moonTrail.push({
                x: centerX + positions.moonX * zoom,
                y: centerY + positions.moonY * zoom
            });
            marsTrail.push({
                x: centerX + positions.marsX * zoom,
                y: centerY + positions.marsY * zoom
            });
            phobosTrail.push({
                x: centerX + positions.phobosX * zoom,
                y: centerY + positions.phobosY * zoom
            });
            deimosTrail.push({
                x: centerX + positions.deimosX * zoom,
                y: centerY + positions.deimosY * zoom
            });
            
            // Limit trail lengths
            const maxTrail = parseInt(trailLengthSlider.value);
            if (earthTrail.length > maxTrail) earthTrail.shift();
            if (moonTrail.length > maxTrail) moonTrail.shift();
            if (marsTrail.length > maxTrail) marsTrail.shift();
            if (phobosTrail.length > maxTrail) phobosTrail.shift();
            if (deimosTrail.length > maxTrail) deimosTrail.shift();
            
            // Draw trails
            if (showEarthTrail) {
                drawTrail(earthTrail, {r: 65, g: 105, b: 225}, 2);
            }
            if (showMoonTrail) {
                drawTrail(moonTrail, {r: 192, g: 192, b: 192}, 1);
            }
            if (showMarsTrail) {
                drawTrail(marsTrail, {r: 205, g: 92, b: 92}, 2);
            }
            if (showPhobosTrail) {
                drawTrail(phobosTrail, {r: 218, g: 165, b: 32}, 1);
            }
            if (showDeimosTrail) {
                drawTrail(deimosTrail, {r: 169, g: 169, b: 169}, 1);
            }
            
            // Draw Sun
            ctx.fillStyle = '#ffff00';
            ctx.strokeStyle = '#ffaa00';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.arc(centerX, centerY, 15, 0, 2 * Math.PI);
            ctx.fill();
            ctx.stroke();
            
            ctx.fillStyle = '#ffff00';
            ctx.font = '12px Arial';
            ctx.textAlign = 'center';
            ctx.fillText('Sun', centerX, centerY - 25);
            
            // Draw Earth
            if (showEarth) {
                const earthScreenX = centerX + positions.earthX * zoom;
                const earthScreenY = centerY + positions.earthY * zoom;
                
                ctx.fillStyle = '#4169e1';
                ctx.strokeStyle = '#1e90ff';
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.arc(earthScreenX, earthScreenY, 8, 0, 2 * Math.PI);
                ctx.fill();
                ctx.stroke();
                
                ctx.fillStyle = '#87ceeb';
                ctx.font = '10px Arial';
                ctx.textAlign = 'center';
                ctx.fillText('Earth', earthScreenX, earthScreenY - 18);
            }
            
            // Draw Moon
            if (showMoon) {
                const moonScreenX = centerX + positions.moonX * zoom;
                const moonScreenY = centerY + positions.moonY * zoom;
                
                ctx.fillStyle = '#c0c0c0';
                ctx.strokeStyle = '#ffffff';
                ctx.lineWidth = 1;
                ctx.beginPath();
                ctx.arc(moonScreenX, moonScreenY, 4, 0, 2 * Math.PI);
                ctx.fill();
                ctx.stroke();
                
                ctx.fillStyle = '#ffffff';
                ctx.font = '9px Arial';
                ctx.textAlign = 'center';
                ctx.fillText('Moon', moonScreenX, moonScreenY - 12);
            }
            
            // Draw Mars system
            if (showMars) {
                const marsScreenX = centerX + positions.marsX * zoom;
                const marsScreenY = centerY + positions.marsY * zoom;
                
                ctx.fillStyle = '#cd5c5c';
                ctx.strokeStyle = '#ff6347';
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.arc(marsScreenX, marsScreenY, 6, 0, 2 * Math.PI);
                ctx.fill();
                ctx.stroke();
                
                ctx.fillStyle = '#ff6600';
                ctx.font = '10px Arial';
                ctx.textAlign = 'center';
                ctx.fillText('Mars', marsScreenX, marsScreenY - 16);
            }
            
            if (showPhobos) {
                const phobosScreenX = centerX + positions.phobosX * zoom;
                const phobosScreenY = centerY + positions.phobosY * zoom;
                
                ctx.fillStyle = '#8b7355';
                ctx.strokeStyle = '#daa520';
                ctx.lineWidth = 1;
                ctx.beginPath();
                ctx.arc(phobosScreenX, phobosScreenY, 2, 0, 2 * Math.PI);
                ctx.fill();
                ctx.stroke();
                
                ctx.fillStyle = '#daa520';
                ctx.font = '8px Arial';
                ctx.textAlign = 'center';
                ctx.fillText('Phobos', phobosScreenX, phobosScreenY - 10);
            }
            
            if (showDeimos) {
                const deimosScreenX = centerX + positions.deimosX * zoom;
                const deimosScreenY = centerY + positions.deimosY * zoom;
                
                ctx.fillStyle = '#696969';
                ctx.strokeStyle = '#a9a9a9';
                ctx.lineWidth = 1;
                ctx.beginPath();
                ctx.arc(deimosScreenX, deimosScreenY, 2, 0, 2 * Math.PI);
                ctx.fill();
                ctx.stroke();
                
                ctx.fillStyle = '#a9a9a9';
                ctx.font = '8px Arial';
                ctx.textAlign = 'center';
                ctx.fillText('Deimos', deimosScreenX, deimosScreenY - 10);
            }
            
            // Update information display
            const years = currentDay / earthOrbitalPeriod;
            const moonOrbits = currentDay / moonOrbitalPeriod;
            const marsYears = currentDay / marsOrbitalPeriod;
            const phobosOrbits = currentDay / phobosOrbitalPeriod;
            
            dayValue.textContent = currentDay.toFixed(1);
            yearValue.textContent = years.toFixed(3);
            moonOrbitsValue.textContent = moonOrbits.toFixed(1);
            marsYearValue.textContent = marsYears.toFixed(3);
            phobosOrbitsValue.textContent = phobosOrbits.toFixed(0);
            
            animationId = requestAnimationFrame(animate);
        }
        
        // Toggle functions
        function toggleEarth() {
            showEarth = !showEarth;
            earthBtn.textContent = `Earth: ${showEarth ? 'ON' : 'OFF'}`;
            earthBtn.style.background = showEarth ? '#4169e1' : 'gray';
        }
        
        function toggleMoon() {
            showMoon = !showMoon;
            moonBtn.textContent = `Moon: ${showMoon ? 'ON' : 'OFF'}`;
            moonBtn.style.background = showMoon ? '#c0c0c0' : 'gray';
        }
        
        function toggleEarthTrail() {
            showEarthTrail = !showEarthTrail;
            earthTrailBtn.textContent = `Earth Trail: ${showEarthTrail ? 'ON' : 'OFF'}`;
            earthTrailBtn.style.background = showEarthTrail ? '#1e90ff' : 'gray';
        }
        
        function toggleMoonTrail() {
            showMoonTrail = !showMoonTrail;
            moonTrailBtn.textContent = `Moon Trail: ${showMoonTrail ? 'ON' : 'OFF'}`;
            moonTrailBtn.style.background = showMoonTrail ? '#ffffff' : 'gray';
        }
        
        function toggleMars() {
            showMars = !showMars;
            marsBtn.textContent = `Mars: ${showMars ? 'ON' : 'OFF'}`;
            marsBtn.style.background = showMars ? '#cd5c5c' : 'gray';
        }
        
        function togglePhobos() {
            showPhobos = !showPhobos;
            phobosBtn.textContent = `Phobos: ${showPhobos ? 'ON' : 'OFF'}`;
            phobosBtn.style.background = showPhobos ? '#8b7355' : 'gray';
        }
        
        function toggleDeimos() {
            showDeimos = !showDeimos;
            deimosBtn.textContent = `Deimos: ${showDeimos ? 'ON' : 'OFF'}`;
            deimosBtn.style.background = showDeimos ? '#696969' : 'gray';
        }
        
        function toggleMarsTrail() {
            showMarsTrail = !showMarsTrail;
            marsTrailBtn.textContent = `Mars Trail: ${showMarsTrail ? 'ON' : 'OFF'}`;
            marsTrailBtn.style.background = showMarsTrail ? '#ff6347' : 'gray';
        }
        
        function togglePhobosTrail() {
            showPhobosTrail = !showPhobosTrail;
            phobosTrailBtn.textContent = `Phobos Trail: ${showPhobosTrail ? 'ON' : 'OFF'}`;
            phobosTrailBtn.style.background = showPhobosTrail ? '#daa520' : 'gray';
        }
        
        function toggleDeimosTrail() {
            showDeimosTrail = !showDeimosTrail;
            deimosTrailBtn.textContent = `Deimos Trail: ${showDeimosTrail ? 'ON' : 'OFF'}`;
            deimosTrailBtn.style.background = showDeimosTrail ? '#a9a9a9' : 'gray';
        }
        
        function resetSimulation() {
            currentDay = 0;
            earthTrail = [];
            moonTrail = [];
            marsTrail = [];
            phobosTrail = [];
            deimosTrail = [];
        }
        
        function togglePause() {
            paused = !paused;
            pauseBtn.textContent = paused ? 'Resume' : 'Pause';
        }
        
        // Mouse wheel zoom functionality
        canvas.addEventListener('wheel', (e) => {
            e.preventDefault(); // Prevent page scrolling
            
            const zoomSpeed = 0.1;
            const currentZoom = parseFloat(zoomSlider.value);
            const minZoom = parseFloat(zoomSlider.min);
            const maxZoom = parseFloat(zoomSlider.max);
            
            let newZoom;
            if (e.deltaY < 0) {
                // Zoom in (wheel up)
                newZoom = Math.min(currentZoom + zoomSpeed, maxZoom);
            } else {
                // Zoom out (wheel down)
                newZoom = Math.max(currentZoom - zoomSpeed, minZoom);
            }
            
            // Update slider and display
            zoomSlider.value = newZoom;
            zoomValue.textContent = newZoom.toFixed(1);
        });

        // Event listeners
        earthBtn.addEventListener('click', toggleEarth);
        moonBtn.addEventListener('click', toggleMoon);
        earthTrailBtn.addEventListener('click', toggleEarthTrail);
        moonTrailBtn.addEventListener('click', toggleMoonTrail);
        marsBtn.addEventListener('click', toggleMars);
        phobosBtn.addEventListener('click', togglePhobos);
        deimosBtn.addEventListener('click', toggleDeimos);
        marsTrailBtn.addEventListener('click', toggleMarsTrail);
        phobosTrailBtn.addEventListener('click', togglePhobosTrail);
        deimosTrailBtn.addEventListener('click', toggleDeimosTrail);
        resetBtn.addEventListener('click', resetSimulation);
        pauseBtn.addEventListener('click', togglePause);
        
        // Start animation
        animate();
    </script>
</body>
</html>
