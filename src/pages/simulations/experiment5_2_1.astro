---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Experiment 5.2.1: Elephant Toothpaste">
    <main class="container mx-auto px-4 py-8">
        <div class="experiment-header">
            <h1 class="text-3xl font-bold text-center text-blue-700 mb-2">EXPERIMENT 5.2.1</h1>
            <h2 class="text-2xl font-bold text-center text-blue-700 mb-8">ELEPHANT TOOTHPASTE</h2>
        </div>

        <!-- Email Collection Section -->
        <section class="mb-8">
            <div class="bg-blue-50 p-4 rounded-lg mb-4">
                <h4 class="font-bold mb-2">Student Information:</h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="studentName" class="block text-gray-700 font-bold mb-2">Name:</label>
                        <input type="text" id="studentName" class="w-full px-3 py-2 border rounded-lg" placeholder="Your Name">
                    </div>
                    <div>
                        <label for="studentEmail" class="block text-gray-700 font-bold mb-2">Email:</label>
                        <input type="email" id="studentEmail" class="w-full px-3 py-2 border rounded-lg" placeholder="your.email@example.com">
                    </div>
                </div>
                <div class="mt-4">
                    <label for="teacherEmail" class="block text-gray-700 font-bold mb-2">Teacher's Email:</label>
                    <input type="email" id="teacherEmail" class="w-full px-3 py-2 border rounded-lg" value="chuck@c00lnerd.com" placeholder="teacher.email@example.com">
                </div>
            </div>
        </section>

        <!-- Purpose Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">PURPOSE:</h3>
            <p class="mb-4">To observe an exothermic reaction that produces a large amount of foam, and understand the role of catalysts in chemical reactions.</p>
        </section>

        <!-- Materials Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">MATERIALS:</h3>
            <ul class="list-disc pl-8 mb-4">
                <li>250 mL flask</li>
                <li>75 mL 30% hydrogen peroxide</li>
                <li>2 tablespoons dishwashing soap</li>
                <li>Food coloring (your choice of color)</li>
                <li>1 packet of active dry yeast</li>
                <li>Warm water</li>
                <li>Measuring cup</li>
                <li>Sink or outdoor area (for mess containment)</li>
                <li>Safety goggles</li>
            </ul>
            <div class="bg-yellow-100 border-l-4 border-yellow-500 p-4 mb-4">
                <p class="font-bold">SAFETY WARNING:</p>
                <p>This experiment is very messy! Perform it in a sink or outside. Wear safety goggles to protect your eyes from splashes. Hydrogen peroxide can irritate skin and eyes, so handle with care.</p>
            </div>
        </section>

        <!-- Background Information Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">BACKGROUND INFORMATION:</h3>
            <p class="mb-4">Elephant Toothpaste is a fun demonstration of an exothermic reaction (one that releases heat) and catalysis. In this experiment, hydrogen peroxide (H₂O₂) rapidly decomposes into water (H₂O) and oxygen gas (O₂) when catalyzed by the yeast. The yeast contains an enzyme called catalase that speeds up this decomposition reaction.</p>
            <p class="mb-4">The dishwashing soap traps the oxygen gas produced during the reaction, creating a large amount of foam that looks like toothpaste being squeezed from a tube (hence the name "Elephant Toothpaste"). The reaction is exothermic, meaning it releases heat, which is why the bottle feels warm after the reaction.</p>
            <p class="mb-4">The chemical equation for this reaction is: 2H₂O₂ → 2H₂O + O₂</p>
        </section>

        <!-- Questions Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">QUESTIONS:</h3>
            <p class="mb-4">1. Why does this reaction foam more than the reactions in Experiment 5.2?</p>
            <p class="mb-4">2. What is the role of yeast in this reaction?</p>
            <p class="mb-4">3. Why does the bottle feel warm after the reaction?</p>
        </section>

        <!-- Hypotheses Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">HYPOTHESES:</h3>
            <p class="mb-4">Write your predictions about what will happen in this experiment and why.</p>
            <div class="mb-4">
                <p class="font-bold">My Hypothesis:</p>
                <textarea id="hypothesis" class="w-full p-2 border rounded-lg" rows="4" placeholder="Enter your hypothesis here..."></textarea>
            </div>
        </section>

        <!-- Procedure Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">PROCEDURE:</h3>
            <ol class="list-decimal pl-8 mb-4">
                <li class="mb-2">
                    Put on safety goggles.
                </li>
                <li class="mb-2">
                    Rinse out the 250 mL flask.
                </li>
                <li class="mb-2">
                    Place the flask in a sink or take it outside (this will get messy!).
                </li>
                <li class="mb-2">
                    Add 75 mL of 30% hydrogen peroxide to the flask.
                </li>
                <li class="mb-2">
                    Add 2 tablespoons of dishwashing soap to the flask.
                </li>
                <li class="mb-2">
                    Add a few drops of food coloring of your choice.
                </li>
                <li class="mb-2">
                    In a separate measuring cup, mix a packet of active yeast with a little warm water.
                </li>
                <li class="mb-2">
                    Let the yeast sit in the water for about 5 minutes to activate.
                </li>
                <li class="mb-2">
                    Once the yeast is activated, quickly pour it into the flask with the hydrogen peroxide mixture.
                </li>
                <li class="mb-2">
                    Step back and observe what happens!
                </li>
                <li class="mb-2">
                    After the reaction slows down, feel the outside of the flask. It should feel warm.
                </li>
            </ol>
        </section>

        <!-- Video Demonstration Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">VIDEO DEMONSTRATION:</h3>
            <p class="mb-4">Watch this video demonstration of the elephant toothpaste experiment to see the procedure in action.</p>
            
            <div class="bg-blue-50 p-6 rounded-lg">
                <div class="flex justify-center">
                    <div class="w-full max-w-4xl">
                        <div class="relative w-full" style="padding-bottom: 56.25%; height: 0;">
                            <iframe 
                                class="absolute top-0 left-0 w-full h-full rounded-lg shadow-lg"
                                src="https://www.youtube.com/embed/90nthtCG-1Y"
                                title="Elephant Toothpaste Experiment Demonstration"
                                frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                allowfullscreen
                                loading="lazy">
                            </iframe>
                        </div>
                        <p class="text-center mt-2 text-sm text-gray-600">
                            <a href="https://www.youtube.com/watch?v=90nthtCG-1Y" target="_blank" class="text-blue-600 hover:underline">
                                Watch on YouTube if video doesn't load
                            </a>
                        </p>
                    </div>
                </div>
                
                <div class="bg-white border-2 border-blue-200 rounded-lg p-4 mt-4">
                    <h4 class="font-bold mb-2">What to Look For:</h4>
                    <ul class="list-disc pl-5">
                        <li>The rapid foam production when yeast is added</li>
                        <li>The height and volume of the foam "toothpaste"</li>
                        <li>The exothermic nature of the reaction (heat production)</li>
                        <li>The role of soap in creating the foam structure</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Data Table Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">OBSERVATIONS:</h3>
            <div class="mb-4">
                <p class="font-bold mb-2">Record your observations below:</p>
                <div class="grid grid-cols-1 gap-4">
                    <div>
                        <label class="block text-gray-700 mb-2">Initial temperature of bottle (before reaction):</label>
                        <input type="number" id="initialTemp" class="w-full p-2 border rounded-lg" placeholder="°C">
                    </div>
                    <div>
                        <label class="block text-gray-700 mb-2">Final temperature of bottle (after reaction):</label>
                        <input type="number" id="finalTemp" class="w-full p-2 border rounded-lg" placeholder="°C">
                    </div>
                    <div>
                        <label class="block text-gray-700 mb-2">Temperature change:</label>
                        <input type="text" id="tempChange" class="w-full p-2 border rounded-lg bg-gray-100" readonly>
                    </div>
                    <div>
                        <label class="block text-gray-700 mb-2">Height of foam produced (approximate):</label>
                        <input type="text" id="foamHeight" class="w-full p-2 border rounded-lg" placeholder="cm or inches">
                    </div>
                    <div>
                        <label class="block text-gray-700 mb-2">Time for reaction to complete:</label>
                        <input type="text" id="reactionTime" class="w-full p-2 border rounded-lg" placeholder="seconds">
                    </div>
                    <div>
                        <label class="block text-gray-700 mb-2">Detailed observations (color, texture, speed, etc.):</label>
                        <textarea id="observations" class="w-full p-2 border rounded-lg" rows="4" placeholder="Describe what you observed..."></textarea>
                    </div>
                </div>
            </div>
        </section>


        <!-- Conclusion Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">CONCLUSION:</h3>
            <p class="mb-4">Based on your observations, answer the following questions:</p>
            <div class="mb-4">
                <p class="font-bold">1. Why does this reaction foam more than the reactions in Experiment 5.2?</p>
                <textarea id="question1" class="w-full p-2 border rounded-lg" rows="3" placeholder="Your answer..."></textarea>
            </div>
            <div class="mb-4">
                <p class="font-bold">2. What is the role of yeast in this reaction?</p>
                <textarea id="question2" class="w-full p-2 border rounded-lg" rows="3" placeholder="Your answer..."></textarea>
            </div>
            <div class="mb-4">
                <p class="font-bold">3. Why does the bottle feel warm after the reaction?</p>
                <textarea id="question3" class="w-full p-2 border rounded-lg" rows="3" placeholder="Your answer..."></textarea>
            </div>
            <div class="mb-4">
                <p class="font-bold">What did you learn from this experiment?</p>
                <textarea id="conclusion" class="w-full p-2 border rounded-lg" rows="4" placeholder="Write your conclusion here..."></textarea>
            </div>
        </section>

        <!-- Submit Section -->
        <section class="mb-8">
            <div class="bg-blue-50 p-4 rounded-lg">
                <h3 class="text-xl font-bold text-blue-700 mb-4">SUBMIT YOUR RESULTS:</h3>
                <p class="mb-4">Click the button below to submit your experiment results to your teacher.</p>
                <button id="submitBtn" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                    Submit Results
                </button>
                <p id="submissionMessage" class="mt-2 hidden"></p>
            </div>
        </section>
    </main>
</Layout>

<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
<script>
    // Wait for DOM to be fully loaded (matching module 3 experiments)
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize EmailJS (same as working module 3)
        emailjs.init('ct_s19oZHppLy9BlW');
        
        // DOM Elements
        // Store student information in local storage
        const studentNameInput = document.getElementById('studentName');
        const studentEmailInput = document.getElementById('studentEmail');
        const teacherEmailInput = document.getElementById('teacherEmail');

        // Load stored values if they exist
        if (localStorage.getItem('studentName')) {
            studentNameInput.value = localStorage.getItem('studentName');
        }
        if (localStorage.getItem('studentEmail')) {
            studentEmailInput.value = localStorage.getItem('studentEmail');
        }
        if (localStorage.getItem('teacherEmail')) {
            teacherEmailInput.value = localStorage.getItem('teacherEmail');
        }

        // Save values when they change
        studentNameInput.addEventListener('change', function() {
            localStorage.setItem('studentName', this.value);
        });
        studentEmailInput.addEventListener('change', function() {
            localStorage.setItem('studentEmail', this.value);
        });
        teacherEmailInput.addEventListener('change', function() {
            localStorage.setItem('teacherEmail', this.value);
        });

        // Calculate temperature change
        const initialTempInput = document.getElementById('initialTemp');
        const finalTempInput = document.getElementById('finalTemp');
        const tempChangeInput = document.getElementById('tempChange');

        function calculateTempChange() {
            if (initialTempInput.value && finalTempInput.value) {
                const initialTemp = parseFloat(initialTempInput.value);
                const finalTemp = parseFloat(finalTempInput.value);
                const change = (finalTemp - initialTemp).toFixed(1);
                tempChangeInput.value = change + " °C";
            }
        }

        initialTempInput.addEventListener('input', calculateTempChange);
        finalTempInput.addEventListener('input', calculateTempChange);

        // Video tracking (YouTube video only)
        let videoWatched = false;

        // Handle form submission
        const submitBtn = document.getElementById('submitBtn');
        const submissionMessage = document.getElementById('submissionMessage');

        submitBtn.addEventListener('click', function() {
            // Validate required fields
            const studentName = studentNameInput.value.trim();
            const studentEmail = studentEmailInput.value.trim();
            const teacherEmail = teacherEmailInput.value.trim();
            const hypothesis = document.getElementById('hypothesis').value.trim();
            const observations = document.getElementById('observations').value.trim();
            const conclusion = document.getElementById('conclusion').value.trim();

            if (!studentName || !studentEmail || !teacherEmail) {
                showMessage('Please fill in all required student and teacher information.', 'error');
                return;
            }

            if (!hypothesis || !observations || !conclusion) {
                showMessage('Please complete your hypothesis, observations, and conclusion.', 'error');
                return;
            }

            // Prepare comprehensive experiment data (matching working template structure)
            const experimentData = 
                'EXPERIMENT 5.2.1: ELEPHANT TOOTHPASTE - DETAILED RESULTS\n\n' +
                'Student: ' + studentName + '\n' +
                'Email: ' + studentEmail + '\n\n' +
                'HYPOTHESIS:\n' + hypothesis + '\n\n' +
                'TEMPERATURE MEASUREMENTS:\n' +
                'Initial Temperature: ' + (initialTempInput.value || 'Not recorded') + '°C\n' +
                'Final Temperature: ' + (finalTempInput.value || 'Not recorded') + '°C\n' +
                'Temperature Change: ' + (tempChangeInput.value || 'Not calculated') + '\n\n' +
                'REACTION OBSERVATIONS:\n' +
                'Foam Height: ' + (document.getElementById('foamHeight').value || 'Not recorded') + '\n' +
                'Reaction Time: ' + (document.getElementById('reactionTime').value || 'Not recorded') + '\n' +
                'Detailed Observations: ' + observations + '\n\n' +
                'ANALYSIS QUESTIONS:\n' +
                '1. Why does this reaction foam more than reactions in Experiment 5.2?\n' +
                (document.getElementById('question1').value || 'Not answered') + '\n\n' +
                '2. What is the role of yeast in this reaction?\n' +
                (document.getElementById('question2').value || 'Not answered') + '\n\n' +
                '3. Why does the bottle feel warm after the reaction?\n' +
                (document.getElementById('question3').value || 'Not answered') + '\n\n' +
                'CONCLUSION:\n' + conclusion + '\n\n' +
                'Video Demonstration Watched: ' + (videoWatched ? 'Yes' : 'No') + '\n' +
                'Experiment completed: ' + new Date().toLocaleString();

            // Disable button and show loading state
            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting...';

            // Send email using EmailJS with exact parameter structure from working experiment3_2
            emailjs.send('service_ot1jg6s', 'template_y556rhr', {
                student_name: studentName,
                student_email: studentEmail,
                experiment_title: 'Experiment 5.2.1: Elephant Toothpaste',
                hypothesis: hypothesis || 'No hypothesis provided',
                missing_elements: (document.getElementById('question1').value || 'Not answered') + '\n\n' + 
                                (document.getElementById('question2').value || 'Not answered') + '\n\n' + 
                                (document.getElementById('question3').value || 'Not answered'),
                conclusion: experimentData,
                subject: `Experiment 5.2.1 - ${studentName}`
            })
                .then(function(response) {
                    console.log('SUCCESS!', response.status, response.text);
                    showMessage('Your experiment results have been submitted successfully!', 'success');
                    submitBtn.textContent = 'Submitted';
                })
                .catch(function(error) {
                    console.log('FAILED...', error);
                    showMessage('Failed to submit results. Please try again later.', 'error');
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Submit Results';
                });
        });

        function showMessage(message, type) {
            submissionMessage.textContent = message;
            submissionMessage.classList.remove('hidden', 'text-green-600', 'text-red-600');
            submissionMessage.classList.add(type === 'success' ? 'text-green-600' : 'text-red-600');
        }
    });
</script>
