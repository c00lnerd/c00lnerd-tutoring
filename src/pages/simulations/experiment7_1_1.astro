---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Experiment 7.1.1: Measuring Height with a Stopwatch">
    <main class="container mx-auto px-4 py-8">
        <div class="experiment-header">
            <h1 class="text-3xl font-bold text-center text-blue-700 mb-2">EXPERIMENT 7.1.1</h1>
            <h2 class="text-2xl font-bold text-center text-blue-700 mb-8">MEASURING HEIGHT WITH A STOPWATCH</h2>
        </div>

        <!-- Email Collection Section -->
        <section class="mb-8">
            <div class="bg-blue-50 p-4 rounded-lg mb-4">
                <h4 class="font-bold mb-2">Student Information:</h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="studentName" class="block text-gray-700 font-bold mb-2">Name:</label>
                        <input type="text" id="studentName" class="w-full px-3 py-2 border rounded-lg" placeholder="Your Name">
                    </div>
                    <div>
                        <label for="studentEmail" class="block text-gray-700 font-bold mb-2">Email:</label>
                        <input type="email" id="studentEmail" class="w-full px-3 py-2 border rounded-lg" placeholder="your.email@example.com">
                    </div>
                </div>
                <div class="mt-4">
                    <label for="teacherEmail" class="block text-gray-700 font-bold mb-2">Teacher's Email:</label>
                    <input type="email" id="teacherEmail" class="w-full px-3 py-2 border rounded-lg" value="chuck@c00lnerd.com" placeholder="teacher.email@example.com">
                </div>
            </div>
        </section>

        <!-- Purpose Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">PURPOSE:</h3>
            <p class="mb-4">To use free fall physics and the acceleration due to gravity to measure the height of a room when a direct measurement is not possible.</p>
        </section>

        <!-- Materials Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">MATERIALS:</h3>
            <ul class="list-disc pl-8 mb-4">
                <li>A stopwatch that reads to hundredths of a second (many smartphones have this feature)</li>
                <li>A chair or stepladder</li>
                <li>A rock or other heavy object to reduce air resistance</li>
                <li>A tape measure</li>
            </ul>
        </section>

        <!-- Safety Section -->
        <section class="mb-8">
            <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4">
                <h3 class="text-xl font-bold text-yellow-700">SAFETY:</h3>
                <ul class="list-disc pl-8 mb-0">
                    <li>Be careful when standing on chairs or stepladders.</li>
                    <li>Choose an object that won't damage the floor when dropped.</li>
                    <li>Make sure the area below is clear of obstacles and people.</li>
                    <li>Have a friend spot you if possible.</li>
                </ul>
            </div>
        </section>

        <!-- Background Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">BACKGROUND:</h3>
            <p class="mb-4">Sometimes it is hard to measure the height of something because you do not have a ruler long enough. In this activity, you will use a stopwatch and a rock to measure the height of the ceiling in a room.</p>
            <p class="mb-4">This experiment applies the physics of free fall. When an object falls, it accelerates due to gravity at a constant rate of approximately 9.8 m/s² (or 32 ft/s² if using imperial units). Using the time it takes for an object to fall, we can calculate the distance it traveled using the equation:</p>
            <div class="bg-gray-100 p-4 rounded-lg mb-4 text-center">
                <p class="font-bold">d = ½gt²</p>
                <p>Where:</p>
                <p>d = distance (height)</p>
                <p>g = acceleration due to gravity (9.8 m/s² or 32 ft/s²)</p>
                <p>t = time of fall in seconds</p>
            </div>
            <p class="mb-4">This equation is derived from the kinematic equation for an object starting from rest and accelerating at a constant rate.</p>
            
            <div class="flex flex-col md:flex-row items-center justify-center gap-8 mb-4">
                <div class="md:w-1/2">
                    <img src="/images/stopwatch.jpg" alt="Stopwatch showing time to hundredths of a second" class="rounded-lg shadow-md mx-auto" style="max-width: 300px;">
                    <p class="text-center text-sm mt-2">FIGURE 7.13 - Stopwatch<br>Make sure your stopwatch shows the time to the hundredths of a second.</p>
                </div>
            </div>
        </section>

        <!-- Procedure Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">PROCEDURE:</h3>
            <ol class="list-decimal pl-8 mb-4 space-y-4">
                <li>
                    <p>Stand on the chair or stepladder and hold your rock so that it touches the ceiling of the room. With the stopwatch in your other hand, simultaneously drop the rock and start the stopwatch.</p>
                </li>
                <li>
                    <p>When the rock hits the ground, stop the stopwatch. Record the time from the stopwatch in the data table below.</p>
                </li>
                <li>
                    <p>Repeat timing the drop of the rock 10 times. It is important to repeat this 10 times to reduce experimental error in timing because the time is so small.</p>
                </li>
                <li>
                    <p>Once you have timed the rock drop 10 times, calculate the average time by adding all your measurements and dividing by 10.</p>
                </li>
                <li>
                    <p>Use the time you just calculated and equation 7.1 (d = ½gt²) to determine the distance over which the rock fell.</p>
                </li>
                <li>
                    <p>If the tape measure you have is marked off in feet, use 32 ft/s² for the acceleration. If it is marked off in meters, use 9.8 m/s² as the acceleration.</p>
                </li>
                <li>
                    <p>Once you calculate the height of the room, measure it with the tape measure. How close are your numbers? They should be within 15% of each other.</p>
                </li>
            </ol>
        </section>

        <!-- Data Collection Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">DATA COLLECTION:</h3>
            <div class="overflow-x-auto">
                <table class="min-w-full bg-white border border-gray-300 rounded-lg mb-4">
                    <thead>
                        <tr class="bg-blue-100">
                            <th class="py-2 px-4 border-b">Trial</th>
                            <th class="py-2 px-4 border-b">Time (seconds)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="py-2 px-4 border-b">1</td>
                            <td class="py-2 px-4 border-b">
                                <input type="number" step="0.01" class="w-full px-2 py-1 border rounded" id="time1">
                            </td>
                        </tr>
                        <tr>
                            <td class="py-2 px-4 border-b">2</td>
                            <td class="py-2 px-4 border-b">
                                <input type="number" step="0.01" class="w-full px-2 py-1 border rounded" id="time2">
                            </td>
                        </tr>
                        <tr>
                            <td class="py-2 px-4 border-b">3</td>
                            <td class="py-2 px-4 border-b">
                                <input type="number" step="0.01" class="w-full px-2 py-1 border rounded" id="time3">
                            </td>
                        </tr>
                        <tr>
                            <td class="py-2 px-4 border-b">4</td>
                            <td class="py-2 px-4 border-b">
                                <input type="number" step="0.01" class="w-full px-2 py-1 border rounded" id="time4">
                            </td>
                        </tr>
                        <tr>
                            <td class="py-2 px-4 border-b">5</td>
                            <td class="py-2 px-4 border-b">
                                <input type="number" step="0.01" class="w-full px-2 py-1 border rounded" id="time5">
                            </td>
                        </tr>
                        <tr>
                            <td class="py-2 px-4 border-b">6</td>
                            <td class="py-2 px-4 border-b">
                                <input type="number" step="0.01" class="w-full px-2 py-1 border rounded" id="time6">
                            </td>
                        </tr>
                        <tr>
                            <td class="py-2 px-4 border-b">7</td>
                            <td class="py-2 px-4 border-b">
                                <input type="number" step="0.01" class="w-full px-2 py-1 border rounded" id="time7">
                            </td>
                        </tr>
                        <tr>
                            <td class="py-2 px-4 border-b">8</td>
                            <td class="py-2 px-4 border-b">
                                <input type="number" step="0.01" class="w-full px-2 py-1 border rounded" id="time8">
                            </td>
                        </tr>
                        <tr>
                            <td class="py-2 px-4 border-b">9</td>
                            <td class="py-2 px-4 border-b">
                                <input type="number" step="0.01" class="w-full px-2 py-1 border rounded" id="time9">
                            </td>
                        </tr>
                        <tr>
                            <td class="py-2 px-4 border-b">10</td>
                            <td class="py-2 px-4 border-b">
                                <input type="number" step="0.01" class="w-full px-2 py-1 border rounded" id="time10">
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-gray-700 font-bold mb-2">Average Time (seconds):</label>
                    <div class="flex items-center">
                        <input type="number" step="0.01" class="w-full px-3 py-2 border rounded-lg" id="averageTime" readonly>
                        <button id="calculateAvgBtn" class="ml-2 bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                            Calculate
                        </button>
                    </div>
                </div>
                <div>
                    <label class="block text-gray-700 font-bold mb-2">Units for Calculation:</label>
                    <select id="units" class="w-full px-3 py-2 border rounded-lg">
                        <option value="metric">Metric (meters)</option>
                        <option value="imperial">Imperial (feet)</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-gray-700 font-bold mb-2">Calculated Height:</label>
                    <div class="flex items-center">
                        <input type="number" step="0.01" class="w-full px-3 py-2 border rounded-lg" id="calculatedHeight" readonly>
                        <span id="calculatedUnits" class="ml-2">m</span>
                        <button id="calculateHeightBtn" class="ml-2 bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                            Calculate
                        </button>
                    </div>
                </div>
                <div>
                    <label class="block text-gray-700 font-bold mb-2">Measured Height (with tape measure):</label>
                    <div class="flex items-center">
                        <input type="number" step="0.01" class="w-full px-3 py-2 border rounded-lg" id="measuredHeight">
                        <span id="measuredUnits" class="ml-2">m</span>
                    </div>
                </div>
            </div>

            <div>
                <label class="block text-gray-700 font-bold mb-2">Percent Difference:</label>
                <div class="flex items-center">
                    <input type="number" step="0.01" class="w-full px-3 py-2 border rounded-lg" id="percentDifference" readonly>
                    <span class="ml-2">%</span>
                    <button id="calculateDiffBtn" class="ml-2 bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                        Calculate
                    </button>
                </div>
            </div>
        </section>

        <!-- Analysis Questions Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">ANALYSIS QUESTIONS:</h3>
            <div class="space-y-4">
                <div>
                    <p class="font-bold">1. Why is it important to repeat the time measurement 10 times?</p>
                    <textarea id="question1" class="w-full p-2 border rounded-lg" rows="2" placeholder="Your answer..."></textarea>
                </div>
                <div>
                    <p class="font-bold">2. What factors might contribute to experimental error in this experiment?</p>
                    <textarea id="question2" class="w-full p-2 border rounded-lg" rows="2" placeholder="Your answer..."></textarea>
                </div>
                <div>
                    <p class="font-bold">3. How would air resistance affect your measurements? Would it make your calculated height higher or lower than the actual height?</p>
                    <textarea id="question3" class="w-full p-2 border rounded-lg" rows="2" placeholder="Your answer..."></textarea>
                </div>
                <div>
                    <p class="font-bold">4. If you performed this experiment on the Moon (where g = 1.6 m/s²), how would your results differ?</p>
                    <textarea id="question4" class="w-full p-2 border rounded-lg" rows="2" placeholder="Your answer..."></textarea>
                </div>
                <div>
                    <p class="font-bold">5. Why did we use a heavy object like a rock instead of a lighter object like a feather?</p>
                    <textarea id="question5" class="w-full p-2 border rounded-lg" rows="2" placeholder="Your answer..."></textarea>
                </div>
            </div>
        </section>

        <!-- Conclusion Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">CONCLUSION:</h3>
            <p class="mb-4">Write a paragraph discussing your results. How close was your calculated height to the measured height? What might have caused any differences? How could you improve the accuracy of this experiment?</p>
            <div class="mb-4">
                <textarea id="conclusion" class="w-full p-2 border rounded-lg" rows="6" placeholder="Write your conclusion here..."></textarea>
            </div>
        </section>

        <!-- Submit Section -->
        <section class="mb-8">
            <div class="bg-blue-50 p-4 rounded-lg">
                <h3 class="text-xl font-bold text-blue-700 mb-4">SUBMIT YOUR RESULTS:</h3>
                <p class="mb-4">Click the button below to submit your experiment results to your teacher.</p>
                <button id="submitBtn" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                    Submit Results
                </button>
                <p id="submissionMessage" class="mt-2 hidden"></p>
            </div>
        </section>
    </main>
</Layout>

<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
<script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize EmailJS
        emailjs.init('ct_s19oZHppLy9BlW');
        // Store student information in local storage
        const studentNameInput = document.getElementById('studentName');
        const studentEmailInput = document.getElementById('studentEmail');
        const teacherEmailInput = document.getElementById('teacherEmail');
        const unitsSelect = document.getElementById('units');

        // Load stored values if they exist
        if (localStorage.getItem('studentName')) {
            studentNameInput.value = localStorage.getItem('studentName');
        }
        if (localStorage.getItem('studentEmail')) {
            studentEmailInput.value = localStorage.getItem('studentEmail');
        }
        if (localStorage.getItem('teacherEmail')) {
            teacherEmailInput.value = localStorage.getItem('teacherEmail');
        }

        // Save values when they change
        studentNameInput.addEventListener('change', function() {
            localStorage.setItem('studentName', this.value);
        });
        studentEmailInput.addEventListener('change', function() {
            localStorage.setItem('studentEmail', this.value);
        });
        teacherEmailInput.addEventListener('change', function() {
            localStorage.setItem('teacherEmail', this.value);
        });

        // Update units display when selection changes
        unitsSelect.addEventListener('change', function() {
            const calculatedUnits = document.getElementById('calculatedUnits');
            const measuredUnits = document.getElementById('measuredUnits');
            
            if (this.value === 'metric') {
                calculatedUnits.textContent = 'm';
                measuredUnits.textContent = 'm';
            } else {
                calculatedUnits.textContent = 'ft';
                measuredUnits.textContent = 'ft';
            }
        });

        // Calculate average time
        document.getElementById('calculateAvgBtn').addEventListener('click', function() {
            let sum = 0;
            let count = 0;
            
            for (let i = 1; i <= 10; i++) {
                const timeInput = document.getElementById(`time${i}`);
                if (timeInput.value) {
                    sum += parseFloat(timeInput.value);
                    count++;
                }
            }
            
            if (count > 0) {
                const average = sum / count;
                document.getElementById('averageTime').value = average.toFixed(3);
            } else {
                alert('Please enter at least one time measurement.');
            }
        });

        // Calculate height based on time
        document.getElementById('calculateHeightBtn').addEventListener('click', function() {
            const averageTime = parseFloat(document.getElementById('averageTime').value);
            
            if (isNaN(averageTime)) {
                alert('Please calculate the average time first.');
                return;
            }
            
            const units = document.getElementById('units').value;
            const g = units === 'metric' ? 9.8 : 32; // m/s² or ft/s²
            
            // d = 1/2 * g * t²
            const height = 0.5 * g * Math.pow(averageTime, 2);
            document.getElementById('calculatedHeight').value = height.toFixed(3);
        });

        // Calculate percent difference
        document.getElementById('calculateDiffBtn').addEventListener('click', function() {
            const calculatedHeight = parseFloat(document.getElementById('calculatedHeight').value);
            const measuredHeight = parseFloat(document.getElementById('measuredHeight').value);
            
            if (isNaN(calculatedHeight) || isNaN(measuredHeight)) {
                alert('Please calculate the height and enter the measured height first.');
                return;
            }
            
            // Percent difference = |measured - calculated| / measured * 100
            const difference = Math.abs(measuredHeight - calculatedHeight);
            const percentDiff = (difference / measuredHeight) * 100;
            document.getElementById('percentDifference').value = percentDiff.toFixed(2);
        });

        // Handle form submission
        const submitBtn = document.getElementById('submitBtn');
        const submissionMessage = document.getElementById('submissionMessage');

        submitBtn.addEventListener('click', function() {
            // Validate required fields
            const studentName = studentNameInput.value.trim();
            const studentEmail = studentEmailInput.value.trim();
            const teacherEmail = teacherEmailInput.value.trim();
            const conclusion = document.getElementById('conclusion').value.trim();

            if (!studentName || !studentEmail || !teacherEmail) {
                showMessage('Please fill in all required student and teacher information.', 'error');
                return;
            }

            if (!conclusion) {
                showMessage('Please complete your conclusion before submitting.', 'error');
                return;
            }

            // Collect data from the experiment
            const times = [];
            for (let i = 1; i <= 10; i++) {
                const timeInput = document.getElementById(`time${i}`);
                times.push(timeInput.value || 'N/A');
            }

            const averageTime = document.getElementById('averageTime').value;
            const units = document.getElementById('units').value;
            const calculatedHeight = document.getElementById('calculatedHeight').value;
            const measuredHeight = document.getElementById('measuredHeight').value;
            const percentDifference = document.getElementById('percentDifference').value;

            // Collect answers to analysis questions
            const question1 = document.getElementById('question1').value.trim();
            const question2 = document.getElementById('question2').value.trim();
            const question3 = document.getElementById('question3').value.trim();
            const question4 = document.getElementById('question4').value.trim();
            const question5 = document.getElementById('question5').value.trim();

            // Prepare comprehensive experiment data for email
            const experimentData = `
EXPERIMENT: Measuring Height with a Stopwatch

STUDENT: ${studentName}
EMAIL: ${studentEmail}

MEASUREMENTS:
Times Recorded: ${times.join(', ')} seconds
Average Time: ${averageTime || 'Not calculated'} seconds
Units Used: ${units === 'metric' ? 'Metric (meters)' : 'Imperial (feet)'}
Calculated Height: ${calculatedHeight || 'Not calculated'}
Measured Height: ${measuredHeight || 'Not provided'}
Percent Difference: ${percentDifference || 'Not calculated'}%

ANALYSIS QUESTIONS:
1. ${question1 || 'Not answered'}
2. ${question2 || 'Not answered'}
3. ${question3 || 'Not answered'}
4. ${question4 || 'Not answered'}
5. ${question5 || 'Not answered'}

CONCLUSION:
${conclusion}
            `.trim();

            // Use proven EmailJS parameter structure from experiment3_2
            const templateParams = {
                student_name: studentName,
                student_email: studentEmail,
                experiment_title: 'Experiment 7.1.1: Measuring Height with a Stopwatch',
                hypothesis: `Using gravity and time measurements to calculate room height`,
                missing_elements: `Times: ${times.join(', ')}s | Avg: ${averageTime || 'N/A'}s | Height: ${calculatedHeight || 'N/A'} | Difference: ${percentDifference || 'N/A'}%`,
                conclusion: experimentData,
                subject: `Physical Science Experiment 7.1.1 Results - ${studentName}`
            };

            // Disable button and show loading state
            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting...';

            // Send email using EmailJS
            emailjs.send('service_ot1jg6s', 'template_y556rhr', templateParams)
                .then(function(response) {
                    console.log('SUCCESS!', response.status, response.text);
                    showMessage('Your experiment results have been submitted successfully!', 'success');
                    submitBtn.textContent = 'Submitted';
                })
                .catch(function(error) {
                    console.log('FAILED...', error);
                    showMessage('Failed to submit results. Please try again later.', 'error');
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Submit Results';
                });
        });

        function showMessage(message, type) {
            submissionMessage.textContent = message;
            submissionMessage.classList.remove('hidden', 'text-green-600', 'text-red-600');
            submissionMessage.classList.add(type === 'success' ? 'text-green-600' : 'text-red-600');
        }
    });
</script>
