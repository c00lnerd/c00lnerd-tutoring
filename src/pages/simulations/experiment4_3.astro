---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Experiment 4.3: Forces Between Molecules">
    <main class="container mx-auto px-4 py-8">
        <div class="experiment-header">
            <h1 class="text-3xl font-bold text-center text-blue-700 mb-2">EXPERIMENT 4.3</h1>
            <h2 class="text-2xl font-bold text-center text-blue-700 mb-8">FORCES BETWEEN MOLECULES</h2>
        </div>

        <!-- Email Collection Section -->
        <section class="mb-8">
            <div class="bg-blue-50 p-4 rounded-lg mb-4">
                <h4 class="font-bold mb-2">Student Information:</h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="studentName" class="block text-gray-700 font-bold mb-2">Name:</label>
                        <input type="text" id="studentName" class="w-full px-3 py-2 border rounded-lg" placeholder="Your Name">
                    </div>
                    <div>
                        <label for="studentEmail" class="block text-gray-700 font-bold mb-2">Email:</label>
                        <input type="email" id="studentEmail" class="w-full px-3 py-2 border rounded-lg" placeholder="Your Email">
                    </div>
                </div>
            </div>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">PURPOSE:</h3>
            <p class="mb-4">To investigate cohesion and adhesion in water molecules.</p>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">MATERIALS:</h3>
            <ul class="list-disc pl-8 mb-4">
                <li>Water</li>
                <li>Bowl</li>
                <li>4 beakers or clear glasses</li>
                <li>Paper towels</li>
                <li>Wax paper</li>
                <li>Pipette or eyedropper</li>
                <li>Straw</li>
                <li>2 microscope slides</li>
                <li>Metal paper clip (Use a standard-sized paper clip. A big one will probably not work.)</li>
                <li>Toilet paper</li>
                <li>Dish soap</li>
                <li>Vegetable oil</li>
                <li>Toothpicks</li>
                <li>Scissors</li>
                <li>Blue and red food coloring</li>
                <li>Spoon</li>
                <li>Eye protection such as goggles or safety glasses</li>
            </ul>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">QUESTIONS:</h3>
            <p class="mb-4">Do drops of water look different than drops of oil or soapy water? Can drops of water be separated? Can water move against gravity? Can objects denser than water float? Can water act as glue?</p>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">HYPOTHESES:</h3>
            <p class="mb-4">Write your predictions by answering the questions listed above.</p>
            
            <div class="bg-gray-100 p-4 rounded-lg mb-4">
                <h4 class="font-bold mb-2">My Hypotheses:</h4>
                <textarea id="hypothesesInput" class="w-full p-2 border rounded" rows="6" placeholder="Enter your hypotheses here..."></textarea>
            </div>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">PROCEDURE—PART 1, MOVING WATER:</h3>
            <ol class="list-decimal pl-8 mb-4">
                <li class="mb-2">Fill one beaker ¾ full of hot tap water. Add a few drops of red food coloring and stir.</li>
                <li class="mb-2">Fill one beaker ¾ full of cold tap water. Add a few drops of blue food coloring and stir.</li>
                <li class="mb-2">Place each beaker filled with water next to an empty beaker so they are side by side.</li>
                <li class="mb-2">Roll two paper towel sheets into tight tubes.</li>
                <li class="mb-2">
                    Place one end of one paper towel tube in the beaker of hot water and the other end 
                    of the tube in the neighboring empty beaker. Make sure the paper towel roll extends 
                    at least half-way down in the water. You will need to bend the tube to a U-shape to 
                    have it go into the empty beaker. Repeat with the other two beakers. Draw your 
                    experimental set-up in the data table and describe what you observe.
                </li>
                <li class="mb-2">
                    Leave this set-up alone and complete the other parts of the experiment before 
                    coming back to observe again.
                </li>
                <li class="mb-2">
                    After completing the other parts of the experiment record your observations on how 
                    the water moved in each set of beakers. Was there a difference between the hot 
                    and cold beakers?
                </li>
            </ol>
        </section>

        <!-- Capillary Action Video Demonstration -->
        <section class="mb-8">
            <h4 class="text-lg font-bold text-blue-700 mb-4">📹 Capillary Action Video Demonstration</h4>
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
                <p class="text-blue-800 mb-4">
                    Watch this demonstration that shows capillary action in action using paper towels! 
                    This video perfectly illustrates the concepts you're exploring in Part 1 of the experiment.
                </p>
                <div class="flex justify-center">
                    <iframe width="325" height="578" src="https://www.youtube.com/embed/nP6LMjdSI1U" title="This Paper Towel Experiment Explains Capillary Action" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen class="rounded-lg shadow-lg"></iframe>
                </div>
                <div class="mt-4 bg-white p-4 rounded-lg">
                    <h5 class="font-semibold text-blue-800 mb-2">🔍 What to Look For:</h5>
                    <ul class="text-blue-700 text-sm space-y-1">
                        <li>• How water climbs up the paper towel against gravity</li>
                        <li>• The role of adhesion (water sticking to paper fibers)</li>
                        <li>• The role of cohesion (water molecules sticking to each other)</li>
                        <li>• How this relates to your beaker-to-beaker water transfer experiment</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Part 1 Data Table -->
        <section class="mb-8">
            <h4 class="font-bold mb-2">Part 1 Data:</h4>
            <div class="bg-gray-100 p-4 rounded-lg">
                <p class="mb-2">Draw your experimental setup:</p>
                <textarea id="part1Setup" class="w-full p-2 border rounded mb-4" rows="4" placeholder="Describe your experimental setup..."></textarea>
                
                <p class="mb-2">Initial observations:</p>
                <textarea id="part1Initial" class="w-full p-2 border rounded mb-4" rows="4" placeholder="Describe what you observe initially..."></textarea>
                
                <p class="mb-2">Final observations (after completing other parts):</p>
                <textarea id="part1Final" class="w-full p-2 border rounded mb-4" rows="4" placeholder="Describe what you observe after completing the other parts..."></textarea>
                
                <p class="mb-2">Was there a difference between hot and cold water? Explain:</p>
                <textarea id="part1Difference" class="w-full p-2 border rounded" rows="4" placeholder="Explain any differences observed..."></textarea>
            </div>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">PROCEDURE—PART 2, WATER DROPS ON WAX PAPER:</h3>
            <ol class="list-decimal pl-8 mb-4" start="8">
                <li class="mb-2">Place a sheet of wax paper on a flat surface.</li>
                <li class="mb-2">
                    Using the eyedropper, place several drops of water on the wax paper. Observe the 
                    shape of the drops. Draw and describe them in your data table.
                </li>
                <li class="mb-2">
                    Touch one of the drops with a dry toothpick. Describe what happens in your data 
                    table.
                </li>
                <li class="mb-2">
                    Dip a toothpick in water and then touch a drop with the wet toothpick. Push the 
                    toothpick through the drop. Describe what happens in your data table.
                </li>
                <li class="mb-2">
                    Try to cut a drop in half with a dry toothpick. Describe what happens in your data 
                    table.
                </li>
                <li class="mb-2">
                    Place two drops of water close to each other on the wax paper. Using a straw, gently 
                    blow between the drops to push them together. Describe what happens in your data 
                    table.
                </li>
                <li class="mb-2">
                    Dip a toothpick in dish soap. Touch one of the water drops with the soapy toothpick. 
                    Describe what happens in your data table.
                </li>
            </ol>
        </section>

        <!-- Water Droplet Video Demonstration -->
        <section class="mb-8">
            <h4 class="text-lg font-bold text-blue-700 mb-4">📹 Water Drops on Wax Paper Video</h4>
            <div class="bg-green-50 border border-green-200 rounded-lg p-6">
                <p class="text-green-800 mb-4">
                    Watch this demonstration showing how water behaves on waxed paper! This video shows 
                    the exact phenomena you'll observe in Part 2 of your experiment.
                </p>
                <div class="flex justify-center">
                    <iframe width="853" height="480" src="https://www.youtube.com/embed/LrJfueQLrSk" title="Drops of water on waxed paper" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen class="rounded-lg shadow-lg max-w-full h-auto"></iframe>
                </div>
                <div class="mt-4 bg-white p-4 rounded-lg">
                    <h5 class="font-semibold text-green-800 mb-2">🔍 Key Observations to Notice:</h5>
                    <ul class="text-green-700 text-sm space-y-1">
                        <li>• How water forms rounded droplets on the wax paper surface</li>
                        <li>• The effect of surface tension creating the droplet shape</li>
                        <li>• How droplets behave when touched with dry vs. wet objects</li>
                        <li>• What happens when droplets are pushed together</li>
                        <li>• The dramatic effect of soap on water's surface tension</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Part 2 Data Table -->
        <section class="mb-8">
            <h4 class="font-bold mb-2">Part 2 Data:</h4>
            <div class="bg-gray-100 p-4 rounded-lg">
                <p class="mb-2">Description of water drops on wax paper:</p>
                <textarea id="part2Drops" class="w-full p-2 border rounded mb-4" rows="3" placeholder="Describe the shape of the water drops..."></textarea>
                
                <p class="mb-2">What happened when you touched a drop with a dry toothpick?</p>
                <textarea id="part2DryToothpick" class="w-full p-2 border rounded mb-4" rows="3" placeholder="Describe your observations..."></textarea>
                
                <p class="mb-2">What happened when you touched a drop with a wet toothpick?</p>
                <textarea id="part2WetToothpick" class="w-full p-2 border rounded mb-4" rows="3" placeholder="Describe your observations..."></textarea>
                
                <p class="mb-2">What happened when you tried to cut a drop in half?</p>
                <textarea id="part2CutDrop" class="w-full p-2 border rounded mb-4" rows="3" placeholder="Describe your observations..."></textarea>
                
                <p class="mb-2">What happened when you pushed two drops together?</p>
                <textarea id="part2PushDrops" class="w-full p-2 border rounded mb-4" rows="3" placeholder="Describe your observations..."></textarea>
                
                <p class="mb-2">What happened when you touched a drop with a soapy toothpick?</p>
                <textarea id="part2SoapyToothpick" class="w-full p-2 border rounded" rows="3" placeholder="Describe your observations..."></textarea>
            </div>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">PROCEDURE—PART 3, FLOATING PAPER CLIP:</h3>
            <ol class="list-decimal pl-8 mb-4" start="15">
                <li class="mb-2">
                    Fill a bowl about half full with water. Let the water settle for a minute.
                </li>
                <li class="mb-2">
                    Tear off a small piece of toilet paper (about 1 inch square).
                </li>
                <li class="mb-2">
                    Gently place the toilet paper on the surface of the water.
                </li>
                <li class="mb-2">
                    Carefully place a paper clip flat on top of the toilet paper.
                </li>
                <li class="mb-2">
                    Use a toothpick to carefully push the toilet paper under the water, leaving the paper 
                    clip floating on the surface. This may take a few tries. If the paper clip sinks, try again 
                    with a new paper clip and toilet paper.
                </li>
                <li class="mb-2">
                    Once the paper clip is floating, observe it closely. Draw and describe what you see in 
                    your data table.
                </li>
                <li class="mb-2">
                    Dip a toothpick in dish soap. Touch the water surface near (but not touching) the 
                    paper clip. Describe what happens in your data table.
                </li>
                <li class="mb-2">
                    Try the experiment again, but this time add a drop of dish soap to the water before 
                    trying to float the paper clip. What happens? Describe your observations in your data 
                    table.
                </li>
                <li class="mb-2">
                    Empty the bowl and rinse it out.
                </li>
            </ol>
        </section>

        <!-- Floating Paper Clip Video Demonstration -->
        <section class="mb-8">
            <h4 class="text-lg font-bold text-blue-700 mb-4">📹 Floating Paper Clip Demonstration</h4>
            <div class="bg-purple-50 border border-purple-200 rounded-lg p-6">
                <p class="text-purple-800 mb-4">
                    Watch this amazing demonstration of surface tension in action! This video shows exactly 
                    how to make a paper clip float on water and explains the science behind it.
                </p>
                <div class="flex justify-center">
                    <iframe width="325" height="578" src="https://www.youtube.com/embed/MAT1mC2miY8" title="This Is How To Make A Paper Clip Float On Water 💦 📎 😮" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen class="rounded-lg shadow-lg"></iframe>
                </div>
                <div class="mt-4 bg-white p-4 rounded-lg">
                    <h5 class="font-semibold text-purple-800 mb-2">🔬 Science Concepts to Observe:</h5>
                    <ul class="text-purple-700 text-sm space-y-1">
                        <li>• Surface tension creating an invisible "skin" on water</li>
                        <li>• How careful placement prevents breaking the surface tension</li>
                        <li>• The paper clip appears to rest on top of the water surface</li>
                        <li>• What happens when soap disrupts the molecular forces</li>
                        <li>• Why objects denser than water can still "float"</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Part 3 Data Table -->
        <section class="mb-8">
            <h4 class="font-bold mb-2">Part 3 Data:</h4>
            <div class="bg-gray-100 p-4 rounded-lg">
                <p class="mb-2">Description of floating paper clip:</p>
                <textarea id="part3FloatingClip" class="w-full p-2 border rounded mb-4" rows="4" placeholder="Describe what you observed with the floating paper clip..."></textarea>
                
                <p class="mb-2">What happened when you touched the water with a soapy toothpick?</p>
                <textarea id="part3SoapyToothpick" class="w-full p-2 border rounded mb-4" rows="4" placeholder="Describe your observations..."></textarea>
                
                <p class="mb-2">What happened when you tried to float a paper clip in soapy water?</p>
                <textarea id="part3SoapyWater" class="w-full p-2 border rounded" rows="4" placeholder="Describe your observations..."></textarea>
            </div>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">PROCEDURE—PART 4, WATER GLUE?:</h3>
            <ol class="list-decimal pl-8 mb-4" start="24">
                <li class="mb-2">
                    In a clean beaker or glass, measure out ¼ cup of water. Mix a few drops of dish soap 
                    into the water and stir.
                </li>
                <li class="mb-2">
                    With the eyedropper, on a clean section of the wax paper, place one drop of water 
                    and one drop of soapy water.
                </li>
                <li class="mb-2">
                    Rinse out the eyedropper with tap water. Place one drop of oil next to the drops of 
                    water and soapy water. Draw the drops and describe them in your data table.
                </li>
                <li class="mb-2">
                    Place a glass microscope slide on a clean section of the sheet of wax paper.
                </li>
                <li class="mb-2">
                    Using the eyedropper, place one drop of water on the glass slide. Describe what you 
                    see and compare it to the drops on the wax paper.
                </li>
                <li class="mb-2">
                    Place a few more drops of water on the glass slide. Then place the second glass 
                    slide on top of the first glass slide. Now try to pull (not slide) the glass slides apart. 
                    Describe—was it easy or difficult?
                </li>
                <li class="mb-2">Clean off the glass slides under warm water and dry with a paper towel.</li>
                <li class="mb-2">Repeat steps 29 and 30 using drops of soapy water. Record your results.</li>
                <li class="mb-2">Repeat steps 29 and 30 using drops of oil. Record your results.</li>
                <li class="mb-2">Go back to Part 1 and make final observations recording them.</li>
                <li class="mb-2">Clean up and return all material to their proper place.</li>
            </ol>
        </section>

        <!-- Part 4 Data Table -->
        <section class="mb-8">
            <h4 class="font-bold mb-2">Part 4 Data:</h4>
            <div class="bg-gray-100 p-4 rounded-lg">
                <p class="mb-2">Description of water, soapy water, and oil drops on wax paper:</p>
                <textarea id="part4Drops" class="w-full p-2 border rounded mb-4" rows="4" placeholder="Describe and compare the three types of drops..."></textarea>
                
                <p class="mb-2">Description of water drop on glass slide compared to wax paper:</p>
                <textarea id="part4WaterOnGlass" class="w-full p-2 border rounded mb-4" rows="4" placeholder="Describe your observations..."></textarea>
                
                <p class="mb-2">Was it easy or difficult to pull apart glass slides with water between them?</p>
                <textarea id="part4WaterSlides" class="w-full p-2 border rounded mb-4" rows="3" placeholder="Describe your observations..."></textarea>
                
                <p class="mb-2">Was it easy or difficult to pull apart glass slides with soapy water between them?</p>
                <textarea id="part4SoapySlides" class="w-full p-2 border rounded mb-4" rows="3" placeholder="Describe your observations..."></textarea>
                
                <p class="mb-2">Was it easy or difficult to pull apart glass slides with oil between them?</p>
                <textarea id="part4OilSlides" class="w-full p-2 border rounded" rows="3" placeholder="Describe your observations..."></textarea>
            </div>
        </section>

        <!-- Interactive Simulation Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">INTERACTIVE SIMULATION:</h3>
            <p class="mb-4">Explore the concepts of cohesion, adhesion, and surface tension with these interactive demonstrations.</p>
            
            <div class="bg-blue-50 p-6 rounded-lg">
                <div class="flex flex-wrap mb-4">
                    <button id="demo1Btn" class="bg-blue-600 text-white px-4 py-2 rounded mr-2 mb-2">Capillary Action Demo</button>
                    <button id="demo2Btn" class="bg-blue-600 text-white px-4 py-2 rounded mr-2 mb-2">Water Droplet Demo</button>
                    <button id="demo3Btn" class="bg-blue-600 text-white px-4 py-2 rounded mr-2 mb-2">Floating Paper Clip Demo</button>
                    <button id="resetBtn" class="bg-gray-600 text-white px-4 py-2 rounded mb-2">Reset</button>
                </div>
                
                <div id="simulationContainer" class="relative bg-white border-2 border-blue-200 rounded-lg p-4 mb-4" style="height: 300px;">
                    <!-- Simulation content will be dynamically inserted here -->
                    <div id="demo1" class="hidden">
                        <div class="flex flex-col items-center justify-center h-full">
                            <div class="mb-4 text-center">
                                <h4 class="font-bold mb-2">Capillary Action Demonstration</h4>
                            </div>
                            <div class="relative" style="width: 300px; height: 200px;">
                                <!-- Two beakers -->
                                <div class="absolute bottom-0 left-0 w-20 h-24 border-2 border-gray-400 rounded-b-lg bg-red-200" style="opacity: 0.7;">
                                    <div class="absolute bottom-0 left-0 right-0 h-16 bg-red-300 rounded-b-lg"></div>
                                    <div class="text-xs text-center mt-1">Hot Water</div>
                                </div>
                                <div class="absolute bottom-0 left-24 w-20 h-24 border-2 border-gray-400 rounded-b-lg bg-gray-100">
                                    <div class="text-xs text-center mt-1">Empty</div>
                                </div>
                                
                                <!-- Paper towel bridge -->
                                <div class="absolute bottom-16 left-4 w-32 h-2 bg-white border border-gray-300 rounded" style="transform: rotate(-10deg);"></div>
                                
                                <!-- Arrow showing water movement -->
                                <div class="absolute bottom-12 left-16 text-blue-600 text-2xl" id="waterFlow">→</div>
                                
                                <!-- Second set -->
                                <div class="absolute bottom-0 right-44 w-20 h-24 border-2 border-gray-400 rounded-b-lg bg-blue-200" style="opacity: 0.7;">
                                    <div class="absolute bottom-0 left-0 right-0 h-16 bg-blue-300 rounded-b-lg"></div>
                                    <div class="text-xs text-center mt-1">Cold Water</div>
                                </div>
                                <div class="absolute bottom-0 right-20 w-20 h-24 border-2 border-gray-400 rounded-b-lg bg-gray-100">
                                    <div class="text-xs text-center mt-1">Empty</div>
                                </div>
                                
                                <!-- Paper towel bridge -->
                                <div class="absolute bottom-16 right-36 w-32 h-2 bg-white border border-gray-300 rounded" style="transform: rotate(-10deg);"></div>
                                
                                <!-- Arrow showing water movement -->
                                <div class="absolute bottom-12 right-28 text-blue-600 text-2xl" id="waterFlow2">→</div>
                            </div>
                        </div>
                    </div>
                    
                    <div id="demo2" class="hidden">
                        <div class="flex items-center justify-center h-full">
                            <div class="relative" style="width: 300px; height: 250px;">
                                <!-- Wax paper surface -->
                                <div class="absolute bottom-0 left-0 right-0 h-4 bg-gray-100 border border-gray-300"></div>
                                
                                <!-- Water droplet -->
                                <div class="absolute bottom-4 left-20 w-16 h-8 bg-blue-300 rounded-full" style="opacity: 0.7;"></div>
                                
                                <!-- Glass surface -->
                                <div class="absolute bottom-40 left-0 right-0 h-4 bg-blue-100 border border-gray-300"></div>
                                
                                <!-- Water droplet on glass -->
                                <div class="absolute bottom-44 left-20 w-20 h-6 bg-blue-300 rounded-full" style="opacity: 0.7; transform: scaleY(0.5);"></div>
                            </div>
                        </div>
                    </div>
                    
                    <div id="demo3" class="hidden">
                        <div class="flex items-center justify-center h-full">
                            <div class="relative" style="width: 300px; height: 250px;">
                                <!-- Bowl with water -->
                                <div class="absolute bottom-0 left-0 right-0 h-32 border-2 border-gray-400 rounded-b-full"></div>
                                <div class="absolute bottom-0 left-0 right-0 h-24 bg-blue-200 rounded-b-full" style="opacity: 0.7;"></div>
                                
                                <!-- Paper clip -->
                                <div class="absolute bottom-24 left-1/2 transform -translate-x-1/2 w-16 h-2 bg-gray-600 rounded" id="paperClip"></div>
                                
                                <!-- Add soap button -->
                                <button id="addSoapBtn" class="absolute top-4 right-4 bg-yellow-400 text-black px-3 py-1 rounded text-sm">Add Soap</button>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div id="explanationContainer" class="bg-white border-2 border-blue-200 rounded-lg p-4">
                    <h4 class="font-bold mb-2">Explanation:</h4>
                    <p id="explanationText">Select a demo above to see it in action.</p>
                </div>
            </div>
        </section>

        <!-- Email Submission Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">SUBMIT YOUR RESULTS:</h3>
            <div class="bg-blue-50 p-4 rounded-lg">
                <div class="mb-4">
                    <label for="teacherEmail" class="block text-gray-700 font-bold mb-2">Teacher's Email:</label>
                    <input type="email" id="teacherEmail" class="w-full px-3 py-2 border rounded-lg" placeholder="Teacher's Email">
                </div>
                
                <button id="submitBtn" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                    Submit Experiment Results
                </button>
                
                <p id="submissionMessage" class="mt-2 hidden"></p>
            </div>
        </section>

        <!-- Conclusion Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">CONCLUSION:</h3>
            <p class="mb-4">Based on your observations, explain the following:</p>
            <ol class="list-decimal pl-8 mb-4">
                <li class="mb-2">How do water molecules interact with each other (cohesion)?</li>
                <li class="mb-2">How do water molecules interact with other surfaces (adhesion)?</li>
                <li class="mb-2">What is surface tension and how did you observe it in this experiment?</li>
                <li class="mb-2">How does soap affect the properties of water?</li>
                <li class="mb-2">How do the properties of water compare to oil?</li>
                <li class="mb-2">Why was water able to move up the paper towel against gravity in Part 1?</li>
            </ol>
            
            <div class="bg-gray-100 p-4 rounded-lg mb-4">
                <h4 class="font-bold mb-2">My Conclusion:</h4>
                <textarea id="conclusionInput" class="w-full p-2 border rounded" rows="10" placeholder="Write your conclusion here, addressing all the questions above..."></textarea>
            </div>
        </section>
    </main>
</Layout>

<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
<script>
    // Wait for DOM to be fully loaded (matching module 3 experiments)
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize EmailJS (same as working module 3)
        emailjs.init('ct_s19oZHppLy9BlW');
        
        // DOM Elements
        // Store student information in local storage
        const studentNameInput = document.getElementById('studentName');
        const studentEmailInput = document.getElementById('studentEmail');
        const teacherEmailInput = document.getElementById('teacherEmail');
        
        // Load saved data from localStorage
        if (localStorage.getItem('studentName')) {
            studentNameInput.value = localStorage.getItem('studentName');
        }
        
        if (localStorage.getItem('studentEmail')) {
            studentEmailInput.value = localStorage.getItem('studentEmail');
        }
        
        if (localStorage.getItem('teacherEmail')) {
            teacherEmailInput.value = localStorage.getItem('teacherEmail');
        }
        
        // Save data to localStorage when inputs change
        studentNameInput.addEventListener('change', function() {
            localStorage.setItem('studentName', this.value);
        });
        
        studentEmailInput.addEventListener('change', function() {
            localStorage.setItem('studentEmail', this.value);
        });
        
        teacherEmailInput.addEventListener('change', function() {
            localStorage.setItem('teacherEmail', this.value);
        });
        
        // Interactive Simulation
        const demo1Btn = document.getElementById('demo1Btn');
        const demo2Btn = document.getElementById('demo2Btn');
        const demo3Btn = document.getElementById('demo3Btn');
        const resetBtn = document.getElementById('resetBtn');
        const demo1 = document.getElementById('demo1');
        const demo2 = document.getElementById('demo2');
        const demo3 = document.getElementById('demo3');
        const explanationText = document.getElementById('explanationText');
        const addSoapBtn = document.getElementById('addSoapBtn');
        const paperClip = document.getElementById('paperClip');
        
        // Hide all demos initially
        demo1.classList.add('hidden');
        demo2.classList.add('hidden');
        demo3.classList.add('hidden');
        
        // Function to hide all demos
        function hideAllDemos() {
            demo1.classList.add('hidden');
            demo2.classList.add('hidden');
            demo3.classList.add('hidden');
        }
        
        // Demo 1: Capillary Action Demonstration
        demo1Btn.addEventListener('click', function() {
            hideAllDemos();
            demo1.classList.remove('hidden');
            
            explanationText.innerHTML = 
                "This demonstration shows <strong>capillary action</strong>, which occurs due to adhesion and cohesion. " +
                "Water molecules are attracted to the paper towel fibers (adhesion) and to each other (cohesion). " +
                "This allows water to climb up the paper towel against gravity. The water will eventually transfer " +
                "from one container to another until the levels equalize. Hot water moves faster than cold water due to increased molecular motion.";
        });
        
        // Demo 2: Water Droplet
        demo2Btn.addEventListener('click', function() {
            hideAllDemos();
            demo2.classList.remove('hidden');
            explanationText.innerHTML = 
                "This shows how water behaves differently on different surfaces. " +
                "On the wax paper (bottom), water forms rounded droplets due to strong cohesion and weak adhesion to the " +
                "hydrophobic surface. On glass (top), water spreads out more because of stronger adhesion to the " +
                "hydrophilic glass surface. Surface tension, caused by cohesion, gives water drops their curved shape.";
        });
        
        // Demo 3: Floating Paper Clip
        demo3Btn.addEventListener('click', function() {
            hideAllDemos();
            demo3.classList.remove('hidden');
            paperClip.style.bottom = "24px";
            explanationText.innerHTML = 
                "This demonstrates <strong>surface tension</strong>. Although the paper clip is denser than water, " +
                "it can float because the surface tension of water creates a kind of 'skin' on the surface. " +
                "The water molecules at the surface are strongly attracted to each other (cohesion), creating " +
                "enough force to support the weight of the paper clip. Click 'Add Soap' to see what happens when " +
                "soap disrupts the surface tension.";
        });
        
        // Add Soap Button
        addSoapBtn.addEventListener('click', function() {
            paperClip.style.bottom = "22px";
            explanationText.innerHTML = 
                "When soap is added to the water, it disrupts the surface tension. Soap molecules have a hydrophilic " +
                "head and a hydrophobic tail, which breaks up the cohesive forces between water molecules at the surface. " +
                "With reduced surface tension, the paper clip can no longer be supported and sinks.";
        });
        
        // Reset Button
        resetBtn.addEventListener('click', function() {
            hideAllDemos();
            explanationText.innerHTML = "Select a demo above to see it in action.";
        });
        
        // Email Submission
        const submitBtn = document.getElementById('submitBtn');
        const submissionMessage = document.getElementById('submissionMessage');
        
        submitBtn.addEventListener('click', function() {
            // Validate required fields
            const studentName = studentNameInput.value.trim();
            const studentEmail = studentEmailInput.value.trim();
            const teacherEmail = teacherEmailInput.value.trim();
            
            if (!studentName || !studentEmail || !teacherEmail) {
                showMessage("Please fill in all required fields (student name, student email, and teacher email).", "error");
                return;
            }
            
            // Disable button and show loading state
            submitBtn.disabled = true;
            submitBtn.textContent = "Submitting...";
            
            // Collect all data from textareas
            const experimentData = {
                // Student info
                studentName: studentName,
                studentEmail: studentEmail,
                
                // Hypotheses
                hypotheses: document.getElementById('hypothesesInput').value,
                
                // Part 1 data
                part1Setup: document.getElementById('part1Setup').value,
                part1Initial: document.getElementById('part1Initial').value,
                part1Final: document.getElementById('part1Final').value,
                part1Difference: document.getElementById('part1Difference').value,
                
                // Part 2 data
                part2Drops: document.getElementById('part2Drops').value,
                part2DryToothpick: document.getElementById('part2DryToothpick').value,
                part2WetToothpick: document.getElementById('part2WetToothpick').value,
                part2CutDrop: document.getElementById('part2CutDrop').value,
                part2PushDrops: document.getElementById('part2PushDrops').value,
                part2SoapyToothpick: document.getElementById('part2SoapyToothpick').value,
                
                // Part 3 data
                part3FloatingClip: document.getElementById('part3FloatingClip').value,
                part3SoapyToothpick: document.getElementById('part3SoapyToothpick').value,
                part3SoapyWater: document.getElementById('part3SoapyWater').value,
                
                // Part 4 data
                part4Drops: document.getElementById('part4Drops').value,
                part4WaterOnGlass: document.getElementById('part4WaterOnGlass').value,
                part4WaterSlides: document.getElementById('part4WaterSlides').value,
                part4SoapySlides: document.getElementById('part4SoapySlides').value,
                part4OilSlides: document.getElementById('part4OilSlides').value,
                
                // Conclusion
                conclusion: document.getElementById('conclusionInput').value
            };
            
            // Format message for email
            const formattedMessage = `EXPERIMENT 4.3: MOLECULAR MODELS - STUDENT RESULTS

Student Information:
• Name: ${studentName}
• Email: ${studentEmail}

Experiment Results:

Hypothesis:
${experimentData.hypothesis}

Molecular Model Observations:
${experimentData.observations}

Analysis Questions:
• Question 1: ${experimentData.analysis1}
• Question 2: ${experimentData.analysis2}
• Question 3: ${experimentData.analysis3}
• Question 4: ${experimentData.analysis4}
• Question 5: ${experimentData.analysis5}

Conclusion:
${experimentData.conclusion}

---
This is an automated submission from the C00lnerd Experiment System.`;
            
            // Check if EmailJS is available
            if (typeof emailjs !== 'undefined') {
                // Send email using EmailJS with proven parameter mapping
                emailjs.send("service_ot1jg6s", "template_y556rhr", {
                    student_name: studentName || studentEmail?.split('@')[0] || 'Student',
                    student_email: studentEmail,
                    experiment_title: 'Experiment 4.3: Forces Between Molecules',
                    hypothesis: 'Exploring intermolecular forces and their effects on molecular behavior',
                    missing_elements: `Student Info: ${studentName ? '✓' : '✗'}, Email: ${studentEmail ? '✓' : '✗'}, Results: ${formattedMessage ? '✓' : '✗'}`,
                    conclusion: formattedMessage,
                    subject: `Physical Science Experiment 4.3 Results - ${studentName || studentEmail?.split('@')[0] || 'Student'}`
                })
                .then(function(response) {
                    console.log("Email sent successfully:", response);
                    showMessage("Your experiment results have been submitted successfully!", "success");
                    submitBtn.textContent = "Submitted";
                })
                .catch(function(error) {
                    console.error("Email sending failed:", error);
                    showMessage("Failed to submit results. Please try again later.", "error");
                    submitBtn.disabled = false;
                    submitBtn.textContent = "Submit Experiment Results";
                });
            } else {
                showMessage("Email service is not available. Please try again later.", "error");
                submitBtn.disabled = false;
                submitBtn.textContent = "Submit Experiment Results";
            }
        });
        
        function showMessage(message, type) {
            submissionMessage.textContent = message;
            submissionMessage.classList.remove('hidden', 'text-green-600', 'text-red-600');
            submissionMessage.classList.add(type === 'success' ? 'text-green-600' : 'text-red-600');
        }
    });
</script>
