---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Experiment 11.2.1 - Van de Graaff Generator Experiments">
    <div class="container">
        <h1>Experiment 11.2.1: Van de Graaff Generator Experiments</h1>
        <p class="experiment-description">Explore electrical charges and static electricity using a Van de Graaff generator to demonstrate attraction, repulsion, and charge transfer.</p>

        <!-- Student Information Section -->
        <div class="student-info">
            <h2>Student Information</h2>
            <div class="info-grid">
                <div>
                    <label for="student-name">Name:</label>
                    <input type="text" id="student-name" placeholder="Enter your full name">
                </div>
                <div>
                    <label for="student-email">Email:</label>
                    <input type="email" id="student-email" placeholder="your.email@example.com" value="chuck@c00lnerd.com">
                </div>
                <div>
                    <label for="experiment-date">Date:</label>
                    <input type="date" id="experiment-date">
                </div>
            </div>
        </div>

        <!-- Purpose Section -->
        <div class="section">
            <h2>Purpose</h2>
            <p>To observe and understand electrical charges, static electricity, and the principles of charge transfer using a Van de Graaff generator.</p>
        </div>

        <!-- Materials Section -->
        <div class="section">
            <h2>Materials</h2>
            <ul class="materials-list">
                <li>Van de Graaff generator</li>
                <li>Small pieces of aluminum foil (2-3 cm squares)</li>
                <li>Pith balls or small Styrofoam balls</li>
                <li>Thread (about 30 cm)</li>
                <li>Metal pie pan</li>
                <li>Plastic ruler</li>
                <li>Small fluorescent light bulb</li>
                <li>Eye protection such as goggles or safety glasses</li>
                <li>Electroscope (from Experiment 11.2 or a commercial one)</li>
            </ul>
        </div>

        <!-- Safety Section -->
        <div class="safety-section">
            <h2>⚠️ Safety Instructions</h2>
            <ul>
                <li>Wear eye protection at all times during this experiment</li>
                <li>Never operate the Van de Graaff generator near water or in humid conditions</li>
                <li>Keep the generator away from electronic devices and computers</li>
                <li>People with pacemakers or other electronic medical devices should maintain a safe distance</li>
                <li>Never touch the dome of the generator while it is operating unless specifically instructed to do so</li>
                <li>Always turn off the generator when not in use</li>
                <li>Ensure proper supervision by a teacher or qualified adult</li>
            </ul>
        </div>

        <!-- Background Information -->
        <div class="section">
            <h2>Background Information</h2>
            <div class="background-info">
                <h3>What is a Van de Graaff Generator?</h3>
                <p>A Van de Graaff generator is a device that creates static electricity and can generate very high voltages. It was invented by American physicist Robert J. Van de Graaff in 1929. The generator uses a moving belt to accumulate electric charge on a hollow metal sphere (the dome), creating a very high electric potential difference between the dome and ground.</p>
                
                <h3>How It Works</h3>
                <p>The Van de Graaff generator consists of a belt running over two rollers, one at the bottom and one at the top inside a hollow metal dome. The bottom roller is typically made of a material that tends to give up electrons, while the top roller is made of a material that tends to accept electrons. As the belt moves, it carries positive charge up to the dome. The dome, being a conductor, allows the charge to spread over its outer surface, creating a high voltage.</p>
                
                <h3>Principles Demonstrated</h3>
                <ol>
                    <li><strong>Like charges repel, unlike charges attract</strong> - Objects with the same charge push away from each other, while objects with opposite charges pull toward each other.</li>
                    <li><strong>Charge distribution</strong> - Electric charge on a conductor moves to the outside surface and concentrates at points and edges.</li>
                    <li><strong>Corona discharge</strong> - When the electric field is strong enough, it can ionize the air, creating a visible glow or spark.</li>
                    <li><strong>Induction</strong> - A charged object can influence the distribution of charge in nearby objects without touching them.</li>
                </ol>
            </div>
        </div>

        <!-- Procedure Section -->
        <div class="section">
            <h2>Procedure</h2>
            <div class="procedure-steps">
                <div class="step">
                    <h3>Step 1: Setup</h3>
                    <p>Place the Van de Graaff generator on a dry, non-conductive surface. Ensure it is turned off before beginning setup.</p>
                </div>
                
                <div class="step">
                    <h3>Step 2: Prepare for Demonstrations</h3>
                    <p>Gather all materials and ensure everyone is wearing safety goggles. Make sure the area around the generator is clear of electronic devices and that the floor is dry.</p>
                </div>
                
                <div class="step">
                    <h3>Step 3: Aluminum Foil Pieces Demonstration</h3>
                    <p>Place the metal pie pan on top of the Van de Graaff generator dome. Turn on the generator and allow it to run for about 30 seconds. Place several small pieces of aluminum foil in the pan and observe what happens. Record your observations.</p>
                </div>
                
                <div class="step">
                    <h3>Step 4: Pith Ball Demonstration</h3>
                    <p>Turn off the generator. Tie a pith ball or Styrofoam ball to one end of the thread. Hold the other end of the thread and allow the ball to touch the dome of the generator. Turn on the generator briefly (5-10 seconds) and then turn it off. Observe what happens to the ball after it touches the dome. Record your observations.</p>
                </div>
                
                <div class="step">
                    <h3>Step 5: Hair-Raising Demonstration (Optional)</h3>
                    <p>If a volunteer is available and willing, have them stand on an insulating platform (like a plastic stool) and place their hand on the dome of the generator. Turn on the generator and observe what happens to their hair. Turn off the generator after 15-20 seconds or if the volunteer feels uncomfortable. Record observations.</p>
                    <p><strong>Note:</strong> This step should only be performed with proper supervision and willing volunteers who do not have any electronic medical devices.</p>
                </div>
                
                <div class="step">
                    <h3>Step 6: Electroscope Test</h3>
                    <p>Place the electroscope (either from Experiment 11.2 or a commercial one) near the Van de Graaff generator but not touching it. Turn on the generator and observe what happens to the foil strips or needle of the electroscope as you move it closer to and further from the generator. Record your observations.</p>
                </div>
                
                <div class="step">
                    <h3>Step 7: Fluorescent Bulb Demonstration</h3>
                    <p>Turn on the generator and allow it to run for about 30 seconds. Carefully hold the fluorescent bulb near (but not touching) the dome. Observe what happens and record your observations.</p>
                </div>
                
                <div class="step">
                    <h3>Step 8: Charging by Induction</h3>
                    <p>Turn on the generator. Hold the metal pie pan by its edges with an insulating material (like a plastic ruler) and bring it near the dome without touching it. After a few seconds, touch the pan briefly with your finger while still holding it near the dome. Then move the pan away from the dome. The pan is now charged by induction. Test this by bringing it near small pieces of paper or the pith ball. Record your observations.</p>
                </div>
                
                <div class="step">
                    <h3>Step 9: Clean Up</h3>
                    <p>Turn off the generator and ensure it is fully discharged by touching the dome with a grounded metal object. Clean up all materials and return them to their proper storage locations.</p>
                </div>
            </div>
        </div>

        <!-- Data Collection Section -->
        <div class="section">
            <h2>Data Collection</h2>
            <div class="observation-table">
                <h3>Record your observations for each demonstration:</h3>
                
                <div class="form-group">
                    <label for="foil-observation">Aluminum Foil Pieces Demonstration:</label>
                    <textarea id="foil-observation" rows="3" placeholder="Describe what happened to the aluminum foil pieces..."></textarea>
                </div>
                
                <div class="form-group">
                    <label for="pith-observation">Pith Ball Demonstration:</label>
                    <textarea id="pith-observation" rows="3" placeholder="Describe what happened to the pith ball..."></textarea>
                </div>
                
                <div class="form-group">
                    <label for="hair-observation">Hair-Raising Demonstration (if performed):</label>
                    <textarea id="hair-observation" rows="3" placeholder="Describe what happened to the volunteer's hair..."></textarea>
                </div>
                
                <div class="form-group">
                    <label for="electroscope-observation">Electroscope Test:</label>
                    <textarea id="electroscope-observation" rows="3" placeholder="Describe how the electroscope responded..."></textarea>
                </div>
                
                <div class="form-group">
                    <label for="bulb-observation">Fluorescent Bulb Demonstration:</label>
                    <textarea id="bulb-observation" rows="3" placeholder="Describe what happened with the fluorescent bulb..."></textarea>
                </div>
                
                <div class="form-group">
                    <label for="induction-observation">Charging by Induction:</label>
                    <textarea id="induction-observation" rows="3" placeholder="Describe what happened during the induction charging..."></textarea>
                </div>
            </div>
        </div>

        <!-- Analysis Questions Section -->
        <div class="section">
            <h2>Analysis Questions</h2>
            <div class="analysis-questions">
                <div class="question">
                    <label for="question1">1. Why did the aluminum foil pieces initially jump up and then fly away from the pie pan? Explain in terms of electrical charges.</label>
                    <textarea id="question1" rows="3" placeholder="Enter your answer here..."></textarea>
                </div>
                
                <div class="question">
                    <label for="question2">2. Compare the behavior of the pith ball when it touched the dome to what you observed with the balloon in Experiment 11.1. What similarities and differences did you notice?</label>
                    <textarea id="question2" rows="3" placeholder="Enter your answer here..."></textarea>
                </div>
                
                <div class="question">
                    <label for="question3">3. Why does the fluorescent bulb glow when held near the Van de Graaff generator? What is happening to the gas inside the bulb?</label>
                    <textarea id="question3" rows="3" placeholder="Enter your answer here..."></textarea>
                </div>
                
                <div class="question">
                    <label for="question4">4. Explain how the process of charging by induction works. Why did you need to touch the pie pan with your finger during this process?</label>
                    <textarea id="question4" rows="3" placeholder="Enter your answer here..."></textarea>
                </div>
                
                <div class="question">
                    <label for="question5">5. The Van de Graaff generator can create much stronger electric fields than a balloon rubbed on hair. How did this affect your observations compared to the previous experiments?</label>
                    <textarea id="question5" rows="3" placeholder="Enter your answer here..."></textarea>
                </div>
            </div>
        </div>

        <!-- Conclusion Section -->
        <div class="section">
            <h2>Conclusion</h2>
            <div class="form-group">
                <label for="conclusion">Based on your observations and the analysis questions, write a conclusion about what you learned regarding electrical charges, static electricity, and the principles demonstrated by the Van de Graaff generator:</label>
                <textarea id="conclusion" rows="5" placeholder="Enter your conclusion here..."></textarea>
            </div>
        </div>

        <!-- Extension Activities Section -->
        <div class="section">
            <h2>Extension Activities</h2>
            <div class="extension-activities">
                <h3>Try these additional activities if time permits:</h3>
                <ol>
                    <li>Create a "lightning rod" effect by attaching a pointed metal object to the dome and observe how this affects charge buildup.</li>
                    <li>Test the effect of humidity on the generator's performance by using a humidifier nearby (at a safe distance).</li>
                    <li>Compare the charging ability of different materials by testing various objects with the generator.</li>
                    <li>Research how Van de Graaff generators are used in particle accelerators and other scientific applications.</li>
                </ol>
            </div>
        </div>

        <!-- Submit Button Section -->
        <div class="submit-section">
            <button id="submit-btn" class="submit-button">Submit Results to Instructor</button>
            <div id="submission-status" class="status-message"></div>
        </div>
    </div>

    <style>
        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 20px;
            font-family: Arial, sans-serif;
        }
        h1 {
            color: #2c3e50;
            text-align: center;
            margin-bottom: 10px;
        }
        .experiment-description {
            text-align: center;
            font-style: italic;
            margin-bottom: 30px;
            color: #7f8c8d;
        }
        .student-info {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 30px;
        }
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
        }
        .info-grid div {
            margin-bottom: 10px;
        }
        label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }
        input, textarea, select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 16px;
        }
        .section {
            margin-bottom: 30px;
            border-bottom: 1px solid #eee;
            padding-bottom: 20px;
        }
        .section h2 {
            color: #3498db;
            border-bottom: 2px solid #3498db;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        .safety-section {
            background-color: #ffebee;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 30px;
        }
        .safety-section h2 {
            color: #e53935;
            margin-top: 0;
        }
        .materials-list li, .safety-section li {
            margin-bottom: 8px;
        }
        .procedure-steps .step {
            margin-bottom: 20px;
            padding-left: 20px;
            border-left: 3px solid #3498db;
        }
        .procedure-steps h3 {
            color: #3498db;
            margin-bottom: 10px;
        }
        .form-group, .question {
            margin-bottom: 20px;
        }
        .background-info {
            background-color: #e8f4f8;
            padding: 15px;
            border-radius: 8px;
        }
        .background-info h3 {
            color: #2980b9;
            margin-top: 15px;
            margin-bottom: 10px;
        }
        .background-info p, .background-info li {
            margin-bottom: 10px;
        }
        .submit-button {
            background-color: #2ecc71;
            color: white;
            border: none;
            padding: 12px 24px;
            font-size: 18px;
            border-radius: 4px;
            cursor: pointer;
            display: block;
            margin: 30px auto;
            transition: background-color 0.3s;
        }
        .submit-button:hover {
            background-color: #27ae60;
        }
        .status-message {
            text-align: center;
            margin-top: 15px;
            font-weight: bold;
        }
        .success {
            color: #2ecc71;
        }
        .error {
            color: #e74c3c;
        }
    </style>

    <script>
        // Wait for the DOM to be fully loaded
        document.addEventListener('DOMContentLoaded', function() {
            // Set today's date as the default
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('experiment-date').value = today;
            
            // Try to retrieve email from localStorage if available
            const savedEmail = localStorage.getItem('studentEmail');
            if (savedEmail) {
                document.getElementById('student-email').value = savedEmail;
            }
            
            // Submit button functionality
            document.getElementById('submit-btn').addEventListener('click', function() {
                submitResults();
            });
        });

        // Function to submit results via EmailJS
        function submitResults() {
            const studentName = document.getElementById('student-name').value.trim();
            const studentEmail = document.getElementById('student-email').value.trim();
            const experimentDate = document.getElementById('experiment-date').value;
            
            // Validate required fields
            if (!studentName || !studentEmail || !experimentDate) {
                document.getElementById('submission-status').textContent = 'Please fill in all required fields.';
                document.getElementById('submission-status').className = 'status-message error';
                return;
            }
            
            // Save email to localStorage for convenience
            localStorage.setItem('studentEmail', studentEmail);
            
            // Collect observations
            const foilObservation = document.getElementById('foil-observation').value.trim();
            const pithObservation = document.getElementById('pith-observation').value.trim();
            const hairObservation = document.getElementById('hair-observation').value.trim();
            const electroscopeObservation = document.getElementById('electroscope-observation').value.trim();
            const bulbObservation = document.getElementById('bulb-observation').value.trim();
            const inductionObservation = document.getElementById('induction-observation').value.trim();
            
            // Collect analysis answers
            const answer1 = document.getElementById('question1').value.trim();
            const answer2 = document.getElementById('question2').value.trim();
            const answer3 = document.getElementById('question3').value.trim();
            const answer4 = document.getElementById('question4').value.trim();
            const answer5 = document.getElementById('question5').value.trim();
            
            // Collect conclusion
            const conclusion = document.getElementById('conclusion').value.trim();
            
            // Prepare comprehensive experiment data for email
            const experimentData = `
EXPERIMENT: Van de Graaff Generator Experiments

STUDENT: ${studentName}
EMAIL: ${studentEmail}

OBSERVATIONS:
Aluminum Foil: ${foilObservation || 'Not provided'}
Pith Ball: ${pithObservation || 'Not provided'}
Hair-Raising: ${hairObservation || 'Not provided'}
Electroscope: ${electroscopeObservation || 'Not provided'}
Fluorescent Bulb: ${bulbObservation || 'Not provided'}
Induction: ${inductionObservation || 'Not provided'}

ANALYSIS QUESTIONS:
1. ${answer1 || 'Not answered'}
2. ${answer2 || 'Not answered'}
3. ${answer3 || 'Not answered'}
4. ${answer4 || 'Not answered'}
5. ${answer5 || 'Not answered'}

CONCLUSION:
${conclusion}
            `.trim();

            // Use proven EmailJS parameter structure from experiment3_2
            const templateParams = {
                student_name: studentName,
                student_email: studentEmail,
                experiment_title: 'Experiment 11.2.1: Van de Graaff Generator Experiments',
                hypothesis: `Van de Graaff generator experiments with various materials`,
                missing_elements: `Foil: ${foilObservation ? '✓' : '✗'} | Pith: ${pithObservation ? '✓' : '✗'} | Hair: ${hairObservation ? '✓' : '✗'} | Electroscope: ${electroscopeObservation ? '✓' : '✗'} | Bulb: ${bulbObservation ? '✓' : '✗'}`,
                conclusion: experimentData,
                subject: `Physical Science Experiment 11.2.1 Results - ${studentName}`
            };

            // Show loading status
            document.getElementById('submission-status').textContent = 'Submitting results...';
            document.getElementById('submission-status').className = 'status-message';
            document.getElementById('submit-btn').disabled = true;
            
            // Send email using EmailJS
            emailjs.send('service_ot1jg6s', 'template_y556rhr', templateParams)
                .then(function(response) {
                    console.log('SUCCESS!', response.status, response.text);
                    document.getElementById('submission-status').textContent = 'Results submitted successfully!';
                    document.getElementById('submission-status').className = 'status-message success';
                    document.getElementById('submit-btn').disabled = false;
                }, function(error) {
                    console.log('FAILED...', error);
                    document.getElementById('submission-status').textContent = 'Failed to submit results. Please try again.';
                    document.getElementById('submission-status').className = 'status-message error';
                    document.getElementById('submit-btn').disabled = false;
                });
        }
    </script>
    
    <!-- EmailJS SDK -->
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
    <script type="text/javascript">
        (function() {
            emailjs.init("ct_s19oZHppLy9BlW");
        })();
    </script>
</Layout>
