---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Experiment 4.2: Comparing Solids">
    <main class="container mx-auto px-4 py-8">
        <div class="experiment-header">
            <h1 class="text-3xl font-bold text-center text-blue-700 mb-2">EXPERIMENT 4.2</h1>
            <h2 class="text-2xl font-bold text-center text-blue-700 mb-8">COMPARING SOLIDS</h2>
        </div>

        <!-- Email Collection Section -->
        <section class="mb-8">
            <div class="bg-blue-50 p-4 rounded-lg mb-4">
                <h4 class="font-bold mb-2">Student Information:</h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="studentName" class="block text-gray-700 font-bold mb-2">Name:</label>
                        <input type="text" id="studentName" class="w-full px-3 py-2 border rounded-lg" placeholder="Your Name">
                    </div>
                    <div>
                        <label for="studentEmail" class="block text-gray-700 font-bold mb-2">Email:</label>
                        <input type="email" id="studentEmail" class="w-full px-3 py-2 border rounded-lg" placeholder="Your Email">
                    </div>
                </div>
            </div>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">PURPOSE:</h3>
            <p class="mb-4">To observe the differences in solid water and solid butter.</p>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">BACKGROUND:</h3>
            <p class="mb-4">
                Typically as a substance is heated it expands. Because of the increase in kinetic energy supplied 
                by the heat, the molecules of the substance speed up and move around more, increasing their 
                volume (which decreases density). Likewise as most substances cool, they contract because 
                their molecules slow down as their kinetic energy decreases. As they slow down their volume 
                decreases because they take up less space (increasing density). Remember from Experiment 
                2.2 that less dense substance will float in more dense substances. In this experiment you will 
                investigate if this phenomenon happens for both butter and water.
            </p>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">MATERIALS:</h3>
            <ul class="list-disc pl-8 mb-4">
                <li>Stick of butter or margarine (It must be fresh from the refrigerator so that it is solid)</li>
                <li>Two beakers or microwave-safe glass bowls</li>
                <li>Water</li>
                <li>Ice cube</li>
                <li>Microwave (A saucepan and stove can be substituted for the microwave.)</li>
                <li>Knife (A serrated one works best. You will use it to cut the butter.)</li>
                <li>Spoon</li>
                <li>Eye protection such as goggles or safety glasses</li>
            </ul>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">QUESTIONS:</h3>
            <p class="mb-4">What happens when solid butter is placed in liquid butter? What happens when solid water is placed in liquid water?</p>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">HYPOTHESIS:</h3>
            <p class="mb-4">Predict what will happen when solid water and butter are placed in liquid water and butter respectively.</p>
            
            <div class="bg-gray-100 p-4 rounded-lg mb-4">
                <h4 class="font-bold mb-2">My Hypothesis:</h4>
                <textarea id="hypothesisInput" class="w-full p-2 border rounded" rows="4" placeholder="Enter your hypothesis here..."></textarea>
            </div>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">PROCEDURE:</h3>
            <ol class="list-decimal pl-8 mb-4">
                <li class="mb-2">
                    Look at the tablespoon markings on the wrapper that covers the stick of butter. Using 
                    those markings as a guide, cut ½ tablespoon off the end of the stick with the knife so that 
                    you have a small square of butter.
                </li>
                <li class="mb-2">
                    Unwrap both the piece you cut off and the rest of the stick.
                </li>
                <li class="mb-2">
                    Put the ½ tablespoon of butter back in the refrigerator until it is needed in step 8.
                </li>
                <li class="mb-2">
                    Put the rest of the stick of butter into the beaker or microwave-safe glass bowl.
                </li>
                <li class="mb-2">
                    Melt the butter in the microwave for about 1 minute. (Check after 30 seconds to see if it 
                    is melted.) You can also melt the butter in a saucepan on the stove.
                </li>
                <li class="mb-2">
                    When the butter is completely melted, take it out of the microwave. If using the saucepan, 
                    carefully pour the melted butter into the beaker or glass bowl. You now have a beaker of 
                    liquid butter.
                </li>
                <li class="mb-2">
                    Fill the other beaker with water. Set both beakers side by side.
                </li>
                <li class="mb-2">
                    Go to the refrigerator and get the solid butter you put there. Also get an ice cube from 
                    the freezer.
                </li>
                <li class="mb-2">
                    Drop the ice cube in the water.
                </li>
                <li class="mb-2">
                    Drop the ½ tablespoon of solid butter in the liquid butter.
                </li>
                <li class="mb-2">
                    Record your observations of what happened to the ice cube and the solid square of butter 
                    in your data table.
                </li>
                <li class="mb-2">
                    Clean up and put everything away.
                </li>
            </ol>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">DATA TABLE:</h3>
            <div class="overflow-x-auto">
                <table class="min-w-full bg-white border border-gray-300 mb-4">
                    <thead>
                        <tr>
                            <th class="border border-gray-300 px-4 py-2">Substance</th>
                            <th class="border border-gray-300 px-4 py-2">Observation</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="border border-gray-300 px-4 py-2">Ice cube in water</td>
                            <td class="border border-gray-300 px-4 py-2">
                                <textarea id="iceObservation" class="w-full p-2 border rounded" rows="2"></textarea>
                            </td>
                        </tr>
                        <tr>
                            <td class="border border-gray-300 px-4 py-2">Solid butter in liquid butter</td>
                            <td class="border border-gray-300 px-4 py-2">
                                <textarea id="butterObservation" class="w-full p-2 border rounded" rows="2"></textarea>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">CONCLUSION:</h3>
            <p class="mb-4">
                What was the difference in what happened to the ice cube and the solid butter square? Explain 
                what happened (use density in your explanation) and make connections to the text (discuss 
                hydrogen bonding).
            </p>
            
            <div class="bg-gray-100 p-4 rounded-lg mb-4">
                <h4 class="font-bold mb-2">My Conclusion:</h4>
                <textarea id="conclusionInput" class="w-full p-2 border rounded" rows="6" placeholder="Enter your conclusion here..."></textarea>
            </div>
        </section>



        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">SUBMIT YOUR WORK</h3>
            <form id="experimentForm" class="bg-gray-100 p-6 rounded-lg">

                
                <div class="flex justify-end">
                    <button type="submit" id="submitButton" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700">Submit Experiment</button>
                </div>
            </form>
        </section>

        <div class="mt-8 text-center">
            <a href="/physical-science" class="inline-block bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700">Back to Physical Science</a>
        </div>
    </main>
</Layout>

<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
<script>

    // Initialize EmailJS with error checking
    if (typeof emailjs !== 'undefined') {
        emailjs.init("ct_s19oZHppLy9BlW");
    }

    // Store email in local storage if available
    document.addEventListener('DOMContentLoaded', function() {
        // Check for stored email
        const storedName = localStorage.getItem('studentName');
        const storedEmail = localStorage.getItem('studentEmail');
        
        if (storedName) {
            document.getElementById('studentName').value = storedName;
        }
        
        if (storedEmail) {
            document.getElementById('studentEmail').value = storedEmail;
        }
        
        // Save email when entered
        document.getElementById('studentName').addEventListener('change', function() {
            localStorage.setItem('studentName', this.value);
        });
        
        document.getElementById('studentEmail').addEventListener('change', function() {
            localStorage.setItem('studentEmail', this.value);
        });
    });


    
    // Form submission
    document.getElementById('experimentForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        // Get form data
        const studentName = document.getElementById('studentName').value;
        const studentEmail = document.getElementById('studentEmail').value;
        const hypothesis = document.getElementById('hypothesisInput').value;
        const iceObservation = document.getElementById('iceObservation').value;
        const butterObservation = document.getElementById('butterObservation').value;
        const conclusion = document.getElementById('conclusionInput').value;
        
        // Validate inputs
        if (!studentName || !studentEmail) {
            alert('Please enter your name and email at the top of the page.');
            return;
        }
        

        
        // Disable submit button to prevent multiple submissions
        document.getElementById('submitButton').disabled = true;
        document.getElementById('submitButton').textContent = 'Submitting...';
        
        // Prepare comprehensive experiment data for email
        const experimentData = `
EXPERIMENT: Comparing Solids

STUDENT: ${studentName}
EMAIL: ${studentEmail}

HYPOTHESIS:
${hypothesis || 'Not provided'}

OBSERVATIONS:
Ice Cube: ${iceObservation || 'Not provided'}
Butter: ${butterObservation || 'Not provided'}

CONCLUSION:
${conclusion || 'Not provided'}
        `.trim();

        // Use proven EmailJS parameter structure
        const templateParams = {
            student_name: studentName,
            student_email: studentEmail,
            experiment_title: 'Experiment 4.2: Comparing Solids',
            hypothesis: hypothesis || 'Comparing properties of ice and butter solids',
            missing_elements: `Ice: ${iceObservation ? '✓' : '✗'} | Butter: ${butterObservation ? '✓' : '✗'} | Conclusion: ${conclusion ? '✓' : '✗'}`,
            conclusion: experimentData,
            subject: `Physical Science Experiment 4.2 Results - ${studentName}`
        };
        
        // Check if EmailJS is available
        if (typeof emailjs !== 'undefined') {
            // Send email using EmailJS
            emailjs.send('service_ot1jg6s', 'template_y556rhr', templateParams)
                .then(function(response) {
                    console.log('SUCCESS!', response.status, response.text);
                    alert('Your experiment has been submitted successfully!');
                    document.getElementById('submitButton').disabled = false;
                    document.getElementById('submitButton').textContent = 'Submit Experiment';
                }, function(error) {
                    console.log('FAILED...', error);
                    alert('Failed to submit. Please try again.');
                    document.getElementById('submitButton').disabled = false;
                    document.getElementById('submitButton').textContent = 'Submit Experiment';
                });
        } else {
            alert('Email service is not available. Please try again later.');
            document.getElementById('submitButton').disabled = false;
            document.getElementById('submitButton').textContent = 'Submit Experiment';
        }
    });
</script>
