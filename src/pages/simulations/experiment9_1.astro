        background-color: #6c757d;
        cursor: not-allowed;
    }

    .submission-message {
        font-size: 0.9em;
        margin-top: 0.5rem;
    }
</style>

<script>
window.addEventListener('load', function() {
    const volumeRange = document.getElementById('volume');
    const volumeDisplay = document.getElementById('volumeDisplay');
    const flame = document.getElementById('flame');
    const toggleToneBtn = document.getElementById('toggleTone');

    let audioCtx;
    let oscillator;
    let gainNode;

    function getIntensity() {
        const val = Number(volumeRange?.value || 5);
        return Math.min(1, Math.max(0, (val - 1) / 9));
    }

    function updateIntensityUI() {
        if (volumeDisplay && volumeRange) {
            volumeDisplay.textContent = volumeRange.value;
        }

        const intensity = getIntensity();
        if (flame) {
            const tilt = (intensity * 10);
            const wobble = (intensity * 14);
            flame.style.animation = `flame-flicker 0.12s infinite alternate ease-in-out`;
            flame.style.setProperty('--flame-tilt', `${tilt}deg`);
            flame.style.setProperty('--flame-wobble', `${wobble}deg`);
            flame.style.setProperty('--flame-scale', `${1 + intensity * 0.12}`);
        }

        if (gainNode) {
            const targetGain = intensity * 0.15;
            const now = audioCtx.currentTime;
            gainNode.gain.cancelScheduledValues(now);
            gainNode.gain.setTargetAtTime(targetGain, now, 0.02);
        }
    }

    function ensureAudio() {
        if (audioCtx) return;
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        oscillator = audioCtx.createOscillator();
        gainNode = audioCtx.createGain();
        oscillator.type = 'sine';
        oscillator.frequency.value = 440;
        gainNode.gain.value = 0;
        oscillator.connect(gainNode).connect(audioCtx.destination);
        oscillator.start();
    }

    function isTonePlaying() {
        return !!(audioCtx && gainNode && gainNode.gain.value > 0.0001);
    }

    function stopTone() {
        if (!gainNode || !audioCtx) return;
        const now = audioCtx.currentTime;
        gainNode.gain.cancelScheduledValues(now);
        gainNode.gain.setTargetAtTime(0, now, 0.02);
        if (toggleToneBtn) toggleToneBtn.textContent = 'Play Tone';
    }

    function startTone() {
        ensureAudio();
        if (!gainNode) return;
        updateIntensityUI();
        if (toggleToneBtn) toggleToneBtn.textContent = 'Stop Tone';
    }

    if (volumeRange) {
        volumeRange.addEventListener('input', updateIntensityUI);
        updateIntensityUI();
    }

    if (toggleToneBtn) {
        toggleToneBtn.addEventListener('click', function() {
            if (!audioCtx) {
                startTone();
                return;
            }

            if (isTonePlaying()) {
                stopTone();
            } else {
                startTone();
            }
        });
    }

    const video = document.getElementById('experimentVideo');
    const playButton = document.getElementById('playButton');
    const volumeButton = document.getElementById('volumeButton');
    const volumeSlider = document.getElementById('volumeSlider');
    
    /* ... existing code ... */
        playButton.addEventListener('click', function(event) {
            if (video.paused) {
                video.play();
                playButton.innerHTML = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>';
            } else {
                video.pause();
                playButton.innerHTML = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
            }
        });

        volumeButton.addEventListener('click', function(event) {
            if (video.muted) {
                video.muted = false;
                volumeButton.innerHTML = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>';
                volumeSlider.value = video.volume;
            } else {
                video.muted = true;
                volumeButton.innerHTML = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 9v6h4l5 5V4l-5 5H7z"/></svg>';
                volumeSlider.value = 0;
            }
        });

        volumeSlider.addEventListener('input', function(event) {
            video.volume = event.target.value;
            video.muted = event.target.value === '0';
            volumeButton.innerHTML = video.muted ? 
                '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 9v6h4l5 5V4l-5 5H7z"/></svg>' :
                '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>';
        });

        video.addEventListener('ended', function(event) {
            playButton.innerHTML = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
        });

        video.addEventListener('error', function(event) {
            console.error('Video error:', video.error);
            if (video.error) {
                document.getElementById('videoError').textContent = `Video error: ${video.error.message}`;
                document.getElementById('videoError').style.display = 'block';
            }
        });

        video.addEventListener('loadedmetadata', function(event) {
            console.log('Video metadata loaded successfully');
            document.getElementById('videoError').style.display = 'none';
        });
    
    // Email functionality
    const emailInput = document.getElementById('studentEmail');
    const saveEmailBtn = document.getElementById('saveEmail');
    const emailStatus = document.getElementById('emailStatus');
    
    // Check if email is already saved
    const savedEmail = localStorage.getItem('studentEmail');
    if (savedEmail) {
        emailInput.value = savedEmail;
        emailStatus.textContent = `Email saved: ${savedEmail}`;
        emailStatus.style.color = '#28a745';
    }
    
    // Save email functionality
    saveEmailBtn.addEventListener('click', function(event) {
        const email = emailInput.value.trim();
        if (email && isValidEmail(email)) {
            localStorage.setItem('studentEmail', email);
            emailStatus.textContent = `Email saved: ${email}`;
            emailStatus.style.color = '#28a745';
        } else {
            emailStatus.textContent = 'Please enter a valid email address';
            emailStatus.style.color = '#dc3545';
        }
    });
    
    // Email validation
    function isValidEmail(email) {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        return emailRegex.test(email);
    }
    
    // Submit Results Button
    const submissionMessage = document.getElementById('submissionMessage');
    const submitResultsBtn = document.getElementById('submitResults');
    
    // Add event listener only if the button exists
    if (submitResultsBtn) {
        submitResultsBtn.addEventListener('click', function(event) {
        const savedEmail = localStorage.getItem('studentEmail');
        if (!savedEmail) {
            showSubmissionMessage('Please save your email address before submitting', 'error');
            return;
        }
        
        const conclusions = document.getElementById('conclusions').value.trim();
        if (!conclusions) {
            showSubmissionMessage('Please fill in your conclusions before submitting', 'error');
            return;
        }
        
        console.log('=== EXPERIMENT RESULTS SUBMISSION ===');
        console.log('Student Email:', savedEmail);
        console.log('Student Conclusions:', conclusions);
        
        // Check if EmailJS is ready before sending
        if (!emailjsReady) {
            showSubmissionMessage('Email service is still loading. Please wait a moment and try again.', 'error');
            return;
        }

        // Disable button and show loading state
        submitResultsBtn.disabled = true;
        submitResultsBtn.textContent = 'Submitting...';
            
            // Extract student name from email or use default
            const studentName = savedEmail.split('@')[0] || 'Student';
            
            // Prepare comprehensive experiment data for email
            const experimentData = `
EXPERIMENT: Sound Wave Visualization

STUDENT: ${studentName}
EMAIL: ${savedEmail}

STUDENT CONCLUSIONS:
${conclusions || 'No conclusions provided'}

EXPERIMENT SUMMARY:
The student completed the sound wave visualization experiment, observing how sound waves create vibrations in rice grains placed on a plastic-covered bowl when sound is produced nearby.
            `.trim();

            const templateParams = {
                student_name: studentName,
                student_email: savedEmail,
                experiment_title: 'Experiment 9.1: Sound Wave Visualization',
                hypothesis: 'Exploring how sound waves create visible vibrations in matter',
                missing_elements: `Conclusions: ${conclusions ? '✓' : '✗'}`,
                conclusion: experimentData,
                subject: `Physical Science Experiment 9.1 Results - ${studentName}`
            };

            // Send via EmailJS
            window.emailjs.send("service_ot1jg6s", "template_y556rhr", templateParams)
                .then(function(response) {
                    console.log('Experiment results sent successfully:', response);
                    showSubmissionMessage('Experiment submitted successfully!', 'success');
                    submitResultsBtn.textContent = 'Submit to Teacher';
                    submitResultsBtn.disabled = false;
                })
                .catch(function(error) {
                    console.error('Failed to send experiment results:', error);
                    showSubmissionMessage('Failed to submit. Please try again.', 'error');
                    submitResultsBtn.textContent = 'Submit to Teacher';
                    submitResultsBtn.disabled = false;
                });
    });
    }
    
    function showSubmissionMessage(message, type) {
        const submissionMessage = document.getElementById('submissionMessage');
        if (submissionMessage) {
            submissionMessage.textContent = message;
            submissionMessage.style.display = 'block';
            submissionMessage.style.color = type === 'success' ? '#28a745' : '#dc3545';
        } else {
            console.warn('Submission message element not found');
        }
    }
});
</script>

