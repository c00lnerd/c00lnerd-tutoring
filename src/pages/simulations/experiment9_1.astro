<script client:load>
// Dynamic EmailJS loading with retry logic
let emailjsReady = false;
let emailjsRetryCount = 0;
const maxRetries = 3;

function loadEmailJS() {
    return new Promise((resolve, reject) => {
        if (window.emailjs) {
            emailjsReady = true;
            window.emailjs.init("ct_s19oZHppLy9BlW");
            resolve();
            return;
        }

        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js';
        script.onload = () => {
            if (window.emailjs) {
                emailjsReady = true;
                window.emailjs.init("ct_s19oZHppLy9BlW");
                console.log('EmailJS loaded and initialized successfully');
                resolve();
            } else {
                reject(new Error('EmailJS not available after script load'));
            }
        };
        script.onerror = () => reject(new Error('Failed to load EmailJS script'));
        document.head.appendChild(script);
    });
}

function retryEmailJSLoad() {
    if (emailjsRetryCount < maxRetries) {
        emailjsRetryCount++;
        console.log(`Retrying EmailJS load (attempt ${emailjsRetryCount}/${maxRetries})`);
        setTimeout(() => {
            loadEmailJS().catch(() => {
                if (emailjsRetryCount < maxRetries) {
                    retryEmailJSLoad();
                } else {
                    console.error('Failed to load EmailJS after maximum retries');
                }
            });
        }, 1000 * emailjsRetryCount);
    }
}

window.addEventListener('load', function() {
    console.log('Window load event fired');
    
    // Load EmailJS
    loadEmailJS().catch(() => {
        console.warn('Initial EmailJS load failed, starting retry logic');
        retryEmailJSLoad();
    });
        
    // Set up volume control
    const volumeControl = document.getElementById('volume');
    if (volumeControl) {
        volumeControl.addEventListener('input', (event) => {
            const volumeDisplay = document.getElementById('volumeDisplay');
            if (volumeDisplay) {
                volumeDisplay.textContent = event.target.value;
            }
        });
        console.log('Volume control initialized');
    } else {
        console.warn('Volume control not found');
    }
});
</script>
