---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Experiment 6.1: The Importance of Direction in Velocity">
    <main class="container mx-auto px-4 py-8">
        <div class="experiment-header">
            <h1 class="text-3xl font-bold text-center text-blue-700 mb-2">EXPERIMENT 6.1</h1>
            <h2 class="text-2xl font-bold text-center text-blue-700 mb-8">THE IMPORTANCE OF DIRECTION IN VELOCITY</h2>
        </div>

        <!-- Email Collection Section -->
        <section class="mb-8">
            <div class="bg-blue-50 p-4 rounded-lg mb-4">
                <h4 class="font-bold mb-2">Student Information:</h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="studentName" class="block text-gray-700 font-bold mb-2">Name:</label>
                        <input type="text" id="studentName" class="w-full px-3 py-2 border rounded-lg" placeholder="Your Name">
                    </div>
                    <div>
                        <label for="studentEmail" class="block text-gray-700 font-bold mb-2">Email:</label>
                        <input type="email" id="studentEmail" class="w-full px-3 py-2 border rounded-lg" placeholder="your.email@example.com">
                    </div>
                </div>
                <div class="mt-4">
                    <label for="teacherEmail" class="block text-gray-700 font-bold mb-2">Teacher's Email:</label>
                    <input type="email" id="teacherEmail" class="w-full px-3 py-2 border rounded-lg" value="chuck@c00lnerd.com" placeholder="teacher.email@example.com">
                </div>
            </div>
        </section>

        <!-- Purpose Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">PURPOSE:</h3>
            <p class="mb-4">To observe how direction plays a role when objects are moving at different speeds.</p>
        </section>

        <!-- Materials Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">MATERIALS:</h3>
            <ul class="list-disc pl-8 mb-4">
                <li>At least 4 eggs</li>
                <li>Two pieces of reasonably strong cardboard (like the cardboard found on the back of writing tablets)</li>
                <li>Several books</li>
                <li>A pair of scissors</li>
                <li>Ruler</li>
                <li>A large tray or cookie sheet</li>
                <li>Paper towels</li>
                <li>Kitchen table</li>
                <li>Eye protection such as goggles or safety glasses</li>
            </ul>
            <div class="bg-yellow-100 border-l-4 border-yellow-500 p-4 mb-4">
                <p class="font-bold">SAFETY WARNING:</p>
                <p>This experiment involves eggs that may break. Wear eye protection to prevent any egg from getting into your eyes. Clean up any broken eggs promptly to prevent slipping hazards.</p>
            </div>
        </section>

        <!-- Background Information Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">BACKGROUND:</h3>
            <p class="mb-4">The difference between speed and velocity is very important in physics. This experiment demonstrates that fact.</p>
        </section>

        <!-- Question Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">QUESTION:</h3>
            <p class="mb-4">How does direction affect two objects relative to each other when they are moving in the same direction with the same speed? What about when they are moving with the same speed in opposite directions, towards each other?</p>
        </section>

        <!-- Hypotheses Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">HYPOTHESIS:</h3>
            <p class="mb-4">Write what you predict will happen to 2 eggs that roll down a ramp in the same direction. Write what you predict will happen to 2 eggs that roll down ramps in opposite directions, towards each other.</p>
            <div class="mb-4">
                <p class="font-bold">Hypothesis for eggs rolling in the same direction:</p>
                <textarea id="hypothesisSameDirection" class="w-full p-2 border rounded-lg" rows="3" placeholder="Enter your hypothesis here..."></textarea>
            </div>
            <div class="mb-4">
                <p class="font-bold">Hypothesis for eggs rolling in opposite directions:</p>
                <textarea id="hypothesisOppositeDirection" class="w-full p-2 border rounded-lg" rows="3" placeholder="Enter your hypothesis here..."></textarea>
            </div>
        </section>

        <!-- Procedure Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">PROCEDURE:</h3>
            <ol class="list-decimal pl-8 mb-4">
                <li class="mb-2">
                    This is a potentially messy experiment, so put some paper towels on the table for easier clean-up.
                </li>
                <li class="mb-2">
                    Make a pile of books about 8 inches high on the tabletop. (You will need to make a second pile 8 inches high for step 7, so gather all books now.)
                </li>
                <li class="mb-2">
                    Take the cardboard pieces and measure 2 inches in from each side and 1 inch from the top. Cut the 2 in × 1 in rectangles out (see Figure 6.12). Fold the long edges up to form "railings" on each side. Fold the short edge back.
                </li>
                <li class="mb-2">
                    Next, tuck the short edge between the top 2 books so that the cardboard leans against the pile of books, making what looks like a slide going from the top of the books to the tray. Your set-up should look like Figure 6.13.
                </li>
                <li class="mb-2">
                    Trial 1—Hold two eggs together on top of the slide. Hold them so that one egg is behind the other. Release them together, allowing them to roll down the slide one behind the other. Use your other hand to stop them when they roll off the slide and onto the tray. Note whether the eggs have been damaged or not. Record your observations in your data table. If the eggs were damaged, get new ones. If not, you can reuse them.
                </li>
                <li class="mb-2">
                    Trial 2—Lay one egg on the tray at the bottom of the slide. Allow the other egg to roll down the slide and hit the egg at the bottom of the slide. Record your observations, noting any damage caused. Once again reuse any undamaged eggs.
                </li>
                <li class="mb-2">
                    Build another slide like the one you've been using. It needs to be close to the same height as the first slide.
                </li>
                <li class="mb-2">
                    Place the two slides so that they are on opposite sides of the tray and so that they meet in the center of the tray.
                </li>
                <li class="mb-2">
                    Trial 3—Place one egg at the top of one slide and the second egg at the top of the other slide.
                </li>
                <li class="mb-2">
                    Simultaneously let both eggs go, allowing them to roll down the slides and crash into each other. Record your observations, noting the damage to the eggs.
                </li>
                <li class="mb-2">
                    Clean up and put everything away.
                </li>
            </ol>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-4">
                <div class="bg-blue-50 p-4 rounded-lg">
                    <p class="font-bold">Figure 6.12: Cardboard Setup</p>
                    <img src="/images/figure6.12.png" alt="Cardboard setup diagram showing dimensions and fold lines" class="w-full rounded-lg my-2">
                    <p>Cardboard setup with dimensions and fold lines.</p>
                </div>
                <div class="bg-blue-50 p-4 rounded-lg">
                    <p class="font-bold">Figure 6.13: Experimental Setup</p>
                    <img src="/images/figure6.13.png" alt="Experimental setup showing the ramp made with books and cardboard" class="w-full rounded-lg my-2">
                    <p>Experimental setup with books and cardboard ramp.</p>
                </div>
            </div>
        </section>



        <!-- Analysis Questions Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">ANALYSIS QUESTIONS:</h3>
            <div class="mb-4">
                <p class="font-bold">1. In Trial 1, did the eggs damage each other? Why or why not?</p>
                <textarea id="analysis1" class="w-full p-2 border rounded-lg" rows="3" placeholder="Your answer..."></textarea>
            </div>
            <div class="mb-4">
                <p class="font-bold">2. In Trial 2, what happened when the moving egg hit the stationary egg? Why?</p>
                <textarea id="analysis2" class="w-full p-2 border rounded-lg" rows="3" placeholder="Your answer..."></textarea>
            </div>
            <div class="mb-4">
                <p class="font-bold">3. In Trial 3, what happened when the two eggs collided? How does this compare to Trial 1 and Trial 2?</p>
                <textarea id="analysis3" class="w-full p-2 border rounded-lg" rows="3" placeholder="Your answer..."></textarea>
            </div>
            <div class="mb-4">
                <p class="font-bold">4. How does the direction of motion affect the outcome of each trial?</p>
                <textarea id="analysis4" class="w-full p-2 border rounded-lg" rows="3" placeholder="Your answer..."></textarea>
            </div>
            <div class="mb-4">
                <p class="font-bold">5. What is the difference between speed and velocity?</p>
                <textarea id="analysis5" class="w-full p-2 border rounded-lg" rows="3" placeholder="Your answer..."></textarea>
            </div>
        </section>

        <!-- Interactive Simulation Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">INTERACTIVE SIMULATION:</h3>
            <p class="mb-4">Watch this video demonstration of the experiment:</p>
            <div class="flex justify-center mb-4">
                <div class="w-full max-w-3xl">
                    <video id="demoVideo" class="w-full rounded-lg shadow-lg" controls>
                        <source src="/videos/direction-velocity.mp4" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>
            </div>
        </section>

        <!-- Conclusion Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">CONCLUSION:</h3>
            <p class="mb-4">Based on your observations and analysis, explain how this experiment demonstrates the importance of direction in velocity. How does this relate to real-world situations involving moving objects?</p>
            <div class="mb-4">
                <textarea id="conclusion" class="w-full p-2 border rounded-lg" rows="6" placeholder="Write your conclusion here..."></textarea>
            </div>
        </section>

        <!-- Submit Section -->
        <section class="mb-8">
            <div class="bg-blue-50 p-4 rounded-lg">
                <h3 class="text-xl font-bold text-blue-700 mb-4">SUBMIT YOUR RESULTS:</h3>
                <p class="mb-4">Click the button below to submit your experiment results to your teacher.</p>
                <button id="submitBtn" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                    Submit Results
                </button>
                <p id="submissionMessage" class="mt-2 hidden"></p>
            </div>
        </section>
    </main>
</Layout>

<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
<script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
        // Load EmailJS
        emailjs.init('ct_s19oZHppLy9BlW');
        // Store student information in local storage
        const studentNameInput = document.getElementById('studentName');
        const studentEmailInput = document.getElementById('studentEmail');
        const teacherEmailInput = document.getElementById('teacherEmail');

        // Load stored values if they exist
        if (localStorage.getItem('studentName')) {
            studentNameInput.value = localStorage.getItem('studentName');
        }
        if (localStorage.getItem('studentEmail')) {
            studentEmailInput.value = localStorage.getItem('studentEmail');
        }
        if (localStorage.getItem('teacherEmail')) {
            teacherEmailInput.value = localStorage.getItem('teacherEmail');
        }

        // Save values when they change
        studentNameInput.addEventListener('change', function() {
            localStorage.setItem('studentName', this.value);
        });
        studentEmailInput.addEventListener('change', function() {
            localStorage.setItem('studentEmail', this.value);
        });
        teacherEmailInput.addEventListener('change', function() {
            localStorage.setItem('teacherEmail', this.value);
        });

        // Track video events
        const demoVideo = document.getElementById('demoVideo');
        let videoWatched = false;

        demoVideo.addEventListener('play', function() {
            console.log('Video started playing');
        });

        demoVideo.addEventListener('ended', function() {
            console.log('Video finished playing');
            videoWatched = true;
        });

        // Handle form submission
        const submitBtn = document.getElementById('submitBtn');
        const submissionMessage = document.getElementById('submissionMessage');

        submitBtn.addEventListener('click', function() {
            // Validate required fields
            const studentName = studentNameInput.value.trim();
            const studentEmail = studentEmailInput.value.trim();
            const teacherEmail = teacherEmailInput.value.trim();
            const hypothesisSameDirection = document.getElementById('hypothesisSameDirection').value.trim();
            const hypothesisOppositeDirection = document.getElementById('hypothesisOppositeDirection').value.trim();
            const conclusion = document.getElementById('conclusion').value.trim();

            if (!studentName || !studentEmail || !teacherEmail) {
                showMessage('Please fill in all required student and teacher information.', 'error');
                return;
            }

            if (!hypothesisSameDirection || !hypothesisOppositeDirection || !conclusion) {
                showMessage('Please complete your hypotheses and conclusion.', 'error');
                return;
            }

            // Prepare comprehensive experiment data for submission
            const analysisAnswers = [
                document.getElementById('analysis1').value || 'Not answered',
                document.getElementById('analysis2').value || 'Not answered', 
                document.getElementById('analysis3').value || 'Not answered',
                document.getElementById('analysis4').value || 'Not answered',
                document.getElementById('analysis5').value || 'Not answered'
            ];
            
            const experimentData = `HYPOTHESES:

Hypothesis for eggs rolling in the same direction:
${hypothesisSameDirection}

Hypothesis for eggs rolling in opposite directions:
${hypothesisOppositeDirection}

ANALYSIS QUESTIONS:

1. In Trial 1, did the eggs damage each other? Why or why not?
${analysisAnswers[0]}

2. In Trial 2, what happened when the moving egg hit the stationary egg? Why?
${analysisAnswers[1]}

3. In Trial 3, what happened when the two eggs collided? How does this compare to Trial 1 and Trial 2?
${analysisAnswers[2]}

4. How does the direction of motion affect the outcome of each trial?
${analysisAnswers[3]}

5. What is the difference between speed and velocity?
${analysisAnswers[4]}

CONCLUSION:
${conclusion}`;
            
            const templateParams = {
                student_name: studentName,
                student_email: studentEmail,
                experiment_title: 'Experiment 6.1: The Importance of Direction in Velocity',
                hypothesis: 'Exploring how direction affects velocity measurements',
                missing_elements: `Student Info: ${studentName ? '✓' : '✗'}, Email: ${studentEmail ? '✓' : '✗'}, Results: ${experimentData ? '✓' : '✗'}`,
                conclusion: experimentData,
                subject: `Physical Science Experiment 6.1 Results - ${studentName}`
            };

            // Disable button and show loading state
            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting...';

            // Send email using EmailJS
            emailjs.send('service_ot1jg6s', 'template_y556rhr', templateParams)
                .then(function(response) {
                    console.log('SUCCESS!', response.status, response.text);
                    showMessage('Your experiment results have been submitted successfully!', 'success');
                    submitBtn.textContent = 'Submitted';
                })
                .catch(function(error) {
                    console.log('FAILED...', error);
                    showMessage('Failed to submit results. Please try again later.', 'error');
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Submit Results';
                });
        });

        function showMessage(message, type) {
            submissionMessage.textContent = message;
            submissionMessage.classList.remove('hidden', 'text-green-600', 'text-red-600');
            submissionMessage.classList.add(type === 'success' ? 'text-green-600' : 'text-red-600');
        }
    });
</script>
