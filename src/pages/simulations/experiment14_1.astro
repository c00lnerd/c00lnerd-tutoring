---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Experiment 14.1: Comparing Vitamin C in Fruit Juices | C00lnerd">
    <div class="experiment-container">
        <h1>Experiment 14.1: Comparing Vitamin C in Fruit Juices</h1>
        
        <div class="student-info">
            <h2>Student Information</h2>
            <form id="studentInfoForm">
                <div class="form-group">
                    <label for="studentName">Student Name:</label>
                    <input type="text" id="studentName" name="studentName" required>
                </div>
                <div class="form-group">
                    <label for="studentEmail">Student Email:</label>
                    <input type="email" id="studentEmail" name="studentEmail" required>
                </div>
                <div class="form-group">
                    <label for="instructorEmail">Instructor Email:</label>
                    <input type="email" id="instructorEmail" name="instructorEmail" value="chuck@c00lnerd.com" readonly>
                </div>
            </form>
        </div>

        <div class="experiment-content">
            <section class="purpose">
                <h2>Purpose</h2>
                <p>To use an indicator to determine the relative amount of vitamin C in fruit juices.</p>
            </section>

            <section class="materials">
                <h2>Materials</h2>
                <ul>
                    <li>Tincture of iodine—1 ounce bottle (You can find this at any drug store.)</li>
                    <li>Lemon juice</li>
                    <li>Apple juice</li>
                    <li>Orange juice</li>
                    <li>Grapefruit juice or pineapple juice (or another juice of your choosing)</li>
                    <li>1000 mg vitamin C pill</li>
                    <li>Medicine dropper</li>
                    <li>A 1 quart jar</li>
                    <li>Measuring cup with milliliter markings</li>
                    <li>Water</li>
                    <li>Six 8 ounce clear plastic cups</li>
                </ul>
            </section>

            <section class="background">
                <h2>Background</h2>
                <p>Different fruits or fruit juices all contain vitamin C, but which is the best source? Vitamin C is an organic acid called ascorbic acid. Like other acids, vitamin C reacts with indicators to produce a color change. Tincture of iodine is a brownish-red colored indicator. When vitamin C is added, it becomes colorless. This reaction can be used to test for the presence of vitamin C and to give some idea of the amount that can be found in the fruit or fruit juices.</p>
                
                <div class="safety-note">
                    <p><strong>Note:</strong> Do not consume any of the fruit or fruit juices during this experiment! Tincture of iodine can stain and should NOT be ingested, so you may want to place plastic under your lab area.</p>
                </div>
            </section>

            <section class="hypothesis">
                <h2>Hypothesis</h2>
                <p>Predict which fruit juice contains the most vitamin C. Record your prediction:</p>
                <textarea class="hypothesis-text" placeholder="Enter your hypothesis here..."></textarea>
            </section>

            <section class="procedure">
                <h2>Procedure</h2>
                <div class="procedure-section">
                    <ol>
                        <li>Prepare an iodine solution by mixing a bottle of tincture of iodine with 500 mL of water in the quart jar.</li>
                        <li>Pour 50 mL of the iodine solution into each of 5 clear plastic cups. Line them up on your work area.</li>
                        <li>Using a spoon, crush a vitamin C tablet and then dissolve it in 100 mL of water in the other clear plastic cup. This will be your control.</li>
                        <li>Using the medicine dropper add one drop of the vitamin C control solution to a cup of iodine. Swirl the cup and note the color change. If the iodine solution did not become clear, continue adding drops of the vitamin C solution one at a time (and swirling after each drop) until the iodine solution turns clear or almost clear. Make sure to count the drops and then record the total number of drops required to turn the iodine solution clear.</li>
                        <li>Rinse out the medicine dropper thoroughly so that your results will not be contaminated. If you have more than one medicine dropper, use a different one for the next juice while the first one dries.</li>
                        <li>Repeat steps 4 and 5 for each of the juices.</li>
                        <li>Clean up and put everything away.</li>
                    </ol>
                </div>
            </section>

            <section class="data-collection">
                <h2>Data Collection</h2>
                <div class="data-table">
                    <h3>Vitamin C Control (1000mg tablet in 100mL water)</h3>
                    <p>Drops of vitamin C control solution needed to clear the iodine solution:</p>
                    <input type="number" class="data-input" id="control-drops" min="0" step="1" placeholder="Enter number of drops">
                </div>

                <div class="data-table">
                    <h3>Fruit Juice Testing Results</h3>
                    <table>
                        <thead>
                            <tr>
                                <th>Juice Type</th>
                                <th>Drops Needed to Clear Iodine</th>
                                <th>Relative Vitamin C Content</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Lemon juice</td>
                                <td><input type="number" class="juice-data" min="0" step="1" data-juice="lemon"></td>
                                <td class="relative-content" id="lemon-relative">--</td>
                            </tr>
                            <tr>
                                <td>Apple juice</td>
                                <td><input type="number" class="juice-data" min="0" step="1" data-juice="apple"></td>
                                <td class="relative-content" id="apple-relative">--</td>
                            </tr>
                            <tr>
                                <td>Orange juice</td>
                                <td><input type="number" class="juice-data" min="0" step="1" data-juice="orange"></td>
                                <td class="relative-content" id="orange-relative">--</td>
                            </tr>
                            <tr>
                                <td>Grapefruit/Pineapple juice</td>
                                <td><input type="number" class="juice-data" min="0" step="1" data-juice="other"></td>
                                <td class="relative-content" id="other-relative">--</td>
                            </tr>
                        </tbody>
                    </table>
                    <p class="note"><em>Note: Fewer drops needed = higher vitamin C content</em></p>
                </div>
            </section>

            <section class="conclusions">
                <h2>Conclusions</h2>
                <p>Make a bar graph of your results. Which fruit juice had the most vitamin C? Write a paragraph explaining how your results showed the juices with the most vitamin C. Make connections to the text.</p>
                
                <div class="chart-container">
                    <h3>Vitamin C Content Bar Chart</h3>
                    <canvas id="vitaminChart" width="600" height="400"></canvas>
                    <p class="chart-note"><em>Chart will update automatically as you enter your data above</em></p>
                </div>
                
                <textarea class="conclusion-text" placeholder="Write your conclusions here, including which juice had the most vitamin C and how your results connect to what you learned..."></textarea>
            </section>

            <div class="email-section">
                <h2>Submit Results</h2>
                <button type="button" id="submit-results" class="submit-btn">Submit Experiment Results</button>
                <div id="submission-message" class="submission-message"></div>
            </div>
        </div>
    </div>

    <style>
        .experiment-container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 2rem;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: #333;
        }

        h1 {
            color: #2c3e50;
            text-align: center;
            margin-bottom: 2rem;
            font-size: 2.5rem;
        }

        h2 {
            color: #34495e;
            border-bottom: 2px solid #3498db;
            padding-bottom: 0.5rem;
            margin-top: 2rem;
        }

        h3 {
            color: #2c3e50;
            margin-top: 1.5rem;
        }

        .student-info {
            background: #f8f9fa;
            padding: 1.5rem;
            border-radius: 8px;
            margin-bottom: 2rem;
        }

        .form-group {
            margin-bottom: 1rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: bold;
        }

        .form-group input {
            width: 100%;
            padding: 0.5rem;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 1rem;
        }

        .experiment-content section {
            margin-bottom: 2rem;
        }

        .materials ul, .safety ul {
            background: #f8f9fa;
            padding: 1.5rem;
            border-radius: 8px;
            border-left: 4px solid #3498db;
        }

        .materials li, .safety li {
            margin-bottom: 0.5rem;
        }

        .procedure-section {
            background: #fff;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 1.5rem;
            margin-bottom: 1rem;
        }

        .procedure-section ol {
            margin: 0;
            padding-left: 1.5rem;
        }

        .procedure-section li {
            margin-bottom: 0.8rem;
            line-height: 1.6;
        }

        .data-table {
            margin: 1.5rem 0;
        }

        .data-table table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 1rem;
        }

        .data-table th,
        .chart-note {
            font-size: 0.9rem;
            color: #666;
            margin: 0.5rem 0 0 0;
            text-align: center;
        }

        .chart-container {
            background: #f8f9fa;
            padding: 1.5rem;
            border-radius: 8px;
            margin: 1.5rem 0;
            border: 2px solid #3498db;
            height: 450px;
            position: relative;
        }

        .chart-container h3 {
            color: #2c3e50;
            margin-bottom: 1rem;
            text-align: center;
        }

        #vitaminChart {
            display: block;
            margin: 0 auto;
            border: 1px solid #ddd;
            border-radius: 4px;
            background: white;
            max-height: 350px;
            width: 100%;
        }

        .safety-note {
            background: #fff3cd;
            border: 1px solid #ffeaa7;
            border-radius: 8px;
            padding: 1rem;
            margin: 1rem 0;
        }

        .hypothesis-text {
            width: 100%;
            min-height: 80px;
            padding: 0.75rem;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-family: inherit;
            font-size: 0.95rem;
            margin-top: 0.5rem;
            resize: vertical;
        }

        .data-table th {
            background-color: #3498db;
            color: white;
            font-weight: bold;
        }

        .data-table tr:nth-child(even) {
            background-color: #f8f9fa;
        }

        .data-input, .juice-data {
            width: 80px;
            padding: 0.25rem;
            border: 1px solid #ccc;
            border-radius: 4px;
            text-align: center;
        }

        .juice-name {
            width: 120px;
            padding: 0.25rem;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        .calculated-average, .calculated-vitamin-c {
            font-weight: bold;
            color: #2c3e50;
        }

        .questions {
            background: #f8f9fa;
            padding: 1.5rem;
            border-radius: 8px;
            border-left: 4px solid #e74c3c;
        }

        .questions li {
            margin-bottom: 1.5rem;
        }

        .analysis-answer {
            width: 100%;
            min-height: 80px;
            padding: 0.75rem;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-family: inherit;
            font-size: 0.95rem;
            margin-top: 0.5rem;
            resize: vertical;
        }

        .conclusion-text {
            width: 100%;
            min-height: 120px;
            padding: 0.75rem;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-family: inherit;
            font-size: 0.95rem;
            resize: vertical;
        }

        .email-section {
            background: #e8f5e8;
            padding: 1.5rem;
            border-radius: 8px;
            margin-top: 2rem;
            border: 2px solid #27ae60;
        }

        .email-section .form-group {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .email-section input {
            flex: 1;
            padding: 0.75rem;
            border: 1px solid #27ae60;
            border-radius: 4px;
        }

        .email-section button {
            padding: 0.75rem 1.5rem;
            background: #27ae60;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
        }

        .email-section button:hover {
            background: #229954;
        }

        .submit-btn {
            background: #3498db;
            color: white;
            padding: 1rem 2rem;
            border: none;
            border-radius: 6px;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            width: 100%;
            margin-top: 1rem;
            transition: background-color 0.3s;
        }

        .submit-btn:hover {
            background: #2980b9;
        }

        .submit-btn:disabled {
            background: #6c757d;
            cursor: not-allowed;
        }

        .status-message, .submission-message {
            margin-top: 0.5rem;
            padding: 0.5rem;
            border-radius: 4px;
            font-weight: bold;
        }

        .status-message.success, .submission-message.success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .status-message.error, .submission-message.error {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        @media (max-width: 768px) {
            .experiment-container {
                padding: 1rem;
            }

            h1 {
                font-size: 2rem;
            }

            .data-table table {
                font-size: 0.9rem;
            }

            .email-section .form-group {
                flex-direction: column;
                align-items: stretch;
            }
        }
    </style>

    <script>
        // Global variables
        let vitaminChart = null;

        // Load EmailJS
        function loadEmailJS() {
            return new Promise((resolve, reject) => {
                if (window.emailjs) {
                    resolve();
                    return;
                }
                
                const script = document.createElement('script');
                script.src = 'https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js';
                script.onload = () => {
                    window.emailjs.init('ct_s19oZHppLy9BlW');
                    resolve();
                };
                script.onerror = reject;
                document.head.appendChild(script);
            });
        }

        // Load Chart.js library
        function loadChartJS() {
            return new Promise((resolve, reject) => {
                if (window.Chart) {
                    resolve();
                    return;
                }
                
                const script = document.createElement('script');
                script.src = 'https://cdn.jsdelivr.net/npm/chart.js';
                script.onload = resolve;
                script.onerror = reject;
                document.head.appendChild(script);
            });
        }

        // Create or update the bar chart
        function updateChart(labels, data, colors) {
            const canvas = document.getElementById('vitaminChart');
            if (!canvas) return;
            
            const ctx = canvas.getContext('2d');
            
            // Destroy existing chart if it exists
            if (vitaminChart) {
                vitaminChart.destroy();
            }
            
            // Create new chart
            vitaminChart = new window.Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Relative Vitamin C Content',
                        data: data,
                        backgroundColor: colors.map(color => color + '80'),
                        borderColor: colors,
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    aspectRatio: 2,
                    plugins: {
                        title: {
                            display: true,
                            text: 'Vitamin C Content Comparison',
                            font: { size: 16, weight: 'bold' }
                        },
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Relative Content (higher = more vitamin C)'
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'Fruit Juice Type'
                            }
                        }
                    }
                }
            });
        }

        // Calculate relative vitamin C content and update chart
        function calculateResults() {
            const controlDropsEl = document.getElementById('control-drops');
            const controlDrops = parseFloat(controlDropsEl?.value || '0') || 0;
            const juiceLabels = ['Lemon', 'Apple', 'Orange', 'Grapefruit/Pineapple'];
            const juiceData = [];
            const juiceColors = ['#e74c3c', '#f39c12', '#27ae60', '#3498db'];
            
            if (controlDrops > 0) {
                const juiceInputs = document.querySelectorAll('.juice-data');
                juiceInputs.forEach((input) => {
                    const juiceDrops = parseFloat(input.value) || 0;
                    const juiceType = input.getAttribute('data-juice');
                    const relativeCell = document.getElementById(juiceType + '-relative');
                    
                    if (juiceDrops > 0 && relativeCell) {
                        const relativeContent = (controlDrops / juiceDrops).toFixed(2);
                        relativeCell.textContent = relativeContent + 'x';
                        juiceData.push(parseFloat(relativeContent));
                        
                        const value = parseFloat(relativeContent);
                        if (value > 1.5) {
                            relativeCell.style.color = '#27ae60';
                            relativeCell.style.fontWeight = 'bold';
                        } else if (value > 0.8) {
                            relativeCell.style.color = '#f39c12';
                            relativeCell.style.fontWeight = 'bold';
                        } else {
                            relativeCell.style.color = '#e74c3c';
                            relativeCell.style.fontWeight = 'bold';
                        }
                    } else {
                        juiceData.push(0);
                    }
                });
                
                updateChart(juiceLabels, juiceData, juiceColors);
            }
        }

        // Initialize page
        document.addEventListener('DOMContentLoaded', function() {
            // Add event listeners for automatic calculation
            const allInputs = document.querySelectorAll('#control-drops, .juice-data');
            allInputs.forEach(input => {
                input.addEventListener('input', calculateResults);
            });

            // Load Chart.js and initialize empty chart
            loadChartJS().then(() => {
                updateChart(['Lemon', 'Apple', 'Orange', 'Grapefruit/Pineapple'], [0, 0, 0, 0], ['#e74c3c', '#f39c12', '#27ae60', '#3498db']);
            }).catch(error => {
                console.error('Failed to load Chart.js:', error);
            });

            // Email functionality
            const emailInput = document.getElementById('student-email');
            const emailStatus = document.getElementById('email-status');
            const saveEmailButton = document.getElementById('save-email');
            const submitButton = document.getElementById('submit-results');
            
            if (saveEmailButton && emailInput && emailStatus) {
                saveEmailButton.addEventListener('click', function() {
                    const email = emailInput.value.trim();
                    if (email && email.includes('@')) {
                        emailStatus.textContent = 'Email saved!';
                        emailStatus.style.color = '#27ae60';
                    } else {
                        emailStatus.textContent = 'Please enter a valid email address.';
                        emailStatus.style.color = '#e74c3c';
                    }
                });
            }

            if (submitButton && emailInput && emailStatus) {
                submitButton.addEventListener('click', async function() {
                    const email = emailInput.value.trim();
                    if (!email || !email.includes('@')) {
                        alert('Please enter a valid email address first.');
                        return;
                    }

                    submitButton.disabled = true;
                    submitButton.textContent = 'Submitting...';

                    try {
                        await loadEmailJS();
                        
                        const templateParams = {
                            to_email: email,
                            student_name: document.getElementById('studentName')?.value || 'Student',
                            student_email: email,
                            experiment_title: 'Experiment 14.1: Comparing Vitamin C in Fruit Juices',
                            hypothesis: document.getElementById('hypothesis-text')?.value || 'No hypothesis provided',
                            control_drops: document.getElementById('control-drops')?.value || '0',
                            lemon_drops: document.getElementById('lemon-drops')?.value || '0',
                            apple_drops: document.getElementById('apple-drops')?.value || '0',
                            orange_drops: document.getElementById('orange-drops')?.value || '0',
                            grapefruit_drops: document.getElementById('grapefruit-drops')?.value || '0',
                            lemon_relative: document.getElementById('lemon-relative')?.textContent || 'N/A',
                            apple_relative: document.getElementById('apple-relative')?.textContent || 'N/A',
                            orange_relative: document.getElementById('orange-relative')?.textContent || 'N/A',
                            grapefruit_relative: document.getElementById('grapefruit-relative')?.textContent || 'N/A',
                            conclusions: document.getElementById('conclusions-text')?.value || 'No conclusions provided',
                            subject: `Experiment 14.1 - ${document.getElementById('studentName')?.value || 'Student'}`
                        };

                        await window.emailjs.send('service_ot1jg6s', 'template_y556rhr', templateParams);
                        
                        emailStatus.textContent = 'Results submitted successfully!';
                        emailStatus.style.color = '#27ae60';
                        submitButton.textContent = 'Submitted Successfully';
                    } catch (error) {
                        console.error('Error submitting results:', error);
                        emailStatus.textContent = 'Error submitting results. Please try again.';
                        emailStatus.style.color = '#e74c3c';
                        submitButton.disabled = false;
                        submitButton.textContent = 'Submit Results';
                    }
                });
            }
        });
    </script>
</Layout>
