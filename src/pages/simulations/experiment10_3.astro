---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Experiment 10.3: Infrared Light">
    <main class="container mx-auto px-4 py-8">
        <div class="experiment-header">
            <h1 class="text-3xl font-bold text-center text-blue-700 mb-2">EXPERIMENT 10.3</h1>
            <h2 class="text-2xl font-bold text-center text-blue-700 mb-8">INFRARED LIGHT</h2>
        </div>

        <!-- Student Information Section -->
        <section id="student-info" class="mb-8 p-6 bg-gray-50 rounded-lg shadow-md">
            <h3 class="text-xl font-bold text-blue-700 mb-4">STUDENT INFORMATION</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="studentName" class="block text-sm font-medium text-gray-700 mb-1">Name:</label>
                    <input type="text" id="studentName" class="w-full p-2 border border-gray-300 rounded" placeholder="Your Name">
                </div>
                <div>
                    <label for="studentDate" class="block text-sm font-medium text-gray-700 mb-1">Date:</label>
                    <input type="date" id="studentDate" class="w-full p-2 border border-gray-300 rounded">
                </div>
                <div>
                    <label for="studentEmail" class="block text-sm font-medium text-gray-700 mb-1">Email:</label>
                    <input type="email" id="studentEmail" class="w-full p-2 border border-gray-300 rounded" placeholder="your.email@example.com">
                </div>
                <div>
                    <label for="teacherEmail" class="block text-sm font-medium text-gray-700 mb-1">Teacher's Email:</label>
                    <input type="email" id="teacherEmail" class="w-full p-2 border border-gray-300 rounded" value="chuck@c00lnerd.com" readonly>
                </div>
            </div>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">PURPOSE:</h3>
            <p class="mb-4">To investigate the properties of infrared light and understand how it transfers heat energy.</p>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">BACKGROUND:</h3>
            <p class="mb-4">
                Infrared (IR) light is a type of electromagnetic radiation with wavelengths longer than visible light but shorter than microwaves.
                Though invisible to the human eye, we can feel infrared radiation as heat. The sun emits a significant amount of infrared radiation,
                which warms the Earth's surface. Many everyday objects emit infrared radiation, with warmer objects emitting more than cooler ones.
            </p>
            <p class="mb-4">
                Infrared light is used in various applications, including thermal imaging cameras, remote controls, night vision equipment,
                and heat lamps. In this experiment, we will explore how infrared radiation transfers heat and how different materials
                interact with infrared light.
            </p>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">MATERIALS:</h3>
            <ul class="list-disc pl-8 mb-4">
                <li>Two identical thermometers</li>
                <li>Two identical glass jars with lids</li>
                <li>Black construction paper</li>
                <li>White construction paper</li>
                <li>Scissors</li>
                <li>Tape</li>
                <li>Sunny location or heat lamp</li>
                <li>Timer or stopwatch</li>
                <li>Optional: Infrared thermometer</li>
                <li>Optional: Remote control and digital camera or smartphone</li>
            </ul>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">SAFETY PRECAUTIONS:</h3>
            <ul class="list-disc pl-8 mb-4">
                <li>Be careful when handling glass jars</li>
                <li>If using a heat lamp, do not touch it when hot</li>
                <li>Do not look directly at the sun</li>
                <li>Use caution with scissors</li>
            </ul>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">PROCEDURE:</h3>
            <h4 class="text-lg font-semibold mb-2">Part 1: Absorption of Infrared Light</h4>
            <ol class="list-decimal pl-8 mb-4">
                <li class="mb-2">
                    Cut two circles from the construction paper—one black and one white—that are large enough to line the bottom of the jars.
                </li>
                <li class="mb-2">
                    Place the black paper circle at the bottom of one jar and the white paper circle at the bottom of the other jar.
                </li>
                <li class="mb-2">
                    Place one thermometer in each jar and secure the lids.
                </li>
                <li class="mb-2">
                    Record the initial temperature in both jars.
                </li>
                <li class="mb-2">
                    Place both jars in direct sunlight or under a heat lamp, ensuring they receive equal exposure.
                </li>
                <li class="mb-2">
                    Record the temperature in each jar every 5 minutes for 30 minutes.
                </li>
                <li class="mb-2">
                    Graph your results, with time on the x-axis and temperature on the y-axis.
                </li>
            </ol>

            <h4 class="text-lg font-semibold mb-2">Part 2: Detecting Infrared Light (Optional)</h4>
            <ol class="list-decimal pl-8 mb-4">
                <li class="mb-2">
                    In a darkened room, point a remote control at a digital camera or smartphone camera.
                </li>
                <li class="mb-2">
                    Press buttons on the remote control while looking at the camera screen.
                </li>
                <li class="mb-2">
                    Observe and record what you see on the camera screen when you press the remote control buttons.
                </li>
                <li class="mb-2">
                    If available, use an infrared thermometer to measure the temperature of various objects in the room.
                    Compare these readings with how the objects feel to the touch.
                </li>
            </ol>
        </section>

        <!-- Data Collection Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700 mb-4">DATA COLLECTION:</h3>
            
            <h4 class="text-lg font-semibold mb-2">Part 1: Temperature Measurements</h4>
            <div class="overflow-x-auto mb-6">
                <table class="min-w-full bg-white border border-gray-300">
                    <thead>
                        <tr class="bg-gray-100">
                            <th class="border border-gray-300 px-4 py-2">Time (minutes)</th>
                            <th class="border border-gray-300 px-4 py-2">Temperature in Jar with Black Paper (°C)</th>
                            <th class="border border-gray-300 px-4 py-2">Temperature in Jar with White Paper (°C)</th>
                            <th class="border border-gray-300 px-4 py-2">Temperature Difference (°C)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="border border-gray-300 px-4 py-2">0 (Initial)</td>
                            <td class="border border-gray-300 px-4 py-2">
                                <input type="number" id="blackInitial" class="w-full p-1 border border-gray-200 rounded" step="0.1">
                            </td>
                            <td class="border border-gray-300 px-4 py-2">
                                <input type="number" id="whiteInitial" class="w-full p-1 border border-gray-200 rounded" step="0.1">
                            </td>
                            <td class="border border-gray-300 px-4 py-2" id="diffInitial">-</td>
                        </tr>
                        <tr>
                            <td class="border border-gray-300 px-4 py-2">5</td>
                            <td class="border border-gray-300 px-4 py-2">
                                <input type="number" id="black5" class="w-full p-1 border border-gray-200 rounded" step="0.1">
                            </td>
                            <td class="border border-gray-300 px-4 py-2">
                                <input type="number" id="white5" class="w-full p-1 border border-gray-200 rounded" step="0.1">
                            </td>
                            <td class="border border-gray-300 px-4 py-2" id="diff5">-</td>
                        </tr>
                        <tr>
                            <td class="border border-gray-300 px-4 py-2">10</td>
                            <td class="border border-gray-300 px-4 py-2">
                                <input type="number" id="black10" class="w-full p-1 border border-gray-200 rounded" step="0.1">
                            </td>
                            <td class="border border-gray-300 px-4 py-2">
                                <input type="number" id="white10" class="w-full p-1 border border-gray-200 rounded" step="0.1">
                            </td>
                            <td class="border border-gray-300 px-4 py-2" id="diff10">-</td>
                        </tr>
                        <tr>
                            <td class="border border-gray-300 px-4 py-2">15</td>
                            <td class="border border-gray-300 px-4 py-2">
                                <input type="number" id="black15" class="w-full p-1 border border-gray-200 rounded" step="0.1">
                            </td>
                            <td class="border border-gray-300 px-4 py-2">
                                <input type="number" id="white15" class="w-full p-1 border border-gray-200 rounded" step="0.1">
                            </td>
                            <td class="border border-gray-300 px-4 py-2" id="diff15">-</td>
                        </tr>
                        <tr>
                            <td class="border border-gray-300 px-4 py-2">20</td>
                            <td class="border border-gray-300 px-4 py-2">
                                <input type="number" id="black20" class="w-full p-1 border border-gray-200 rounded" step="0.1">
                            </td>
                            <td class="border border-gray-300 px-4 py-2">
                                <input type="number" id="white20" class="w-full p-1 border border-gray-200 rounded" step="0.1">
                            </td>
                            <td class="border border-gray-300 px-4 py-2" id="diff20">-</td>
                        </tr>
                        <tr>
                            <td class="border border-gray-300 px-4 py-2">25</td>
                            <td class="border border-gray-300 px-4 py-2">
                                <input type="number" id="black25" class="w-full p-1 border border-gray-200 rounded" step="0.1">
                            </td>
                            <td class="border border-gray-300 px-4 py-2">
                                <input type="number" id="white25" class="w-full p-1 border border-gray-200 rounded" step="0.1">
                            </td>
                            <td class="border border-gray-300 px-4 py-2" id="diff25">-</td>
                        </tr>
                        <tr>
                            <td class="border border-gray-300 px-4 py-2">30</td>
                            <td class="border border-gray-300 px-4 py-2">
                                <input type="number" id="black30" class="w-full p-1 border border-gray-200 rounded" step="0.1">
                            </td>
                            <td class="border border-gray-300 px-4 py-2">
                                <input type="number" id="white30" class="w-full p-1 border border-gray-200 rounded" step="0.1">
                            </td>
                            <td class="border border-gray-300 px-4 py-2" id="diff30">-</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="mb-6">
                <button id="calculateDifferences" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                    Calculate Temperature Differences
                </button>
            </div>

            <div class="mb-6">
                <canvas id="temperatureChart" width="400" height="200"></canvas>
            </div>

            <h4 class="text-lg font-semibold mb-2">Part 2: Infrared Detection Observations</h4>
            <div class="mb-4">
                <label for="remoteObservation" class="block text-sm font-medium text-gray-700 mb-1">
                    What did you observe on the camera screen when pressing the remote control buttons?
                </label>
                <textarea id="remoteObservation" rows="3" class="w-full p-2 border border-gray-300 rounded"></textarea>
            </div>

            <div class="mb-4">
                <label for="irThermometerObservations" class="block text-sm font-medium text-gray-700 mb-1">
                    If you used an infrared thermometer, record your measurements and observations:
                </label>
                <textarea id="irThermometerObservations" rows="3" class="w-full p-2 border border-gray-300 rounded"></textarea>
            </div>
        </section>

        <!-- Analysis Questions Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700 mb-4">ANALYSIS QUESTIONS:</h3>
            
            <div class="mb-4">
                <label for="question1" class="block text-sm font-medium text-gray-700 mb-1">
                    1. Which jar showed a greater temperature increase? Explain why this occurred in terms of absorption and reflection of infrared light.
                </label>
                <textarea id="question1" rows="3" class="w-full p-2 border border-gray-300 rounded"></textarea>
            </div>
            
            <div class="mb-4">
                <label for="question2" class="block text-sm font-medium text-gray-700 mb-1">
                    2. How does the color of an object affect its ability to absorb infrared radiation? Provide examples from your experiment.
                </label>
                <textarea id="question2" rows="3" class="w-full p-2 border border-gray-300 rounded"></textarea>
            </div>
            
            <div class="mb-4">
                <label for="question3" class="block text-sm font-medium text-gray-700 mb-1">
                    3. If you conducted the remote control observation, explain how the digital camera was able to detect the infrared light when your eyes could not.
                </label>
                <textarea id="question3" rows="3" class="w-full p-2 border border-gray-300 rounded"></textarea>
            </div>
            
            <div class="mb-4">
                <label for="question4" class="block text-sm font-medium text-gray-700 mb-1">
                    4. Describe three real-world applications of infrared technology and explain how they work.
                </label>
                <textarea id="question4" rows="3" class="w-full p-2 border border-gray-300 rounded"></textarea>
            </div>
            
            <div class="mb-4">
                <label for="question5" class="block text-sm font-medium text-gray-700 mb-1">
                    5. How is the greenhouse effect related to infrared radiation? Explain the connection between this experiment and global warming.
                </label>
                <textarea id="question5" rows="3" class="w-full p-2 border border-gray-300 rounded"></textarea>
            </div>
        </section>

        <!-- Conclusion Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700 mb-4">CONCLUSION:</h3>
            <div class="mb-4">
                <label for="conclusion" class="block text-sm font-medium text-gray-700 mb-1">
                    Summarize what you learned about infrared light from this experiment. Include your key findings and how they relate to the properties of infrared radiation.
                </label>
                <textarea id="conclusion" rows="5" class="w-full p-2 border border-gray-300 rounded"></textarea>
            </div>
        </section>

        <!-- Submit Results Section -->
        <section class="mb-8">
            <div id="submissionSection" class="p-6 bg-gray-50 rounded-lg shadow-md">
                <h3 class="text-xl font-bold text-blue-700 mb-4">SUBMIT YOUR RESULTS:</h3>
                <p class="mb-4">Click the button below to submit your experiment results to your teacher.</p>
                <button id="submitResults" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                    Submit to Teacher
                </button>
                <div id="submissionMessage" class="mt-4 hidden"></div>
            </div>
        </section>
    </main>
</Layout>

<script is:inline>
    // Load EmailJS
    (function() {
        emailjs.init("ct_s19oZHppLy9BlW");
    })();

    // Initialize variables and set up event listeners when DOM is loaded
    document.addEventListener('DOMContentLoaded', function() {
        // Check for stored email and populate fields
        const storedEmail = localStorage.getItem('studentEmail');
        const storedName = localStorage.getItem('studentName');
        
        if (storedEmail) {
            document.getElementById('studentEmail').value = storedEmail;
        }
        
        if (storedName) {
            document.getElementById('studentName').value = storedName;
        }
        
        // Set current date if not already set
        if (!document.getElementById('studentDate').value) {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('studentDate').value = today;
        }

        // Add event listener for the calculate differences button
        const calculateButton = document.getElementById('calculateDifferences');
        if (calculateButton) {
            calculateButton.addEventListener('click', calculateAndDisplayDifferences);
        }

        // Add event listener for the submit results button
        const submitButton = document.getElementById('submitResults');
        if (submitButton) {
            submitButton.addEventListener('click', submitResults);
        }

        // Load Chart.js
        loadScript('https://cdn.jsdelivr.net/npm/chart.js', function() {
            // Initialize empty chart
            initializeChart();
        });
    });

    // Function to load external scripts
    function loadScript(url, callback) {
        const script = document.createElement('script');
        script.type = 'text/javascript';
        script.src = url;
        script.onload = callback;
        document.head.appendChild(script);
    }

    // Function to calculate temperature differences
    function calculateAndDisplayDifferences() {
        const times = [0, 5, 10, 15, 20, 25, 30];
        const blackTemps = [];
        const whiteTemps = [];
        const differences = [];

        // Collect all temperature values
        times.forEach(time => {
            const timeStr = time === 0 ? 'Initial' : time.toString();
            const blackTemp = parseFloat(document.getElementById(`black${timeStr}`).value) || 0;
            const whiteTemp = parseFloat(document.getElementById(`white${timeStr}`).value) || 0;
            const diff = blackTemp - whiteTemp;
            
            blackTemps.push(blackTemp);
            whiteTemps.push(whiteTemp);
            differences.push(diff);
            
            // Display the difference
            document.getElementById(`diff${timeStr}`).textContent = diff.toFixed(1);
        });

        // Update the chart
        updateChart(times, blackTemps, whiteTemps);
    }

    // Function to initialize the temperature chart
    function initializeChart() {
        if (typeof Chart !== 'undefined') {
            const ctx = document.getElementById('temperatureChart').getContext('2d');
            window.tempChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: [0, 5, 10, 15, 20, 25, 30],
                    datasets: [
                        {
                            label: 'Black Paper Jar (°C)',
                            data: [],
                            borderColor: 'rgba(0, 0, 0, 1)',
                            backgroundColor: 'rgba(0, 0, 0, 0.1)',
                            tension: 0.1
                        },
                        {
                            label: 'White Paper Jar (°C)',
                            data: [],
                            borderColor: 'rgba(169, 169, 169, 1)',
                            backgroundColor: 'rgba(169, 169, 169, 0.1)',
                            tension: 0.1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            beginAtZero: false,
                            title: {
                                display: true,
                                text: 'Temperature (°C)'
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'Time (minutes)'
                            }
                        }
                    }
                }
            });
        }
    }

    // Function to update the chart with new data
    function updateChart(times, blackTemps, whiteTemps) {
        if (window.tempChart) {
            window.tempChart.data.datasets[0].data = blackTemps;
            window.tempChart.data.datasets[1].data = whiteTemps;
            window.tempChart.update();
        }
    }

    // Function to collect all data for submission
    function collectExperimentData() {
        // Collect student information
        const studentName = document.getElementById('studentName').value;
        const studentDate = document.getElementById('studentDate').value;
        const studentEmail = document.getElementById('studentEmail').value;
        const teacherEmail = document.getElementById('teacherEmail').value;

        // Save student email and name to localStorage
        if (studentEmail) {
            localStorage.setItem('studentEmail', studentEmail);
        }
        if (studentName) {
            localStorage.setItem('studentName', studentName);
        }

        // Collect temperature data
        const temperatureData = {};
        const times = [0, 5, 10, 15, 20, 25, 30];
        times.forEach(time => {
            const timeStr = time === 0 ? 'Initial' : time.toString();
            const blackTemp = document.getElementById(`black${timeStr}`).value || 'N/A';
            const whiteTemp = document.getElementById(`white${timeStr}`).value || 'N/A';
            const diff = document.getElementById(`diff${timeStr}`).textContent || 'N/A';
            
            temperatureData[`Time ${time} min`] = {
                'Black Paper Jar': blackTemp,
                'White Paper Jar': whiteTemp,
                'Difference': diff
            };
        });

        // Collect observations
        const remoteObservation = document.getElementById('remoteObservation').value;
        const irThermometerObservations = document.getElementById('irThermometerObservations').value;

        // Collect analysis answers
        const analysisAnswers = {
            'Question 1': document.getElementById('question1').value,
            'Question 2': document.getElementById('question2').value,
            'Question 3': document.getElementById('question3').value,
            'Question 4': document.getElementById('question4').value,
            'Question 5': document.getElementById('question5').value
        };

        // Collect conclusion
        const conclusion = document.getElementById('conclusion').value;

        // Compile all data
        return {
            studentInfo: {
                name: studentName,
                date: studentDate,
                email: studentEmail,
                teacherEmail: teacherEmail
            },
            experimentData: {
                temperatureData: temperatureData,
                remoteObservation: remoteObservation,
                irThermometerObservations: irThermometerObservations
            },
            analysisAnswers: analysisAnswers,
            conclusion: conclusion
        };
    }

    // Function to submit results via EmailJS
    function submitResults() {
        const data = collectExperimentData();
        const submissionMessage = document.getElementById('submissionMessage');
        
        if (!data.studentInfo.name || !data.studentInfo.email) {
            showSubmissionMessage('Please enter your name and email before submitting.', 'error');
            return;
        }

        // Format data for email with proven parameter mapping
        const emailParams = {
            student_name: data.studentInfo.name || data.studentInfo.email?.split('@')[0] || 'Student',
            student_email: data.studentInfo.email,
            experiment_title: 'Experiment 10.3: Infrared Light',
            hypothesis: data.hypothesis || 'No hypothesis provided',
            missing_elements: `Observations: ${data.observations ? '✓' : '✗'}, Analysis: ${data.analysisAnswers?.length > 0 ? '✓' : '✗'}, Conclusion: ${data.conclusion ? '✓' : '✗'}`,
            conclusion: `EXPERIMENT 10.3: INFRARED LIGHT - STUDENT RESULTS

Student Information:
• Name: ${data.studentInfo.name || data.studentInfo.email?.split('@')[0] || 'Student'}
• Email: ${data.studentInfo.email}

Experiment Results:

Hypothesis:
${data.hypothesis || 'No hypothesis provided'}

Observations:
${data.observations || 'No observations recorded'}

Analysis Questions:
• Question 1: ${data.analysis1 || 'Not answered'}
• Question 2: ${data.analysis2 || 'Not answered'}
• Question 3: ${data.analysis3 || 'Not answered'}
• Question 4: ${data.analysis4 || 'Not answered'}
• Question 5: ${data.analysis5 || 'Not answered'}

Conclusion:
${data.conclusion || 'No conclusion provided'}

---
This is an automated submission from the C00lnerd Experiment System.`,
            subject: `Physical Science Experiment 10.3 Results - ${data.studentInfo.name || data.studentInfo.email?.split('@')[0] || 'Student'}`
        };

        // Show sending message
        showSubmissionMessage('Sending your results...', 'info');

        // Send email using EmailJS
        emailjs.send('service_ot1jg6s', 'template_y556rhr', emailParams)
            .then(function(response) {
                console.log('SUCCESS!', response.status, response.text);
                showSubmissionMessage('Your results have been submitted successfully!', 'success');
            }, function(error) {
                console.log('FAILED...', error);
                showSubmissionMessage('Failed to submit results. Please try again later.', 'error');
            });
    }

    // Function to show submission messages
    function showSubmissionMessage(message, type) {
        const submissionMessage = document.getElementById('submissionMessage');
        if (submissionMessage) {
            submissionMessage.textContent = message;
            submissionMessage.className = 'mt-4 p-3 rounded';
            
            // Add appropriate styling based on message type
            if (type === 'error') {
                submissionMessage.classList.add('bg-red-100', 'text-red-700');
            } else if (type === 'success') {
                submissionMessage.classList.add('bg-green-100', 'text-green-700');
            } else {
                submissionMessage.classList.add('bg-blue-100', 'text-blue-700');
            }
            
            submissionMessage.classList.remove('hidden');
        }
    }
</script>
