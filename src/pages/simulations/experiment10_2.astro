---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Experiment 10.2: Ultraviolet Light">
    <main class="container mx-auto px-4 py-8">
        <div class="experiment-header">
            <h1 class="text-3xl font-bold text-center text-blue-700 mb-2">EXPERIMENT 10.2</h1>
            <h2 class="text-2xl font-bold text-center text-blue-700 mb-8">ULTRAVIOLET LIGHT</h2>
        </div>

        <!-- Student Information Section -->
        <section class="mb-8 p-6 bg-gray-50 rounded-lg shadow-md">
            <h3 class="text-xl font-bold text-blue-700 mb-4">STUDENT INFORMATION</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="studentName" class="block text-sm font-medium text-gray-700 mb-2">Student Name:</label>
                    <input type="text" id="studentName" class="w-full p-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Enter your full name" required>
                </div>
                <div>
                    <label for="studentEmail" class="block text-sm font-medium text-gray-700 mb-2">Student Email:</label>
                    <input type="email" id="studentEmail" class="w-full p-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Enter your email address" required>
                </div>
            </div>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">PURPOSE:</h3>
            <p class="mb-4">To investigate the properties of ultraviolet light and understand how it affects different materials.</p>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">BACKGROUND:</h3>
            <p class="mb-4">
                Ultraviolet (UV) light is a type of electromagnetic radiation with wavelengths shorter than visible light but longer than X-rays. 
                UV light is invisible to the human eye, but it can cause certain materials to fluoresce (emit visible light). 
                The sun emits UV radiation, which is partially blocked by the Earth's ozone layer. 
                UV light is categorized into three types based on wavelength: UVA (315-400 nm), UVB (280-315 nm), and UVC (100-280 nm).
            </p>
            <p class="mb-4">
                While UV light has beneficial uses like vitamin D production in our skin, sterilization, and forensic analysis, 
                excessive exposure can be harmful, causing sunburn, premature aging, and increasing the risk of skin cancer.
                In this experiment, we will explore how UV light interacts with different materials and observe fluorescence.
            </p>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">MATERIALS:</h3>
            <ul class="list-disc pl-8 mb-4">
                <li>UV flashlight (blacklight)</li>
                <li>Various household items to test:
                    <ul class="list-disc pl-8">
                        <li>White paper</li>
                        <li>White cotton fabric</li>
                        <li>Laundry detergent</li>
                        <li>Tonic water</li>
                        <li>Highlighter markers</li>
                        <li>White/light-colored flowers</li>
                        <li>Petroleum jelly</li>
                        <li>Extra virgin olive oil</li>
                        <li>Banana (ripe and green)</li>
                    </ul>
                </li>
                <li>Sunscreen (SPF 30 or higher)</li>
                <li>Clear plastic or glass containers</li>
                <li>Darkened room</li>
            </ul>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">SAFETY PRECAUTIONS:</h3>
            <ul class="list-disc pl-8 mb-4">
                <li>Never look directly at a UV light source</li>
                <li>Limit exposure of skin to UV light</li>
                <li>Wear protective eyewear if available</li>
                <li>Keep UV light away from eyes</li>
            </ul>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">PROCEDURE:</h3>
            <ol class="list-decimal pl-8 mb-4">
                <li class="mb-2">
                    Set up your experiment in a darkened room to better observe fluorescence effects.
                </li>
                <li class="mb-2">
                    Draw a design or write a message on white paper using a highlighter marker.
                </li>
                <li class="mb-2">
                    Let the ink dry completely, then observe the paper under normal light.
                </li>
                <li class="mb-2">
                    Turn off the lights and shine the UV flashlight on the paper. Record your observations.
                </li>
                <li class="mb-2">
                    Place a small amount of laundry detergent in a clear container and observe it under UV light. Record your observations.
                </li>
                <li class="mb-2">
                    Pour some tonic water into a clear container and observe it under UV light. Record your observations.
                </li>
                <li class="mb-2">
                    Apply a small amount of petroleum jelly on a piece of paper and observe it under UV light. Record your observations.
                </li>
                <li class="mb-2">
                    Pour a small amount of extra virgin olive oil into a clear container and observe it under UV light. Record your observations.
                </li>
                <li class="mb-2">
                    Examine both ripe and green bananas under UV light. Record your observations.
                </li>
                <li class="mb-2">
                    Apply a small amount of sunscreen to a piece of paper, leaving part of the paper uncovered. Shine the UV light on both areas and record your observations.
                </li>
                <li class="mb-2">
                    Examine white or light-colored flowers under UV light. Record your observations.
                </li>
                <li class="mb-2">
                    Test any other household items you're curious about and record your findings.
                </li>
            </ol>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">DATA:</h3>
            <div class="overflow-x-auto">
                <table class="min-w-full bg-purple-100 border border-purple-300">
                    <thead>
                        <tr class="bg-purple-200">
                            <th class="py-2 px-4 border-b border-purple-300 text-center">Material</th>
                            <th class="py-2 px-4 border-b border-purple-300 text-center">Appearance Under Normal Light</th>
                            <th class="py-2 px-4 border-b border-purple-300 text-center">Appearance Under UV Light</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="py-2 px-4 border-b border-purple-300">Highlighter on paper</td>
                            <td class="py-2 px-4 border-b border-purple-300">
                                <textarea id="highlighter-normal" rows="2" class="w-full p-2 border border-gray-300 rounded"></textarea>
                            </td>
                            <td class="py-2 px-4 border-b border-purple-300">
                                <textarea id="highlighter-uv" rows="2" class="w-full p-2 border border-gray-300 rounded"></textarea>
                            </td>
                        </tr>
                        <tr>
                            <td class="py-2 px-4 border-b border-purple-300">Laundry detergent</td>
                            <td class="py-2 px-4 border-b border-purple-300">
                                <textarea id="detergent-normal" rows="2" class="w-full p-2 border border-gray-300 rounded"></textarea>
                            </td>
                            <td class="py-2 px-4 border-b border-purple-300">
                                <textarea id="detergent-uv" rows="2" class="w-full p-2 border border-gray-300 rounded"></textarea>
                            </td>
                        </tr>
                        <tr>
                            <td class="py-2 px-4 border-b border-purple-300">Tonic water</td>
                            <td class="py-2 px-4 border-b border-purple-300">
                                <textarea id="tonic-normal" rows="2" class="w-full p-2 border border-gray-300 rounded"></textarea>
                            </td>
                            <td class="py-2 px-4 border-b border-purple-300">
                                <textarea id="tonic-uv" rows="2" class="w-full p-2 border border-gray-300 rounded"></textarea>
                            </td>
                        </tr>
                        <tr>
                            <td class="py-2 px-4 border-b border-purple-300">Petroleum jelly</td>
                            <td class="py-2 px-4 border-b border-purple-300">
                                <textarea id="jelly-normal" rows="2" class="w-full p-2 border border-gray-300 rounded"></textarea>
                            </td>
                            <td class="py-2 px-4 border-b border-purple-300">
                                <textarea id="jelly-uv" rows="2" class="w-full p-2 border border-gray-300 rounded"></textarea>
                            </td>
                        </tr>
                        <tr>
                            <td class="py-2 px-4 border-b border-purple-300">Extra virgin olive oil</td>
                            <td class="py-2 px-4 border-b border-purple-300">
                                <textarea id="olive-oil-normal" rows="2" class="w-full p-2 border border-gray-300 rounded"></textarea>
                            </td>
                            <td class="py-2 px-4 border-b border-purple-300">
                                <textarea id="olive-oil-uv" rows="2" class="w-full p-2 border border-gray-300 rounded"></textarea>
                            </td>
                        </tr>
                        <tr>
                            <td class="py-2 px-4 border-b border-purple-300">Ripe banana</td>
                            <td class="py-2 px-4 border-b border-purple-300">
                                <textarea id="ripe-banana-normal" rows="2" class="w-full p-2 border border-gray-300 rounded"></textarea>
                            </td>
                            <td class="py-2 px-4 border-b border-purple-300">
                                <textarea id="ripe-banana-uv" rows="2" class="w-full p-2 border border-gray-300 rounded"></textarea>
                            </td>
                        </tr>
                        <tr>
                            <td class="py-2 px-4 border-b border-purple-300">Green banana</td>
                            <td class="py-2 px-4 border-b border-purple-300">
                                <textarea id="green-banana-normal" rows="2" class="w-full p-2 border border-gray-300 rounded"></textarea>
                            </td>
                            <td class="py-2 px-4 border-b border-purple-300">
                                <textarea id="green-banana-uv" rows="2" class="w-full p-2 border border-gray-300 rounded"></textarea>
                            </td>
                        </tr>
                        <tr>
                            <td class="py-2 px-4 border-b border-purple-300">Sunscreen test</td>
                            <td class="py-2 px-4 border-b border-purple-300">
                                <textarea id="sunscreen-normal" rows="2" class="w-full p-2 border border-gray-300 rounded"></textarea>
                            </td>
                            <td class="py-2 px-4 border-b border-purple-300">
                                <textarea id="sunscreen-uv" rows="2" class="w-full p-2 border border-gray-300 rounded"></textarea>
                            </td>
                        </tr>
                        <tr>
                            <td class="py-2 px-4 border-b border-purple-300">Flowers</td>
                            <td class="py-2 px-4 border-b border-purple-300">
                                <textarea id="flowers-normal" rows="2" class="w-full p-2 border border-gray-300 rounded"></textarea>
                            </td>
                            <td class="py-2 px-4 border-b border-purple-300">
                                <textarea id="flowers-uv" rows="2" class="w-full p-2 border border-gray-300 rounded"></textarea>
                            </td>
                        </tr>
                        <tr>
                            <td class="py-2 px-4 border-b border-purple-300">Other item: <input type="text" id="other-item-name" class="w-full p-1 border border-gray-300 rounded"></td>
                            <td class="py-2 px-4 border-b border-purple-300">
                                <textarea id="other-normal" rows="2" class="w-full p-2 border border-gray-300 rounded"></textarea>
                            </td>
                            <td class="py-2 px-4 border-b border-purple-300">
                                <textarea id="other-uv" rows="2" class="w-full p-2 border border-gray-300 rounded"></textarea>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>



        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">ANALYSIS QUESTIONS:</h3>
            <ol class="list-decimal pl-8 mb-4">
                <li class="mb-4">
                    <p class="mb-2">What is fluorescence, and how does it relate to UV light?</p>
                    <textarea id="analysis-q1" rows="3" class="w-full p-2 border border-gray-300 rounded"></textarea>
                </li>
                <li class="mb-4">
                    <p class="mb-2">Why do some materials fluoresce under UV light while others don't?</p>
                    <textarea id="analysis-q2" rows="3" class="w-full p-2 border border-gray-300 rounded"></textarea>
                </li>
                <li class="mb-4">
                    <p class="mb-2">Based on your observations, how effective was the sunscreen at blocking UV light?</p>
                    <textarea id="analysis-q3" rows="3" class="w-full p-2 border border-gray-300 rounded"></textarea>
                </li>
                <li class="mb-4">
                    <p class="mb-2">How might insects and other animals perceive flowers differently than humans, based on your UV light observations?</p>
                    <textarea id="analysis-q4" rows="3" class="w-full p-2 border border-gray-300 rounded"></textarea>
                </li>
                <li class="mb-4">
                    <p class="mb-2">What are some practical applications of UV light in everyday life and various industries?</p>
                    <textarea id="analysis-q5" rows="3" class="w-full p-2 border border-gray-300 rounded"></textarea>
                </li>
            </ol>
        </section>

        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">CONCLUSIONS:</h3>
            <p class="mb-4">
                Summarize what you learned about UV light and fluorescence. Discuss how different materials interact with UV light 
                and why this is important in our daily lives. Include information about the protective role of sunscreen and the 
                ozone layer against harmful UV radiation.
            </p>
            <textarea id="conclusions" rows="6" class="w-full p-2 border border-gray-300 rounded"></textarea>
        </section>

        <!-- Email Submission Section -->
        <section id="submission-section" class="mb-8 p-6 bg-blue-50 rounded-lg shadow-md">
            <h3 class="text-xl font-bold text-blue-700 mb-4">SUBMIT YOUR RESULTS</h3>
            <p class="mb-4">Click the button below to submit your experiment results to your teacher.</p>
            <button id="submit-results" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                Submit to Teacher
            </button>
            <div id="submission-message" class="mt-4 hidden"></div>
        </section>
    </main>

    <!-- Load EmailJS before initializing -->
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js" is:inline></script>
    
    <script is:inline>
        // Initialize EmailJS
        document.addEventListener('DOMContentLoaded', function() {
            try {
                emailjs.init("ct_s19oZHppLy9BlW");
                console.log('EmailJS initialized');
            } catch (error) {
                console.error('Failed to initialize EmailJS:', error);
            }

            // Check for saved email in localStorage
            const savedEmail = localStorage.getItem('studentEmail');
            if (savedEmail) {
                const emailField = document.getElementById('studentEmail');
                if (emailField) emailField.value = savedEmail;
            }
        });



        // Email submission
        document.getElementById('submit-results').addEventListener('click', function() {
            // Get student information from input fields
            const studentName = document.getElementById('studentName')?.value?.trim() || 'Student';
            const studentEmail = document.getElementById('studentEmail')?.value?.trim() || 'chuck@c00lnerd.com';
            
            if (!studentName || !studentEmail) {
                showSubmissionMessage('Please enter your name and email address.', 'error');
                return;
            }
            
            // Save email to localStorage
            localStorage.setItem('studentEmail', studentEmail);
            
            // Collect data from all input fields
            const experimentData = {
                // Material observations
                highlighter_normal: document.getElementById('highlighter-normal').value,
                highlighter_uv: document.getElementById('highlighter-uv').value,
                detergent_normal: document.getElementById('detergent-normal').value,
                detergent_uv: document.getElementById('detergent-uv').value,
                tonic_normal: document.getElementById('tonic-normal').value,
                tonic_uv: document.getElementById('tonic-uv').value,
                jelly_normal: document.getElementById('jelly-normal').value,
                jelly_uv: document.getElementById('jelly-uv').value,
                ripe_banana_normal: document.getElementById('ripe-banana-normal').value,
                ripe_banana_uv: document.getElementById('ripe-banana-uv').value,
                green_banana_normal: document.getElementById('green-banana-normal').value,
                green_banana_uv: document.getElementById('green-banana-uv').value,
                sunscreen_normal: document.getElementById('sunscreen-normal').value,
                sunscreen_uv: document.getElementById('sunscreen-uv').value,
                flowers_normal: document.getElementById('flowers-normal').value,
                flowers_uv: document.getElementById('flowers-uv').value,
                other_item: document.getElementById('other-item-name').value,
                other_normal: document.getElementById('other-normal').value,
                other_uv: document.getElementById('other-uv').value,
                
                // Analysis questions
                analysis_q1: document.getElementById('analysis-q1').value,
                analysis_q2: document.getElementById('analysis-q2').value,
                analysis_q3: document.getElementById('analysis-q3').value,
                analysis_q4: document.getElementById('analysis-q4').value,
                analysis_q5: document.getElementById('analysis-q5').value,
                
                // Conclusions
                conclusions: document.getElementById('conclusions').value
            };
            
            // Send email with EmailJS
            showSubmissionMessage('Sending your results...', 'info');
            
            // Create comprehensive experiment data with all collected information
            const conclusionText = `
EXPERIMENT 10.2: ULTRAVIOLET LIGHT RESULTS

STUDENT: ${studentName}
DATE: ${new Date().toISOString().split('T')[0]}

MATERIAL OBSERVATIONS:
• Highlighter - Normal: ${experimentData.highlighter_normal || 'Not recorded'}
• Highlighter - UV: ${experimentData.highlighter_uv || 'Not recorded'}
• Detergent - Normal: ${experimentData.detergent_normal || 'Not recorded'}
• Detergent - UV: ${experimentData.detergent_uv || 'Not recorded'}
• Tonic Water - Normal: ${experimentData.tonic_normal || 'Not recorded'}
• Tonic Water - UV: ${experimentData.tonic_uv || 'Not recorded'}
• Petroleum Jelly - Normal: ${experimentData.jelly_normal || 'Not recorded'}
• Petroleum Jelly - UV: ${experimentData.jelly_uv || 'Not recorded'}
• Ripe Banana - Normal: ${experimentData.ripe_banana_normal || 'Not recorded'}
• Ripe Banana - UV: ${experimentData.ripe_banana_uv || 'Not recorded'}
• Green Banana - Normal: ${experimentData.green_banana_normal || 'Not recorded'}
• Green Banana - UV: ${experimentData.green_banana_uv || 'Not recorded'}
• Sunscreen - Normal: ${experimentData.sunscreen_normal || 'Not recorded'}
• Sunscreen - UV: ${experimentData.sunscreen_uv || 'Not recorded'}
• Flowers - Normal: ${experimentData.flowers_normal || 'Not recorded'}
• Flowers - UV: ${experimentData.flowers_uv || 'Not recorded'}
• Other Item (${experimentData.other_item || 'None'}) - Normal: ${experimentData.other_normal || 'Not recorded'}
• Other Item - UV: ${experimentData.other_uv || 'Not recorded'}

ANALYSIS QUESTIONS:
1. What is fluorescence, and how does it relate to UV light?
${experimentData.analysis_q1 || 'Not answered'}

2. Why do some materials fluoresce under UV light while others don't?
${experimentData.analysis_q2 || 'Not answered'}

3. Based on your observations, how effective was the sunscreen at blocking UV light?
${experimentData.analysis_q3 || 'Not answered'}

4. How might insects and other animals perceive flowers differently than humans, based on your UV light observations?
${experimentData.analysis_q4 || 'Not answered'}

5. What are some practical applications of UV light in everyday life and various industries?
${experimentData.analysis_q5 || 'Not answered'}

CONCLUSIONS:
${experimentData.conclusions || 'No conclusions provided'}

EXPERIMENT SUMMARY:
This experiment investigates ultraviolet light properties, fluorescence effects on various materials, and practical applications in daily life and industry.
            `.trim();
            
            // Check for missing elements
            const missingElements = [];
            if (!experimentData.analysis_q1) missingElements.push('Analysis Q1');
            if (!experimentData.analysis_q2) missingElements.push('Analysis Q2');
            if (!experimentData.analysis_q3) missingElements.push('Analysis Q3');
            if (!experimentData.analysis_q4) missingElements.push('Analysis Q4');
            if (!experimentData.analysis_q5) missingElements.push('Analysis Q5');
            if (!experimentData.conclusions) missingElements.push('Conclusions');
            
            const missingElementsText = missingElements.length > 0 
                ? `Missing: ${missingElements.join(', ')} ❌` 
                : 'All sections complete ✅';
            
            emailjs.send("service_ot1jg6s", "template_y556rhr", {
                student_name: studentName,
                student_email: studentEmail,
                experiment_title: 'Experiment 10.2: Ultraviolet Light',
                hypothesis: 'Investigating ultraviolet light properties and fluorescence effects on various materials',
                missing_elements: missingElementsText,
                conclusion: conclusionText,
                subject: `Experiment 10.2: Ultraviolet Light - ${studentName}`
            })
            .then(function(response) {
                console.log('Email sent successfully:', response);
                showSubmissionMessage('Your results have been submitted successfully!', 'success');
            })
            .catch(function(error) {
                console.error('Email sending failed:', error);
                showSubmissionMessage('Failed to submit results. Please try again or contact your instructor.', 'error');
            });
        });
        
        function showSubmissionMessage(message, type) {
            const submissionMessage = document.getElementById('submission-message');
            if (!submissionMessage) return;
            
            submissionMessage.textContent = message;
            submissionMessage.className = 'mt-4 p-3 rounded';
            
            if (type === 'success') {
                submissionMessage.classList.add('bg-green-100', 'text-green-800');
            } else if (type === 'error') {
                submissionMessage.classList.add('bg-red-100', 'text-red-800');
            } else {
                submissionMessage.classList.add('bg-blue-100', 'text-blue-800');
            }
            
            submissionMessage.classList.remove('hidden');
        }
    </script>
</Layout>
