</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Audio functionality
        let audioEnabled1 = true;
        let audioEnabled2 = true;
        
        // Create audio context and sounds
        function createBeepSound(frequency = 800, duration = 200) {
            if (!window.AudioContext && !window.webkitAudioContext) return null;
            
            const audioContext = new (window.AudioContext || window.webkitAudioContext)();
            const oscillator = audioContext.createOscillator();
            const gainNode = audioContext.createGain();
            
            oscillator.connect(gainNode);
            gainNode.connect(audioContext.destination);
            
            oscillator.frequency.value = frequency;
            oscillator.type = 'sine';
            
            gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
            gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + duration / 1000);
            
            oscillator.start(audioContext.currentTime);
            oscillator.stop(audioContext.currentTime + duration / 1000);
            
            return { audioContext, oscillator, gainNode };
        }
        
        function playCountdownBeep() {
            createBeepSound(600, 150);
        }
        
        function playFinalBeep() {
            createBeepSound(1000, 500);
        }

        // Timer functionality
        const timerDisplay = document.getElementById('timerDisplay');
        const startTimerBtn = document.getElementById('startTimer');
        const resetTimerBtn = document.getElementById('resetTimer');
        const timerStatus = document.getElementById('timerStatus');
        const audioToggle1 = document.getElementById('audioToggle1');
        
        let timerInterval = null;
        let timeRemaining = 30;
        
        // Start timer function
        startTimerBtn.addEventListener('click', function() {
            if (timerInterval) return; // Prevent multiple timers
            
            startTimerBtn.disabled = true;
            timerDisplay.classList.add('counting');
            timerStatus.textContent = 'Timer running... Start counting swings!';
            
            timerInterval = setInterval(function() {
                timeRemaining--;
                timerDisplay.textContent = timeRemaining;
                
                // Play countdown beeps
                if (audioEnabled1 && timeRemaining <= 5 && timeRemaining > 0) {
                    playCountdownBeep();
                }
                
                if (timeRemaining <= 0) {
                    clearInterval(timerInterval);
                    timerInterval = null;
                    timerDisplay.classList.remove('counting');
                    timerDisplay.classList.add('finished');
                    timerDisplay.textContent = '0';
                    timerStatus.textContent = '⏰ Time\'s up! Stop counting and record your result.';
                    
                    // Play final beep
                    if (audioEnabled1) {
                        playFinalBeep();
                    }
                    
                    // Auto-reset after 2 seconds
                    setTimeout(function() {
                        timeRemaining = 30;
                        timerDisplay.textContent = '30';
                        timerDisplay.classList.remove('counting', 'finished');
                        timerStatus.textContent = 'Ready to start';
                        startTimerBtn.disabled = false;
                    }, 2000);
                }
            }, 1000);
        });
        
        // Reset timer function
        resetTimerBtn.addEventListener('click', function() {
            if (timerInterval) {
                clearInterval(timerInterval);
                timerInterval = null;
            }
            timeRemaining = 30;
            timerDisplay.textContent = '30';
            timerDisplay.classList.remove('counting', 'finished');
            timerStatus.textContent = 'Ready to start';
            startTimerBtn.disabled = false;
        });
        
        // Audio toggle for timer 1
        audioToggle1.addEventListener('click', function() {
            audioEnabled1 = !audioEnabled1;
            if (audioEnabled1) {
                audioToggle1.textContent = '🔊';
                audioToggle1.classList.remove('muted');
                audioToggle1.title = 'Disable countdown sounds';
            } else {
                audioToggle1.textContent = '🔇';
                audioToggle1.classList.add('muted');
                audioToggle1.title = 'Enable countdown sounds';
            }
        });

        // Second Timer functionality for Part 2
        const timerDisplay2 = document.getElementById('timerDisplay2');
        const startTimerBtn2 = document.getElementById('startBtn2');
        const resetTimerBtn2 = document.getElementById('resetBtn2');
        const timerStatus2 = document.getElementById('timerStatus2');
        const audioToggle2 = document.getElementById('audioToggle2');
        
        let timerInterval2 = null;
        let timeRemaining2 = 30;
        
        // Start timer 2 function
        startTimerBtn2.addEventListener('click', function() {
            if (timerInterval2) return; // Prevent multiple timers
            
            startTimerBtn2.disabled = true;
            timerDisplay2.classList.add('counting');
            timerStatus2.textContent = 'Timer running... Start counting swings!';
            
            timerInterval2 = setInterval(function() {
                timeRemaining2--;
                timerDisplay2.textContent = timeRemaining2;
                
                // Play countdown beeps
                if (audioEnabled2 && timeRemaining2 <= 5 && timeRemaining2 > 0) {
                    playCountdownBeep();
                }
                
                if (timeRemaining2 <= 0) {
                    clearInterval(timerInterval2);
                    timerInterval2 = null;
                    timerDisplay2.classList.remove('counting');
                    timerDisplay2.classList.add('finished');
                    timerDisplay2.textContent = '0';
                    timerStatus2.textContent = '⏰ Time\'s up! Stop counting and record your result.';
                    
                    // Play final beep
                    if (audioEnabled2) {
                        playFinalBeep();
                    }
                    
                    // Auto-reset after 2 seconds
                    setTimeout(function() {
                        timeRemaining2 = 30;
                        timerDisplay2.textContent = '30';
                        timerDisplay2.classList.remove('counting', 'finished');
                        timerStatus2.textContent = 'Ready to start';
                        startTimerBtn2.disabled = false;
                    }, 2000);
                }
            }, 1000);
        });
        
        // Reset timer 2 function
        resetTimerBtn2.addEventListener('click', function() {
            if (timerInterval2) {
                clearInterval(timerInterval2);
                timerInterval2 = null;
            }
            timeRemaining2 = 30;
            timerDisplay2.textContent = '30';
            timerDisplay2.classList.remove('counting', 'finished');
            timerStatus2.textContent = 'Ready to start';
            startTimerBtn2.disabled = false;
        });
        
        // Audio toggle for timer 2
        audioToggle2.addEventListener('click', function() {
            audioEnabled2 = !audioEnabled2;
            if (audioEnabled2) {
                audioToggle2.textContent = '🔊';
                audioToggle2.classList.remove('muted');
                audioToggle2.title = 'Disable countdown sounds';
            } else {
                audioToggle2.textContent = '🔇';
                audioToggle2.classList.add('muted');
                audioToggle2.title = 'Enable countdown sounds';
            }
        });

        // Email functionality
        const emailInput = document.getElementById('studentEmail');
        const saveEmailBtn = document.getElementById('saveEmail');
        const emailStatus = document.getElementById('emailStatus');
        const submitResultsBtn = document.getElementById('submitResults');
        
        // Check if email is already saved
        const savedEmail = localStorage.getItem('studentEmail');
        if (savedEmail) {
            emailInput.value = savedEmail;
            emailStatus.textContent = `Email saved: ${savedEmail}`;
            emailStatus.style.color = '#28a745';
        }
        
        // Save email functionality
        saveEmailBtn.addEventListener('click', function() {
            const email = emailInput.value.trim();
            if (email && isValidEmail(email)) {
                localStorage.setItem('studentEmail', email);
                emailStatus.textContent = `Email saved: ${email}`;
                emailStatus.style.color = '#28a745';
            } else {
                emailStatus.textContent = 'Please enter a valid email address';
                emailStatus.style.color = '#dc3545';
            }
        });
        
        // Submit results functionality
        submitResultsBtn.addEventListener('click', function() {
            const email = localStorage.getItem('studentEmail');
            if (!email) {
                emailStatus.innerHTML = '<span style="color: red;">⚠ Please enter and save your email address first!</span>';
                return;
            }
            
            // Collect all experiment data
            const conclusions = document.getElementById('conclusions').value.trim();
            const results = document.getElementById('results').value.trim();
            
            if (!conclusions || !results) {
                emailStatus.innerHTML = '<span style="color: red;">⚠ Please complete both the results and conclusions sections before submitting.</span>';
                return;
            }
            
            // Send the experiment results
            sendExperimentResults(email, conclusions);
        });
        
        // Email validation
        function isValidEmail(email) {
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            return emailRegex.test(email);
        }

        // Initialize Chart.js variables
        let massChart = null;
        let lengthChart = null;

        // Initialize charts
        function initializeCharts() {
            const massCtx = document.getElementById('massChart').getContext('2d');
            const lengthCtx = document.getElementById('lengthChart').getContext('2d');

            // Mass Chart
            massChart = new Chart(massCtx, {
                type: 'line',
                data: {
                    labels: ['1 washer', '2 washers', '3 washers', '4 washers', '5 washers'],
                    datasets: [{
                        label: 'Average Period (seconds)',
                        data: [0, 0, 0, 0, 0],
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        borderWidth: 3,
                        pointBackgroundColor: '#3b82f6',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 6,
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        title: {
                            display: true,
                            text: 'Mass vs. Average Period',
                            font: { size: 16, weight: 'bold' },
                            color: '#374151'
                        },
                        legend: {
                            display: true,
                            position: 'top'
                        }
                    },
                    scales: {
                        x: {
                            title: {
                                display: true,
                                text: 'Mass (number of washers)',
                                font: { size: 14, weight: 'bold' },
                                color: '#6b7280'
                            },
                            grid: { color: '#e5e7eb' }
                        },
                        y: {
                            title: {
                                display: true,
                                text: 'Average Period (seconds)',
                                font: { size: 14, weight: 'bold' },
                                color: '#6b7280'
                            },
                            beginAtZero: true,
                            grid: { color: '#e5e7eb' }
                        }
                    },
                    interaction: {
                        intersect: false,
                        mode: 'index'
                    }
                }
            });

            // Length Chart
            lengthChart = new Chart(lengthCtx, {
                type: 'line',
                data: {
                    labels: ['10 cm', '15 cm', '20 cm', '25 cm', '30 cm'],
                    datasets: [{
                        label: 'Average Period (seconds)',
                        data: [0, 0, 0, 0, 0],
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        borderWidth: 3,
                        pointBackgroundColor: '#10b981',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 6,
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        title: {
                            display: true,
                            text: 'Length vs. Average Period',
                            font: { size: 16, weight: 'bold' },
                            color: '#374151'
                        },
                        legend: {
                            display: true,
                            position: 'top'
                        }
                    },
                    scales: {
                        x: {
                            title: {
                                display: true,
                                text: 'String Length (cm)',
                                font: { size: 14, weight: 'bold' },
                                color: '#6b7280'
                            },
                            grid: { color: '#e5e7eb' }
                        },
                        y: {
                            title: {
                                display: true,
                                text: 'Average Period (seconds)',
                                font: { size: 14, weight: 'bold' },
                                color: '#6b7280'
                            },
                            beginAtZero: true,
                            grid: { color: '#e5e7eb' }
                        }
                    },
                    interaction: {
                        intersect: false,
                        mode: 'index'
                    }
                }
            });
        }

        // Update mass chart with current data
        function updateMassChart() {
            const data = [];
            for (let i = 1; i <= 5; i++) {
                const avgElement = document.getElementById(`mass${i}_avg`);
                const avgValue = parseFloat(avgElement.textContent) || 0;
                data.push(avgValue);
            }
            if (massChart) {
                massChart.data.datasets[0].data = data;
                massChart.update();
            }
        }

        // Update length chart with current data
        function updateLengthChart() {
            const data = [];
            const lengths = [10, 15, 20, 25, 30]; // Reverse order for proper display
            lengths.forEach(length => {
                const avgElement = document.getElementById(`length${length}_avg`);
                const avgValue = parseFloat(avgElement.textContent) || 0;
                data.push(avgValue);
            });
            if (lengthChart) {
                lengthChart.data.datasets[0].data = data;
                lengthChart.update();
            }
        }

        // Calculate averages for mass data
        document.getElementById('calculateMassAverages').addEventListener('click', function() {
            for (let i = 1; i <= 5; i++) {
                const trial1 = parseFloat(document.getElementById(`mass${i}_trial1`).value) || 0;
                const trial2 = parseFloat(document.getElementById(`mass${i}_trial2`).value) || 0;
                const trial3 = parseFloat(document.getElementById(`mass${i}_trial3`).value) || 0;
                const average = (trial1 + trial2 + trial3) / 3;
                document.getElementById(`mass${i}_avg`).textContent = average.toFixed(2);
            }
            // Update the mass chart after calculating averages
            updateMassChart();
        });

        // Calculate averages for length data
        document.getElementById('calculateLengthAverages').addEventListener('click', function() {
            const lengths = [30, 25, 20, 15, 10];
            lengths.forEach(length => {
                const trial1 = parseFloat(document.getElementById(`length${length}_trial1`).value) || 0;
                const trial2 = parseFloat(document.getElementById(`length${length}_trial2`).value) || 0;
                const trial3 = parseFloat(document.getElementById(`length${length}_trial3`).value) || 0;
                const average = (trial1 + trial2 + trial3) / 3;
                document.getElementById(`length${length}_avg`).textContent = average.toFixed(2);
            });
            // Update the length chart after calculating averages
            updateLengthChart();
        });

        // Initialize charts when Chart.js is loaded
        if (typeof Chart !== 'undefined') {
            initializeCharts();
        } else {
            // Wait for Chart.js to load
            window.addEventListener('load', function() {
                if (typeof Chart !== 'undefined') {
                    initializeCharts();
                }
            });
        }
        
        // Send experiment results via EmailJS
        submitResultsBtn.addEventListener('click', function() {
            const savedEmail = localStorage.getItem('studentEmail');
            if (savedEmail) {
                const conclusions = document.getElementById('conclusions').value.trim();
                if (conclusions) {
                    sendExperimentResults(savedEmail, conclusions);
                } else {
                    alert('Please fill in your conclusions before submitting');
                }
            } else {
                alert('Please save your email address before submitting');
            }
        });
        
        // Send experiment results via EmailJS
        function sendExperimentResults(email, conclusions) {
            console.log('=== EXPERIMENT 1.2 RESULTS SUBMISSION ===');
            console.log('Student Email:', email);
            console.log('Student Conclusions:', conclusions);
            
            if (typeof emailjs !== 'undefined') {
                // Initialize EmailJS right before sending (matching Module 9 quiz)
                emailjs.init("ct_s19oZHppLy9BlW");
                console.log('✅ EmailJS initialized successfully');
                
                // Collect all experiment data
                const hypothesis = document.getElementById('hypothesis').value || 'No hypothesis recorded';
                const independentVar1 = document.getElementById('independentVar1').value || 'Not specified';
                const dependentVar1 = document.getElementById('dependentVar1').value || 'Not specified';
                const independentVar2 = document.getElementById('independentVar2').value || 'Not specified';
                const dependentVar2 = document.getElementById('dependentVar2').value || 'Not specified';
                const results = document.getElementById('results').value || 'No results recorded';

                // Collect mass data
                let massData = 'MASS DATA:\n';
                for (let i = 1; i <= 5; i++) {
                    const trial1 = document.getElementById(`mass${i}_trial1`).value || '0';
                    const trial2 = document.getElementById(`mass${i}_trial2`).value || '0';
                    const trial3 = document.getElementById(`mass${i}_trial3`).value || '0';
                    const avg = document.getElementById(`mass${i}_avg`).textContent || '0';
                    massData += `${i} washer(s): T1=${trial1}, T2=${trial2}, T3=${trial3}, Avg=${avg}\n`;
                }

                // Collect length data
                let lengthData = 'LENGTH DATA:\n';
                const lengths = [30, 25, 20, 15, 10];
                lengths.forEach(length => {
                    const trial1 = document.getElementById(`length${length}_trial1`).value || '0';
                    const trial2 = document.getElementById(`length${length}_trial2`).value || '0';
                    const trial3 = document.getElementById(`length${length}_trial3`).value || '0';
                    const avg = document.getElementById(`length${length}_avg`).textContent || '0';
                    lengthData += `${length}cm: T1=${trial1}, T2=${trial2}, T3=${trial3}, Avg=${avg}\n`;
                });

                // Format message for EmailJS template
                const messageContent = `EXPERIMENT 1.2: PRACTICE COLLECTING AND ANALYZING DATA WITH PENDULUMS
========================================

STUDENT EMAIL: ${email}
COMPLETION TIME: ${new Date().toLocaleString()}

HYPOTHESIS:
${hypothesis}

VARIABLES:
Part 1 - Independent: ${independentVar1}
Part 1 - Dependent: ${dependentVar1}
Part 2 - Independent: ${independentVar2}
Part 2 - Dependent: ${dependentVar2}

${massData}

${lengthData}

RESULTS ANALYSIS:
${results}

STUDENT CONCLUSIONS:
${conclusions}

EXPERIMENT SUMMARY:
The student completed the pendulum data collection experiment, investigating how mass and length affect pendulum swing frequency, practicing data collection, analysis, and graphing skills.`;

                // Extract student name from email or use default
                const studentName = email.split('@')[0] || 'Student';
                
                const templateParams = {
                    student_name: studentName,
                    student_email: email,
                    experiment_title: 'Experiment 1.2: Pendulum Data Collection',
                    hypothesis: 'Exploring pendulum motion and data collection methods',
                    missing_elements: 'Complete pendulum measurements and analysis',
                    conclusion: messageContent,
                    subject: `Physical Science Experiment 1.2 Results - ${studentName}`
                };

                console.log('=== EMAILJS TEMPLATE PARAMETERS ===');
                console.log('student_email:', templateParams.student_email);
                console.log('experiment_title:', templateParams.experiment_title);
                console.log('conclusion:', templateParams.conclusion);
                console.log('=== END TEMPLATE PARAMETERS ===');

                // Show user what's being sent
                emailStatus.innerHTML += `<br><small style="color: blue;">📤 Sending experiment results...</small>`;

                emailjs.send("service_ot1jg6s", "template_y556rhr", templateParams)
                    .then(function(response) {
                        console.log('✅ Experiment results sent successfully:', response);
                        emailStatus.innerHTML += '<br><small style="color: green;">✓ Results sent to instructor successfully!</small>';
                        submitResultsBtn.textContent = '✅ Results Sent';
                        submitResultsBtn.disabled = true;
                    })
                    .catch(function(error) {
                        console.error('❌ Failed to send experiment results:', error);
                        emailStatus.innerHTML += '<br><small style="color: red;">⚠ Failed to send results. Please try again.</small>';
                    });
            } else {
                console.warn('⚠ EmailJS not available - typeof emailjs:', typeof emailjs);
                emailStatus.innerHTML += '<br><small style="color: red;">⚠ EmailJS not available</small>';
            }
        }
    });
</script>

