---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Experiment 12.2: Chemical Weathering Model | C00lnerd">
    <div class="experiment-container">
        <h1>Experiment 12.2: Chemical Weathering Model</h1>
        
        <div class="student-info">
            <h2>Student Information</h2>
            <form id="studentInfoForm">
                <div class="form-group">
                    <label for="studentName">Student Name:</label>
                    <input type="text" id="studentName" name="studentName" required>
                </div>
                <div class="form-group">
                    <label for="studentEmail">Student Email:</label>
                    <input type="email" id="studentEmail" name="studentEmail" required>
                </div>
                <div class="form-group">
                    <label for="instructorEmail">Instructor Email:</label>
                    <input type="email" id="instructorEmail" name="instructorEmail" value="chuck@c00lnerd.com" readonly>
                </div>
            </form>
        </div>

        <div class="experiment-section">
            <h2>Purpose</h2>
            <p>To model chemical weathering and observe how different substances affect limestone (chalk).</p>
        </div>

        <div class="experiment-section">
            <h2>Background Information</h2>
            <p>Chemical weathering occurs when chemicals in water react with minerals in rock, causing the rock to break down or dissolve. This is one of the primary ways that Earth's surface changes over time.</p>
            
            <p>Limestone is a sedimentary rock primarily composed of calcium carbonate (CaCO₃). In nature, limestone is particularly susceptible to chemical weathering when exposed to acidic solutions. When acid comes into contact with limestone, it reacts with the calcium carbonate, causing it to dissolve.</p>
            
            <p>The chemical reaction between an acid and limestone can be represented as:</p>
            <p class="chemical-equation">CaCO₃ + 2H⁺ → Ca²⁺ + H₂O + CO₂</p>
            
            <p>In this experiment, we will use chalk (which is made of calcium carbonate, the main component of limestone) to observe chemical weathering. We'll compare the effects of water (a neutral substance) and vinegar (a weak acid) on the chalk to simulate how acidic rain and other natural acids weather limestone in nature.</p>
        </div>

        <div class="experiment-section">
            <h2>Materials</h2>
            <ul>
                <li>Two pieces of chalk</li>
                <li>White vinegar or lemon juice</li>
                <li>Medicine dropper or pipette</li>
                <li>Water</li>
                <li>Two small plates or bowls</li>
                <li>Eye protection (safety goggles)</li>
            </ul>
        </div>

        <div class="experiment-section">
            <h2>Safety</h2>
            <div class="safety-warning">
                <p><strong>IMPORTANT:</strong> Always wear eye protection during this experiment.</p>
                <p>Vinegar is a mild acid but can cause eye irritation. If vinegar gets in your eyes, rinse immediately with plenty of water.</p>
                <p>This experiment should be conducted in a well-ventilated area.</p>
                <p>Wash your hands after handling the materials.</p>
            </div>
        </div>

        <div class="experiment-section">
            <h2>Procedure</h2>
            <ol>
                <li>Place one piece of chalk on each plate or bowl.</li>
                <li>Take a dropper full of water and begin by placing a drop on one piece of chalk.</li>
                <li>Observe what happens when the water reacts with the chalk or limestone.</li>
                <li>Continue placing drops of water on the chalk until you have added 5-10 drops. Record your observations.</li>
                <li>Now repeat the procedure but use drops of vinegar on the second piece of chalk.</li>
                <li>Record your observations after dropping each drop until you've added 5-10 drops of vinegar.</li>
                <li>When you have finished dropping the water and vinegar on each chalk piece, pick up what's left of the chalk.</li>
                <li>Do you notice anything left on the plate? This is sediment resulting from chemical weathering.</li>
                <li>Compare the amount of sediment left on each plate and record your observations.</li>
            </ol>
        </div>

        <div class="experiment-section">
            <h2>Data Collection</h2>
            <table class="data-table">
                <tr>
                    <th>Observation Point</th>
                    <th>Water + Chalk</th>
                    <th>Vinegar + Chalk</th>
                </tr>
                <tr>
                    <td>Initial reaction (first drop)</td>
                    <td><textarea id="observation1a" rows="3"></textarea></td>
                    <td><textarea id="observation1b" rows="3"></textarea></td>
                </tr>
                <tr>
                    <td>After 5 drops</td>
                    <td><textarea id="observation2a" rows="3"></textarea></td>
                    <td><textarea id="observation2b" rows="3"></textarea></td>
                </tr>
                <tr>
                    <td>After 10 drops</td>
                    <td><textarea id="observation3a" rows="3"></textarea></td>
                    <td><textarea id="observation3b" rows="3"></textarea></td>
                </tr>
                <tr>
                    <td>Sediment left on plate</td>
                    <td><textarea id="observation4a" rows="3"></textarea></td>
                    <td><textarea id="observation4b" rows="3"></textarea></td>
                </tr>
                <tr>
                    <td>Changes to chalk appearance</td>
                    <td><textarea id="observation5a" rows="3"></textarea></td>
                    <td><textarea id="observation5b" rows="3"></textarea></td>
                </tr>
            </table>
        </div>

        <div class="experiment-section">
            <h2>Analysis Questions</h2>
            <div class="question">
                <p>1. Which liquid caused more noticeable changes to the chalk? Why do you think this happened?</p>
                <textarea id="analysis1" rows="4"></textarea>
            </div>
            <div class="question">
                <p>2. How does this experiment demonstrate chemical weathering? Explain the chemical reaction that occurred.</p>
                <textarea id="analysis2" rows="4"></textarea>
            </div>
            <div class="question">
                <p>3. In nature, what substances might act like vinegar to weather limestone? Give examples.</p>
                <textarea id="analysis3" rows="4"></textarea>
            </div>
            <div class="question">
                <p>4. How is the weathering observed in this experiment different from mechanical weathering?</p>
                <textarea id="analysis4" rows="4"></textarea>
            </div>
            <div class="question">
                <p>5. What natural landforms or features might result from chemical weathering of limestone? Research and explain.</p>
                <textarea id="analysis5" rows="4"></textarea>
            </div>
        </div>

        <div class="experiment-section">
            <h2>Conclusion</h2>
            <p>Summarize what you learned about chemical weathering from this experiment. Explain how this relates to real-world geological processes and landform development.</p>
            <textarea id="conclusion" rows="6"></textarea>
        </div>

        <div class="experiment-section">
            <h2>Extension Activities</h2>
            <p>Try these additional activities to further explore chemical weathering:</p>
            <ol>
                <li>Test other acidic substances like lemon juice or soda on chalk and compare their effects.</li>
                <li>Research how acid rain affects buildings and monuments made of limestone or marble.</li>
                <li>Investigate how chemical weathering contributes to the formation of caves and sinkholes.</li>
                <li>Design an experiment to test how temperature affects the rate of chemical weathering.</li>
            </ol>
        </div>

        <div class="submit-section">
            <button id="submitButton" class="submit-button">Submit Results</button>
            <div id="submissionStatus"></div>
        </div>
    </div>
</Layout>

<style>
    .experiment-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 20px;
    }
    
    h1 {
        color: #2c3e50;
        text-align: center;
        margin-bottom: 30px;
    }
    
    h2 {
        color: #3498db;
        margin-top: 30px;
        border-bottom: 2px solid #3498db;
        padding-bottom: 5px;
    }
    
    .experiment-section {
        margin-bottom: 30px;
    }
    
    .form-group {
        margin-bottom: 15px;
    }
    
    label {
        display: block;
        margin-bottom: 5px;
        font-weight: bold;
    }
    
    input[type="text"],
    input[type="email"],
    textarea {
        width: 100%;
        padding: 8px;
        border: 1px solid #ddd;
        border-radius: 4px;
    }
    
    .safety-warning {
        background-color: #ffeeee;
        border-left: 4px solid #ff5555;
        padding: 15px;
        margin: 15px 0;
    }
    
    ol, ul {
        margin-left: 20px;
        line-height: 1.6;
    }
    
    .data-table {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0;
    }
    
    .data-table th, .data-table td {
        border: 1px solid #ddd;
        padding: 10px;
    }
    
    .data-table th {
        background-color: #f2f2f2;
        text-align: left;
    }
    
    .question {
        margin-bottom: 20px;
    }
    
    .chemical-equation {
        font-family: monospace;
        font-size: 1.1em;
        text-align: center;
        margin: 15px 0;
        background-color: #f8f9fa;
        padding: 10px;
        border-radius: 4px;
    }
    
    .submit-button {
        background-color: #3498db;
        color: white;
        border: none;
        padding: 10px 20px;
        font-size: 16px;
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.3s;
    }
    
    .submit-button:hover {
        background-color: #2980b9;
    }
    
    #submissionStatus {
        margin-top: 15px;
        font-weight: bold;
    }
    
    .success {
        color: green;
    }
    
    .error {
        color: red;
    }
</style>

<script>
    // Store student email in local storage
    document.addEventListener('DOMContentLoaded', function() {
        // Load saved email if available
        const savedEmail = localStorage.getItem('studentEmail');
        if (savedEmail) {
            const emailInput = document.getElementById('studentEmail') as HTMLInputElement;
            if (emailInput) emailInput.value = savedEmail;
        }
        
        // Save email when entered
        const emailElement = document.getElementById('studentEmail');
        if (emailElement) {
            emailElement.addEventListener('change', function(this: HTMLInputElement) {
                localStorage.setItem('studentEmail', this.value);
            });
        }
        
        // Handle form submission
        const submitBtn = document.getElementById('submitButton');
        if (submitBtn) {
            submitBtn.addEventListener('click', function() {
                submitResults();
            });
        }
    });
    
    function submitResults() {
        // Get form values
        const studentNameEl = document.getElementById('studentName') as HTMLInputElement;
        const studentEmailEl = document.getElementById('studentEmail') as HTMLInputElement;
        const instructorEmailEl = document.getElementById('instructorEmail') as HTMLInputElement;
        
        if (!studentNameEl || !studentEmailEl || !instructorEmailEl) {
            showStatus('Error: Form elements not found.', 'error');
            return;
        }
        
        const studentName = studentNameEl.value;
        const studentEmail = studentEmailEl.value;
        const instructorEmail = instructorEmailEl.value;
        
        // Validate form
        if (!studentName || !studentEmail) {
            showStatus('Please fill in all required fields.', 'error');
            return;
        }
        
        // Collect observations
        const getTextAreaValue = (id: string): string => {
            const element = document.getElementById(id) as HTMLTextAreaElement;
            return element ? element.value : '';
        };
        
        const observations = {
            water_initial: getTextAreaValue('observation1a'),
            vinegar_initial: getTextAreaValue('observation1b'),
            water_5drops: getTextAreaValue('observation2a'),
            vinegar_5drops: getTextAreaValue('observation2b'),
            water_10drops: getTextAreaValue('observation3a'),
            vinegar_10drops: getTextAreaValue('observation3b'),
            water_sediment: getTextAreaValue('observation4a'),
            vinegar_sediment: getTextAreaValue('observation4b'),
            water_appearance: getTextAreaValue('observation5a'),
            vinegar_appearance: getTextAreaValue('observation5b')
        };
        
        // Collect analysis answers
        const analysis = {
            q1: getTextAreaValue('analysis1'),
            q2: getTextAreaValue('analysis2'),
            q3: getTextAreaValue('analysis3'),
            q4: getTextAreaValue('analysis4'),
            q5: getTextAreaValue('analysis5')
        };
        
        const conclusion = getTextAreaValue('conclusion');
        
        // Prepare email content
        const emailContent = `
Student: ${studentName}
Email: ${studentEmail}
Experiment: Chemical Weathering Model

OBSERVATIONS:
Water + Chalk:
- Initial reaction: ${observations.water_initial}
- After 5 drops: ${observations.water_5drops}
- After 10 drops: ${observations.water_10drops}
- Sediment left: ${observations.water_sediment}
- Chalk appearance: ${observations.water_appearance}

Vinegar + Chalk:
- Initial reaction: ${observations.vinegar_initial}
- After 5 drops: ${observations.vinegar_5drops}
- After 10 drops: ${observations.vinegar_10drops}
- Sediment left: ${observations.vinegar_sediment}
- Chalk appearance: ${observations.vinegar_appearance}

ANALYSIS:
1. Which liquid caused more changes and why: ${analysis.q1}
2. How this demonstrates chemical weathering: ${analysis.q2}
3. Natural substances similar to vinegar: ${analysis.q3}
4. Difference from mechanical weathering: ${analysis.q4}
5. Natural landforms from chemical weathering: ${analysis.q5}

CONCLUSION:
${conclusion}
        `;
        
        showStatus('Submitting results...', '');
        
        // Format message for email
        const formattedMessage = `EXPERIMENT 12.2: CHEMICAL WEATHERING MODEL - STUDENT RESULTS

Student Information:
• Name: ${studentName}
• Email: ${studentEmail}

Experiment Results:

Observations:
${Object.entries(observations).map(([key, value]) => `• ${key}: ${value}`).join('\n')}

Analysis Questions:
${Object.entries(analysis).map(([key, value]) => `• ${key}: ${value}`).join('\n')}

Conclusion:
${conclusion}

---
This is an automated submission from the C00lnerd Experiment System.`;

        // Send email using EmailJS with proven parameter mapping
        emailjs.send("service_ot1jg6s", "template_y556rhr", {
            student_name: studentName,
            student_email: studentEmail,
            experiment_title: 'Experiment 12.2: Chemical Weathering Model',
            hypothesis: 'Exploring how chemical weathering affects different types of rocks',
            missing_elements: `Observations: ${Object.keys(observations).length > 0 ? '✓' : '✗'}, Analysis: ${Object.keys(analysis).length > 0 ? '✓' : '✗'}, Conclusion: ${conclusion ? '✓' : '✗'}`,
            conclusion: formattedMessage,
            subject: `Physical Science Experiment 12.2 Results - ${studentName}`
        }).then(function(response) {
            console.log('SUCCESS!', response.status, response.text);
            showStatus('Results submitted successfully!', 'success');
        }, function(error) {
            console.log('FAILED...', error);
            showStatus('Failed to submit results. Please try again.', 'error');
        });
    }
    
    function showStatus(message: string, type: string) {
        const statusElement = document.getElementById('submissionStatus');
        if (statusElement) {
            statusElement.textContent = message;
            statusElement.className = type;
        }
    }
</script>

<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js" is:inline></script>
<script type="text/javascript" is:inline>
    (function() {
        // @ts-ignore
        emailjs.init("ct_s19oZHppLy9BlW");
    })();
</script>
