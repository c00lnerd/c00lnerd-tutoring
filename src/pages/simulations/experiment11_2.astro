            border-radius: 8px;
            cursor: pointer;
            transition: background 0.3s ease;
        }

        .submit-button:hover {
            background: #229954;
        }

        .submission-status {
            margin-top: 15px;
            font-weight: bold;
        }

        @media (max-width: 768px) {
            .container {
                padding: 20px;
                margin: 10px;
            }
            
            .info-grid {
                grid-template-columns: 1fr;
            }
            
            .data-table {
                font-size: 14px;
            }
            
            .submit-button {
                padding: 12px 24px;
                font-size: 16px;
            }
        }
    </style>
</Layout>
