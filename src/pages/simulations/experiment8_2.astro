---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Experiment 8.2: How Fast Can You Do Work?">
    <main class="container mx-auto px-4 py-8">
        <div class="experiment-header">
            <h1 class="text-3xl font-bold text-center text-blue-700 mb-2">EXPERIMENT 8.2</h1>
            <h2 class="text-2xl font-bold text-center text-blue-700 mb-8">HOW FAST CAN YOU DO WORK?</h2>
        </div>

        <!-- Email Collection Section -->
        <section class="mb-8">
            <div class="bg-blue-50 p-4 rounded-lg mb-4">
                <h4 class="font-bold mb-2">Student Information:</h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="studentName" class="block text-gray-700 font-bold mb-2">Name:</label>
                        <input type="text" id="studentName" class="w-full px-3 py-2 border rounded-lg" placeholder="Your Name">
                    </div>
                    <div>
                        <label for="studentEmail" class="block text-gray-700 font-bold mb-2">Email:</label>
                        <input type="email" id="studentEmail" class="w-full px-3 py-2 border rounded-lg" placeholder="your.email@example.com">
                    </div>
                </div>
                <div class="mt-4">
                    <label for="teacherEmail" class="block text-gray-700 font-bold mb-2">Teacher's Email:</label>
                    <input type="email" id="teacherEmail" class="w-full px-3 py-2 border rounded-lg" value="chuck@c00lnerd.com" placeholder="teacher.email@example.com">
                </div>
            </div>
        </section>

        <!-- Purpose Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">PURPOSE:</h3>
            <p class="mb-4">To explore the relationship between work, energy, and power using your own body.</p>
        </section>

        <!-- Materials Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">MATERIALS:</h3>
            <ul class="list-disc pl-8 mb-4">
                <li>A 1 lb hand weight (You can also use a 16 ounce box of spaghetti or other 1 lb substance)</li>
                <li>A piece of string 70 cm long</li>
                <li>Pencil or dowel rod</li>
                <li>Tape</li>
                <li>Tape measure or metric ruler</li>
                <li>Stopwatch</li>
                <li>Bathroom scale</li>
                <li>A clear stairway (You will be running up the steps so make sure the area is safe and you have proper shoes on)</li>
                <li>A helper</li>
            </ul>
        </section>

        <!-- Background Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">BACKGROUND:</h3>
            <p class="mb-4">
                Any time you use a force in the direction of motion to move an object a distance, you are doing work. In this investigation, you will use your arms to supply the force to lift a 1 lb object. You will also use your legs to lift yourself (you are the object) up a flight of stairs.
            </p>
            <p class="mb-4">
                Since you will be doing your work against gravity, lifting your body from the first floor to the second floor, we will only need the vertical height of the stairs, not the horizontal distance. We'll compare the power of your arms and legs.
            </p>
        </section>

        <!-- Questions Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">QUESTIONS:</h3>
            <p class="mb-4">What is the relationship between work, energy, and power?</p>
            <textarea id="questions" class="w-full p-2 border rounded-lg" rows="3" placeholder="Your answer..."></textarea>
        </section>

        <!-- Hypothesis Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">HYPOTHESIS:</h3>
            <p class="mb-4">Write what you predict will have more power, your arms or your legs:</p>
            <textarea id="hypothesis" class="w-full p-2 border rounded-lg" rows="3" placeholder="Your hypothesis..."></textarea>
        </section>

        <!-- Procedure Section - Part A -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">PROCEDURE—PART A, ARMS:</h3>
            <ol class="list-decimal pl-8 mb-4">
                <li class="mb-2">Attach one end of the string to the 1 lb weight or box of spaghetti by tying the string around the center.</li>
                <li class="mb-2">Tie the other end of the string around the pencil and secure with tape.</li>
                <li class="mb-2">Measure the distance by measuring the string from the hanging weight to the pencil. You should have a distance of at least 50 cm. Record this measurement in your data table.</li>
                <li class="mb-2">Record the mass in kilograms of your weight or box of spaghetti (1 lb = 16 oz = 0.45 kg).</li>
                <li class="mb-2">With the stopwatch, have your helper time how quickly you can lift the 1 lb mass by rolling the string onto the pencil as you turn the pencil in your hands. Record the time in seconds.</li>
                <li class="mb-2">Calculate the force (in this case it is the weight, use W = mg, where g = 9.8 m/s²), work, and power (in watts and horsepower) that you produced as you lifted the 1 lb mass and record in the data table.</li>
            </ol>
        </section>

        <!-- Procedure Section - Part B -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">PROCEDURE—PART B, LEGS:</h3>
            <ol class="list-decimal pl-8 mb-4">
                <li class="mb-2">Using a bathroom scale, measure your weight. You will need to convert your weight in pounds to kilograms (1 pound = 0.45 kg). Record your weight in kilograms.</li>
                <li class="mb-2">
                    Since we are going to determine the work and power required to lift your weight from the first floor to the second floor, we are only concerned with the vertical height of the stairs, not the horizontal distance of the stairs. Remember that, although the force you will be applying is in the direction along the stairs, the only part of the force that is used to lift you is the vertical component. The horizontal component does not help to lift you up the stairs.
                    <div class="my-4 p-4 bg-blue-50 border-2 border-blue-200 rounded-lg">
                        <div class="text-center">
                            <svg width="300" height="200" viewBox="0 0 300 200" class="inline-block">
                                <!-- Stairs -->
                                <g stroke="#333" stroke-width="2" fill="none">
                                    <path d="M50 180 L80 180 L80 160 L110 160 L110 140 L140 140 L140 120 L170 120 L170 100 L200 100"/>
                                </g>
                                
                                <!-- Force vectors -->
                                <!-- Orange vector (applied force along stairs) -->
                                <g stroke="orange" stroke-width="3" fill="orange">
                                    <path d="M125 150 L180 105" marker-end="url(#arrowOrange)"/>
                                    <text x="155" y="125" font-size="12" fill="orange">Applied Force</text>
                                </g>
                                
                                <!-- Red vector (vertical component) -->
                                <g stroke="red" stroke-width="3" fill="red">
                                    <path d="M125 150 L125 105" marker-end="url(#arrowRed)"/>
                                    <text x="85" y="125" font-size="12" fill="red">Vertical</text>
                                    <text x="85" y="138" font-size="12" fill="red">Component</text>
                                </g>
                                
                                <!-- Yellow vector (horizontal component) -->
                                <g stroke="gold" stroke-width="3" fill="gold">
                                    <path d="M125 105 L180 105" marker-end="url(#arrowYellow)"/>
                                    <text x="145" y="95" font-size="12" fill="gold">Horizontal</text>
                                    <text x="145" y="85" font-size="12" fill="gold">Component</text>
                                </g>
                                
                                <!-- Blue arrows for step heights -->
                                <g stroke="blue" stroke-width="2" fill="blue">
                                    <path d="M65 180 L65 160" marker-end="url(#arrowBlue)"/>
                                    <path d="M95 160 L95 140" marker-end="url(#arrowBlue)"/>
                                    <path d="M125 140 L125 120" marker-end="url(#arrowBlue)"/>
                                    <path d="M155 120 L155 100" marker-end="url(#arrowBlue)"/>
                                </g>
                                
                                <!-- Arrow markers -->
                                <defs>
                                    <marker id="arrowOrange" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto" markerUnits="strokeWidth">
                                        <path d="M0,0 L0,6 L9,3 z" fill="orange"/>
                                    </marker>
                                    <marker id="arrowRed" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto" markerUnits="strokeWidth">
                                        <path d="M0,0 L0,6 L9,3 z" fill="red"/>
                                    </marker>
                                    <marker id="arrowYellow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto" markerUnits="strokeWidth">
                                        <path d="M0,0 L0,6 L9,3 z" fill="gold"/>
                                    </marker>
                                    <marker id="arrowBlue" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto" markerUnits="strokeWidth">
                                        <path d="M0,0 L0,6 L9,3 z" fill="blue"/>
                                    </marker>
                                </defs>
                            </svg>
                        </div>
                        <p class="text-sm text-gray-600 mt-2 text-center"><strong>FIGURE 8.25</strong> - Force Components on Stairs</p>
                        <div class="text-xs mt-2">
                            <p><span class="text-orange-600">●</span> <strong>Orange:</strong> Applied force along stairs</p>
                            <p><span class="text-red-600">●</span> <strong>Red:</strong> Vertical component (does work against gravity)</p>
                            <p><span class="text-yellow-500">●</span> <strong>Yellow:</strong> Horizontal component (no work against gravity)</p>
                            <p><span class="text-blue-600">●</span> <strong>Blue:</strong> Individual step heights</p>
                        </div>
                    </div>
                    So to determine the vertical height of the stairs, measure the height of each step (blue arrows) and add them together. (You should find that each step is the same height, so once you measure one or two—to be certain they are the same height—you can simply count the number of steps and multiply the number of steps by the height of one step to find the total vertical height.) Record the distance (total vertical height of the stairs) in your data table.
                </li>
                <li class="mb-2">With the stopwatch, have your helper time how quickly you can get from the first floor to the second floor. <span class="text-red-600 font-bold">Use common sense when running up the steps. Hold onto the railing and go up the steps quickly and safely.</span> Record your time in the data table.</li>
                <li class="mb-2">Calculate the force (your weight, use W = mg, where g = 9.8 m/s²), work, and power (in watts and horsepower) that you produced as you lifted your body up the stairs and record in the data table.</li>
                <li class="mb-2">Clean up and put everything away.</li>
            </ol>
        </section>

        <!-- Data Collection Section - Part A -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">DATA COLLECTION:</h3>
            <h4 class="text-lg font-semibold mb-2">Part A: Arms</h4>
            <div class="overflow-x-auto">
                <table class="min-w-full bg-white border rounded-lg">
                    <thead>
                        <tr>
                            <th class="border p-2">Measurement</th>
                            <th class="border p-2">Value</th>
                            <th class="border p-2">Units</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="border p-2">Distance (string length)</td>
                            <td class="border p-2"><input type="number" id="arm-distance" class="w-full p-1 border rounded calculation-input" step="0.01"></td>
                            <td class="border p-2">cm</td>
                        </tr>
                        <tr>
                            <td class="border p-2">Distance (converted)</td>
                            <td class="border p-2"><input type="number" id="arm-distance-m" class="w-full p-1 border rounded bg-gray-100" readonly></td>
                            <td class="border p-2">m</td>
                        </tr>
                        <tr>
                            <td class="border p-2">Mass of weight</td>
                            <td class="border p-2"><input type="number" id="arm-mass" class="w-full p-1 border rounded calculation-input" value="0.45" step="0.01"></td>
                            <td class="border p-2">kg</td>
                        </tr>
                        <tr>
                            <td class="border p-2">Time to lift</td>
                            <td class="border p-2"><input type="number" id="arm-time" class="w-full p-1 border rounded calculation-input" step="0.01"></td>
                            <td class="border p-2">seconds</td>
                        </tr>
                        <tr>
                            <td class="border p-2">Force (W = mg)</td>
                            <td class="border p-2"><input type="number" id="arm-force" class="w-full p-1 border rounded bg-gray-100" readonly></td>
                            <td class="border p-2">N</td>
                        </tr>
                        <tr>
                            <td class="border p-2">Work (Force × Distance)</td>
                            <td class="border p-2"><input type="number" id="arm-work" class="w-full p-1 border rounded bg-gray-100" readonly></td>
                            <td class="border p-2">J</td>
                        </tr>
                        <tr>
                            <td class="border p-2">Power (Work ÷ Time)</td>
                            <td class="border p-2"><input type="number" id="arm-power" class="w-full p-1 border rounded bg-gray-100" readonly></td>
                            <td class="border p-2">W</td>
                        </tr>
                        <tr>
                            <td class="border p-2">Power (in horsepower)</td>
                            <td class="border p-2"><input type="number" id="arm-hp" class="w-full p-1 border rounded bg-gray-100" readonly></td>
                            <td class="border p-2">hp</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Data Collection Section - Part B -->
        <section class="mb-8">
            <h4 class="text-lg font-semibold mb-2">Part B: Legs</h4>
            <div class="overflow-x-auto">
                <table class="min-w-full bg-white border rounded-lg">
                    <thead>
                        <tr>
                            <th class="border p-2">Measurement</th>
                            <th class="border p-2">Value</th>
                            <th class="border p-2">Units</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="border p-2">Your weight (in pounds)</td>
                            <td class="border p-2"><input type="number" id="leg-weight-lb" class="w-full p-1 border rounded calculation-input" step="0.1"></td>
                            <td class="border p-2">lb</td>
                        </tr>
                        <tr>
                            <td class="border p-2">Your mass (converted)</td>
                            <td class="border p-2"><input type="number" id="leg-mass" class="w-full p-1 border rounded bg-gray-100" readonly></td>
                            <td class="border p-2">kg</td>
                        </tr>
                        <tr>
                            <td class="border p-2">Height of one step</td>
                            <td class="border p-2"><input type="number" id="step-height" class="w-full p-1 border rounded calculation-input" step="0.1"></td>
                            <td class="border p-2">cm</td>
                        </tr>
                        <tr>
                            <td class="border p-2">Number of steps</td>
                            <td class="border p-2"><input type="number" id="step-count" class="w-full p-1 border rounded calculation-input" step="1"></td>
                            <td class="border p-2">steps</td>
                        </tr>
                        <tr>
                            <td class="border p-2">Total vertical height</td>
                            <td class="border p-2"><input type="number" id="leg-distance" class="w-full p-1 border rounded bg-gray-100" readonly></td>
                            <td class="border p-2">cm</td>
                        </tr>
                        <tr>
                            <td class="border p-2">Total vertical height (converted)</td>
                            <td class="border p-2"><input type="number" id="leg-distance-m" class="w-full p-1 border rounded bg-gray-100" readonly></td>
                            <td class="border p-2">m</td>
                        </tr>
                        <tr>
                            <td class="border p-2">Time to climb stairs</td>
                            <td class="border p-2"><input type="number" id="leg-time" class="w-full p-1 border rounded calculation-input" step="0.01"></td>
                            <td class="border p-2">seconds</td>
                        </tr>
                        <tr>
                            <td class="border p-2">Force (W = mg)</td>
                            <td class="border p-2"><input type="number" id="leg-force" class="w-full p-1 border rounded bg-gray-100" readonly></td>
                            <td class="border p-2">N</td>
                        </tr>
                        <tr>
                            <td class="border p-2">Work (Force × Distance)</td>
                            <td class="border p-2"><input type="number" id="leg-work" class="w-full p-1 border rounded bg-gray-100" readonly></td>
                            <td class="border p-2">J</td>
                        </tr>
                        <tr>
                            <td class="border p-2">Power (Work ÷ Time)</td>
                            <td class="border p-2"><input type="number" id="leg-power" class="w-full p-1 border rounded bg-gray-100" readonly></td>
                            <td class="border p-2">W</td>
                        </tr>
                        <tr>
                            <td class="border p-2">Power (in horsepower)</td>
                            <td class="border p-2"><input type="number" id="leg-hp" class="w-full p-1 border rounded bg-gray-100" readonly></td>
                            <td class="border p-2">hp</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Conclusions Section -->
        <section class="mb-8">
            <h3 class="text-xl font-bold text-blue-700">CONCLUSIONS:</h3>
            <p class="mb-4">In a paragraph or two, answer the following questions and make connections to the text:</p>
            <ol class="list-decimal pl-8 mb-4">
                <li class="mb-2">
                    <p>Which activity required the most work? Explain why using the terms force and distance.</p>
                    <textarea class="w-full p-2 border rounded-lg mb-4" rows="3" id="conclusion-1"></textarea>
                </li>
                <li class="mb-2">
                    <p>Which activity produced the most power? Explain why.</p>
                    <textarea class="w-full p-2 border rounded-lg mb-4" rows="3" id="conclusion-2"></textarea>
                </li>
                <li class="mb-2">
                    <p>If you wanted to produce more power in either part A or B, what could you do to maximize power?</p>
                    <textarea class="w-full p-2 border rounded-lg mb-4" rows="3" id="conclusion-3"></textarea>
                </li>
                <li class="mb-2">
                    <p>If you went up the stairs twice as fast as you did, would you be doing more work? Why or why not?</p>
                    <textarea class="w-full p-2 border rounded-lg mb-4" rows="3" id="conclusion-4"></textarea>
                </li>
            </ol>
        </section>

        <!-- Submit Button -->
        <section class="mb-8 text-center">
            <button id="submitBtn" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg">
                Submit to Teacher
            </button>
            <p id="submissionMessage" class="mt-2 hidden"></p>
        </section>
    </main>
</Layout>

<script is:inline>
    // EmailJS loading and initialization with retry logic
    let emailjsReady = false;
    
    function loadEmailJS() {
        return new Promise((resolve, reject) => {
            if (window.emailjs) {
                emailjsReady = true;
                resolve();
                return;
            }
            
            const script = document.createElement('script');
            script.src = 'https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js';
            script.onload = function() {
                if (window.emailjs) {
                    try {
                        emailjs.init("ct_s19oZHppLy9BlW");
                        emailjsReady = true;
                        resolve();
                    } catch (error) {
                        console.error('EmailJS initialization failed:', error);
                        reject(error);
                    }
                } else {
                    reject(new Error('EmailJS failed to load'));
                }
            };
            script.onerror = function() {
                reject(new Error('Failed to load EmailJS script'));
            };
            document.head.appendChild(script);
        });
    }
    
    // Initialize EmailJS with retry logic
    function initializeEmailJS() {
        loadEmailJS().catch(error => {
            console.error('EmailJS loading failed:', error);
            // Retry after 2 seconds
            setTimeout(() => {
                loadEmailJS().catch(err => {
                    console.error('EmailJS retry failed:', err);
                });
            }, 2000);
        });
    }
    
    // Start loading EmailJS immediately
    initializeEmailJS();

    document.addEventListener('DOMContentLoaded', function() {
        // Store student information in local storage
        const studentNameInput = document.getElementById('studentName');
        const studentEmailInput = document.getElementById('studentEmail');
        const teacherEmailInput = document.getElementById('teacherEmail');

        // Load stored values if they exist
        if (localStorage.getItem('studentName')) {
            studentNameInput.value = localStorage.getItem('studentName');
        }
        if (localStorage.getItem('studentEmail')) {
            studentEmailInput.value = localStorage.getItem('studentEmail');
        }

        // Store values when they change
        studentNameInput.addEventListener('change', function() {
            localStorage.setItem('studentName', this.value);
        });
        studentEmailInput.addEventListener('change', function() {
            localStorage.setItem('studentEmail', this.value);
        });

        // Set up calculations
        const calculationInputs = document.querySelectorAll('.calculation-input');
        calculationInputs.forEach(input => {
            input.addEventListener('input', calculateValues);
        });

        // Initial calculation
        calculateValues();

        function calculateValues() {
            // Part A: Arms calculations
            const armDistance = parseFloat(document.getElementById('arm-distance').value) || 0;
            const armDistanceM = armDistance / 100; // Convert cm to m
            document.getElementById('arm-distance-m').value = armDistanceM.toFixed(2);

            const armMass = parseFloat(document.getElementById('arm-mass').value) || 0;
            const armTime = parseFloat(document.getElementById('arm-time').value) || 0;

            // Calculate force, work, and power for arms
            const armForce = armMass * 9.8; // W = mg
            document.getElementById('arm-force').value = armForce.toFixed(2);

            const armWork = armForce * armDistanceM; // Work = Force × Distance
            document.getElementById('arm-work').value = armWork.toFixed(2);

            let armPower = 0;
            if (armTime > 0) {
                armPower = armWork / armTime; // Power = Work ÷ Time
            }
            document.getElementById('arm-power').value = armPower.toFixed(2);

            const armHp = armPower / 745.7; // Convert watts to horsepower (1 hp = 745.7 W)
            document.getElementById('arm-hp').value = armHp.toFixed(4);

            // Part B: Legs calculations
            const legWeightLb = parseFloat(document.getElementById('leg-weight-lb').value) || 0;
            const legMass = legWeightLb * 0.45; // Convert lb to kg
            document.getElementById('leg-mass').value = legMass.toFixed(2);

            const stepHeight = parseFloat(document.getElementById('step-height').value) || 0;
            const stepCount = parseFloat(document.getElementById('step-count').value) || 0;

            const legDistance = stepHeight * stepCount; // Total vertical height in cm
            document.getElementById('leg-distance').value = legDistance.toFixed(2);

            const legDistanceM = legDistance / 100; // Convert cm to m
            document.getElementById('leg-distance-m').value = legDistanceM.toFixed(2);

            const legTime = parseFloat(document.getElementById('leg-time').value) || 0;

            // Calculate force, work, and power for legs
            const legForce = legMass * 9.8; // W = mg
            document.getElementById('leg-force').value = legForce.toFixed(2);

            const legWork = legForce * legDistanceM; // Work = Force × Distance
            document.getElementById('leg-work').value = legWork.toFixed(2);

            let legPower = 0;
            if (legTime > 0) {
                legPower = legWork / legTime; // Power = Work ÷ Time
            }
            document.getElementById('leg-power').value = legPower.toFixed(2);

            const legHp = legPower / 745.7; // Convert watts to horsepower (1 hp = 745.7 W)
            document.getElementById('leg-hp').value = legHp.toFixed(4);
        }

        // Set up form submission
        const submitBtn = document.getElementById('submitBtn');
        const submissionMessage = document.getElementById('submissionMessage');

        submitBtn.addEventListener('click', function() {
            // Validate required fields
            const studentName = studentNameInput.value.trim();
            const studentEmail = studentEmailInput.value.trim();
            const teacherEmail = teacherEmailInput.value.trim();

            if (!studentName || !studentEmail || !teacherEmail) {
                showMessage('Please fill in all required fields (Name and Email).', 'error');
                return;
            }

            // Gather all data
            const hypothesis = document.getElementById('hypothesis').value.trim();
            const questions = document.getElementById('questions').value.trim();
            
            // Part A data
            const armDistance = document.getElementById('arm-distance').value;
            const armMass = document.getElementById('arm-mass').value;
            const armTime = document.getElementById('arm-time').value;
            const armForce = document.getElementById('arm-force').value;
            const armWork = document.getElementById('arm-work').value;
            const armPower = document.getElementById('arm-power').value;
            const armHp = document.getElementById('arm-hp').value;
            
            // Part B data
            const legWeightLb = document.getElementById('leg-weight-lb').value;
            const legMass = document.getElementById('leg-mass').value;
            const stepHeight = document.getElementById('step-height').value;
            const stepCount = document.getElementById('step-count').value;
            const legDistance = document.getElementById('leg-distance').value;
            const legTime = document.getElementById('leg-time').value;
            const legForce = document.getElementById('leg-force').value;
            const legWork = document.getElementById('leg-work').value;
            const legPower = document.getElementById('leg-power').value;
            const legHp = document.getElementById('leg-hp').value;
            
            // Conclusions
            const conclusion1 = document.getElementById('conclusion-1').value.trim();
            const conclusion2 = document.getElementById('conclusion-2').value.trim();
            const conclusion3 = document.getElementById('conclusion-3').value.trim();
            const conclusion4 = document.getElementById('conclusion-4').value.trim();

            // Prepare email parameters
            // Prepare comprehensive experiment data for email
            const experimentData = `
EXPERIMENT: How Fast Can You Do Work?

STUDENT: ${studentName}
EMAIL: ${studentEmail}

HYPOTHESIS:
${hypothesis}

QUESTIONS:
${questions}

PART A - ARMS DATA:
Distance: ${armDistance} cm (${document.getElementById('arm-distance-m')?.value} m)
Mass: ${armMass} kg
Time: ${armTime} seconds
Force: ${armForce} N
Work: ${armWork} J
Power: ${armPower} W (${armHp} hp)

PART B - LEGS DATA:
Weight: ${legWeightLb} lb (${legMass} kg)
Step Height: ${stepHeight} cm
Number of Steps: ${stepCount}
Total Vertical Height: ${legDistance} cm (${document.getElementById('leg-distance-m')?.value} m)
Time: ${legTime} seconds
Force: ${legForce} N
Work: ${legWork} J
Power: ${legPower} W (${legHp} hp)

CONCLUSIONS:
1. Which activity required the most work?
${conclusion1}

2. Which activity produced the most power?
${conclusion2}

3. How to maximize power?
${conclusion3}

4. Going up stairs twice as fast - more work?
${conclusion4}
            `.trim();

            // Check if EmailJS is ready before sending
            if (!emailjsReady) {
                showMessage('Email service is still loading. Please wait a moment and try again.', 'error');
                return;
            }

            // Disable button and show loading state
            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting...';
            
            // Send email using EmailJS with exact parameter structure from working experiments
            emailjs.send('service_ot1jg6s', 'template_y556rhr', {
                student_name: studentName,
                student_email: studentEmail,
                experiment_title: 'Experiment 8.2: How Fast Can You Do Work?',
                hypothesis: hypothesis || 'Exploring work and power calculations in physical activities',
                missing_elements: `Arms: ${armWork ? '✓' : '✗'} | Legs: ${legWork ? '✓' : '✗'} | Conclusions: ${conclusion1 && conclusion2 ? '✓' : '✗'}`,
                conclusion: experimentData,
                subject: `Experiment 8.2 - ${studentName}`
            })
                .then(function(response) {
                    console.log('SUCCESS!', response.status, response.text);
                    showMessage('Experiment submitted successfully!', 'success');
                    submitBtn.textContent = 'Submit to Teacher';
                    submitBtn.disabled = false;
                }, function(error) {
                    console.log('FAILED...', error);
                    showMessage('Failed to submit. Please try again.', 'error');
                    submitBtn.textContent = 'Submit to Teacher';
                    submitBtn.disabled = false;
                });
        });

        function showMessage(message, type) {
            submissionMessage.textContent = message;
            submissionMessage.classList.remove('hidden', 'text-green-600', 'text-red-600');
            submissionMessage.classList.add(type === 'success' ? 'text-green-600' : 'text-red-600');
        }
    });
</script>
