---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Experiment 2.1: Diffusion at Different Temperatures">
    <div class="container">
        <h1>Experiment 2.1: Diffusion at Different Temperatures</h1>
        
        <!-- Email Input Section -->
        <div class="email-section">
            <h3>Student Information</h3>
            <p>Enter your email so your instructor can see your experiment results:</p>
            <input type="email" id="studentEmail" placeholder="your.email@example.com" />
            <div class="email-status" id="emailStatus"></div>
        </div>

        <div class="experiment-content">
            <h2>Purpose</h2>
            <p>To demonstrate the relationship between temperature, kinetic energy, and the rate of diffusion.</p>

            <h2>Materials</h2>
            <div class="materials-list">
                <div class="materials-grid">
                    <div class="material-item">
                        <div class="material-icon">🥤</div>
                        <span>4 beakers (250 mL) or clear glass cups (same size)</span>
                    </div>
                    <div class="material-item">
                        <div class="material-icon">🔥</div>
                        <span>Hot water</span>
                    </div>
                    <div class="material-item">
                        <div class="material-icon">❄️</div>
                        <span>Cold water</span>
                    </div>
                    <div class="material-item">
                        <div class="material-icon">🧊</div>
                        <span>Ice</span>
                    </div>
                    <div class="material-item">
                        <div class="material-icon">🎨</div>
                        <span>Red, blue, green, and yellow food coloring</span>
                    </div>
                    <div class="material-item">
                        <div class="material-icon">📏</div>
                        <span>Measuring cup</span>
                    </div>
                    <div class="material-item">
                        <div class="material-icon">⏱️</div>
                        <span>Stopwatch (optional)</span>
                    </div>
                    <div class="material-item">
                        <div class="material-icon">👥</div>
                        <span>A helper</span>
                    </div>
                </div>
            </div>

            <h2>Question</h2>
            <div class="question-section">
                <p><strong>How does changing the temperature affect the rate of diffusion?</strong></p>
            </div>

            <h2>Hypothesis</h2>
            <div class="hypothesis-section">
                <p>Write your prediction of which beaker of water (steaming hot, hot, cold, or freezing) will have the faster rate of diffusion:</p>
                <textarea id="hypothesis" placeholder="Enter your hypothesis here..."></textarea>
            </div>

            <h2>Procedure</h2>
            <div class="procedure-section">
                <div class="step">
                    <h4>Step 1: Prepare Ice Water</h4>
                    <p>Place a cup of ice cubes into a bowl and add a cup of water. Let sit for 10 minutes.</p>
                    <div class="observation-input">
                        <label for="step1_notes">Notes/Observations:</label>
                        <textarea id="step1_notes" placeholder="Record any observations..."></textarea>
                    </div>
                </div>

                <!-- Timer Section for Step 1 -->
                <div class="timer-section">
                    <h4>10-Minute Timer for Ice Water Preparation</h4>
                    <div class="timer-container">
                        <div class="timer-display" id="timerDisplay1">10:00</div>
                        <div class="timer-controls">
                            <button class="timer-btn start-btn" id="startTimer1">Start Timer</button>
                            <button class="timer-btn reset-btn" id="resetTimer1">Reset</button>
                            <button class="timer-btn audio-btn" id="audioToggle1" title="Toggle countdown sounds">🔊</button>
                        </div>
                        <div class="timer-status" id="timerStatus1">Ready to start</div>
                    </div>
                </div>

                <div class="step">
                    <h4>Step 2: Prepare Room Temperature Water</h4>
                    <p>Add 2/3 cup of tepid (not too hot, not too cold) water to a beaker and let it sit to come to room temperature.</p>
                    <div class="observation-input">
                        <label for="step2_notes">Notes/Observations:</label>
                        <textarea id="step2_notes" placeholder="Record any observations..."></textarea>
                    </div>
                </div>

                <div class="step">
                    <h4>Step 3: Prepare Ice Water Beaker</h4>
                    <p>After 10 minutes remove the ice cubes and measure out 2/3 cup of the ice water and put into a beaker.</p>
                    <div class="observation-input">
                        <label for="step3_notes">Notes/Observations:</label>
                        <textarea id="step3_notes" placeholder="Record any observations..."></textarea>
                    </div>
                </div>

                <!-- Timer Section for Step 3 -->
                <div class="timer-section">
                    <h4>10-Minute Timer for Temperature Equilibration</h4>
                    <div class="timer-container">
                        <div class="timer-display" id="timerDisplay2">10:00</div>
                        <div class="timer-controls">
                            <button class="timer-btn start-btn" id="startTimer2">Start Timer</button>
                            <button class="timer-btn reset-btn" id="resetTimer2">Reset</button>
                            <button class="timer-btn audio-btn" id="audioToggle2" title="Toggle countdown sounds">🔊</button>
                        </div>
                        <div class="timer-status" id="timerStatus2">Ready to start</div>
                    </div>
                </div>

                <div class="step">
                    <h4>Step 4: Prepare Hot Water</h4>
                    <p>Fill another beaker with 2/3 cup very hot tap water.</p>
                    <div class="observation-input">
                        <label for="step4_notes">Notes/Observations:</label>
                        <textarea id="step4_notes" placeholder="Record any observations..."></textarea>
                    </div>
                </div>

                <div class="step">
                    <h4>Step 5: Prepare Cold Water</h4>
                    <p>Fill another beaker with 2/3 cup very cold tap water.</p>
                    <div class="observation-input">
                        <label for="step5_notes">Notes/Observations:</label>
                        <textarea id="step5_notes" placeholder="Record any observations..."></textarea>
                    </div>
                </div>

                <div class="step">
                    <h4>Step 6: Arrange Beakers</h4>
                    <p>Place the beakers or cups side by side.</p>
                </div>

                <div class="step">
                    <h4>Step 7: Add Food Coloring Simultaneously</h4>
                    <p>With your helper and at the same time, put three drops of yellow food coloring in the beaker of very hot tap water, three drops of red food coloring in the beaker of room temperature water, three drops of green food coloring in the beaker of very cold tap water, and three drops of blue food coloring in the beaker of ice water. It is important to add the food coloring to the beakers at the same time. Have your helper add drops to 2 beakers at the same time that you add drops to the other 2 beakers. If you have a stopwatch start the timer as soon as the drops of food coloring enter the water.</p>
                    <div class="observation-input">
                        <label for="step7_notes">Timing and Setup Notes:</label>
                        <textarea id="step7_notes" placeholder="Record timing and coordination notes..."></textarea>
                    </div>
                </div>

                <!-- Up Counter for Reaction Timing -->
                <div class="timer-section">
                    <h4>Reaction Timer (Count Up)</h4>
                    <div class="timer-container">
                        <div class="timer-display" id="timerDisplay3">00:00</div>
                        <div class="timer-controls">
                            <button class="timer-btn start-btn" id="startTimer3">Start Timer</button>
                            <button class="timer-btn reset-btn" id="resetTimer3">Stop & Reset</button>
                            <button class="timer-btn audio-btn" id="audioToggle3" title="Toggle timer sounds">🔊</button>
                        </div>
                        <div class="timer-status" id="timerStatus3">Ready to start timing reaction</div>
                    </div>
                </div>

                <div class="step">
                    <h4>Step 8: Observe Without Mixing</h4>
                    <p>Do not mix the water. Allow the drops of food coloring to spread on their own.</p>
                </div>

                <!-- Timer for Diffusion Timing -->
                <div class="timer-section">
                    <h4>Diffusion Timer (Count Up)</h4>
                    <div class="timer-container">
                        <div class="timer-display" id="timerDisplay4">00:00</div>
                        <div class="timer-controls">
                            <button class="timer-btn start-btn" id="startTimer4">Start Timer</button>
                            <button class="timer-btn reset-btn" id="resetTimer4">Stop & Reset</button>
                            <button class="timer-btn audio-btn" id="audioToggle4" title="Toggle timer sounds">🔊</button>
                        </div>
                        <div class="timer-status" id="timerStatus4">Ready to time diffusion process</div>
                    </div>
                </div>

                <div class="step">
                    <h4>Step 9: Record Observations</h4>
                    <p>Observe which food coloring fills the water of the beaker first. (Diffusion is complete when the beakers are uniformly colored.) Record your observations in your data table. If you have a stopwatch record the times that the food coloring spread throughout the beakers.</p>
                    
                    <div class="data-table">
                        <h5>Diffusion Observations</h5>
                        <table>
                            <thead>
                                <tr>
                                    <th>Water Temperature</th>
                                    <th>Food Coloring</th>
                                    <th>Time to Complete Diffusion</th>
                                    <th>Order of Completion</th>
                                    <th>Observations</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Very Hot</td>
                                    <td>Yellow</td>
                                    <td><input type="text" id="hot_time" placeholder="Time or 'fastest/slowest'"></td>
                                    <td><input type="number" id="hot_order" placeholder="1-4" min="1" max="4"></td>
                                    <td><input type="text" id="hot_observations" placeholder="Describe what you observed"></td>
                                </tr>
                                <tr>
                                    <td>Room Temperature</td>
                                    <td>Red</td>
                                    <td><input type="text" id="room_time" placeholder="Time or 'fastest/slowest'"></td>
                                    <td><input type="number" id="room_order" placeholder="1-4" min="1" max="4"></td>
                                    <td><input type="text" id="room_observations" placeholder="Describe what you observed"></td>
                                </tr>
                                <tr>
                                    <td>Very Cold</td>
                                    <td>Green</td>
                                    <td><input type="text" id="cold_time" placeholder="Time or 'fastest/slowest'"></td>
                                    <td><input type="number" id="cold_order" placeholder="1-4" min="1" max="4"></td>
                                    <td><input type="text" id="cold_observations" placeholder="Describe what you observed"></td>
                                </tr>
                                <tr>
                                    <td>Ice Water</td>
                                    <td>Blue</td>
                                    <td><input type="text" id="ice_time" placeholder="Time or 'fastest/slowest'"></td>
                                    <td><input type="number" id="ice_order" placeholder="1-4" min="1" max="4"></td>
                                    <td><input type="text" id="ice_observations" placeholder="Describe what you observed"></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="step">
                    <h4>Step 10: Clean Up</h4>
                    <p>Pour the colored water down the drain and rinse and dry the beakers. Put everything away in its proper place.</p>
                </div>
            </div>

            <h2>Conclusions</h2>
            <div class="conclusions-section">
                <div class="question-group">
                    <label for="results_explanation">Explain your results by using the kinetic theory of matter and making connections to the text:</label>
                    <textarea id="results_explanation" placeholder="Explain your results using kinetic theory..."></textarea>
                </div>

                <div class="question-group">
                    <label for="hypothesis_check">Was your hypothesis correct? Explain:</label>
                    <textarea id="hypothesis_check" placeholder="Compare your results to your original hypothesis..."></textarea>
                </div>

                <div class="question-group">
                    <label for="temperature_relationship">What relationship did you observe between temperature and diffusion rate?</label>
                    <textarea id="temperature_relationship" placeholder="Describe the relationship you observed..."></textarea>
                </div>

                <div class="question-group">
                    <label for="real_world_applications">Give examples of where you might see this principle in real life:</label>
                    <textarea id="real_world_applications" placeholder="List real-world examples of temperature affecting diffusion..."></textarea>
                </div>
            </div>

            <div class="submit-section">
                <button id="submitResults" class="submit-btn">Submit Experiment Results</button>
                <div id="submitStatus" class="submit-status"></div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js" is:inline></script>
    <script>
        // Initialize EmailJS with error checking
        if (typeof emailjs !== 'undefined') {
            emailjs.init("ct_s19oZHppLy9BlW");
        }

        // Load saved email
        document.addEventListener('DOMContentLoaded', function() {
            const savedEmail = localStorage.getItem('studentEmail');
            if (savedEmail) {
                document.getElementById('studentEmail').value = savedEmail;
            }
        });

        // Save email when entered
        document.getElementById('studentEmail').addEventListener('change', function() {
            localStorage.setItem('studentEmail', this.value);
        });

        // Submit experiment results
        document.getElementById('submitResults').addEventListener('click', function() {
            const email = document.getElementById('studentEmail').value;
            
            if (!email) {
                alert('Please enter your email address before submitting.');
                return;
            }

            if (typeof emailjs === 'undefined') {
                alert('EmailJS is not loaded. Please refresh the page and try again.');
                return;
            }

            // Collect all experiment data
            const experimentData = {
                hypothesis: document.getElementById('hypothesis').value,
                step1_notes: document.getElementById('step1_notes').value,
                step2_notes: document.getElementById('step2_notes').value,
                step3_notes: document.getElementById('step3_notes').value,
                step4_notes: document.getElementById('step4_notes').value,
                step5_notes: document.getElementById('step5_notes').value,
                step7_notes: document.getElementById('step7_notes').value,
                
                // Data table results
                hot_time: document.getElementById('hot_time').value,
                hot_order: document.getElementById('hot_order').value,
                hot_observations: document.getElementById('hot_observations').value,
                room_time: document.getElementById('room_time').value,
                room_order: document.getElementById('room_order').value,
                room_observations: document.getElementById('room_observations').value,
                cold_time: document.getElementById('cold_time').value,
                cold_order: document.getElementById('cold_order').value,
                cold_observations: document.getElementById('cold_observations').value,
                ice_time: document.getElementById('ice_time').value,
                ice_order: document.getElementById('ice_order').value,
                ice_observations: document.getElementById('ice_observations').value,
                
                // Conclusions
                results_explanation: document.getElementById('results_explanation').value,
                hypothesis_check: document.getElementById('hypothesis_check').value,
                temperature_relationship: document.getElementById('temperature_relationship').value,
                real_world_applications: document.getElementById('real_world_applications').value
            };

            // Format data for email
            const message = `
EXPERIMENT 2.1: DIFFUSION AT DIFFERENT TEMPERATURES RESULTS
Student Email: ${email}
Submission Time: ${new Date().toLocaleString()}

=== HYPOTHESIS ===
${experimentData.hypothesis}

=== PROCEDURE NOTES ===
Step 1 (Ice Water Prep): ${experimentData.step1_notes}
Step 2 (Room Temp Prep): ${experimentData.step2_notes}
Step 3 (Ice Water Beaker): ${experimentData.step3_notes}
Step 4 (Hot Water): ${experimentData.step4_notes}
Step 5 (Cold Water): ${experimentData.step5_notes}
Step 7 (Food Coloring): ${experimentData.step7_notes}

=== DIFFUSION DATA ===
Very Hot Water (Yellow):
- Time: ${experimentData.hot_time}
- Order: ${experimentData.hot_order}
- Observations: ${experimentData.hot_observations}

Room Temperature Water (Red):
- Time: ${experimentData.room_time}
- Order: ${experimentData.room_order}
- Observations: ${experimentData.room_observations}

Very Cold Water (Green):
- Time: ${experimentData.cold_time}
- Order: ${experimentData.cold_order}
- Observations: ${experimentData.cold_observations}

Ice Water (Blue):
- Time: ${experimentData.ice_time}
- Order: ${experimentData.ice_order}
- Observations: ${experimentData.ice_observations}

=== CONCLUSIONS ===
Results Explanation (Kinetic Theory):
${experimentData.results_explanation}

Hypothesis Check:
${experimentData.hypothesis_check}

Temperature-Diffusion Relationship:
${experimentData.temperature_relationship}

Real-World Applications:
${experimentData.real_world_applications}
            `;

            // Extract student name from email or use default
            const studentName = email.split('@')[0] || 'Student';
            
            const templateParams = {
                student_name: studentName,
                student_email: email,
                experiment_title: 'Experiment 2.1: Diffusion at Different Temperatures',
                hypothesis: 'Exploring how temperature affects diffusion rates',
                missing_elements: 'Complete temperature observations and analysis',
                conclusion: message,
                subject: `Physical Science Experiment 2.1 Results - ${studentName}`
            };

            console.log('=== EXPERIMENT 2.1 RESULTS SUBMISSION ===');
            console.log('Student Email:', email);
            console.log('Experiment Title:', templateParams.experiment_title);
            console.log('Conclusion Content:', templateParams.conclusion);
            console.log('=== EMAILJS TEMPLATE PARAMETERS ===');
            console.log('student_email:', templateParams.student_email);
            console.log('experiment_title:', templateParams.experiment_title);
            console.log('conclusion:', templateParams.conclusion);
            console.log('=== END TEMPLATE PARAMETERS ===');

            document.getElementById('submitStatus').innerHTML = 'Sending results...';
            
            emailjs.send("service_ot1jg6s", "template_y556rhr", templateParams)
                .then(function(response) {
                    console.log('✅ EmailJS Success Response:', response);
                    document.getElementById('submitStatus').innerHTML = 
                        '<span style="color: green;">✓ Results sent successfully!</span>';
                }, function(error) {
                    console.error('❌ EmailJS Error:', error);
                    document.getElementById('submitStatus').innerHTML = 
                        '<span style="color: red;">✗ Failed to send results.</span>';
                });
        });

        // Timer functionality
        document.addEventListener('DOMContentLoaded', function() {
            // Audio context for beeps
            let audioCtx = null;
            let audioEnabled1 = true;
            let audioEnabled2 = true;
            let audioEnabled3 = true;
            let audioEnabled4 = true;

            function initAudioContext() {
                if (!audioCtx) {
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                }
            }

            function playCountdownBeep() {
                if (!audioCtx) return;
                const oscillator = audioCtx.createOscillator();
                const gainNode = audioCtx.createGain();
                oscillator.connect(gainNode);
                gainNode.connect(audioCtx.destination);
                oscillator.frequency.value = 800;
                oscillator.type = 'sine';
                gainNode.gain.setValueAtTime(0.3, audioCtx.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.1);
                oscillator.start(audioCtx.currentTime);
                oscillator.stop(audioCtx.currentTime + 0.1);
            }

            function playFinalBeep() {
                if (!audioCtx) return;
                const oscillator = audioCtx.createOscillator();
                const gainNode = audioCtx.createGain();
                oscillator.connect(gainNode);
                gainNode.connect(audioCtx.destination);
                oscillator.frequency.value = 1000;
                oscillator.type = 'sine';
                gainNode.gain.setValueAtTime(0.5, audioCtx.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.5);
                oscillator.start(audioCtx.currentTime);
                oscillator.stop(audioCtx.currentTime + 0.5);
            }

            // Timer 1 (10-minute countdown after Step 1)
            const timerDisplay1 = document.getElementById('timerDisplay1');
            const startTimerBtn1 = document.getElementById('startTimer1');
            const resetTimerBtn1 = document.getElementById('resetTimer1');
            const timerStatus1 = document.getElementById('timerStatus1');
            const audioToggle1 = document.getElementById('audioToggle1');
            let timerInterval1 = null;
            let timeRemaining1 = 600; // 10 minutes

            if (startTimerBtn1) {
                startTimerBtn1.addEventListener('click', function() {
                    if (timerInterval1) return;
                    initAudioContext();
                    startTimerBtn1.disabled = true;
                    timerDisplay1.classList.add('counting');
                    timerStatus1.textContent = 'Timer running... Ice water cooling';
                    
                    timerInterval1 = setInterval(function() {
                        timeRemaining1--;
                        const minutes = Math.floor(timeRemaining1 / 60);
                        const seconds = timeRemaining1 % 60;
                        timerDisplay1.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
                        
                        if (audioEnabled1 && timeRemaining1 <= 5 && timeRemaining1 > 0) {
                            playCountdownBeep();
                        }
                        
                        if (timeRemaining1 <= 0) {
                            clearInterval(timerInterval1);
                            timerInterval1 = null;
                            timerDisplay1.classList.remove('counting');
                            timerDisplay1.classList.add('finished');
                            timerStatus1.textContent = '⏰ Time\'s up! Ice water is ready.';
                            startTimerBtn1.disabled = false;
                            if (audioEnabled1) playFinalBeep();
                            
                            setTimeout(function() {
                                timeRemaining1 = 600;
                                timerDisplay1.textContent = '10:00';
                                timerDisplay1.classList.remove('counting', 'finished');
                                timerStatus1.textContent = 'Ready to start';
                            }, 2000);
                        }
                    }, 1000);
                });
            }

            if (resetTimerBtn1) {
                resetTimerBtn1.addEventListener('click', function() {
                    clearInterval(timerInterval1);
                    timerInterval1 = null;
                    timeRemaining1 = 600;
                    timerDisplay1.textContent = '10:00';
                    timerDisplay1.classList.remove('counting', 'finished');
                    timerStatus1.textContent = 'Ready to start';
                    startTimerBtn1.disabled = false;
                });
            }

            if (audioToggle1) {
                audioToggle1.addEventListener('click', function() {
                    audioEnabled1 = !audioEnabled1;
                    audioToggle1.textContent = audioEnabled1 ? '🔊' : '🔇';
                    audioToggle1.style.backgroundColor = audioEnabled1 ? '#4CAF50' : '#f44336';
                    audioToggle1.style.color = 'white';
                });
            }

            // Timer 2 (10-minute countdown after Step 3)
            const timerDisplay2 = document.getElementById('timerDisplay2');
            const startTimerBtn2 = document.getElementById('startTimer2');
            const resetTimerBtn2 = document.getElementById('resetTimer2');
            const timerStatus2 = document.getElementById('timerStatus2');
            const audioToggle2 = document.getElementById('audioToggle2');
            let timerInterval2 = null;
            let timeRemaining2 = 600; // 10 minutes

            if (startTimerBtn2) {
                startTimerBtn2.addEventListener('click', function() {
                    if (timerInterval2) return;
                    initAudioContext();
                    startTimerBtn2.disabled = true;
                    timerDisplay2.classList.add('counting');
                    timerStatus2.textContent = 'Timer running... Temperature equilibration';
                    
                    timerInterval2 = setInterval(function() {
                        timeRemaining2--;
                        const minutes = Math.floor(timeRemaining2 / 60);
                        const seconds = timeRemaining2 % 60;
                        timerDisplay2.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
                        
                        if (audioEnabled2 && timeRemaining2 <= 5 && timeRemaining2 > 0) {
                            playCountdownBeep();
                        }
                        
                        if (timeRemaining2 <= 0) {
                            clearInterval(timerInterval2);
                            timerInterval2 = null;
                            timerDisplay2.classList.remove('counting');
                            timerDisplay2.classList.add('finished');
                            timerStatus2.textContent = '⏰ Time\'s up! Temperature equilibrated.';
                            startTimerBtn2.disabled = false;
                            if (audioEnabled2) playFinalBeep();
                            
                            setTimeout(function() {
                                timeRemaining2 = 600;
                                timerDisplay2.textContent = '10:00';
                                timerDisplay2.classList.remove('counting', 'finished');
                                timerStatus2.textContent = 'Ready to start';
                            }, 2000);
                        }
                    }, 1000);
                });
            }

            if (resetTimerBtn2) {
                resetTimerBtn2.addEventListener('click', function() {
                    clearInterval(timerInterval2);
                    timerInterval2 = null;
                    timeRemaining2 = 600;
                    timerDisplay2.textContent = '10:00';
                    timerDisplay2.classList.remove('counting', 'finished');
                    timerStatus2.textContent = 'Ready to start';
                    startTimerBtn2.disabled = false;
                });
            }

            if (audioToggle2) {
                audioToggle2.addEventListener('click', function() {
                    audioEnabled2 = !audioEnabled2;
                    audioToggle2.textContent = audioEnabled2 ? '🔊' : '🔇';
                    audioToggle2.style.backgroundColor = audioEnabled2 ? '#4CAF50' : '#f44336';
                    audioToggle2.style.color = 'white';
                });
            }

            // Timer 3 (Count up timer after Step 7)
            const timerDisplay3 = document.getElementById('timerDisplay3');
            const startTimerBtn3 = document.getElementById('startTimer3');
            const resetTimerBtn3 = document.getElementById('resetTimer3');
            const timerStatus3 = document.getElementById('timerStatus3');
            const audioToggle3 = document.getElementById('audioToggle3');
            let timerInterval3 = null;
            let timeElapsed3 = 0;

            if (startTimerBtn3) {
                startTimerBtn3.addEventListener('click', function() {
                    if (timerInterval3) {
                        // Stop timer
                        clearInterval(timerInterval3);
                        timerInterval3 = null;
                        startTimerBtn3.textContent = 'Start Timer';
                        timerDisplay3.classList.remove('counting');
                        timerStatus3.textContent = `Reaction timed: ${Math.floor(timeElapsed3 / 60)}:${(timeElapsed3 % 60).toString().padStart(2, '0')}`;
                    } else {
                        // Start timer
                        initAudioContext();
                        startTimerBtn3.textContent = 'Stop Timer';
                        timerDisplay3.classList.add('counting');
                        timerStatus3.textContent = 'Timing reaction...';
                        
                        timerInterval3 = setInterval(function() {
                            timeElapsed3++;
                            const minutes = Math.floor(timeElapsed3 / 60);
                            const seconds = timeElapsed3 % 60;
                            timerDisplay3.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
                        }, 1000);
                    }
                });
            }

            if (resetTimerBtn3) {
                resetTimerBtn3.addEventListener('click', function() {
                    clearInterval(timerInterval3);
                    timerInterval3 = null;
                    timeElapsed3 = 0;
                    timerDisplay3.textContent = '00:00';
                    timerDisplay3.classList.remove('counting', 'finished');
                    timerStatus3.textContent = 'Ready to start timing reaction';
                    startTimerBtn3.textContent = 'Start Timer';
                });
            }

            if (audioToggle3) {
                audioToggle3.addEventListener('click', function() {
                    audioEnabled3 = !audioEnabled3;
                    audioToggle3.textContent = audioEnabled3 ? '🔊' : '🔇';
                    audioToggle3.style.backgroundColor = audioEnabled3 ? '#4CAF50' : '#f44336';
                    audioToggle3.style.color = 'white';
                });
            }

            // Timer 4 (Count up timer before Step 9)
            const timerDisplay4 = document.getElementById('timerDisplay4');
            const startTimerBtn4 = document.getElementById('startTimer4');
            const resetTimerBtn4 = document.getElementById('resetTimer4');
            const timerStatus4 = document.getElementById('timerStatus4');
            const audioToggle4 = document.getElementById('audioToggle4');
            let timerInterval4 = null;
            let timeElapsed4 = 0;

            if (startTimerBtn4) {
                startTimerBtn4.addEventListener('click', function() {
                    if (timerInterval4) {
                        // Stop timer
                        clearInterval(timerInterval4);
                        timerInterval4 = null;
                        startTimerBtn4.textContent = 'Start Timer';
                        timerDisplay4.classList.remove('counting');
                        timerStatus4.textContent = `Diffusion timed: ${Math.floor(timeElapsed4 / 60)}:${(timeElapsed4 % 60).toString().padStart(2, '0')}`;
                    } else {
                        // Start timer
                        initAudioContext();
                        startTimerBtn4.textContent = 'Stop Timer';
                        timerDisplay4.classList.add('counting');
                        timerStatus4.textContent = 'Timing diffusion process...';
                        
                        timerInterval4 = setInterval(function() {
                            timeElapsed4++;
                            const minutes = Math.floor(timeElapsed4 / 60);
                            const seconds = timeElapsed4 % 60;
                            timerDisplay4.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
                        }, 1000);
                    }
                });
            }

            if (resetTimerBtn4) {
                resetTimerBtn4.addEventListener('click', function() {
                    clearInterval(timerInterval4);
                    timerInterval4 = null;
                    timeElapsed4 = 0;
                    timerDisplay4.textContent = '00:00';
                    timerDisplay4.classList.remove('counting', 'finished');
                    timerStatus4.textContent = 'Ready to time diffusion process';
                    startTimerBtn4.textContent = 'Start Timer';
                });
            }

            if (audioToggle4) {
                audioToggle4.addEventListener('click', function() {
                    audioEnabled4 = !audioEnabled4;
                    audioToggle4.textContent = audioEnabled4 ? '🔊' : '🔇';
                    audioToggle4.style.backgroundColor = audioEnabled4 ? '#4CAF50' : '#f44336';
                    audioToggle4.style.color = 'white';
                });
            }
        });
    </script>

