---
import Layout from '../layouts/Layout.astro';
---

<Layout 
	title="Classes - C00lnerd Tutoring"
	description="Physical Science and Programming classes for homeschool students"
>
	<div class="min-h-screen bg-gray-50">
		<!-- Navigation -->
		<nav class="bg-white shadow-lg sticky top-0 z-50">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex justify-between items-center h-16">
					<div class="flex items-center">
						<a href="/" class="text-2xl font-bold text-blue-600">C00lnerd</a>
					</div>
					<div class="hidden md:block">
						<div class="ml-10 flex items-baseline space-x-4">
							<a href="/" class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium transition-colors">Home</a>
							<a href="/about" class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium transition-colors">About</a>
							<a href="#contact" class="bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700 transition-colors">Contact</a>
						</div>
					</div>
				</div>
			</div>
		</nav>

		<!-- Header -->
		<section class="bg-gradient-to-br from-blue-50 to-indigo-100 py-16">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
				<h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">Classes</h1>
				<p class="text-xl text-gray-600 max-w-3xl mx-auto">
					Comprehensive STEM curriculum designed for homeschool students
				</p>
			</div>
		</section>

		<!-- Physical Science Class -->
		<section class="py-20">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="bg-white rounded-xl shadow-lg p-8 mb-12">
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
						<div>
							<h2 class="text-3xl font-bold text-gray-900 mb-6">Physical Science</h2>
							<p class="text-lg text-gray-700 mb-6">
								Complete 32-week curriculum covering fundamental physics and chemistry concepts through hands-on experiments and interactive learning.
							</p>
							<div class="space-y-4 mb-8">
								<div class="flex items-center">
									<i class="fas fa-check text-green-600 mr-3"></i>
									<span>15 comprehensive modules</span>
								</div>
								<div class="flex items-center">
									<i class="fas fa-check text-green-600 mr-3"></i>
									<span>Hands-on experiments with real equipment</span>
								</div>
								<div class="flex items-center">
									<i class="fas fa-check text-green-600 mr-3"></i>
									<span>Interactive quizzes and assessments</span>
								</div>
								<div class="flex items-center">
									<i class="fas fa-check text-green-600 mr-3"></i>
									<span>90-minute weekly sessions</span>
								</div>
							</div>
							<a href="#contact" class="bg-green-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-green-700 transition-colors">
								Enroll Now
							</a>
						</div>
						<div class="bg-gradient-to-br from-green-100 to-emerald-200 p-8 rounded-xl">
							<i class="fas fa-atom text-8xl text-green-600 mb-4"></i>
							<h3 class="text-xl font-semibold text-gray-900 mb-2">What You'll Learn</h3>
							<ul class="text-gray-700 space-y-2">
								<li>• Motion and Forces</li>
								<li>• Energy and Matter</li>
								<li>• Waves and Sound</li>
								<li>• Light and Optics</li>
								<li>• Electricity and Magnetism</li>
								<li>• Atomic Structure</li>
								<li>• Chemical Reactions</li>
							</ul>
						</div>
					</div>
				</div>

				<!-- Programming Class -->
				<div class="bg-white rounded-xl shadow-lg p-8">
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
						<div class="bg-gradient-to-br from-purple-100 to-violet-200 p-8 rounded-xl">
							<i class="fas fa-code text-8xl text-purple-600 mb-4"></i>
							<h3 class="text-xl font-semibold text-gray-900 mb-2">Technologies</h3>
							<ul class="text-gray-700 space-y-2">
								<li>• Python Programming</li>
								<li>• Arduino Microcontrollers</li>
								<li>• miniAuto Robotics Platform</li>
								<li>• Sensor Integration</li>
								<li>• Competition Preparation</li>
								<li>• Project-based Learning</li>
							</ul>
						</div>
						<div>
							<h2 class="text-3xl font-bold text-gray-900 mb-6">Programming & Robotics</h2>
							<p class="text-lg text-gray-700 mb-6">
								Learn programming fundamentals through robotics projects using Python and Arduino. Build real robots and compete in challenges.
							</p>
							<div class="space-y-4 mb-8">
								<div class="flex items-center">
									<i class="fas fa-check text-purple-600 mr-3"></i>
									<span>32-week comprehensive curriculum</span>
								</div>
								<div class="flex items-center">
									<i class="fas fa-check text-purple-600 mr-3"></i>
									<span>Hands-on robot building</span>
								</div>
								<div class="flex items-center">
									<i class="fas fa-check text-purple-600 mr-3"></i>
									<span>Competition preparation</span>
								</div>
								<div class="flex items-center">
									<i class="fas fa-check text-purple-600 mr-3"></i>
									<span>Real-world programming skills</span>
								</div>
							</div>
							<a href="#contact" class="bg-purple-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-purple-700 transition-colors">
								Enroll Now
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Contact Section -->
		<section id="contact" class="py-20 bg-blue-600">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
				<h2 class="text-3xl font-bold text-white mb-4">Ready to Enroll?</h2>
				<p class="text-xl text-blue-100 mb-8">Contact me to discuss class schedules and enrollment</p>
				<a href="mailto:chuck@c00lnerd.com" class="bg-white text-blue-600 px-8 py-3 rounded-lg font-semibold hover:bg-gray-100 transition-colors">
					Email Chuck
				</a>
			</div>
		</section>
	</div>
</Layout>
