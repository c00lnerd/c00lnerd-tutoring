---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Classes - C00lnerd Tutoring">
  <main class="min-h-screen bg-gray-50">
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-blue-50 to-indigo-100 py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
            Available <span class="text-blue-600">Classes</span>
          </h1>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Comprehensive STEM courses designed for homeschool students with hands-on learning and real-world applications
          </p>
        </div>
      </div>
    </section>

    <!-- Classes Grid -->
    <section class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
          
          <!-- Physical Science Class -->
          <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <div class="bg-gradient-to-br from-green-50 to-emerald-100 p-8">
              <div class="text-center">
                <i class="fas fa-atom text-5xl text-green-600 mb-4"></i>
                <h2 class="text-3xl font-bold text-gray-900">Physical Science</h2>
                <p class="text-green-700 font-semibold mt-2">15 Comprehensive Modules</p>
              </div>
            </div>
            <div class="p-8">
              <h3 class="text-xl font-bold text-gray-900 mb-4">Course Overview</h3>
              <p class="text-gray-600 mb-6">
                A complete physical science curriculum covering fundamental concepts in physics and chemistry through hands-on experiments and interactive learning.
              </p>
              
              <h4 class="font-semibold text-gray-900 mb-3">What's Included:</h4>
              <ul class="space-y-2 text-gray-700 mb-6">
                <li class="flex items-center"><i class="fas fa-check text-green-600 mr-2"></i> 15 detailed lesson modules</li>
                <li class="flex items-center"><i class="fas fa-check text-green-600 mr-2"></i> Hands-on laboratory experiments</li>
                <li class="flex items-center"><i class="fas fa-check text-green-600 mr-2"></i> Interactive quizzes and assessments</li>
                <li class="flex items-center"><i class="fas fa-check text-green-600 mr-2"></i> 90-minute weekly sessions</li>
                <li class="flex items-center"><i class="fas fa-check text-green-600 mr-2"></i> Complete materials list</li>
              </ul>

              <div class="flex gap-4">
                <a href="/physical-science" class="flex-1 bg-green-600 text-white text-center py-3 rounded-lg font-semibold hover:bg-green-700 transition-colors">
                  View Curriculum
                </a>
                <a href="#contact" class="flex-1 border-2 border-green-600 text-green-600 text-center py-3 rounded-lg font-semibold hover:bg-green-50 transition-colors">
                  Enroll Now
                </a>
              </div>
            </div>
          </div>

          <!-- Physics Class -->
          <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <div class="bg-gradient-to-br from-blue-50 to-cyan-100 p-8">
              <div class="text-center">
                <i class="fas fa-bullseye text-5xl text-blue-600 mb-4"></i>
                <h2 class="text-3xl font-bold text-gray-900">Physics</h2>
                <p class="text-blue-700 font-semibold mt-2">2 Semesters · 32 Weeks</p>
              </div>
            </div>
            <div class="p-8">
              <h3 class="text-xl font-bold text-gray-900 mb-4">Course Overview</h3>
              <p class="text-gray-600 mb-6">
                An algebra-based high school physics course built roughly on <em>Exploring Creation with Physics</em>, 2nd edition, with mechanics in semester 1 and waves, optics, electricity, and magnetism in semester 2.
              </p>

              <h4 class="font-semibold text-gray-900 mb-3">What's Included:</h4>
              <ul class="space-y-2 text-gray-700 mb-6">
                <li class="flex items-center"><i class="fas fa-check text-blue-600 mr-2"></i> 16 physics modules across 2 semesters</li>
                <li class="flex items-center"><i class="fas fa-check text-blue-600 mr-2"></i> Weekly mechanics, waves, optics, and E&amp;M pacing</li>
                <li class="flex items-center"><i class="fas fa-check text-blue-600 mr-2"></i> Hands-on experiments and lab activities</li>
                <li class="flex items-center"><i class="fas fa-check text-blue-600 mr-2"></i> Structured weekly problem-solving progression</li>
                <li class="flex items-center"><i class="fas fa-check text-blue-600 mr-2"></i> Semester-by-semester course navigation</li>
              </ul>

              <div class="flex gap-4">
                <a href="/physics.html" class="flex-1 bg-blue-600 text-white text-center py-3 rounded-lg font-semibold hover:bg-blue-700 transition-colors">
                  View Curriculum
                </a>
                <a href="#contact" class="flex-1 border-2 border-blue-600 text-blue-600 text-center py-3 rounded-lg font-semibold hover:bg-blue-50 transition-colors">
                  Enroll Now
                </a>
              </div>
            </div>
          </div>

          <!-- Programming Class -->
          <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <div class="bg-gradient-to-br from-purple-50 to-violet-100 p-8">
              <div class="text-center">
                <i class="fas fa-code text-5xl text-purple-600 mb-4"></i>
                <h2 class="text-3xl font-bold text-gray-900">Programming & Robotics</h2>
                <p class="text-purple-700 font-semibold mt-2">32-Week Curriculum</p>
              </div>
            </div>
            <div class="p-8">
              <h3 class="text-xl font-bold text-gray-900 mb-4">Course Overview</h3>
              <p class="text-gray-600 mb-6">
                Learn programming fundamentals through Python and Arduino, culminating in robotics projects and competition preparation.
              </p>
              
              <h4 class="font-semibold text-gray-900 mb-3">What's Included:</h4>
              <ul class="space-y-2 text-gray-700 mb-6">
                <li class="flex items-center"><i class="fas fa-check text-purple-600 mr-2"></i> Python programming fundamentals</li>
                <li class="flex items-center"><i class="fas fa-check text-purple-600 mr-2"></i> Arduino microcontroller projects</li>
                <li class="flex items-center"><i class="fas fa-check text-purple-600 mr-2"></i> miniAuto robotics platform</li>
                <li class="flex items-center"><i class="fas fa-check text-purple-600 mr-2"></i> Competition project development</li>
                <li class="flex items-center"><i class="fas fa-check text-purple-600 mr-2"></i> Weekly coding challenges</li>
              </ul>

              <div class="flex gap-4">
                <a href="/programming.html" class="flex-1 bg-purple-600 text-white text-center py-3 rounded-lg font-semibold hover:bg-purple-700 transition-colors">
                  View Curriculum
                </a>
                <a href="#contact" class="flex-1 border-2 border-purple-600 text-purple-600 text-center py-3 rounded-lg font-semibold hover:bg-purple-50 transition-colors">
                  Enroll Now
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Individual Tutoring Section -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Individual Tutoring</h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Personalized one-on-one instruction tailored to your student's specific needs and learning pace
          </p>
        </div>

        <div class="bg-gradient-to-br from-orange-50 to-amber-100 rounded-xl p-8 shadow-lg">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
            <div>
              <h3 class="text-2xl font-bold text-gray-900 mb-4">Subjects Available</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <h4 class="font-semibold text-gray-900 mb-2">Mathematics</h4>
                  <ul class="text-gray-700 space-y-1">
                    <li>• Algebra I & II</li>
                    <li>• Precalculus</li>
                    <li>• Calculus I & II</li>
                    <li>• Geometry</li>
                  </ul>
                </div>
                <div>
                  <h4 class="font-semibold text-gray-900 mb-2">Sciences</h4>
                  <ul class="text-gray-700 space-y-1">
                    <li>• Physics</li>
                    <li>• Chemistry</li>
                    <li>• Physical Science</li>
                    <li>• Engineering Concepts</li>
                  </ul>
                </div>
              </div>
            </div>
            <div class="text-center">
              <div class="bg-white p-6 rounded-lg shadow-md mb-6">
                <i class="fas fa-user-graduate text-4xl text-orange-600 mb-4"></i>
                <h4 class="text-lg font-semibold text-gray-900">Personalized Learning</h4>
                <p class="text-gray-600 text-sm">Customized to your student's pace and learning style</p>
              </div>
              <a href="#contact" class="bg-orange-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-orange-700 transition-colors">
                Schedule Consultation
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="py-20 bg-blue-600">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Ready to Enroll?</h2>
          <p class="text-xl text-blue-100 max-w-3xl mx-auto">
            Contact me to discuss enrollment, schedules, and how these classes can benefit your student
          </p>
        </div>
        
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <div class="bg-white p-6 rounded-xl shadow-lg text-center">
            <i class="fas fa-envelope text-3xl text-blue-600 mb-4"></i>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Email</h3>
            <a href="mailto:chuck@c00lnerd.com" class="text-blue-600 hover:underline">chuck@c00lnerd.com</a>
          </div>
          
          <div class="bg-white p-6 rounded-xl shadow-lg text-center">
            <i class="fas fa-calendar text-3xl text-blue-600 mb-4"></i>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Free Consultation</h3>
            <p class="text-gray-600">30-minute discussion about your student's needs</p>
          </div>
          
          <div class="bg-white p-6 rounded-xl shadow-lg text-center">
            <i class="fas fa-clock text-3xl text-blue-600 mb-4"></i>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Quick Response</h3>
            <p class="text-gray-600">I'll get back to you within 24 hours</p>
          </div>
        </div>

        <div class="text-center mt-8">
          <a href="/" class="bg-white text-blue-600 px-8 py-3 rounded-lg font-semibold hover:bg-gray-50 transition-colors">
            Back to Homepage
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
