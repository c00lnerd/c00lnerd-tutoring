                    </div>
                    <div class="bg-gray-800 text-green-400 p-4 rounded-lg font-mono text-sm">
                        <pre class="text-green-400 whitespace-pre-wrap">{`// Basic miniAuto program structure
#include "miniAuto.h"

void setup() {
    Serial.begin(115200);
    miniAuto.init();  // Initialize robot systems
    Serial.println("🤖 miniAuto Ready!");
    // Startup sequence
    miniAuto.setLED(BLUE);
    miniAuto.playTone(440, 200);
    delay(1000);
    miniAuto.setLED(GREEN);
}

void loop() {
    // Main robot behavior
    float distance = miniAuto.getDistance();
    float battery = miniAuto.getBatteryVoltage();
    // Display status
    Serial.print("Distance: ");
    Serial.print(distance);
    Serial.print("cm, Battery: ");
    Serial.print(battery);
    Serial.println("V");
    // Simple obstacle avoidance
    if (distance > 30) {
        miniAuto.moveForward(150);
        miniAuto.setLED(GREEN);
    } else if (distance > 10) {
        miniAuto.moveForward(80);  // Slow down
        miniAuto.setLED(YELLOW);
    } else {
        miniAuto.stop();
        miniAuto.setLED(RED);
        miniAuto.turnRight(150);
        delay(500);
    }
    delay(100);
}`}</pre>
