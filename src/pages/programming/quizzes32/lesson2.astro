        let emailjsReady = false;
        
        // Wait for EmailJS to load, then initialize
        window.addEventListener('load', function() {
            if (typeof (window as any).emailjs !== 'undefined') {
                (window as any).emailjs.init('ct_s19oZHppLy9BlW');
                emailjsReady = true;
                console.log('EmailJS initialized successfully');
            } else {
                console.error('EmailJS failed to load');
            }
        });
        // Quiz data with correct answers
        const quizData = {
            correctAnswers: {
                q1: 'B',
                q2: 'A',
                q3: 'B',
                q4: 'B',
                q5: 'B',
                q6: 'B'
            },
            questionText: {
                q1: 'Pin Modes',
                q2: 'Digital Output',
                q3: 'Serial Output',
                q4: 'Variables',
                q5: 'Conditionals',
                q6: 'Syntax',
                q7: 'Assignment vs Comparison',
                q8: 'Blink-and-Count Program'
            }
        };

        document.getElementById('quizForm')?.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const submitBtn = document.getElementById('submitBtn');
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.textContent = 'Submitting...';
            }
            
            // Check if EmailJS is available
            if (!emailjsReady || typeof window.emailjs === 'undefined') {
                alert('Email service is not available. Please refresh the page and try again.');
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Submit Quiz';
                }
                return;
            }
            
            // Get form data
            const formData = new FormData(this);
            const studentNameEl = document.getElementById('quiz2StudentName');
            const studentEmailEl = document.getElementById('quiz2StudentEmail');
            const studentName = studentNameEl ? studentNameEl.value : '';
            const studentEmail = studentEmailEl ? studentEmailEl.value : '';
            
            // Calculate score and build results
            let score = 0;
            let totalQuestions = 6; // Multiple choice questions only
            let results = [];
            
            // Check multiple choice answers
            for (let i = 1; i <= 6; i++) {
                const questionKey = `q${i}`;
                const studentAnswer = formData.get(questionKey);
                const correctAnswer = (quizData.correctAnswers as any)[questionKey];
                const isCorrect = studentAnswer === correctAnswer;
                
                if (isCorrect) score++;
                
                results.push({
                    question: (quizData.questionText as any)[questionKey],
                    studentAnswer: studentAnswer || 'No answer',
                    correctAnswer: correctAnswer,
                    isCorrect: isCorrect
                });
            }
            
            // Add short answer questions
            results.push({
                question: quizData.questionText.q7,
                studentAnswer: formData.get('q7') || 'No answer provided',
                isShortAnswer: true
            });
            
            results.push({
                question: quizData.questionText.q8,
                studentAnswer: formData.get('q8') || 'No answer provided',
                isShortAnswer: true
            });
            
            const percentage = Math.round((score / totalQuestions) * 100);
            
            // Build detailed message
            let message = `LESSON 2 QUIZ RESULTS - Digital Output, Variables, and Serial Output\n\n`;
            message += `Student: ${studentName}\n`;
            message += `Email: ${studentEmail}\n`;
            message += `Score: ${score}/${totalQuestions} (${percentage}%)\n\n`;
            
            message += `DETAILED RESULTS:\n`;
            message += `==================\n\n`;
            
            results.forEach((result, index) => {
                if (result.isShortAnswer) {
                    message += `${result.question}:\n`;
                    message += `Answer: ${result.studentAnswer}\n\n`;
                } else {
                    const status = result.isCorrect ? '? CORRECT' : '? INCORRECT';
                    message += `Q${index + 1}: ${result.question}\n`;
                    message += `Student Answer: ${result.studentAnswer}\n`;
                    message += `Correct Answer: ${result.correctAnswer}\n`;
                    message += `Status: ${status}\n\n`;
                }
            });
            
            // Performance analysis with emoji feedback
            message += `PERFORMANCE ANALYSIS:\n`;
            message += `=====================\n`;
            if (percentage >= 90) {
                message += `?? EXCELLENT! Excellent understanding of digital output, variables, serial messages, and basic Arduino syntax.\n`;
                message += `The student demonstrates strong readiness for the next programming concepts.\n`;
            } else if (percentage >= 80) {
                message += `?? VERY GOOD! Very good understanding of Lesson 2 programming concepts.\n`;
                message += `The student shows good comprehension of pins, variables, and syntax.\n`;
            } else if (percentage >= 70) {
                message += `?? GOOD! Good start with Arduino programming basics, with a few areas needing more practice.\n`;
                message += `Recommend additional practice with serial output, conditionals, and syntax.\n`;
            } else if (percentage >= 60) {
                message += `?? NEEDS IMPROVEMENT! Needs improvement on some key Lesson 2 concepts.\n`;
                message += `Suggest reviewing pin modes, variables, and syntax examples from the lesson.\n`;
            } else {
                message += `?? REQUIRES ATTENTION! Requires more review of the basic Arduino programming ideas from Lesson 2.\n`;
                message += `Recommend extra guided practice with simple code examples and the Serial Monitor.\n`;
            }
            
            message += `\nNext Steps: Practice blink programs, serial messages, and conditionals before moving to Lesson 3.\n`;
            message += `\nSubmitted: ${new Date().toLocaleString()}\n`;
            
            // Display results to student
            let grade = 'F';
            if (percentage >= 90) grade = 'A';
            else if (percentage >= 80) grade = 'B';
            else if (percentage >= 70) grade = 'C';
            else if (percentage >= 60) grade = 'D';
            
            const resultsHTML = `
                <div style="text-align: center; margin-bottom: 1rem;">
                    <div style="font-size: 2rem; font-weight: bold; color: #4a148c;">${score}/${totalQuestions} (${percentage}%)</div>
                    <div style="font-size: 1.5rem; font-weight: bold; color: #4a148c;">Grade: ${grade}</div>
                    <div style="margin-top: 1rem; padding: 1rem; background: #e8f5e8; border-radius: 6px; color: #2e7d32; font-weight: bold;">
