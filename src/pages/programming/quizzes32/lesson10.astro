        // Quiz data with correct answers
        const quizData = {
            correctAnswers: {
                q1: 'B', // PWM allows brightness control and smooth transitions
                q2: 'B', // To prevent excessive current that could damage the LED
                q3: 'B', // 0 to 255
                q4: 'B', // Active buzzers have fixed frequency, passive buzzers allow frequency control
                q5: 'C', // PWM signals with specific pulse widths
                q6: 'B', // 0° to 180°
                q7: 'C', // tone()
                q8: 'B'  // servo.write()
            },
            questionText: {
                q1: "What is the main advantage of using PWM output instead of digital output for LED control?",
                q2: "Why do LEDs require current limiting resistors?",
                q3: "What range of values can be used with analogWrite() for PWM output?",
                q4: "What is the main difference between active and passive buzzers?",
                q5: "What type of signal is used to control servo motor position?",
                q6: "What is the typical position range for a standard servo motor?",
                q7: "What Arduino function is used to generate musical tones with a passive buzzer?",
                q8: "Which Arduino library function is used to set a servo to a specific position?",
                q9: "You want to create an RGB LED mood light that changes colors based on room temperature. Describe how you would connect and program this system, including what input device you'd use and how you'd map temperature to colors.",
                q10: "A student reports that their servo motor is \"jittery\" and doesn't hold its position steadily. It also seems to move to random positions occasionally. What are three possible causes of this problem and how would you fix each one?"
            }
        };

        document.getElementById('quizForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const studentName = document.getElementById('quiz10StudentName').value;
            const studentEmail = document.getElementById('quiz10StudentEmail').value;
            
            if (!studentName || !studentEmail) {
                alert('Please fill in your name and email address.');
                return;
            }

            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting...';
            
            const formData = new FormData(this);
            const results = [];
            let score = 0;
            const totalQuestions = 8; // Multiple choice questions only for scoring
            
            // Check multiple choice answers (q1-q8)
            for (let i = 1; i <= 8; i++) {
                const questionKey = `q${i}`;
                const userAnswer = formData.get(questionKey);
                const correctAnswer = quizData.correctAnswers[questionKey];
                const isCorrect = userAnswer === correctAnswer;
                
                if (isCorrect) score++;
                
                results.push({
                    question: quizData.questionText[questionKey],
                    userAnswer: userAnswer || 'No answer provided',
                    correctAnswer: correctAnswer,
                    isCorrect: isCorrect
                });
            }
            
            // Add short answer questions
            results.push({
                question: quizData.questionText.q9,
                studentAnswer: formData.get('q9') || 'No answer provided',
                isShortAnswer: true
            });
            
            results.push({
                question: quizData.questionText.q10,
                studentAnswer: formData.get('q10') || 'No answer provided',
                isShortAnswer: true
            });
            
            const percentage = Math.round((score / totalQuestions) * 100);
            
            // Build detailed message
            let message = `WEEK 10 QUIZ RESULTS - Output Devices and Actuators\n\n`;
            message += `Student: ${studentName}\n`;
            message += `Email: ${studentEmail}\n`;
            message += `Score: ${score}/${totalQuestions} (${percentage}%)\n\n`;
            
            message += `DETAILED RESULTS:\n`;
            message += `==================\n\n`;
            
            results.forEach((result, index) => {
                if (result.isShortAnswer) {
                    message += `${result.question}:\n`;
                    message += `Answer: ${result.studentAnswer}\n\n`;
                } else {
                    const status = result.isCorrect ? '✓ CORRECT' : '✗ INCORRECT';
                    message += `Q${index + 1}: ${result.question}\n`;
                    message += `Student Answer: ${result.userAnswer}\n`;
                    message += `Correct Answer: ${result.correctAnswer}\n`;
                    message += `Status: ${status}\n\n`;
                }
            });
            
            message += `PERFORMANCE ANALYSIS:\n`;
            message += `====================\n`;
            if (percentage >= 90) {
                message += `🌟 EXCELLENT! Outstanding understanding of output devices and control systems.\n`;
                message += `Student demonstrates mastery of PWM control, servo programming, and actuator integration.\n`;
            } else if (percentage >= 80) {
                message += `🎉 VERY GOOD! Strong grasp of output device fundamentals and control techniques.\n`;
                message += `Student shows solid understanding with minor areas for review.\n`;
            } else if (percentage >= 70) {
                message += `👍 GOOD! Basic understanding of output devices with room for improvement.\n`;
                message += `Recommend additional practice with PWM control and servo programming.\n`;
            } else if (percentage >= 60) {
                message += `⚠️ NEEDS IMPROVEMENT. Some understanding but requires more practice.\n`;
                message += `Focus on PWM concepts, buzzer types, and servo control signals.\n`;
            } else {
                message += `🔄 REQUIRES ATTENTION! Limited understanding of output device concepts.\n`;
                message += `Recommend reviewing lesson materials and hands-on actuator experiments.\n`;
            }
            
            message += `\nNext Steps: Prepare for integrated sensor-actuator projects and Week 11: Motor Control\n`;
            message += `\nSubmitted: ${new Date().toLocaleString()}\n`;
            
            // Display results to student
            let grade = 'F';
            if (percentage >= 90) grade = 'A';
            else if (percentage >= 80) grade = 'B';
            else if (percentage >= 70) grade = 'C';
            else if (percentage >= 60) grade = 'D';
            
            const resultsHTML = `
                <div style="text-align: center; margin-bottom: 1rem;">
                    <div style="font-size: 2rem; font-weight: bold; color: #059669;">${score}/${totalQuestions} (${percentage}%)</div>
                    <div style="font-size: 1.5rem; font-weight: bold; color: #059669;">Grade: ${grade}</div>
                    <div style="margin-top: 1rem; padding: 1rem; background: #d1fae5; border-radius: 6px; color: #059669; font-weight: bold;">
                        ⚡ Week 10: Output Devices and Actuators
                    </div>
                </div>
                <div style="text-align: left;">
                    ${results.map((r, index) => {
                        if (r.isShortAnswer) {
                            return `
                                <div style="margin-bottom: 1rem; padding: 1rem; background: #f0f9ff; border-radius: 6px;">
                                    <strong>${r.question}:</strong><br>
                                    <strong>Your answer:</strong> ${r.studentAnswer}
                                </div>
                            `;
                        } else {
                            return `
                                <div style="margin-bottom: 1rem; padding: 1rem; background: ${r.isCorrect ? '#e8f5e8' : '#ffeaea'}; border-radius: 6px;">
                                    <strong>Question ${index + 1}:</strong> ${r.isCorrect ? '✓' : '✗'}<br>
                                    <strong>Your answer:</strong> ${r.userAnswer}<br>
                                    <strong>Correct answer:</strong> ${r.correctAnswer}
                                </div>
                            `;
                        }
                    }).join('')}
                </div>
            `;
            
            document.getElementById('resultsContent').innerHTML = resultsHTML;
            document.getElementById('quizResults').style.display = 'block';
            
            // Scroll to results
            document.getElementById('quizResults').scrollIntoView({ behavior: 'smooth' });
            
            // Send email using EmailJS
            // Check if EmailJS is available
            if (typeof (window as any).emailjs === 'undefined') {
                alert('Email service is not available. Please refresh the page and try again.');
                return;
            }
            
            // Initialize EmailJS right before sending
            (window as any).emailjs.init('ct_s19oZHppLy9BlW');
            
            (window as any).emailjs.send('service_ot1jg6s', 'template_io02xtm', {
                to_email: 'chuck@c00lnerd.com',
                from_name: 'C00lnerd Quiz System',
                from_email: 'chuck@c00lnerd.com',
                
                message: message,
                subject: `Week 10 Output Devices Quiz - ${studentName} (${percentage}%)`
            }).then(function(response) {
                console.log('Quiz results sent successfully!', response.status, response.text);
                alert('Quiz results sent successfully!');
                
                // Log to Google Sheets
                console.log('Logging quiz results to Google Sheets...');
                fetch('https://script.google.com/macros/s/AKfycbyiA4c14AqtPjr6T8OUXQkGoJ4C3QQnK6WHCdCa2xBDKx1SZreL0Y-sk70YJoa0OzME8w/exec', {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        studentName: studentName,
                        studentEmail: studentEmail,
                        week: 'Week 10',
                        topic: 'Servo Motors & Precise Control',
                        score: score,
                        totalPoints: totalQuestions,
                        percentage: percentage,
                        grade: percentage >= 90 ? 'A' : percentage >= 80 ? 'B' : percentage >= 70 ? 'C' : percentage >= 60 ? 'D' : 'F',
                        timestamp: new Date().toISOString()
                    })
                })
                .then(() => console.log('Quiz results logged to Google Sheets successfully!'))
                .catch(error => console.log('Note: CORS error expected in localhost - Google Sheets logging will work in production:', error));
                
            }, function(error) {
                console.log('Failed to send quiz results...', error);
                alert('There was an issue sending your quiz results. Please contact your instructor.');
            });
        });
    </script>
</Layout>


