---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Lesson 13 Quiz: Display Devices - C00lnerd Tutoring">
    <div style="max-width: 800px; margin: 0 auto; padding: 2rem;">
        
            <!-- Header -->
            <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 2rem; border-radius: 10px; margin-bottom: 2rem; text-align: center;">
                <h1 style="font-size: 2rem; font-weight: bold; margin: 0;">Lesson 13 Quiz: Display Devices</h1>
                <p class="text-xl text-gray-600">Test your understanding of I2C wiring, LCD libraries, and non-blocking screen updates</p>
                <div class="mt-4 p-4 bg-purple-100 rounded-lg">
                    <p class="text-purple-800 font-medium">📺 10 questions covering I2C, LiquidCrystal_I2C, cursor control, and timed refresh</p>
                </div>
            </div>

            <!-- Student Information -->
            <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
                <h2 class="text-2xl font-bold text-purple-800 mb-6">Student Information</h2>
                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <label for="quiz13StudentName" class="block text-sm font-medium text-gray-700 mb-2">Full Name</label>
                        <input type="text" id="quiz13StudentName" name="studentName" required 
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500">
                    </div>
                    <div>
                        <label for="quiz13StudentEmail" class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
                        <input type="email" id="quiz13StudentEmail" name="studentEmail" required 
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500">
                    </div>
                </div>
            </div>

            <!-- Quiz Questions -->
            <form id="quizForm" autocomplete="off" class="space-y-8">
                <!-- Question 1 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 1: Why I2C?</h3>
                    <p class="text-gray-700 mb-4">What is the main reason we use an LCD with an I2C backpack instead of wiring the bare 16×2 display?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="A" class="mr-3">
                            <span>A) I2C makes the screen brighter</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="B" class="mr-3">
                            <span>B) The bare display needs six data/control pins; the backpack needs only two shared bus wires</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="C" class="mr-3">
                            <span>C) I2C displays can show color graphics</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="D" class="mr-3">
                            <span>D) The backpack stores images for the LCD</span>
                        </label>
                    </div>
                </div>

                <!-- Question 2 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 2: I2C Wiring</h3>
                    <p class="text-gray-700 mb-4">On the Arduino Uno, which pins carry the I2C bus — and what do SDA and SCL mean?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="A" class="mr-3">
                            <span>A) A4 = SDA (data), A5 = SCL (clock)</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="B" class="mr-3">
                            <span>B) A4 = SCL (clock), A5 = SDA (data)</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="C" class="mr-3">
                            <span>C) Pin 0 = SDA, pin 1 = SCL</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="D" class="mr-3">
                            <span>D) Any two analog pins you choose in code</span>
                        </label>
                    </div>
                </div>

                <!-- Question 3 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 3: The Address</h3>
                    <p class="text-gray-700 mb-4">In <code>LiquidCrystal_I2C lcd(0x27, 16, 2)</code>, what is <code>0x27</code>?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="A" class="mr-3">
                            <span>A) The pin number the display is connected to</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="B" class="mr-3">
                            <span>B) The display's firmware version</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="C" class="mr-3">
                            <span>C) The device's address on the shared I2C bus — how the Arduino picks which chip to talk to</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="D" class="mr-3">
                            <span>D) The number of characters the screen can hold</span>
                        </label>
                    </div>
                </div>

                <!-- Question 4 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 4: Blank Screen</h3>
                    <p class="text-gray-700 mb-4">Your display shows glowing squares but no text. What is the most likely fix?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="A" class="mr-3">
                            <span>A) Reinstall the Servo library</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="B" class="mr-3">
                            <span>B) Change the address from 0x27 to 0x3F (or adjust the contrast screw)</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="C" class="mr-3">
                            <span>C) Connect VCC to 3.3V instead of 5V</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="D" class="mr-3">
                            <span>D) Increase Serial baud rate</span>
                        </label>
                    </div>
                </div>

                <!-- Question 5 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 5: setCursor()</h3>
                    <p class="text-gray-700 mb-4">What does <code>lcd.setCursor(0, 1)</code> do before a <code>lcd.print()</code>?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="A" class="mr-3">
                            <span>A) Moves the write position to column 0 of row 1 (the second line)</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="B" class="mr-3">
                            <span>B) Clears line 1 of the display</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="C" class="mr-3">
                            <span>C) Sets the cursor blink speed to 1 second</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="D" class="mr-3">
                            <span>D) Scrolls the display down one row</span>
                        </label>
                    </div>
                </div>

                <!-- Question 6 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 6: Ghost Digits</h3>
                    <p class="text-gray-700 mb-4">The screen shows "B: 920" when the base angle is really 92 — because it used to show 120. What caused it, and what's our fix?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="A" class="mr-3">
                            <span>A) The LCD is broken; replace it</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="B" class="mr-3">
                            <span>B) Call lcd.clear() before every print</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="C" class="mr-3">
                            <span>C) The shorter number didn't overwrite the old trailing digit — pad3() prints a fixed-width field instead</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="D" class="mr-3">
                            <span>D) The servo wrote to the display by accident</span>
                        </label>
                    </div>
                </div>

                <!-- Question 7 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 7: Why Not lcd.clear()?</h3>
                    <p class="text-gray-700 mb-4">Why do we avoid calling <code>lcd.clear()</code> on every screen update?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q7" value="A" class="mr-3">
                            <span>A) It erases the library's memory</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q7" value="B" class="mr-3">
                            <span>B) Wiping the whole screen each refresh causes visible flicker — overwriting fields doesn't</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q7" value="C" class="mr-3">
                            <span>C) It draws too much current for USB power</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q7" value="D" class="mr-3">
                            <span>D) It conflicts with the joystick's dead zone</span>
                        </label>
                    </div>
                </div>

                <!-- Question 8 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 8: Three Jobs, One Loop</h3>
                    <p class="text-gray-700 mb-4">Our complete sketch updates servos every 15 ms and the screen every 250 ms, all inside one <code>loop()</code>. How is this possible without threads?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q8" value="A" class="mr-3">
                            <span>A) The LCD has its own processor that runs loop() too</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q8" value="B" class="mr-3">
                            <span>B) Each job is guarded by its own millis() timer — every pass, each one checks "has my interval elapsed?" and does a little work if so</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q8" value="C" class="mr-3">
                            <span>C) The Servo library schedules loop() for us</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q8" value="D" class="mr-3">
                            <span>D) delay(15) and delay(250) alternate automatically</span>
                        </label>
                    </div>
                </div>

                <!-- Question 9: Short Answer -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 9: Display Interval Trade-off</h3>
                    <p class="text-gray-700 mb-4">We refresh the LCD every 250 ms instead of every loop iteration. Explain why a lower value isn't always better — what happens to I2C traffic and loop responsiveness if <code>displayInterval</code> drops too far (say 5 ms)?</p>
                    <textarea name="q9" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500" 
                              placeholder="Write your answer here..."></textarea>
                </div>

                <!-- Question 10: Short Answer -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 10: Paging a Small Screen</h3>
                    <p class="text-gray-700 mb-4">A 16×2 LCD can't show base, shoulder, elbow, and mode all at once. Describe a "paging" approach: how would you use a third millis() timer to alternate between two screens of information, and what state variable would you need?</p>
                    <textarea name="q10" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500" 
                              placeholder="Write your answer here..."></textarea>
                </div>

                <!-- Submit Button -->
                <div class="text-center">
                    <button type="submit" id="submitBtn" 
                            style="background-color: #7c3aed; color: white; padding: 12px 32px; border-radius: 8px; font-weight: 500; border: none; cursor: pointer; transition: background-color 0.2s;">
                        Submit Quiz
                    </button>
                </div>
            </form>
        </div>

        <!-- Quiz Results Display -->
        <div id="quizResults" style="display: none;" class="max-w-4xl mx-auto px-4 py-8">
            <div class="bg-white rounded-lg shadow-lg p-8">
                <h2 class="text-2xl font-bold text-center mb-6 text-purple-800">🎯 Your Quiz Results</h2>
                <div id="resultsContent"></div>
                <div class="text-center mt-6">
                    <p class="text-gray-600">These results have been automatically sent to your instructor.</p>
                </div>
            </div>
        </div>

        <div class="max-w-4xl mx-auto px-4 py-8">
            <!-- Navigation -->
            <div class="flex justify-between items-center mt-8">
                <div>
                    <a href="/programming/lessons32/lesson13" style="background-color: #6b7280; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #4b5563; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#4b5563'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#6b7280'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                        ← Back to Lesson 13
                    </a>
                </div>
                <div>
                    <a href="/programming/lessons32/lesson13-5" style="background-color: #2563eb; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #1d4ed8; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#1d4ed8'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#2563eb'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                        Next: Lesson 13.5 →
                    </a>
                </div>
            </div>
        </div>
    </main>

    <!-- EmailJS Script -->
    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js" is:inline></script>
    <script is:inline>
        // Quiz data with correct answers
        const quizData = {
            correctAnswers: {
                q1: 'B', // Backpack needs only 2 shared wires
                q2: 'A', // A4 = SDA, A5 = SCL
                q3: 'C', // Device address on the I2C bus
                q4: 'B', // Wrong address (0x3F) or contrast
                q5: 'A', // Column 0, row 1
                q6: 'C', // Fixed-width overwrite (pad3)
                q7: 'B', // clear() causes flicker
                q8: 'B'  // Independent millis() timers
            },
            questionText: {
                q1: "What is the main reason we use an LCD with an I2C backpack instead of wiring the bare 16x2 display?",
                q2: "On the Arduino Uno, which pins carry the I2C bus — and what do SDA and SCL mean?",
                q3: "In LiquidCrystal_I2C lcd(0x27, 16, 2), what is 0x27?",
                q4: "Your display shows glowing squares but no text. What is the most likely fix?",
                q5: "What does lcd.setCursor(0, 1) do before a lcd.print()?",
                q6: "The screen shows 'B: 920' when the base angle is really 92. What caused it, and what's our fix?",
                q7: "Why do we avoid calling lcd.clear() on every screen update?",
                q8: "Our sketch updates servos every 15 ms and the screen every 250 ms inside one loop(). How is this possible without threads?",
                q9: "We refresh the LCD every 250 ms instead of every loop iteration. Explain why a lower value isn't always better — what happens if displayInterval drops to 5 ms?",
                q10: "Describe a 'paging' approach for showing base, shoulder, elbow, and mode on a 16x2 LCD — what timer and state variable would you need?"
            }
        };

        document.getElementById('quizForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const studentName = document.getElementById('quiz13StudentName').value;
            const studentEmail = document.getElementById('quiz13StudentEmail').value;
            
            if (!studentName || !studentEmail) {
                alert('Please fill in your name and email address.');
                return;
            }

            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting...';
            
            const formData = new FormData(this);
            const results = [];
            let score = 0;
            const totalQuestions = 8; // Multiple choice questions only for scoring
            
            // Check multiple choice answers (q1-q8)
            for (let i = 1; i <= 8; i++) {
                const questionKey = `q${i}`;
                const userAnswer = formData.get(questionKey);
                const correctAnswer = quizData.correctAnswers[questionKey];
                const isCorrect = userAnswer === correctAnswer;
                
                if (isCorrect) score++;
                
                results.push({
                    question: quizData.questionText[questionKey],
                    userAnswer: userAnswer || 'No answer provided',
                    correctAnswer: correctAnswer,
                    isCorrect: isCorrect
                });
            }
            
            // Add short answer questions
            results.push({
                question: quizData.questionText.q9,
                studentAnswer: formData.get('q9') || 'No answer provided',
                isShortAnswer: true
            });
            
            results.push({
                question: quizData.questionText.q10,
                studentAnswer: formData.get('q10') || 'No answer provided',
                isShortAnswer: true
            });
            
            const percentage = Math.round((score / totalQuestions) * 100);
            
            // Build detailed message
            let message = `LESSON 13 QUIZ RESULTS - Display Devices\n\n`;
            message += `Student: ${studentName}\n`;
            message += `Email: ${studentEmail}\n`;
            message += `Score: ${score}/${totalQuestions} (${percentage}%)\n\n`;
            
            message += `DETAILED RESULTS:\n`;
            message += `==================\n\n`;
            
            results.forEach((result, index) => {
                if (result.isShortAnswer) {
                    message += `${result.question}:\n`;
                    message += `Answer: ${result.studentAnswer}\n\n`;
                } else {
                    const status = result.isCorrect ? 'CORRECT' : 'INCORRECT';
                    message += `Q${index + 1}: ${result.question}\n`;
                    message += `Student Answer: ${result.userAnswer}\n`;
                    message += `Correct Answer: ${result.correctAnswer}\n`;
                    message += `Status: ${status}\n\n`;
                }
            });
            
            message += `PERFORMANCE ANALYSIS:\n`;
            message += `====================\n`;
            if (percentage >= 90) {
                message += `EXCELLENT! Outstanding understanding of I2C displays and non-blocking UI.\n`;
                message += `Student demonstrates mastery of wiring, addresses, and flicker-free updates.\n`;
            } else if (percentage >= 80) {
                message += `VERY GOOD! Strong grasp of display fundamentals.\n`;
                message += `Student shows solid understanding with minor areas for review.\n`;
            } else if (percentage >= 70) {
                message += `GOOD! Basic understanding of LCD control with room for improvement.\n`;
                message += `Recommend additional practice with cursor positioning and timed refresh.\n`;
            } else if (percentage >= 60) {
                message += `NEEDS IMPROVEMENT. Some understanding but requires more practice.\n`;
                message += `Focus on I2C wiring, addresses, and why we overwrite instead of clear.\n`;
            } else {
                message += `REQUIRES ATTENTION! Limited understanding of display concepts.\n`;
                message += `Recommend reviewing lesson materials and re-running the Hello Display sketch.\n`;
            }
            
            message += `\nNext Steps: Lesson 13.5 continues the build. The LCD status screen is now the arm's permanent dashboard.\n`;
            message += `\nSubmitted: ${new Date().toLocaleString()}\n`;
            
            // Display results to student
            let grade = 'F';
            if (percentage >= 90) grade = 'A';
            else if (percentage >= 80) grade = 'B';
            else if (percentage >= 70) grade = 'C';
            else if (percentage >= 60) grade = 'D';
            
            const resultsHTML = `
                <div style="text-align: center; margin-bottom: 1rem;">
                    <div style="font-size: 2rem; font-weight: bold; color: #7c3aed;">${score}/${totalQuestions} (${percentage}%)</div>
                    <div style="font-size: 1.5rem; font-weight: bold; color: #7c3aed;">Grade: ${grade}</div>
                    <div style="margin-top: 1rem; padding: 1rem; background: #ede9fe; border-radius: 6px; color: #7c3aed; font-weight: bold;">
                        📺 Week 13: Display Devices
                    </div>
                </div>
                <div style="text-align: left;">
                    ${results.map((r, index) => {
                        if (r.isShortAnswer) {
                            return `
                                <div style="margin-bottom: 1rem; padding: 1rem; background: #f0f9ff; border-radius: 6px;">
                                    <strong>${r.question}:</strong><br>
                                    <strong>Your answer:</strong> ${r.studentAnswer}
                                </div>
                            `;
                        } else {
                            return `
                                <div style="margin-bottom: 1rem; padding: 1rem; background: ${r.isCorrect ? '#e8f5e8' : '#ffeaea'}; border-radius: 6px;">
                                    <strong>Question ${index + 1}:</strong> ${r.isCorrect ? '✅' : '❌'}<br>
                                    <strong>Your answer:</strong> ${r.userAnswer}<br>
                                    <strong>Correct answer:</strong> ${r.correctAnswer}
                                </div>
                            `;
                        }
                    }).join('')}
                </div>
            `;
            
            document.getElementById('resultsContent').innerHTML = resultsHTML;
            document.getElementById('quizResults').style.display = 'block';
            
            // Scroll to results
            document.getElementById('quizResults').scrollIntoView({ behavior: 'smooth' });
            
            // Send email using EmailJS
            // Check if EmailJS is available
            if (typeof (window as any).emailjs === 'undefined') {
                console.log('Email service unavailable; relying on Google Sheets logging.');
                return;
            }
            
            // Initialize EmailJS right before sending
            (window as any).emailjs.init('ct_s19oZHppLy9BlW');
            
            const sheetsPayload = JSON.stringify({
                studentName: studentName,
                studentEmail: studentEmail,
                week: 'Week 13',
                topic: 'Display Devices (I2C LCD + Timed Refresh)',
                score: score,
                totalPoints: totalQuestions,
                percentage: percentage,
                grade: percentage >= 90 ? 'A' : percentage >= 80 ? 'B' : percentage >= 70 ? 'C' : percentage >= 60 ? 'D' : 'F',
                timestamp: new Date().toISOString()
            });

            const logToSheets = function() {
                console.log('Logging quiz results to Google Sheets...');
                return fetch('https://script.google.com/macros/s/AKfycbxJORcOZtpcCKh-ZRK6mAFsv-TXvroqJUjB22unDmTiRySX3Mylt8rX-FeMCgd_T47qPA/exec', {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: sheetsPayload
                })
                .then(() => console.log('Quiz results logged to Google Sheets successfully!'))
                .catch(error => console.log('Note: CORS error expected in localhost - Google Sheets logging will work in production:', error));
            };

            (window as any).emailjs.send('service_kaw1xkh', 'template_io02xtm', {
                to_email: 'chuck@c00lnerd.com',
                from_name: 'C00lnerd Quiz System',
                from_email: 'chuck@c00lnerd.com',
                
                message: message,
                subject: `Lesson 13 Display Devices Quiz - ${studentName} (${percentage}%)`
            }).then(function(response) {
                console.log('Quiz results sent successfully!', response.status, response.text);
                alert('Quiz results sent successfully!');
                logToSheets();
            }, function(error) {
                console.log('Failed to send quiz results...', error);
                logToSheets();
                alert('Quiz submitted successfully! Email is temporarily unavailable, but your results were saved to the grade log.');
            });
