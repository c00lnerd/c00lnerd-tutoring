        // Quiz answers
        const correctAnswers = {
            q1: 'B', // Mecanum wheels have rollers at 45° angles
            q2: 'B', // 4 motors controlled by PWM and direction pins
            q3: 'B', // Front left and rear right backward, front right and rear left forward
            q4: 'B', // Left wheels forward, right wheels backward
            q5: 'A', // PWM controls speed, direction pins control forward/backward
            q6: 'B', // analogWrite()
            q7: 'B', // Robot stops motors and delays
            q8: 'B'  // Set all motor PWM values to 0 for safety
        };

        const explanations = {
            q1: 'Mecanum wheels have rollers positioned at 45° angles that allow the robot to move in any direction without changing orientation.',
            q2: 'The miniAuto has 4 motors (one for each wheel) controlled by PWM pins for speed and direction pins for forward/backward control.',
            q3: 'For left movement, front left and rear right wheels go backward while front right and rear left wheels go forward, creating the sideways motion.',
            q4: 'For clockwise rotation, the left wheels move forward while the right wheels move backward, causing the robot to spin in place.',
            q5: 'PWM (Pulse Width Modulation) controls motor speed (0-255), while direction pins control whether motors rotate forward or backward.',
            q6: 'analogWrite() is used to send PWM signals to control motor speed, while digitalWrite() only sends HIGH or LOW signals.',
            q7: 'The demonstration program calls stopMotors() and delay() between movements to ensure clean transitions and prevent overlapping commands.',
            q8: 'The stopMotors() function sets all PWM values to 0, ensuring all motors stop completely for safety and control.'
        };

        document.getElementById('quizForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const studentName = document.getElementById('quiz32StudentName').value;
            const studentEmail = document.getElementById('quiz32StudentEmail').value;
            
            if (!studentName || !studentEmail) {
                alert('Please fill in your name and email address.');
                return;
            }

            let score = 0;
            let totalQuestions = 8; // Multiple choice questions
            let results = [];

            // Check multiple choice answers
            for (let i = 1; i <= 8; i++) {
                const questionName = 'q' + i;
                const selectedAnswer = document.querySelector(`input[name="${questionName}"]:checked`);
                
                if (selectedAnswer) {
                    const isCorrect = selectedAnswer.value === correctAnswers[questionName];
                    if (isCorrect) score++;
                    
                    results.push({
                        question: i,
                        selected: selectedAnswer.value,
                        correct: correctAnswers[questionName],
                        isCorrect: isCorrect,
                        explanation: explanations[questionName]
                    });
                } else {
                    results.push({
                        question: i,
                        selected: 'No answer',
                        correct: correctAnswers[questionName],
                        isCorrect: false,
                        explanation: explanations[questionName]
                    });
                }
            }

            // Get short answer responses
            const q9Answer = document.querySelector('textarea[name="q9"]').value;
            const q10Answer = document.querySelector('textarea[name="q10"]').value;

            // Calculate percentage
            const percentage = Math.round((score / totalQuestions) * 100);
            
            // Display results
            displayResults(score, totalQuestions, percentage, results, q9Answer, q10Answer);
            
            // Send email to instructor
            sendQuizResults(studentName, studentEmail, score, totalQuestions, percentage, results, q9Answer, q10Answer);
        });

        function displayResults(score, total, percentage, results, q9Answer, q10Answer) {
            // Determine grade
            let grade = 'F';
            if (percentage >= 90) grade = 'A';
            else if (percentage >= 80) grade = 'B';
            else if (percentage >= 70) grade = 'C';
            else if (percentage >= 60) grade = 'D';
            
            const resultsHTML = `
                <div style="text-align: center; margin-bottom: 1rem;">
                    <div style="font-size: 2rem; font-weight: bold; color: #0891b2;">${score}/${total} (${percentage}%)</div>
                    <div style="font-size: 1.5rem; font-weight: bold; color: #0891b2;">Grade: ${grade}</div>
                    <div style="margin-top: 1rem; padding: 1rem; background: #cffafe; border-radius: 6px; color: #0891b2; font-weight: bold;">
                        ?? Week 12: miniAuto Movement Programming
                    </div>
                </div>
                <div style="text-align: left;">
                    ${results.map((result, index) => {
                        return `
                            <div style="margin-bottom: 1rem; padding: 1rem; background: ${result.isCorrect ? '#e8f5e8' : '#ffeaea'}; border-radius: 6px;">
                                <strong>Question ${index + 1}:</strong> ${result.isCorrect ? '?' : '?'}<br>
                                <strong>Your answer:</strong> ${result.selected}<br>
                                <strong>Correct answer:</strong> ${result.correct}
                            </div>
                        `;
                    }).join('')}
                    <div style="margin-bottom: 1rem; padding: 1rem; background: #f0f9ff; border-radius: 6px;">
                        <strong>Question 9 - Movement Pattern Design:</strong><br>
                        <strong>Your answer:</strong> ${q9Answer || 'No response provided'}
                    </div>
                    <div style="margin-bottom: 1rem; padding: 1rem; background: #f0f9ff; border-radius: 6px;">
                        <strong>Question 10 - Troubleshooting Movement:</strong><br>
                        <strong>Your answer:</strong> ${q10Answer || 'No response provided'}
                    </div>
                </div>
            `;
            
            document.getElementById('resultsContent').innerHTML = resultsHTML;
            document.getElementById('resultsSection').classList.remove('hidden');
            document.getElementById('resultsSection').scrollIntoView({ behavior: 'smooth' });
        }

        function sendQuizResults(studentName, studentEmail, score, total, percentage, results, q9Answer, q10Answer) {

            // Check if EmailJS is available
            if (typeof window.emailjs === 'undefined') {
                alert('Email service is not available. Please refresh the page and try again.');
                return;
            }
            
            // Initialize EmailJS right before sending
            window.emailjs.init('ct_s19oZHppLy9BlW');
            
            let emailContent = `Week 12 Quiz Results - miniAuto Movement Programming\n\n`;
            emailContent += `Student: ${studentName}\n`;
            emailContent += `Email: ${studentEmail}\n`;
            emailContent += `Score: ${score}/${total} (${percentage}%)\n`;
            emailContent += `Date: ${new Date().toLocaleString()}\n\n`;
            
            emailContent += `MULTIPLE CHOICE RESULTS:\n`;
            results.forEach(result => {
