            // Log to Google Sheets
            console.log('Logging quiz results to Google Sheets...');
            const totalQuestions = 10;
            
            // Extract individual answers from results array
            const answersObj = {};
            results.forEach((result, index) => {
                answersObj[`q${index + 1}`] = result.selected;
            });
            answersObj.q9 = q9Answer;
            answersObj.q10 = q10Answer;
            
            // Calculate grade
            let grade = 'F';
            if (percentage >= 90) grade = 'A';
            else if (percentage >= 80) grade = 'B';
            else if (percentage >= 70) grade = 'C';
            else if (percentage >= 60) grade = 'D';
            
            const sheetsData = {
                studentName: studentName,
                studentEmail: studentEmail,
                week: 'Week 12',
                topic: 'miniAuto Movement Programming',
                score: score,
                totalPoints: totalQuestions,
                percentage: percentage,
                grade: percentage >= 90 ? 'A' : percentage >= 80 ? 'B' : percentage >= 70 ? 'C' : percentage >= 60 ? 'D' : 'F',
                timestamp: new Date().toISOString()
            };

            fetch('https://script.google.com/macros/s/AKfycbxJORcOZtpcCKh-ZRK6mAFsv-TXvroqJUjB22unDmTiRySX3Mylt8rX-FeMCgd_T47qPA/exec', {
