---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Week 7 Quiz: Serial Communication - C00lnerd Tutoring">
    <div style="max-width: 800px; margin: 0 auto; padding: 2rem;">
        
            <!-- Header -->
            <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 2rem; border-radius: 10px; margin-bottom: 2rem; text-align: center;">
                <h1 style="font-size: 2rem; font-weight: bold; margin: 0;">Week 7 Quiz: Serial Communication</h1>
                <p class="text-xl text-gray-600">Test your understanding of data exchange and debugging techniques</p>
                <div class="mt-4 p-4 bg-green-100 rounded-lg">
                    <p class="text-green-800 font-medium">📝 10 questions covering serial functions, debugging, and communication</p>
                </div>
            </div>

            <!-- Student Information -->
            <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
                <h2 class="text-2xl font-bold text-green-800 mb-6">Student Information</h2>
                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <label for="quiz7StudentName" class="block text-sm font-medium text-gray-700 mb-2">Full Name</label>
                        <input type="text" id="quiz7StudentName" name="studentName" required 
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500">
                    </div>
                    <div>
                        <label for="quiz7StudentEmail" class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
                        <input type="email" id="quiz7StudentEmail" name="studentEmail" required 
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500">
                    </div>
                </div>
            </div>

            <!-- Quiz Questions -->
            <form id="quizForm" autocomplete="off" class="space-y-8">
                <!-- Question 1 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 1: Serial Initialization</h3>
                    <p class="text-gray-700 mb-4">Which function is used to initialize serial communication in Arduino?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="A" class="mr-3">
                            <span>A) Serial.start()</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="B" class="mr-3">
                            <span>B) Serial.begin()</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="C" class="mr-3">
                            <span>C) Serial.init()</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="D" class="mr-3">
                            <span>D) Serial.open()</span>
                        </label>
                    </div>
                </div>

                <!-- Question 2 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 2: Baud Rate</h3>
                    <p class="text-gray-700 mb-4">What is the most commonly used baud rate for Arduino serial communication?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="A" class="mr-3">
                            <span>A) 4800</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="B" class="mr-3">
                            <span>B) 9600</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="C" class="mr-3">
                            <span>C) 19200</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="D" class="mr-3">
                            <span>D) 115200</span>
                        </label>
                    </div>
                </div>

                <!-- Question 3 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 3: Print vs Println</h3>
                    <p class="text-gray-700 mb-4">What is the difference between Serial.print() and Serial.println()?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="A" class="mr-3">
                            <span>A) No difference, they work the same</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="B" class="mr-3">
                            <span>B) println() adds a newline character at the end</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="C" class="mr-3">
                            <span>C) print() is faster than println()</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="D" class="mr-3">
                            <span>D) println() can only print numbers</span>
                        </label>
                    </div>
                </div>

                <!-- Question 4 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 4: Checking for Data</h3>
                    <p class="text-gray-700 mb-4">Which function checks if serial data is available to read?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="A" class="mr-3">
                            <span>A) Serial.ready()</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="B" class="mr-3">
                            <span>B) Serial.available()</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="C" class="mr-3">
                            <span>C) Serial.check()</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="D" class="mr-3">
                            <span>D) Serial.waiting()</span>
                        </label>
                    </div>
                </div>

                <!-- Question 5 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 5: Reading Characters</h3>
                    <p class="text-gray-700 mb-4">What does Serial.read() return when no data is available?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="A" class="mr-3">
                            <span>A) 0</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="B" class="mr-3">
                            <span>B) -1</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="C" class="mr-3">
                            <span>C) NULL</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="D" class="mr-3">
                            <span>D) Empty string</span>
                        </label>
                    </div>
                </div>

                <!-- Question 6 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 6: String Functions</h3>
                    <p class="text-gray-700 mb-4">Which String method removes whitespace from the beginning and end?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="A" class="mr-3">
                            <span>A) clean()</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="B" class="mr-3">
                            <span>B) strip()</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="C" class="mr-3">
                            <span>C) trim()</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="D" class="mr-3">
                            <span>D) remove()</span>
                        </label>
                    </div>
                </div>

                <!-- Question 7 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 7: Number Formatting</h3>
                    <p class="text-gray-700 mb-4">What does Serial.println(255, HEX) display?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q7" value="A" class="mr-3">
                            <span>A) 255</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q7" value="B" class="mr-3">
                            <span>B) FF</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q7" value="C" class="mr-3">
                            <span>C) 11111111</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q7" value="D" class="mr-3">
                            <span>D) 377</span>
                        </label>
                    </div>
                </div>

                <!-- Question 8 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 8: Debugging Benefits</h3>
                    <p class="text-gray-700 mb-4">Why is serial communication valuable for debugging Arduino programs?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q8" value="A" class="mr-3">
                            <span>A) It makes programs run faster</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q8" value="B" class="mr-3">
                            <span>B) It allows you to see variable values and program flow</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q8" value="C" class="mr-3">
                            <span>C) It reduces memory usage</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q8" value="D" class="mr-3">
                            <span>D) It prevents hardware damage</span>
                        </label>
                    </div>
                </div>

                <!-- Question 9: Short Answer -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 9: Serial Communication Applications</h3>
                    <p class="text-gray-700 mb-4">Describe three practical uses of serial communication in Arduino projects beyond debugging. Explain how each application benefits from serial communication.</p>
                    <textarea name="q9" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500" 
                              placeholder="Write your answer here..."></textarea>
                </div>

                <!-- Question 10: Short Answer -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 10: Command Processing</h3>
                    <p class="text-gray-700 mb-4">Explain how you would design a simple command system that accepts user input like "LED ON", "LED OFF", and "DELAY 500" through the Serial Monitor. What functions and techniques would you use?</p>
                    <textarea name="q10" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500" 
                              placeholder="Write your answer here..."></textarea>
                </div>

                <!-- Submit Button -->
                <div class="text-center">
                    <button type="submit" id="submitBtn" 
                            style="background-color: #059669; color: white; padding: 12px 32px; border-radius: 8px; font-weight: 500; border: none; cursor: pointer; transition: background-color 0.2s;">
                        Submit Quiz
                    </button>
                </div>
            </form>
        </div>

        <!-- Quiz Results Display -->
        <div id="quizResults" style="display: none;" class="max-w-4xl mx-auto px-4 py-8">
            <div class="bg-white rounded-lg shadow-lg p-8">
                <h2 class="text-2xl font-bold text-center mb-6 text-green-800">📊 Your Quiz Results</h2>
                <div id="resultsContent"></div>
                <div class="text-center mt-6">
                    <p class="text-gray-600">These results have been automatically sent to your instructor.</p>
                </div>
            </div>
        </div>

        <div class="max-w-4xl mx-auto px-4 py-8">
            <!-- Navigation -->
            <div class="flex justify-between items-center mt-8">
                <div>
                    <a href="/programming/lessons32/week7" style="background-color: #6b7280; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #4b5563; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#4b5563'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#6b7280'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                        ← Back to Week 7 Lesson
                    </a>
                </div>
                <div>
                    <a href="/programming/lessons32/week8" style="background-color: #2563eb; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #1d4ed8; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#1d4ed8'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#2563eb'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                        Next: Week 8 Lesson →
                    </a>
                </div>
            </div>
        </div>
    </main>

    <!-- EmailJS Script -->
    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js">
window.onload = function() { generateCaptcha(); };
    // CAPTCHA variables
    let captchaAnswer = 0;
    
    function generateCaptcha() {
        const num1 = Math.floor(Math.random() * 10) + 1;
        const num2 = Math.floor(Math.random() * 10) + 1;
        captchaAnswer = num1 + num2;
        const questionElement = document.getElementById('captcha-question');
        if (questionElement) {
            questionElement.textContent = num1 + " + " + num2;
        }
    }
    
    function validateCaptcha() {
        const userAnswer = parseInt(document.getElementById('captcha').value);
        const errorDiv = document.getElementById('captcha-error');
        
        if (userAnswer !== captchaAnswer) {
            if (errorDiv) errorDiv.style.display = 'block';
            generateCaptcha(); // Generate new question
            document.getElementById('captcha').value = '';
            return false;
        }
        
        if (errorDiv) errorDiv.style.display = 'none';
        return true;
    }
    
    // Security validation function
    function validateSecurity() {
        // Check honeypot field (should be empty)
        const honeypot = document.getElementById('website');
        if (honeypot && honeypot.value) {
            console.log('Spam bot detected via honeypot');
            alert('Security check failed. Please try again.');
            return false;
        }
        
        // Rate limiting check
        const lastSubmission = localStorage.getItem('lastQuizStart');
        const now = Date.now();
        if (lastSubmission && (now - parseInt(lastSubmission)) < 30000) { // 30 second cooldown
            alert('Please wait 30 seconds between quiz attempts.');
            return false;
        }
        localStorage.setItem('lastQuizStart', now.toString());
        
        // Validate CAPTCHA
        if (!validateCaptcha()) {
            return false;
        }
        
        // Email validation and domain filtering
        const emailInput = document.getElementById('email');
        if (emailInput && emailInput.value) {
            const email = emailInput.value;
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                alert('Please enter a valid email address.');
                return false;
            }
            
            // Block common spam domains
            const spamDomains = ['tempmail.org', '10minutemail.com', 'guerrillamail.com', 'mailinator.com', 'throwaway.email'];
            const domain = email.split('@')[1].toLowerCase();
            if (spamDomains.includes(domain)) {
                alert('Please use a permanent email address.');
                return false;
            }
        }
        
        return true;
    }</script>
    <script is:inline>
window.onload = function() { generateCaptcha(); };
    }
    
