---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Lesson 7 Quiz: Sensors and Analog Input with Arduino">
    <div style="max-width: 800px; margin: 0 auto; padding: 2rem;">
        <div class="container mx-auto px-4 max-w-4xl">
            <div class="text-center mb-8">
                <div class="flex items-center justify-center mb-4">
                    <div class="bg-purple-500 text-white rounded-full w-16 h-16 flex items-center justify-center font-bold text-2xl mr-4">Q7</div>
                    <div class="text-left">
                        <h1 class="text-3xl font-bold text-gray-800">Lesson 7 Quiz: Sensors and Analog Input with Arduino</h1>
                        <p class="text-gray-600">Test your understanding of sensors, analog input, and reading values with <code>analogRead()</code></p>
                        <p class="text-sm text-blue-600 font-medium">32-Lesson Course • Semester 1</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-lg p-6 mb-8">
                <h2 class="text-2xl font-bold text-gray-800 mb-4">Quiz Instructions</h2>
                <div class="bg-blue-50 p-4 rounded-lg">
                    <ul class="space-y-2 text-blue-800">
                        <li>This quiz covers material from Lesson 7: Sensors and Analog Input with Arduino</li>
                        <li>Answer all questions to the best of your ability</li>
                        <li>Your responses will be emailed to your instructor for review</li>
                        <li>Take your time and think carefully about each answer</li>
                        <li>You can review the lesson material if needed before submitting</li>
                    </ul>
                </div>
            </div>

            <form id="quizForm" autocomplete="off" class="space-y-8">
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-4">Student Information</h3>
                    <div class="grid md:grid-cols-2 gap-4">
                        <div>
                            <label for="quiz7StudentName" class="block text-sm font-medium text-gray-700 mb-2">Full Name</label>
                            <input type="text" id="quiz7StudentName" name="studentName" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                        <div>
                            <label for="quiz7StudentEmail" class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
                            <input type="email" id="quiz7StudentEmail" name="studentEmail" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 1: What does a sensor do?</h3>
                    <p class="text-gray-600 mb-4">What is the main job of a sensor in an Arduino project?</p>
                    <div class="space-y-2">
                        <label class="flex items-center"><input type="radio" name="q1" value="A" class="mr-3"><span>A) It stores programs forever</span></label>
                        <label class="flex items-center"><input type="radio" name="q1" value="B" class="mr-3"><span>B) It measures something and sends information to Arduino</span></label>
                        <label class="flex items-center"><input type="radio" name="q1" value="C" class="mr-3"><span>C) It only turns LEDs on</span></label>
                        <label class="flex items-center"><input type="radio" name="q1" value="D" class="mr-3"><span>D) It replaces the need for code</span></label>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 2: Digital vs Analog</h3>
                    <p class="text-gray-600 mb-4">Which statement best describes analog input?</p>
                    <div class="space-y-2">
                        <label class="flex items-center"><input type="radio" name="q2" value="A" class="mr-3"><span>A) It can only be HIGH or LOW</span></label>
                        <label class="flex items-center"><input type="radio" name="q2" value="B" class="mr-3"><span>B) It can change through many values</span></label>
                        <label class="flex items-center"><input type="radio" name="q2" value="C" class="mr-3"><span>C) It only works with buttons</span></label>
                        <label class="flex items-center"><input type="radio" name="q2" value="D" class="mr-3"><span>D) It does not need any wires</span></label>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 3: Analog Pins</h3>
                    <p class="text-gray-600 mb-4">Which pin is the correct kind of pin to use with <code>analogRead()</code> for a beginner sensor lesson?</p>
                    <div class="space-y-2">
                        <label class="flex items-center"><input type="radio" name="q3" value="A" class="mr-3"><span>A) Pin 13</span></label>
                        <label class="flex items-center"><input type="radio" name="q3" value="B" class="mr-3"><span>B) Pin 8</span></label>
                        <label class="flex items-center"><input type="radio" name="q3" value="C" class="mr-3"><span>C) A0</span></label>
                        <label class="flex items-center"><input type="radio" name="q3" value="D" class="mr-3"><span>D) GND</span></label>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 4: Understanding <code>analogRead()</code></h3>
                    <p class="text-gray-600 mb-4">What does <code>analogRead(A0)</code> do?</p>
                    <div class="space-y-2">
                        <label class="flex items-center"><input type="radio" name="q4" value="A" class="mr-3"><span>A) It turns pin A0 on</span></label>
                        <label class="flex items-center"><input type="radio" name="q4" value="B" class="mr-3"><span>B) It measures the input value on analog pin A0</span></label>
                        <label class="flex items-center"><input type="radio" name="q4" value="C" class="mr-3"><span>C) It sends text to the Serial Monitor</span></label>
                        <label class="flex items-center"><input type="radio" name="q4" value="D" class="mr-3"><span>D) It changes A0 into an output pin</span></label>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 5: Sensor Range</h3>
                    <p class="text-gray-600 mb-4">In this lesson, what range of values does Arduino usually read from an analog sensor?</p>
                    <div class="space-y-2">
                        <label class="flex items-center"><input type="radio" name="q5" value="A" class="mr-3"><span>A) 0 to 1</span></label>
                        <label class="flex items-center"><input type="radio" name="q5" value="B" class="mr-3"><span>B) 0 to 5</span></label>
                        <label class="flex items-center"><input type="radio" name="q5" value="C" class="mr-3"><span>C) 0 to 255</span></label>
                        <label class="flex items-center"><input type="radio" name="q5" value="D" class="mr-3"><span>D) 0 to 1023</span></label>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 6: Potentiometer Wiring</h3>
                    <p class="text-gray-600 mb-4">In the lesson's potentiometer setup, where does the middle pin connect?</p>
                    <div class="space-y-2">
                        <label class="flex items-center"><input type="radio" name="q6" value="A" class="mr-3"><span>A) To GND</span></label>
                        <label class="flex items-center"><input type="radio" name="q6" value="B" class="mr-3"><span>B) To pin 8</span></label>
                        <label class="flex items-center"><input type="radio" name="q6" value="C" class="mr-3"><span>C) To A0</span></label>
                        <label class="flex items-center"><input type="radio" name="q6" value="D" class="mr-3"><span>D) To the LED long leg</span></label>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 7: Why Use the Serial Monitor?</h3>
                    <p class="text-gray-600 mb-4">Why is the Serial Monitor useful when testing a sensor?</p>
                    <div class="space-y-2">
                        <label class="flex items-center"><input type="radio" name="q7" value="A" class="mr-3"><span>A) It makes the sensor more accurate</span></label>
                        <label class="flex items-center"><input type="radio" name="q7" value="B" class="mr-3"><span>B) It lets you see the changing values Arduino is reading</span></label>
                        <label class="flex items-center"><input type="radio" name="q7" value="C" class="mr-3"><span>C) It removes the need for <code>analogRead()</code></span></label>
                        <label class="flex items-center"><input type="radio" name="q7" value="D" class="mr-3"><span>D) It converts analog signals into motors</span></label>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 8: Code Analysis</h3>
                    <p class="text-gray-600 mb-4">What does this line do?<br><code>Serial.println(sensorValue);</code></p>
                    <div class="space-y-2">
                        <label class="flex items-center"><input type="radio" name="q8" value="A" class="mr-3"><span>A) It prints the sensor value to the Serial Monitor</span></label>
                        <label class="flex items-center"><input type="radio" name="q8" value="B" class="mr-3"><span>B) It turns the sensor off</span></label>
                        <label class="flex items-center"><input type="radio" name="q8" value="C" class="mr-3"><span>C) It changes the wiring automatically</span></label>
                        <label class="flex items-center"><input type="radio" name="q8" value="D" class="mr-3"><span>D) It sets the sensor value equal to zero</span></label>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 9: Reading the Pattern</h3>
                    <p class="text-gray-600 mb-4">Explain what you would expect to happen to the numbers in the Serial Monitor as you slowly turn a potentiometer knob from one end to the other.</p>
                    <textarea name="q9" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Write your answer here..."></textarea>
                </div>

                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 10: Simple Sensor Program</h3>
                    <p class="text-gray-600 mb-4">Describe a simple Arduino program that reads a sensor. What sensor would you use, what pin would it connect to, and what would the program print or do?</p>
                    <textarea name="q10" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Write your answer here..."></textarea>
                </div>

                <div class="text-center">
                    <button type="submit" id="submitBtn" style="background-color: #10b981; color: white; padding: 12px 32px; border-radius: 8px; font-weight: 500; border: none; cursor: pointer; transition: background-color 0.2s;">Submit Quiz</button>
                </div>
            </form>
        </div>

        <div id="quizResults" style="display: none;" class="max-w-4xl mx-auto px-4 py-8">
            <div class="bg-white rounded-lg shadow-lg p-8">
                <h2 class="text-2xl font-bold text-center mb-6 text-purple-800">Your Quiz Results</h2>
                <div id="resultsContent"></div>
                <div class="text-center mt-6">
                    <p class="text-gray-600">These results have been automatically sent to your instructor.</p>
                </div>
            </div>
        </div>

        <div class="max-w-4xl mx-auto px-4 py-8">
            <div class="flex justify-between items-center mt-8">
                <div>
                    <a href="/programming/lessons32/Lesson7" style="background-color: #6b7280; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #4b5563; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#4b5563'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#6b7280'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">← Back to Lesson 7</a>
                </div>
                <div>
                    <a href="/programming/lessons32/Lesson8" style="background-color: #2563eb; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #1d4ed8; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#1d4ed8'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#2563eb'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">Next: Lesson 8 →</a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
    <script is:inline>
    let captchaAnswer = 0;
    let emailjsReady = false;

    function generateCaptcha() {
        const num1 = Math.floor(Math.random() * 10) + 1;
        const num2 = Math.floor(Math.random() * 10) + 1;
        captchaAnswer = num1 + num2;

        const captchaQuestion = document.getElementById('captcha-question');
        if (captchaQuestion) {
            captchaQuestion.textContent = `What is ${num1} + ${num2}?`;
        }
    }

    function validateCaptcha() {
        const captchaInput = document.getElementById('captcha');
        const errorDiv = document.getElementById('captcha-error');
        const userAnswer = parseInt(captchaInput?.value, 10);

        if (!captchaInput) {
            return true;
        }

        if (userAnswer !== captchaAnswer) {
            if (errorDiv) errorDiv.style.display = 'block';
            generateCaptcha();
            captchaInput.value = '';
            return false;
        }

        if (errorDiv) errorDiv.style.display = 'none';
        return true;
    }

    function validateSecurity() {
        const honeypot = document.getElementById('website');
        if (honeypot && honeypot.value) {
            console.log('Spam bot detected via honeypot');
            alert('Security check failed. Please try again.');
            return false;
        }

        const lastSubmission = localStorage.getItem('lastQuizStart');
        const now = Date.now();
        if (lastSubmission && (now - parseInt(lastSubmission, 10)) < 30000) {
            alert('Please wait 30 seconds between quiz attempts.');
            return false;
        }

        const emailInput = document.getElementById('quiz7StudentEmail');
        if (emailInput && emailInput.value) {
            const email = emailInput.value;
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                alert('Please enter a valid email address.');
                return false;
            }

            const spamDomains = ['tempmail.org', '10minutemail.com', 'guerrillamail.com', 'mailinator.com', 'throwaway.email'];
            const domain = email.split('@')[1]?.toLowerCase();
            if (domain && spamDomains.includes(domain)) {
                alert('Please use a permanent email address.');
                return false;
            }
        }

        if (!validateCaptcha()) {
            return false;
        }

        localStorage.setItem('lastQuizStart', now.toString());
        return true;
    }

    window.addEventListener('load', function() {
        if (document.getElementById('captcha-question')) {
            generateCaptcha();
        }

        if (typeof window.emailjs !== 'undefined') {
            window.emailjs.init('ct_s19oZHppLy9BlW');
            emailjsReady = true;
            console.log('EmailJS initialized successfully');
        } else {
            console.error('EmailJS failed to load');
        }
    });

    const quizData = {
        correctAnswers: {
            q1: 'B',
            q2: 'B',
            q3: 'C',
            q4: 'B',
            q5: 'D',
            q6: 'C',
            q7: 'B',
            q8: 'A'
        },
        questionText: {
            q1: 'What does a sensor do?',
            q2: 'Digital vs Analog',
            q3: 'Analog Pins',
            q4: 'Understanding analogRead()',
            q5: 'Sensor Range',
            q6: 'Potentiometer Wiring',
            q7: 'Why Use the Serial Monitor?',
            q8: 'Code Analysis',
            q9: 'Reading the Pattern',
            q10: 'Simple Sensor Program'
        }
    };

    document.getElementById('quizForm').addEventListener('submit', function(e) {
        e.preventDefault();

        if (!validateSecurity()) {
            return;
        }

        const submitBtn = document.getElementById('submitBtn');
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting...';

        const formData = new FormData(this);
        const studentName = document.getElementById('quiz7StudentName').value;
        const studentEmail = document.getElementById('quiz7StudentEmail').value;
        const results = [];
        let score = 0;
        const totalQuestions = 8;

        for (let i = 1; i <= 8; i++) {
            const questionKey = `q${i}`;
            const studentAnswer = formData.get(questionKey);
            const correctAnswer = quizData.correctAnswers[questionKey];
            const isCorrect = studentAnswer === correctAnswer;

            if (isCorrect) score++;

            results.push({
                question: quizData.questionText[questionKey],
                studentAnswer: studentAnswer || 'No answer',
                correctAnswer: correctAnswer,
                isCorrect: isCorrect
            });
        }

        results.push({
            question: quizData.questionText.q9,
            studentAnswer: formData.get('q9') || 'No answer provided',
            isShortAnswer: true
        });

        results.push({
            question: quizData.questionText.q10,
            studentAnswer: formData.get('q10') || 'No answer provided',
            isShortAnswer: true
        });

        const percentage = Math.round((score / totalQuestions) * 100);

        let message = `LESSON 7 QUIZ RESULTS - Sensors and Analog Input with Arduino\n\n`;
        message += `Student: ${studentName}\n`;
        message += `Email: ${studentEmail}\n`;
        message += `Score: ${score}/${totalQuestions} (${percentage}%)\n\n`;
        message += `DETAILED RESULTS:\n`;
        message += `==================\n\n`;

        results.forEach((result, index) => {
            if (result.isShortAnswer) {
                message += `${result.question}:\n`;
                message += `Answer: ${result.studentAnswer}\n\n`;
            } else {
                const status = result.isCorrect ? 'CORRECT' : 'INCORRECT';
                message += `Q${index + 1}: ${result.question}\n`;
                message += `Student Answer: ${result.studentAnswer}\n`;
                message += `Correct Answer: ${result.correctAnswer}\n`;
                message += `Status: ${status}\n\n`;
            }
        });

        message += `PERFORMANCE ANALYSIS:\n`;
        message += `=====================\n`;
        if (percentage >= 90) {
            message += `EXCELLENT! Excellent understanding of beginner sensors and analog input.\n`;
            message += `The student is ready to begin using sensor values in decision-making projects.\n`;
        } else if (percentage >= 80) {
            message += `VERY GOOD! Solid understanding of analog input and reading sensor values.\n`;
            message += `The student shows good progress with sensor wiring and Serial Monitor testing.\n`;
        } else if (percentage >= 70) {
            message += `GOOD! Basic sensor ideas are understood, with some areas for more practice.\n`;
            message += `Recommend reviewing analog pins, analogRead(), and the 0 to 1023 range.\n`;
        } else if (percentage >= 60) {
            message += `NEEDS IMPROVEMENT! Some understanding is present, but sensor reading needs reinforcement.\n`;
            message += `Suggest more practice wiring a potentiometer and watching changing values in the Serial Monitor.\n`;
        } else {
            message += `REQUIRES ATTENTION! More guided practice is needed with sensors, analog pins, and code tracing.\n`;
            message += `Recommend reviewing what sensors do, where to connect them, and how analogRead() works.\n`;
        }

        message += `\nNext Steps: Practice reading real sensor values and prepare to use those values in decisions and outputs.\n`;
        message += `\nSubmitted: ${new Date().toLocaleString()}\n`;

        let grade = 'F';
        if (percentage >= 90) grade = 'A';
        else if (percentage >= 80) grade = 'B';
        else if (percentage >= 70) grade = 'C';
        else if (percentage >= 60) grade = 'D';

        const resultsHTML = `
            <div style="text-align: center; margin-bottom: 1rem;">
                <div style="font-size: 2rem; font-weight: bold; color: #4a148c;">${score}/${totalQuestions} (${percentage}%)</div>
                <div style="font-size: 1.5rem; font-weight: bold; color: #4a148c;">Grade: ${grade}</div>
                <div style="margin-top: 1rem; padding: 1rem; background: #e8f5e8; border-radius: 6px; color: #2e7d32; font-weight: bold;">
                    Lesson 7: Sensors and Analog Input with Arduino
                </div>
            </div>
            <div style="text-align: left;">
                ${results.map((r, index) => {
                    if (r.isShortAnswer) {
                        return `
                            <div style="margin-bottom: 1rem; padding: 1rem; background: #f0f9ff; border-radius: 6px;">
                                <strong>${r.question}:</strong><br>
                                <strong>Your answer:</strong> ${r.studentAnswer}
                            </div>
                        `;
                    }

                    return `
                        <div style="margin-bottom: 1rem; padding: 1rem; background: ${r.isCorrect ? '#e8f5e8' : '#ffeaea'}; border-radius: 6px;">
                            <strong>Question ${index + 1}:</strong> ${r.isCorrect ? 'Correct' : 'Incorrect'}<br>
                            <strong>Your answer:</strong> ${r.studentAnswer}<br>
                            <strong>Correct answer:</strong> ${r.correctAnswer}
                        </div>
                    `;
                }).join('')}
            </div>
        `;

        document.getElementById('resultsContent').innerHTML = resultsHTML;
        document.getElementById('quizResults').style.display = 'block';
        document.getElementById('quizResults').scrollIntoView({ behavior: 'smooth' });

        if (!emailjsReady || typeof window.emailjs === 'undefined') {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Submit Quiz';
            alert('Email service is not available. Please refresh the page and try again.');
            return;
        }

        const sheetsPayload = {
            studentName: studentName,
            studentEmail: studentEmail,
            week: 'Lesson 7',
            topic: 'Sensors and Analog Input with Arduino',
            score: score,
            totalPoints: 10,
            percentage: percentage,
            grade: grade,
            timestamp: new Date().toISOString()
        };

        function logQuizToGoogleSheets() {
            console.log('Logging quiz results to Google Sheets...');
            return fetch('https://script.google.com/macros/s/AKfycbxJORcOZtpcCKh-ZRK6mAFsv-TXvroqJUjB22unDmTiRySX3Mylt8rX-FeMCgd_T47qPA/exec', {
                method: 'POST',
                mode: 'no-cors',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(sheetsPayload)
            })
                .then(() => console.log('Quiz results logged to Google Sheets successfully!'))
                .catch(error => console.log('Note: CORS error expected in localhost - Google Sheets logging will work in production:', error));
        }

        window.emailjs.send('service_kaw1xkh', 'template_io02xtm', {
            to_email: 'chuck@c00lnerd.com',
            from_name: 'C00lnerd Quiz System',
            from_email: 'chuck@c00lnerd.com',
            message: message,
            subject: `Lesson 7 Arduino Quiz - ${studentName} (${percentage}%)`
        }).then(function(response) {
            console.log('Quiz results sent successfully!', response.status, response.text);
            alert('Quiz submitted successfully!');
            return logQuizToGoogleSheets();
        }, function(error) {
            console.log('Failed to send quiz results...', error);
            return logQuizToGoogleSheets().then(function() {
                alert('Quiz submitted successfully! Email is temporarily unavailable, but your results were saved to the grade log.');
            });
        }).finally(function() {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Submit Quiz';
        });
    });
    </script>
</Layout>
