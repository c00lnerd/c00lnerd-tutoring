    <script is:inline>
window.onload = function() { generateCaptcha(); };
    // CAPTCHA variables
    let captchaAnswer = 0;
    
    function generateCaptcha() {
        const num1 = Math.floor(Math.random() * 10) + 1;
        const num2 = Math.floor(Math.random() * 10) + 1;
        captchaAnswer = num1 + num2;
        const questionElement = document.getElementById('captcha-question');
        if (questionElement) {
            questionElement.textContent = num1 + " + " + num2;
        }
    }
    
    function validateCaptcha() {
        const userAnswer = parseInt(document.getElementById('captcha').value);
        const errorDiv = document.getElementById('captcha-error');
        
        if (userAnswer !== captchaAnswer) {
            if (errorDiv) errorDiv.style.display = 'block';
            generateCaptcha(); // Generate new question
            document.getElementById('captcha').value = '';
            return false;
        }
        
        if (errorDiv) errorDiv.style.display = 'none';
        return true;
    }
    
    // Security validation function
    function validateSecurity() {
        // Check honeypot field (should be empty)
        const honeypot = document.getElementById('website');
        if (honeypot && honeypot.value) {
            console.log('Spam bot detected via honeypot');
            alert('Security check failed. Please try again.');
            return false;
        }
        
        // Rate limiting check
        const lastSubmission = localStorage.getItem('lastQuizStart');
        const now = Date.now();
        if (lastSubmission && (now - parseInt(lastSubmission)) < 30000) { // 30 second cooldown
            alert('Please wait 30 seconds between quiz attempts.');
            return false;
        }
        localStorage.setItem('lastQuizStart', now.toString());
        
        // Validate CAPTCHA
        if (!validateCaptcha()) {
            return false;
        }
        
        // Email validation and domain filtering
        const emailInput = document.getElementById('email');
        if (emailInput && emailInput.value) {
            const email = emailInput.value;
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                alert('Please enter a valid email address.');
                return false;
            }
            
            // Block common spam domains
            const spamDomains = ['tempmail.org', '10minutemail.com', 'guerrillamail.com', 'mailinator.com', 'throwaway.email'];
            const domain = email.split('@')[1].toLowerCase();
            if (spamDomains.includes(domain)) {
                alert('Please use a permanent email address.');
                return false;
            }
        }
        
        return true;
    }
        // Load EmailJS dynamically
        const emailjsScript = document.createElement('script');
        emailjsScript.src = 'https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js';
        document.head.appendChild(emailjsScript);
        
        // Wait for EmailJS to load before setting up event listener
        emailjsScript.onload = function() {
        document.getElementById('submitBtn').addEventListener('click', function() {
            const studentName = document.getElementById('studentName').value.trim();
            const studentEmail = document.getElementById('studentEmail').value.trim();
            
            if (!studentName || !studentEmail) {
                alert('Please enter both your name and email address.');
                return;
            }

            // Collect answers
            const answers = {};
            
            // Multiple choice questions
            for (let i = 1; i <= 8; i++) {
                const selected = document.querySelector(`input[name="q${i}"]:checked`);
                answers[`q${i}`] = selected ? selected.value : '';
            }
            
            // Short answer questions
            answers.q9 = document.getElementById('question9').value.trim();
            answers.q10 = document.getElementById('question10').value.trim();

            // Check if all questions are answered
            let unanswered = [];
            for (let i = 1; i <= 8; i++) {
                if (!answers[`q${i}`]) unanswered.push(i);
            }
            if (!answers.q9) unanswered.push(9);
            if (!answers.q10) unanswered.push(10);
            
            if (unanswered.length > 0) {
                alert(`Please answer question(s): ${unanswered.join(', ')}`);
                return;
            }

            // Correct answers
            const correctAnswers = {
                q1: 'A', q2: 'B', q3: 'B', q4: 'B', q5: 'B', 
                q6: 'B', q7: 'C', q8: 'B'
            };

            // Calculate score
            let score = 0;
            let feedback = [];
            
            for (let i = 1; i <= 8; i++) {
                if (answers[`q${i}`] === correctAnswers[`q${i}`]) {
                    score++;
                    feedback.push(`Question ${i}: Correct ✓`);
                } else {
                    feedback.push(`Question ${i}: Incorrect ✗ (Correct answer: ${correctAnswers[`q${i}`]})`);
                }
            }
            
            const percentage = Math.round((score / 8) * 100);
            let grade = 'F';
            if (percentage >= 90) grade = 'A';
            else if (percentage >= 80) grade = 'B';
            else if (percentage >= 70) grade = 'C';
            else if (percentage >= 60) grade = 'D';
            
            // Create quiz data object
            const quizData = {
                studentName: studentName,
                studentEmail: studentEmail,
                score: score,
                totalQuestions: 8,
                percentage: percentage,
                grade: grade,
                answers: answers,
                feedback: feedback
            };
            
            // Display results, send email, and log to sheets
            displayResults(quizData);
            sendResultsEmail(quizData);
            logToGoogleSheets(quizData);
            
            // Disable submit button
            this.disabled = true;
            this.textContent = 'Quiz Submitted';
        });
        
        function displayResults(data) {
            const resultsDiv = document.getElementById('resultsContent');
            if (!resultsDiv) return;
            
            resultsDiv.innerHTML = 
                '<div style="background: white; padding: 1.5rem; border-radius: 8px; margin-bottom: 1rem;">' +
                    '<h3 style="color: #1f2937; margin-bottom: 1rem;">Your Performance</h3>' +
                    '<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1rem;">' +
                        '<div style="text-align: center; padding: 1rem; background: #f3f4f6; border-radius: 8px;">' +
                            '<div style="font-size: 2rem; font-weight: bold; color: #059669;">' + data.score + '/' + data.totalQuestions + '</div>' +
                            '<div style="color: #6b7280;">Questions Correct</div>' +
                        '</div>' +
                        '<div style="text-align: center; padding: 1rem; background: #f3f4f6; border-radius: 8px;">' +
                            '<div style="font-size: 2rem; font-weight: bold; color: #0ea5e9;">' + data.percentage + '%</div>' +
                            '<div style="color: #6b7280;">Score</div>' +
                        '</div>' +
                        '<div style="text-align: center; padding: 1rem; background: #f3f4f6; border-radius: 8px;">' +
                            '<div style="font-size: 2rem; font-weight: bold; color: #8b5cf6;">' + data.grade + '</div>' +
                            '<div style="color: #6b7280;">Grade</div>' +
                        '</div>' +
                    '</div>' +
