        function logToGoogleSheets(data) {
            const sheetData = {
                studentName: data.studentName,
                studentEmail: data.studentEmail,
                week: 'Week 26',
                topic: 'Color Recognition & Computer Vision',
                score: data.score,
                totalPoints: data.totalQuestions,
                percentage: data.percentage,
                grade: data.grade,
                timestamp: new Date().toISOString()
            };
            
            fetch('https://script.google.com/macros/s/AKfycbyiA4c14AqtPjr6T8OUXQkGoJ4C3QQnK6WHCdCa2xBDKx1SZreL0Y-sk70YJoa0OzME8w/exec', {
                method: 'POST',
                mode: 'no-cors',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(sheetData)
            }).then(function() {
                console.log('Data logged to Google Sheets');
            }).catch(function(error) {
                console.error('Error logging to Google Sheets:', error);
            });
        }
