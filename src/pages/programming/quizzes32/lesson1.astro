---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Week 1 Quiz: Introduction to Arduino & Programming">
    <div style="max-width: 800px; margin: 0 auto; padding: 2rem;">
        <div class="container mx-auto px-4 max-w-4xl">
            <!-- Header -->
            <div class="text-center mb-8">
                <div class="flex items-center justify-center mb-4">
                    <div class="bg-green-500 text-white rounded-full w-16 h-16 flex items-center justify-center font-bold text-2xl mr-4">Q1</div>
                    <div class="text-left">
                        <h1 class="text-3xl font-bold text-gray-800">Week 1 Quiz: Introduction to Arduino & Programming</h1>
                        <p class="text-gray-600">Test your understanding of Arduino basics and programming concepts</p>
                        <p class="text-sm text-blue-600 font-medium">32-Week Course • Semester 1</p>
                    </div>
                </div>
            </div>

            <!-- Quiz Instructions -->
            <div class="bg-white rounded-xl shadow-lg p-6 mb-8">
                <h2 class="text-2xl font-bold text-gray-800 mb-4">Quiz Instructions</h2>
                <div class="bg-blue-50 p-4 rounded-lg">
                    <ul class="space-y-2 text-blue-800">
                        <li>• This quiz covers material from Week 1: Introduction to Arduino & Programming</li>
                        <li>• Answer all questions to the best of your ability</li>
                        <li>• Your responses will be emailed to your instructor for review</li>
                        <li>• Take your time and think carefully about each answer</li>
                        <li>• You can review the lesson material if needed before submitting</li>
                    </ul>
                </div>
            </div>

            <!-- Quiz Form -->
            <form id="quizForm" autocomplete="off" class="space-y-8">
                <!-- Student Information -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-4">Student Information</h3>
                    <div class="grid md:grid-cols-2 gap-4">
                        <div>
                            <label for="quiz1StudentName" class="block text-sm font-medium text-gray-700 mb-2">Full Name</label>
                            <input type="text" id="quiz1StudentName" name="quiz1StudentName" autocomplete="off" required 
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                        <div>
                            <label for="quiz1StudentEmail" class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
                            <input type="email" id="quiz1StudentEmail" name="quiz1StudentEmail" autocomplete="off" required 
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                    </div>
                </div>

                <!-- Question 1 -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 1: What is Arduino?</h3>
                    <p class="text-gray-600 mb-4">Choose the best description of what Arduino is:</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="A" class="mr-3">
                            <span>A) A programming language like Python or Java</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="B" class="mr-3">
                            <span>B) An open-source electronics platform with hardware and software</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="C" class="mr-3">
                            <span>C) A type of computer processor</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="D" class="mr-3">
                            <span>D) A brand of electronic components</span>
                        </label>
                    </div>
                </div>

                <!-- Question 2 -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 2: Arduino Programming Language</h3>
                    <p class="text-gray-600 mb-4">Arduino programs are written in which programming language?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="A" class="mr-3">
                            <span>A) Python</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="B" class="mr-3">
                            <span>B) JavaScript</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="C" class="mr-3">
                            <span>C) C/C++</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="D" class="mr-3">
                            <span>D) HTML</span>
                        </label>
                    </div>
                </div>

                <!-- Question 3 -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 3: Arduino Components</h3>
                    <p class="text-gray-600 mb-4">Which of these is NOT a typical component found on an Arduino board?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="A" class="mr-3">
                            <span>A) Microcontroller</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="B" class="mr-3">
                            <span>B) Digital pins</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="C" class="mr-3">
                            <span>C) Hard disk drive</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="D" class="mr-3">
                            <span>D) Power connector</span>
                        </label>
                    </div>
                </div>

                <!-- Question 4 -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 4: Programming Applications</h3>
                    <p class="text-gray-600 mb-4">Which of these is a real-world application where Arduino programming is commonly used?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="A" class="mr-3">
                            <span>A) Home automation systems</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="B" class="mr-3">
                            <span>B) Robotics projects</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="C" class="mr-3">
                            <span>C) Environmental monitoring</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="D" class="mr-3">
                            <span>D) All of the above</span>
                        </label>
                    </div>
                </div>

                <!-- Question 5 -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 5: Safety and Best Practices</h3>
                    <p class="text-gray-600 mb-4">What is the most important safety consideration when working with Arduino projects?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="A" class="mr-3">
                            <span>A) Always wear safety goggles</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="B" class="mr-3">
                            <span>B) Disconnect power when making circuit changes</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="C" class="mr-3">
                            <span>C) Use only expensive components</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="D" class="mr-3">
                            <span>D) Work only in complete darkness</span>
                        </label>
                    </div>
                </div>

                <!-- Question 6 - Short Answer -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 6: Explain Your Interest</h3>
                    <p class="text-gray-600 mb-4">In 2-3 sentences, explain why you're interested in learning Arduino programming and what you hope to build:</p>
                    <textarea name="q6" rows="4" 
                              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                              placeholder="Write your answer here..."></textarea>
                </div>

                <!-- Question 7 - Short Answer -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 7: Problem Solving</h3>
                    <p class="text-gray-600 mb-4">Describe a simple problem in your daily life that could potentially be solved with an Arduino project:</p>
                    <textarea name="q7" rows="4" 
                              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                              placeholder="Write your answer here..."></textarea>
                </div>

                <!-- Submit Button -->
                <div class="text-center">
                    <button type="submit" id="submitBtn" 
                            class="bg-green-500 hover:bg-green-600 text-white px-8 py-3 rounded-lg font-medium transition-colors duration-200"
                            style="background-color: #10b981; color: white; padding: 12px 32px; border-radius: 8px; font-weight: 500; border: none; cursor: pointer; transition: background-color 0.2s;">
                        Submit Quiz
                    </button>
                </form>
            </div>

            <!-- Quiz Results Display -->
            <div id="quizResults" style="display: none;" class="max-w-4xl mx-auto px-4 py-8">
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h2 class="text-2xl font-bold text-center mb-6 text-purple-800">📊 Your Quiz Results</h2>
                    <div id="resultsContent"></div>
                    <div class="text-center mt-6">
                        <p class="text-gray-600">These results have been automatically sent to your instructor.</p>
                    </div>
                </div>
            </div>

            <!-- Navigation -->
            <div class="flex justify-between items-center mt-8">
                <div>
                    <a href="/programming/lessons32/week1" style="background-color: #6b7280; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #4b5563; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#4b5563'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#6b7280'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                        ← Back to Week 1 Lesson
                    </a>
                </div>
                <div>
                    <a href="/programming/lessons32/week2" style="background-color: #2563eb; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #1d4ed8; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#1d4ed8'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#2563eb'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                        Next: Week 2 Lesson →
                    </a>
                </div>
            </div>
        </div>
    </main>

    <!-- EmailJS Script -->
    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
    <script>

        // Quiz data with correct answers
        const quizData = {
            correctAnswers: {
                q1: 'B', // Arduino is an open-source electronics platform
                q2: 'C', // Arduino uses C/C++
                q3: 'C', // Hard disk drive is not on Arduino
                q4: 'D', // All applications are correct
                q5: 'B'  // Disconnect power when making changes
            },
            questionText: {
                q1: 'What is Arduino?',
                q2: 'Arduino Programming Language',
                q3: 'Arduino Components',
                q4: 'Programming Applications',
                q5: 'Safety and Best Practices',
                q6: 'Explain Your Interest',
                q7: 'Problem Solving'
            }
        };

        document.getElementById('quizForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting...';
            
            // Get form data
            const formData = new FormData(this);
            const studentName = formData.get('quiz1StudentName');
            const studentEmail = formData.get('quiz1StudentEmail');
            
            // Calculate score and build results
            let score = 0;
            let totalQuestions = 5; // Multiple choice questions only
            let results = [];
            
            // Check multiple choice answers
            for (let i = 1; i <= 5; i++) {
                const questionKey = `q${i}`;
                const studentAnswer = formData.get(questionKey);
                const correctAnswer = quizData.correctAnswers[questionKey];
                const isCorrect = studentAnswer === correctAnswer;
                
                if (isCorrect) score++;
                
                results.push({
                    question: quizData.questionText[questionKey],
                    studentAnswer: studentAnswer || 'No answer',
                    correctAnswer: correctAnswer,
                    isCorrect: isCorrect
                });
            }
            
            // Add short answer questions
            results.push({
                question: quizData.questionText.q6,
                studentAnswer: formData.get('q6') || 'No answer provided',
                isShortAnswer: true
            });
            
            results.push({
                question: quizData.questionText.q7,
                studentAnswer: formData.get('q7') || 'No answer provided',
                isShortAnswer: true
            });
            
            const percentage = Math.round((score / totalQuestions) * 100);
            
            // Build detailed message
            let message = `WEEK 1 QUIZ RESULTS - Introduction to Arduino & Programming\n\n`;
            message += `Student: ${studentName}\n`;
            message += `Email: ${studentEmail}\n`;
            message += `Score: ${score}/${totalQuestions} (${percentage}%)\n\n`;
            
            message += `DETAILED RESULTS:\n`;
            message += `==================\n\n`;
            
            results.forEach((result, index) => {
                if (result.isShortAnswer) {
                    message += `${result.question}:\n`;
                    message += `Answer: ${result.studentAnswer}\n\n`;
                } else {
                    const status = result.isCorrect ? '✓ CORRECT' : '✗ INCORRECT';
                    message += `Q${index + 1}: ${result.question}\n`;
                    message += `Student Answer: ${result.studentAnswer}\n`;
                    message += `Correct Answer: ${result.correctAnswer}\n`;
                    message += `Status: ${status}\n\n`;
                }
            });
            
            // Performance analysis with emoji feedback
            message += `PERFORMANCE ANALYSIS:\n`;
            message += `=====================\n`;
            if (percentage >= 90) {
                message += `🌟 EXCELLENT! Outstanding understanding of Arduino basics and programming concepts.\n`;
                message += `The student demonstrates strong foundational knowledge and is ready to advance.\n`;
            } else if (percentage >= 80) {
                message += `🎯 VERY GOOD! Solid grasp of Arduino fundamentals with minor areas for review.\n`;
                message += `The student shows good comprehension and readiness for more advanced topics.\n`;
            } else if (percentage >= 70) {
                message += `👍 GOOD! Basic understanding demonstrated, with some concepts needing reinforcement.\n`;
                message += `Recommend reviewing lesson materials and practicing key concepts.\n`;
            } else if (percentage >= 60) {
                message += `📚 NEEDS IMPROVEMENT! Some understanding shown, but significant gaps remain.\n`;
                message += `Suggest additional study time and one-on-one review of fundamental concepts.\n`;
            } else {
                message += `🔄 REQUIRES ATTENTION! Limited understanding of basic concepts.\n`;
                message += `Recommend re-reading lesson materials and scheduling extra help sessions.\n`;
            }
            
            message += `\nNext Steps: Practice with Arduino IDE and prepare for Week 2: Arduino IDE Mastery\n`;
            message += `\nSubmitted: ${new Date().toLocaleString()}\n`;
            
            // Display results to student
            let grade = 'F';
            if (percentage >= 90) grade = 'A';
            else if (percentage >= 80) grade = 'B';
            else if (percentage >= 70) grade = 'C';
            else if (percentage >= 60) grade = 'D';
            
            const resultsHTML = `
                <div style="text-align: center; margin-bottom: 1rem;">
                    <div style="font-size: 2rem; font-weight: bold; color: #4a148c;">${score}/${totalQuestions} (${percentage}%)</div>
                    <div style="font-size: 1.5rem; font-weight: bold; color: #4a148c;">Grade: ${grade}</div>
                    <div style="margin-top: 1rem; padding: 1rem; background: #e8f5e8; border-radius: 6px; color: #2e7d32; font-weight: bold;">
                        📚 Week 1: Introduction to Arduino & Programming
                    </div>
                </div>
                <div style="text-align: left;">
                    ${results.map((r, index) => {
                        if (r.isShortAnswer) {
                            return `
                                <div style="margin-bottom: 1rem; padding: 1rem; background: #f0f9ff; border-radius: 6px;">
                                    <strong>${r.question}:</strong><br>
                                    <strong>Your answer:</strong> ${r.studentAnswer}
                                </div>
                            `;
                        } else {
                            return `
                                <div style="margin-bottom: 1rem; padding: 1rem; background: ${r.isCorrect ? '#e8f5e8' : '#ffeaea'}; border-radius: 6px;">
                                    <strong>Question ${index + 1}:</strong> ${r.isCorrect ? '✓' : '✗'}<br>
                                    <strong>Your answer:</strong> ${r.studentAnswer}<br>
                                    <strong>Correct answer:</strong> ${r.correctAnswer}
                                </div>
                            `;
                        }
                    }).join('')}
                </div>
            `;
            
            document.getElementById('resultsContent').innerHTML = resultsHTML;
            document.getElementById('quizResults').style.display = 'block';
            
            // Scroll to results
            document.getElementById('quizResults').scrollIntoView({ behavior: 'smooth' });
            
            // Set a timeout to prevent infinite loading
            console.log('Attempting to send email with EmailJS...');
            console.log('EmailJS parameters:', {
                service: 'service_ot1jg6s',
                template: 'template_io02xtm',
                to_email: 'chuck@c00lnerd.com',
                from_name: 'C00lnerd Quiz System',
                from_email: 'chuck@c00lnerd.com',
                subject: `Week 1 Arduino Quiz - ${studentName} (${percentage}%)`
            });
            
            // Set a timeout to prevent infinite loading
            const timeoutId = setTimeout(() => {
                console.error('EmailJS timeout - taking too long to respond');
                alert('The quiz submission is taking too long. Please check your internet connection and try again.');
                submitBtn.disabled = false;
                submitBtn.textContent = 'Submit Quiz';
            }, 15000); // 15 second timeout
            
            // Check if EmailJS is available
            if (typeof (window as any).emailjs === 'undefined') {
                alert('Email service is not available. Please refresh the page and try again.');
                submitBtn.disabled = false;
                submitBtn.textContent = 'Submit Quiz';
                return;
            }
            
            // Initialize EmailJS right before sending
            (window as any).emailjs.init('ct_s19oZHppLy9BlW');
            
            (window as any).emailjs.send('service_ot1jg6s', 'template_io02xtm', {
                to_email: 'chuck@c00lnerd.com',
                from_name: 'C00lnerd Quiz System',
                from_email: 'chuck@c00lnerd.com',
                message: message,
                subject: `Week 1 Arduino Quiz - ${studentName} (${percentage}%)`
            }).then(function(response) {
                clearTimeout(timeoutId);
                console.log('Quiz results sent successfully!', response.status, response.text);
                alert('Quiz submitted successfully! Your results have been sent to your instructor.');
                
                // Log to Google Sheets
                console.log('Logging quiz results to Google Sheets...');
                const totalQuestions = 7;
                
                // Calculate grade
                let grade = 'F';
                if (percentage >= 90) grade = 'A';
                else if (percentage >= 80) grade = 'B';
                else if (percentage >= 70) grade = 'C';
                else if (percentage >= 60) grade = 'D';
                
                const sheetsData = {
                    studentName: studentName,
                    studentEmail: studentEmail,
                    week: 'Week 1',
                    topic: 'Introduction to Programming',
                    score: score,
                    totalPoints: 7,
                    percentage: percentage,
                    grade: percentage >= 90 ? 'A' : percentage >= 80 ? 'B' : percentage >= 70 ? 'C' : percentage >= 60 ? 'D' : 'F',
                    timestamp: new Date().toISOString()
                };

                fetch('https://script.google.com/macros/s/AKfycbyiA4c14AqtPjr6T8OUXQkGoJ4C3QQnK6WHCdCa2xBDKx1SZreL0Y-sk70YJoa0OzME8w/exec', {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(sheetsData)
                })
                .then(() => {
                    console.log('Quiz results logged to Google Sheets successfully!');
                })
                .catch(error => {
                    console.log('Note: CORS error expected in localhost - Google Sheets logging will work in production:', error);
                });
            }).catch(function(error) {
                clearTimeout(timeoutId);
                console.error('EmailJS Error:', error);
                console.error('Error details:', error.text || error.message || 'Unknown error');
                alert(`There was an error submitting your quiz: ${error.text || error.message || 'Unknown error'}. Please try again or contact your instructor.`);
                submitBtn.disabled = false;
                submitBtn.textContent = 'Submit Quiz';
            });
        });
    </script>
</Layout>
