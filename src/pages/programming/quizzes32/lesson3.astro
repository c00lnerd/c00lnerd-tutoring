---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Lesson 3 Quiz: Calculations with Variables">
    <div style="max-width: 800px; margin: 0 auto; padding: 2rem;">
        <div class="container mx-auto px-4 max-w-4xl">
            <!-- Header -->
            <div class="text-center mb-8">
                <div class="flex items-center justify-center mb-4">
                    <div class="bg-green-500 text-white rounded-full w-16 h-16 flex items-center justify-center font-bold text-2xl mr-4">Q3</div>
                    <div class="text-left">
                        <h1 class="text-3xl font-bold text-gray-800">Lesson 3 Quiz: Calculations with Variables</h1>
                        <p class="text-gray-600">Test your understanding of using variables for math, conversions, and clear Serial output</p>
                        <p class="text-sm text-blue-600 font-medium">32-Week Course � Semester 1</p>
                    </div>
                </div>
            </div>

            <!-- Quiz Instructions -->
            <div class="bg-white rounded-xl shadow-lg p-6 mb-8">
                <h2 class="text-2xl font-bold text-gray-800 mb-4">Quiz Instructions</h2>
                <div class="bg-blue-50 p-4 rounded-lg">
                    <ul class="space-y-2 text-blue-800">
                        <li>� This quiz covers material from Lesson 3: Calculations with Variables</li>
                        <li>� Answer all questions to the best of your ability</li>
                        <li>� Your responses will be emailed to your instructor for review</li>
                        <li>� Take your time and think carefully about each answer</li>
                        <li>� You can review the lesson material if needed before submitting</li>
                    </ul>
                </div>
            </div>

            <!-- Quiz Form -->
            <form id="quizForm" autocomplete="off" class="space-y-8">
                <!-- Student Information -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-4">Student Information</h3>
                    <div class="grid md:grid-cols-2 gap-4">
                        <div>
                            <label for="quiz3StudentName" class="block text-sm font-medium text-gray-700 mb-2">Full Name</label>
                            <input type="text" id="quiz3StudentName" name="studentName" required 
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                        <div>
                            <label for="quiz3StudentEmail" class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
                            <input type="email" id="quiz3StudentEmail" name="studentEmail" required 
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                    </div>
                </div>

                <!-- Question 1 -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 1: Choosing a Variable Type</h3>
                    <p class="text-gray-600 mb-4">Which variable type is the best choice for a temperature value like <code>23.5</code>?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="A" class="mr-3">
                            <span>A) bool</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="B" class="mr-3">
                            <span>B) float</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="C" class="mr-3">
                            <span>C) char</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="D" class="mr-3">
                            <span>D) String</span>
                        </label>
                    </div>
                </div>

                <!-- Question 2 -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 2: Arithmetic</h3>
                    <p class="text-gray-600 mb-4">If <code>int apples = 3;</code> and <code>int oranges = 5;</code>, what does <code>apples + oranges</code> equal?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="A" class="mr-3">
                            <span>A) 15</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="B" class="mr-3">
                            <span>B) 8</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="C" class="mr-3">
                            <span>C) 35</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="D" class="mr-3">
                            <span>D) 2</span>
                        </label>
                    </div>
                </div>

                <!-- Question 3 -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 3: Reading a Formula</h3>
                    <p class="text-gray-600 mb-4">What does this formula do? <code>float fahrenheit = (celsius * 9.0 / 5.0) + 32.0;</code></p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="A" class="mr-3">
                            <span>A) It converts Fahrenheit to Celsius</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="B" class="mr-3">
                            <span>B) It converts Celsius to Fahrenheit</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="C" class="mr-3">
                            <span>C) It finds the average temperature</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="D" class="mr-3">
                            <span>D) It rounds the temperature</span>
                        </label>
                    </div>
                </div>

                <!-- Question 4 -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 4: Constants</h3>
                    <p class="text-gray-600 mb-4">What is the purpose of a line like <code>const int totalPoints = 10;</code>?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="A" class="mr-3">
                            <span>A) It makes a text message</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="B" class="mr-3">
                            <span>B) It stores a value that should not change</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="C" class="mr-3">
                            <span>C) It turns a variable into a decimal</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="D" class="mr-3">
                            <span>D) It sends the answer to the Serial Monitor</span>
                        </label>
                    </div>
                </div>

                <!-- Question 5 -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 5: Percentages</h3>
                    <p class="text-gray-600 mb-4">If a student scores 8 out of 10, which expression correctly calculates the percentage?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="A" class="mr-3">
                            <span>A) score + total * 100</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="B" class="mr-3">
                            <span>B) (score / 10.0) * 100.0</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="C" class="mr-3">
                            <span>C) score - total / 100</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="D" class="mr-3">
                            <span>D) score * total * 100</span>
                        </label>
                    </div>
                </div>

                <!-- Question 6 -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 6: Serial Output</h3>
                    <p class="text-gray-600 mb-4">Which code best prints a label and a value clearly, like <code>Score: 8</code>, to the Serial Monitor?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="A" class="mr-3">
                            <span>A) Serial.println(score + "Score");</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="B" class="mr-3">
                            <span>B) Serial.print("Score: "); Serial.println(score);</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="C" class="mr-3">
                            <span>C) Serial.print(score); Serial.print(score);</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="D" class="mr-3">
                            <span>D) Serial.println("Score" score);</span>
                        </label>
                    </div>
                </div>

                <!-- Question 7 - Short Answer -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 7: Code Analysis</h3>
                    <p class="text-gray-600 mb-4">Explain what happens in this code snippet:</p>
                    <pre class="bg-gray-100 p-3 rounded mb-4"><code>int score = 8;
int total = 10;
float percentage = (score / 10.0) * 100.0;
Serial.println(percentage);</code></pre>
                    <textarea name="q7" rows="3" 
                              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                              placeholder="Write your answer here..."></textarea>
                </div>

                <!-- Question 8 - Short Answer -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 8: Simple Calculator Program</h3>
                    <p class="text-gray-600 mb-4">Describe the simple calculator-style program you created. What values did you use, what calculation did your code perform, and what did it print to the Serial Monitor?</p>
                    <textarea name="q8" rows="4" 
                              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                              placeholder="Write your answer here..."></textarea>
                </div>

                <!-- Submit Button -->
                <div class="text-center">
                    <button type="submit" id="submitBtn" 
                            class="bg-green-500 hover:bg-green-600 text-white px-8 py-3 rounded-lg font-medium transition-colors duration-200"
                            style="background-color: #10b981; color: white; padding: 12px 32px; border-radius: 8px; font-weight: 500; border: none; cursor: pointer; transition: background-color 0.2s;">
                        Submit Quiz
                    </button>
                </div>
            </form>

            <!-- Quiz Results Display -->
            <div id="quizResults" style="display: none;" class="max-w-4xl mx-auto px-4 py-8">
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h2 class="text-2xl font-bold text-center mb-6 text-purple-800">?? Your Quiz Results</h2>
                    <div id="resultsContent"></div>
                    <div class="text-center mt-6">
                        <p class="text-gray-600">These results have been automatically sent to your instructor.</p>
                    </div>
                </div>
            </div>

            <!-- Navigation -->
            <div class="flex justify-between items-center mt-8">
                <div>
                    <a href="/programming/lessons32/Lesson3" style="background-color: #6b7280; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #4b5563; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#4b5563'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#6b7280'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                        ← Back to Lesson 3
                    </a>
                </div>
                <div>
                    <a href="/programming/lessons32/Lesson4" style="background-color: #2563eb; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #1d4ed8; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#1d4ed8'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#2563eb'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                        Next: Lesson 4 →
                    </a>
                </div>
            </div>
        </div>
    </main>

    <!-- EmailJS Script -->
    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
    <script is:inline>
     let captchaAnswer = 0;
     let emailjsReady = false;

     function generateCaptcha() {
         const num1 = Math.floor(Math.random() * 10) + 1;
         const num2 = Math.floor(Math.random() * 10) + 1;
         captchaAnswer = num1 + num2;

         const captchaQuestion = document.getElementById('captcha-question');
         if (captchaQuestion) {
             captchaQuestion.textContent = `What is ${num1} + ${num2}?`;
         }
     }

     function validateCaptcha() {
         const captchaInput = document.getElementById('captcha');
         const errorDiv = document.getElementById('captcha-error');
         const userAnswer = parseInt(captchaInput?.value, 10);

         if (!captchaInput) {
             return true;
         }

         if (userAnswer !== captchaAnswer) {
             if (errorDiv) errorDiv.style.display = 'block';
             generateCaptcha();
             if (captchaInput) {
                 captchaInput.value = '';
             }
             return false;
         }

         if (errorDiv) errorDiv.style.display = 'none';
         return true;
     }

     function validateSecurity() {
         const honeypot = document.getElementById('website');
         if (honeypot && honeypot.value) {
             console.log('Spam bot detected via honeypot');
             alert('Security check failed. Please try again.');
             return false;
         }

         const lastSubmission = localStorage.getItem('lastQuizStart');
         const now = Date.now();
         if (lastSubmission && (now - parseInt(lastSubmission, 10)) < 30000) {
             alert('Please wait 30 seconds between quiz attempts.');
             return false;
         }

         const emailInput = document.getElementById('quiz3StudentEmail');
         if (emailInput && emailInput.value) {
             const email = emailInput.value;
             const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
             if (!emailRegex.test(email)) {
                 alert('Please enter a valid email address.');
                 return false;
             }

             const spamDomains = ['tempmail.org', '10minutemail.com', 'guerrillamail.com', 'mailinator.com', 'throwaway.email'];
             const domain = email.split('@')[1]?.toLowerCase();
             if (domain && spamDomains.includes(domain)) {
                 alert('Please use a permanent email address.');
                 return false;
             }
         }

         if (!validateCaptcha()) {
             return false;
         }

         localStorage.setItem('lastQuizStart', now.toString());
         return true;
     }

     window.addEventListener('load', function() {
         if (document.getElementById('captcha-question')) {
             generateCaptcha();
         }

         if (typeof window.emailjs !== 'undefined') {
             window.emailjs.init('ct_s19oZHppLy9BlW');
             emailjsReady = true;
             console.log('EmailJS initialized successfully');
         } else {
             console.error('EmailJS failed to load');
         }
     });

     const quizData = {
         correctAnswers: {
             q1: 'B',
             q2: 'B',
             q3: 'B',
             q4: 'B',
             q5: 'B',
             q6: 'B'
         },
         questionText: {
             q1: 'Choosing a Variable Type',
             q2: 'Arithmetic',
             q3: 'Reading a Formula',
             q4: 'Constants',
             q5: 'Percentages',
             q6: 'Serial Output',
             q7: 'Code Analysis',
             q8: 'Simple Calculator Program'
         }
     };

     document.getElementById('quizForm').addEventListener('submit', function(e) {
         e.preventDefault();

         if (!validateSecurity()) {
             return;
         }

         const submitBtn = document.getElementById('submitBtn');
         submitBtn.disabled = true;
         submitBtn.textContent = 'Submitting...';

         const formData = new FormData(this);
         const studentName = document.getElementById('quiz3StudentName').value;
         const studentEmail = document.getElementById('quiz3StudentEmail').value;

         let score = 0;
         const totalQuestions = 6;
         const results = [];

         for (let i = 1; i <= 6; i++) {
             const questionKey = `q${i}`;
             const studentAnswer = formData.get(questionKey);
             const correctAnswer = quizData.correctAnswers[questionKey];
             const isCorrect = studentAnswer === correctAnswer;

             if (isCorrect) score++;

             results.push({
                 question: quizData.questionText[questionKey],
                 studentAnswer: studentAnswer || 'No answer',
                 correctAnswer: correctAnswer,
                 isCorrect: isCorrect
             });
         }

         results.push({
             question: quizData.questionText.q7,
             studentAnswer: formData.get('q7') || 'No answer provided',
             isShortAnswer: true
         });

         results.push({
             question: quizData.questionText.q8,
             studentAnswer: formData.get('q8') || 'No answer provided',
             isShortAnswer: true
         });

         const percentage = Math.round((score / totalQuestions) * 100);

         let message = `LESSON 3 QUIZ RESULTS - Calculations with Variables\n\n`;
         message += `Student: ${studentName}\n`;
         message += `Email: ${studentEmail}\n`;
         message += `Score: ${score}/${totalQuestions} (${percentage}%)\n\n`;
         message += `DETAILED RESULTS:\n`;
         message += `==================\n\n`;

         results.forEach((result, index) => {
             if (result.isShortAnswer) {
                 message += `${result.question}:\n`;
                 message += `Answer: ${result.studentAnswer}\n\n`;
             } else {
                 const status = result.isCorrect ? 'CORRECT' : 'INCORRECT';
                 message += `Q${index + 1}: ${result.question}\n`;
                 message += `Student Answer: ${result.studentAnswer}\n`;
                 message += `Correct Answer: ${result.correctAnswer}\n`;
                 message += `Status: ${status}\n\n`;
             }
         });

         message += `PERFORMANCE ANALYSIS:\n`;
         message += `=====================\n`;
         if (percentage >= 90) {
             message += `EXCELLENT! Excellent understanding of variable calculations, conversions, and Serial output.\n`;
             message += `The student demonstrates strong readiness for more applied Arduino programming.\n`;
         } else if (percentage >= 80) {
             message += `VERY GOOD! Solid grasp of calculation concepts and readable output.\n`;
             message += `The student shows good progress using variables in practical code.\n`;
         } else if (percentage >= 70) {
             message += `GOOD! Basic calculation ideas are understood, with some areas for practice.\n`;
             message += `Recommend more practice with formulas, percentages, and conversions.\n`;
         } else if (percentage >= 60) {
             message += `NEEDS IMPROVEMENT! Some understanding is present, but key calculation ideas need reinforcement.\n`;
             message += `Suggest reviewing how variables are used in arithmetic expressions and Serial output.\n`;
         } else {
             message += `REQUIRES ATTENTION! More guided practice is needed with variable math and reading code.\n`;
             message += `Recommend extra support with simple examples like temperature conversion and score percentages.\n`;
         }

         message += `\nNext Steps: Practice more small calculation programs and prepare for Lesson 4.\n`;
         message += `\nSubmitted: ${new Date().toLocaleString()}\n`;

         let grade = 'F';
         if (percentage >= 90) grade = 'A';
         else if (percentage >= 80) grade = 'B';
         else if (percentage >= 70) grade = 'C';
         else if (percentage >= 60) grade = 'D';

         const resultsHTML = `
             <div style="text-align: center; margin-bottom: 1rem;">
                 <div style="font-size: 2rem; font-weight: bold; color: #4a148c;">${score}/${totalQuestions} (${percentage}%)</div>
                 <div style="font-size: 1.5rem; font-weight: bold; color: #4a148c;">Grade: ${grade}</div>
                 <div style="margin-top: 1rem; padding: 1rem; background: #e8f5e8; border-radius: 6px; color: #2e7d32; font-weight: bold;">
                     Lesson 3: Calculations with Variables
                 </div>
             </div>
             <div style="text-align: left;">
                 ${results.map((r, index) => {
                     if (r.isShortAnswer) {
                         return `
                             <div style="margin-bottom: 1rem; padding: 1rem; background: #f0f9ff; border-radius: 6px;">
                                 <strong>${r.question}:</strong><br>
                                 <strong>Your answer:</strong> ${r.studentAnswer}
                             </div>
                         `;
                     }

                     return `
                         <div style="margin-bottom: 1rem; padding: 1rem; background: ${r.isCorrect ? '#e8f5e8' : '#ffeaea'}; border-radius: 6px;">
                             <strong>Question ${index + 1}:</strong> ${r.isCorrect ? 'Correct' : 'Incorrect'}<br>
                             <strong>Your answer:</strong> ${r.studentAnswer}<br>
                             <strong>Correct answer:</strong> ${r.correctAnswer}
                         </div>
                     `;
                 }).join('')}
             </div>
         `;

         document.getElementById('resultsContent').innerHTML = resultsHTML;
         document.getElementById('quizResults').style.display = 'block';
         document.getElementById('quizResults').scrollIntoView({ behavior: 'smooth' });

         if (!emailjsReady || typeof window.emailjs === 'undefined') {
             submitBtn.disabled = false;
             submitBtn.textContent = 'Submit Quiz';
             alert('Email service is not available. Please refresh the page and try again.');
             return;
         }

         const sheetsPayload = {
             studentName: studentName,
             studentEmail: studentEmail,
             week: 'Lesson 3',
             topic: 'Calculations with Variables',
             score: score,
             totalPoints: 8,
             percentage: percentage,
             grade: grade,
             timestamp: new Date().toISOString()
         };

         function logQuizToGoogleSheets() {
             console.log('Logging quiz results to Google Sheets...');
             return fetch('https://script.google.com/macros/s/AKfycbxJORcOZtpcCKh-ZRK6mAFsv-TXvroqJUjB22unDmTiRySX3Mylt8rX-FeMCgd_T47qPA/exec', {
                 method: 'POST',
                 mode: 'no-cors',
                 headers: {
                     'Content-Type': 'application/json'
                 },
                 body: JSON.stringify(sheetsPayload)
             })
                 .then(() => console.log('Quiz results logged to Google Sheets successfully!'))
                 .catch(error => console.log('Note: CORS error expected in localhost - Google Sheets logging will work in production:', error));
         }

         window.emailjs.send('service_kaw1xkh', 'template_io02xtm', {
             to_email: 'chuck@c00lnerd.com',
             from_name: 'C00lnerd Quiz System',
             from_email: 'chuck@c00lnerd.com',
             message: message,
             subject: `Lesson 3 Arduino Quiz - ${studentName} (${percentage}%)`
         }).then(function(response) {
             console.log('Quiz results sent successfully!', response.status, response.text);
             alert('Quiz submitted successfully!');
             return logQuizToGoogleSheets();
         }, function(error) {
             console.log('Failed to send quiz results...', error);
             return logQuizToGoogleSheets().then(function() {
                 alert('Quiz submitted successfully! Email is temporarily unavailable, but your results were saved to the grade log.');
             });
         }).finally(function() {
             submitBtn.disabled = false;
             submitBtn.textContent = 'Submit Quiz';
         });
     });
     </script>
 </Layout>
