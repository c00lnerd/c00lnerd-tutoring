---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Week 3 Quiz: Variables & Data Types">
    <div style="max-width: 800px; margin: 0 auto; padding: 2rem;">
        <div class="container mx-auto px-4 max-w-4xl">
            <!-- Header -->
            <div class="text-center mb-8">
                <div class="flex items-center justify-center mb-4">
                    <div class="bg-green-500 text-white rounded-full w-16 h-16 flex items-center justify-center font-bold text-2xl mr-4">Q3</div>
                    <div class="text-left">
                        <h1 class="text-3xl font-bold text-gray-800">Week 3 Quiz: Variables & Data Types</h1>
                        <p class="text-gray-600">Test your understanding of variables and data types in Arduino programming</p>
                        <p class="text-sm text-blue-600 font-medium">32-Week Course • Semester 1</p>
                    </div>
                </div>
            </div>

            <!-- Quiz Instructions -->
            <div class="bg-white rounded-xl shadow-lg p-6 mb-8">
                <h2 class="text-2xl font-bold text-gray-800 mb-4">Quiz Instructions</h2>
                <div class="bg-blue-50 p-4 rounded-lg">
                    <ul class="space-y-2 text-blue-800">
                        <li>• This quiz covers material from Week 3: Variables & Data Types</li>
                        <li>• Answer all questions to the best of your ability</li>
                        <li>• Your responses will be emailed to your instructor for review</li>
                        <li>• Take your time and think carefully about each answer</li>
                        <li>• You can review the lesson material if needed before submitting</li>
                    </ul>
                </div>
            </div>

            <!-- Quiz Form -->
            <form id="quizForm" autocomplete="off" class="space-y-8">
                <!-- Student Information -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-4">Student Information</h3>
                    <div class="grid md:grid-cols-2 gap-4">
                        <div>
                            <label for="quiz3StudentName" class="block text-sm font-medium text-gray-700 mb-2">Full Name</label>
                            <input type="text" id="quiz3StudentName" name="studentName" required 
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                        <div>
                            <label for="quiz3StudentEmail" class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
                            <input type="email" id="quiz3StudentEmail" name="studentEmail" required 
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                    </div>
                </div>

                <!-- Question 1 -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 1: Variable Declaration</h3>
                    <p class="text-gray-600 mb-4">Which of the following correctly declares an integer variable named "count" with an initial value of 10?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="A" class="mr-3">
                            <span>A) integer count = 10;</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="B" class="mr-3">
                            <span>B) int count = 10;</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="C" class="mr-3">
                            <span>C) var count = 10;</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="D" class="mr-3">
                            <span>D) count int = 10;</span>
                        </label>
                    </div>
                </div>

                <!-- Question 2 -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 2: Data Types</h3>
                    <p class="text-gray-600 mb-4">Which data type is best for storing decimal numbers in Arduino?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="A" class="mr-3">
                            <span>A) int</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="B" class="mr-3">
                            <span>B) bool</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="C" class="mr-3">
                            <span>C) float</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="D" class="mr-3">
                            <span>D) char</span>
                        </label>
                    </div>
                </div>

                <!-- Question 3 -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 3: Boolean Values</h3>
                    <p class="text-gray-600 mb-4">What are the two possible values for a boolean (bool) data type?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="A" class="mr-3">
                            <span>A) 0 and 1</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="B" class="mr-3">
                            <span>B) true and false</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="C" class="mr-3">
                            <span>C) yes and no</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="D" class="mr-3">
                            <span>D) on and off</span>
                        </label>
                    </div>
                </div>

                <!-- Question 4 -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 4: Variable Scope</h3>
                    <p class="text-gray-600 mb-4">Where should global variables be declared in an Arduino program?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="A" class="mr-3">
                            <span>A) Inside the setup() function</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="B" class="mr-3">
                            <span>B) Inside the loop() function</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="C" class="mr-3">
                            <span>C) At the top of the program, before setup() and loop()</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="D" class="mr-3">
                            <span>D) At the bottom of the program, after loop()</span>
                        </label>
                    </div>
                </div>

                <!-- Question 5 -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 5: Mathematical Operations</h3>
                    <p class="text-gray-600 mb-4">What is the result of the expression: 15 % 4 (modulo operator)?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="A" class="mr-3">
                            <span>A) 3</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="B" class="mr-3">
                            <span>B) 4</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="C" class="mr-3">
                            <span>C) 11</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="D" class="mr-3">
                            <span>D) 60</span>
                        </label>
                    </div>
                </div>

                <!-- Question 6 -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 6: String Data Type</h3>
                    <p class="text-gray-600 mb-4">How do you declare a String variable containing the text "Arduino"?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="A" class="mr-3">
                            <span>A) String message = Arduino;</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="B" class="mr-3">
                            <span>B) String message = "Arduino";</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="C" class="mr-3">
                            <span>C) string message = "Arduino";</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="D" class="mr-3">
                            <span>D) text message = "Arduino";</span>
                        </label>
                    </div>
                </div>

                <!-- Question 7 - Short Answer -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 7: Code Analysis</h3>
                    <p class="text-gray-600 mb-4">Explain what happens in this code snippet:</p>
                    <pre class="bg-gray-100 p-3 rounded mb-4"><code>int temperature = 25;
temperature = temperature + 5;
Serial.println(temperature);</code></pre>
                    <textarea name="q7" rows="3" 
                              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                              placeholder="Write your answer here..."></textarea>
                </div>

                <!-- Question 8 - Short Answer -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 8: Data Logger Project</h3>
                    <p class="text-gray-600 mb-4">Describe the personal data logger you created for the hands-on activity. What data did you choose to track and what calculations did your program perform?</p>
                    <textarea name="q8" rows="4" 
                              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                              placeholder="Write your answer here..."></textarea>
                </div>

                <!-- Submit Button -->
                <div class="text-center">
                    <button type="submit" id="submitBtn" 
                            class="bg-green-500 hover:bg-green-600 text-white px-8 py-3 rounded-lg font-medium transition-colors duration-200"
                            style="background-color: #10b981; color: white; padding: 12px 32px; border-radius: 8px; font-weight: 500; border: none; cursor: pointer; transition: background-color 0.2s;">
                        Submit Quiz
                    </button>
                </div>
            </form>

            <!-- Quiz Results Display -->
            <div id="quizResults" style="display: none;" class="max-w-4xl mx-auto px-4 py-8">
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h2 class="text-2xl font-bold text-center mb-6 text-purple-800">?? Your Quiz Results</h2>
                    <div id="resultsContent"></div>
                    <div class="text-center mt-6">
                        <p class="text-gray-600">These results have been automatically sent to your instructor.</p>
                    </div>
                </div>
            </div>

            <!-- Navigation -->
            <div class="flex justify-between items-center mt-8">
                <div>
                    <a href="/programming/lessons32/week3" style="background-color: #6b7280; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #4b5563; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#4b5563'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#6b7280'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                        ? Back to Week 3 Lesson
                    </a>
                </div>
                <div>
                    <a href="/programming/lessons32/week4" style="background-color: #2563eb; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #1d4ed8; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#1d4ed8'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#2563eb'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                        Next: Week 4 Lesson ?
                    </a>
                </div>
            </div>
        </div>
    </main>

    <!-- EmailJS Script -->
    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js">
window.onload = function() { generateCaptcha(); };
    // CAPTCHA variables
    let captchaAnswer = 0;
    
    function generateCaptcha() {
        const num1 = Math.floor(Math.random() * 10) + 1;
        const num2 = Math.floor(Math.random() * 10) + 1;
        captchaAnswer = num1 + num2;
        const questionElement = document.getElementById('captcha-question');
        if (questionElement) {
            questionElement.textContent = num1 + " + " + num2;
        }
    }
    
    function validateCaptcha() {
        const userAnswer = parseInt(document.getElementById('captcha').value);
        const errorDiv = document.getElementById('captcha-error');
        
        if (userAnswer !== captchaAnswer) {
            if (errorDiv) errorDiv.style.display = 'block';
            generateCaptcha(); // Generate new question
            document.getElementById('captcha').value = '';
            return false;
        }
        
        if (errorDiv) errorDiv.style.display = 'none';
        return true;
    }
    
    // Security validation function
    function validateSecurity() {
        // Check honeypot field (should be empty)
        const honeypot = document.getElementById('website');
        if (honeypot && honeypot.value) {
            console.log('Spam bot detected via honeypot');
            alert('Security check failed. Please try again.');
            return false;
        }
        
        // Rate limiting check
        const lastSubmission = localStorage.getItem('lastQuizStart');
        const now = Date.now();
        if (lastSubmission && (now - parseInt(lastSubmission)) < 30000) { // 30 second cooldown
            alert('Please wait 30 seconds between quiz attempts.');
            return false;
        }
        localStorage.setItem('lastQuizStart', now.toString());
        
        // Validate CAPTCHA
        if (!validateCaptcha()) {
            return false;
        }
        
        // Email validation and domain filtering
        const emailInput = document.getElementById('email');
        if (emailInput && emailInput.value) {
            const email = emailInput.value;
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                alert('Please enter a valid email address.');
                return false;
            }
            
            // Block common spam domains
            const spamDomains = ['tempmail.org', '10minutemail.com', 'guerrillamail.com', 'mailinator.com', 'throwaway.email'];
            const domain = email.split('@')[1].toLowerCase();
            if (spamDomains.includes(domain)) {
                alert('Please use a permanent email address.');
                return false;
            }
        }
        
        return true;
    }</script>
