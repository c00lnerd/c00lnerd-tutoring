---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Week 5 Quiz: Analog Inputs & Sensors - C00lnerd Tutoring">
    <div style="max-width: 800px; margin: 0 auto; padding: 2rem;">
        
            <!-- Header -->
            <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 2rem; border-radius: 10px; margin-bottom: 2rem; text-align: center;">
                <h1 style="font-size: 2rem; font-weight: bold; margin: 0;">Week 5 Quiz: Analog Inputs & Sensors</h1>
                <p class="text-xl text-gray-600">Test your understanding of analog signals and sensor interfacing</p>
                <div class="mt-4 p-4 bg-blue-100 rounded-lg">
                    <p class="text-blue-800 font-medium">📝 10 questions covering ADC, sensors, and data processing</p>
                </div>
            </div>

            <!-- Student Information -->
            <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
                <h2 class="text-2xl font-bold text-purple-800 mb-6">Student Information</h2>
                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <label for="quiz5StudentName" class="block text-sm font-medium text-gray-700 mb-2">Full Name</label>
                        <input type="text" id="quiz5StudentName" name="studentName" required 
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500">
                    </div>
                    <div>
                        <label for="quiz5StudentEmail" class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
                        <input type="email" id="quiz5StudentEmail" name="studentEmail" required 
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500">
                    </div>
                </div>
            </div>

            <!-- Quiz Questions -->
            <form id="quizForm" autocomplete="off" class="space-y-8">
                <!-- Question 1 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 1: ADC Resolution</h3>
                    <p class="text-gray-700 mb-4">What is the resolution of Arduino's Analog-to-Digital Converter (ADC)?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="A" class="mr-3">
                            <span>A) 8-bit (0-255)</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="B" class="mr-3">
                            <span>B) 10-bit (0-1023)</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="C" class="mr-3">
                            <span>C) 12-bit (0-4095)</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="D" class="mr-3">
                            <span>D) 16-bit (0-65535)</span>
                        </label>
                    </div>
                </div>

                <!-- Question 2 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 2: Analog Reading Function</h3>
                    <p class="text-gray-700 mb-4">Which function is used to read analog values from a sensor?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="A" class="mr-3">
                            <span>A) digitalRead(pin)</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="B" class="mr-3">
                            <span>B) analogRead(pin)</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="C" class="mr-3">
                            <span>C) readAnalog(pin)</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="D" class="mr-3">
                            <span>D) getSensor(pin)</span>
                        </label>
                    </div>
                </div>

                <!-- Question 3 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 3: Voltage Conversion</h3>
                    <p class="text-gray-700 mb-4">If analogRead() returns 512 on a 5V system, what voltage does this represent?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="A" class="mr-3">
                            <span>A) 1.25V</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="B" class="mr-3">
                            <span>B) 2.5V</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="C" class="mr-3">
                            <span>C) 3.75V</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="D" class="mr-3">
                            <span>D) 5V</span>
                        </label>
                    </div>
                </div>

                <!-- Question 4 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 4: map() Function</h3>
                    <p class="text-gray-700 mb-4">What does this code do: <code>int brightness = map(sensorValue, 0, 1023, 0, 255);</code></p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="A" class="mr-3">
                            <span>A) Converts sensor value to voltage</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="B" class="mr-3">
                            <span>B) Scales sensor value (0-1023) to PWM range (0-255)</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="C" class="mr-3">
                            <span>C) Adds 255 to the sensor value</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="D" class="mr-3">
                            <span>D) Divides sensor value by 4</span>
                        </label>
                    </div>
                </div>

                <!-- Question 5 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 5: Potentiometer Wiring</h3>
                    <p class="text-gray-700 mb-4">In a potentiometer circuit, which pin should be connected to the analog input?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="A" class="mr-3">
                            <span>A) The pin connected to 5V</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="B" class="mr-3">
                            <span>B) The wiper (middle) pin</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="C" class="mr-3">
                            <span>C) The pin connected to ground</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="D" class="mr-3">
                            <span>D) Any of the three pins</span>
                        </label>
                    </div>
                </div>

                <!-- Question 6 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 6: LED Current-Limiting Resistors</h3>
                    <p class="text-gray-700 mb-4">Why is a current-limiting resistor essential when connecting an LED to an Arduino pin?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="A" class="mr-3">
                            <span>A) To increase the LED brightness</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="B" class="mr-3">
                            <span>B) To protect the LED and Arduino pin from excessive current</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="C" class="mr-3">
                            <span>C) To change the LED color</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="D" class="mr-3">
                            <span>D) To make the LED blink automatically</span>
                        </label>
                    </div>
                </div>

                <!-- Question 7 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 7: Data Filtering</h3>
                    <p class="text-gray-700 mb-4">Why is data filtering important when reading sensors?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q7" value="A" class="mr-3">
                            <span>A) To make readings faster</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q7" value="B" class="mr-3">
                            <span>B) To reduce noise and stabilize readings</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q7" value="C" class="mr-3">
                            <span>C) To increase the sensor's range</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q7" value="D" class="mr-3">
                            <span>D) To save memory</span>
                        </label>
                    </div>
                </div>

                <!-- Question 8 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 8: Moving Average</h3>
                    <p class="text-gray-700 mb-4">In a moving average filter with 5 readings, what happens to the oldest reading when a new one is added?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q8" value="A" class="mr-3">
                            <span>A) It's added to the newest reading</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q8" value="B" class="mr-3">
                            <span>B) It's discarded and replaced</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q8" value="C" class="mr-3">
                            <span>C) It's stored permanently</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q8" value="D" class="mr-3">
                            <span>D) It's multiplied by 2</span>
                        </label>
                    </div>
                </div>

                <!-- Question 9: Short Answer -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 9: Sensor Calibration</h3>
                    <p class="text-gray-700 mb-4">Explain why sensor calibration is important and describe one method to calibrate a light sensor for your specific environment.</p>
                    <textarea name="q9" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500" 
                              placeholder="Write your answer here..."></textarea>
                </div>

                <!-- Question 10: Short Answer -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 10: Voltage Divider Circuit</h3>
                    <p class="text-gray-700 mb-4">Describe how a voltage divider circuit works with a variable resistor (like an LDR or potentiometer) to create varying analog signals for the Arduino to read.</p>
                    <textarea name="q10" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500" 
                              placeholder="Write your answer here..."></textarea>
                </div>

                <!-- Submit Button -->
                <div class="text-center">
                    <button type="submit" id="submitBtn" 
                            style="background-color: #10b981; color: white; padding: 12px 32px; border-radius: 8px; font-weight: 500; border: none; cursor: pointer; transition: background-color 0.2s;">
                        Submit Quiz
                    </button>
                </div>
            </form>
        </div>

        <!-- Quiz Results Display -->
        <div id="quizResults" style="display: none;" class="max-w-4xl mx-auto px-4 py-8">
            <div class="bg-white rounded-lg shadow-lg p-8">
                <h2 class="text-2xl font-bold text-center mb-6 text-purple-800">📊 Your Quiz Results</h2>
                <div id="resultsContent"></div>
                <div class="text-center mt-6">
                    <p class="text-gray-600">These results have been automatically sent to your instructor.</p>
                </div>
            </div>
        </div>

        <div class="max-w-4xl mx-auto px-4 py-8">
            <!-- Navigation -->
            <div class="flex justify-between items-center mt-8">
                <div>
                    <a href="/programming/lessons32/week5" style="background-color: #6b7280; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #4b5563; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#4b5563'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#6b7280'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                        ← Back to Week 5 Lesson
                    </a>
                </div>
                <div>
                    <a href="/programming/lessons32/week6" style="background-color: #2563eb; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #1d4ed8; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#1d4ed8'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#2563eb'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                        Next: Week 6 Lesson →
                    </a>
                </div>
            </div>
        </div>
    </main>

    <!-- EmailJS Script -->
    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js">
window.onload = function() { generateCaptcha(); };
    // CAPTCHA variables
    let captchaAnswer = 0;
    
    function generateCaptcha() {
        const num1 = Math.floor(Math.random() * 10) + 1;
        const num2 = Math.floor(Math.random() * 10) + 1;
        captchaAnswer = num1 + num2;
        const questionElement = document.getElementById('captcha-question');
        if (questionElement) {
            questionElement.textContent = num1 + " + " + num2;
        }
    }
    
    function validateCaptcha() {
        const userAnswer = parseInt(document.getElementById('captcha').value);
        const errorDiv = document.getElementById('captcha-error');
        
        if (userAnswer !== captchaAnswer) {
            if (errorDiv) errorDiv.style.display = 'block';
            generateCaptcha(); // Generate new question
            document.getElementById('captcha').value = '';
            return false;
        }
        
        if (errorDiv) errorDiv.style.display = 'none';
        return true;
    }
    
    // Security validation function
    function validateSecurity() {
        // Check honeypot field (should be empty)
        const honeypot = document.getElementById('website');
        if (honeypot && honeypot.value) {
            console.log('Spam bot detected via honeypot');
            alert('Security check failed. Please try again.');
            return false;
        }
        
        // Rate limiting check
        const lastSubmission = localStorage.getItem('lastQuizStart');
        const now = Date.now();
        if (lastSubmission && (now - parseInt(lastSubmission)) < 30000) { // 30 second cooldown
            alert('Please wait 30 seconds between quiz attempts.');
            return false;
        }
        localStorage.setItem('lastQuizStart', now.toString());
        
        // Validate CAPTCHA
        if (!validateCaptcha()) {
            return false;
        }
        
        // Email validation and domain filtering
        const emailInput = document.getElementById('email');
        if (emailInput && emailInput.value) {
            const email = emailInput.value;
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                alert('Please enter a valid email address.');
                return false;
            }
            
            // Block common spam domains
            const spamDomains = ['tempmail.org', '10minutemail.com', 'guerrillamail.com', 'mailinator.com', 'throwaway.email'];
            const domain = email.split('@')[1].toLowerCase();
            if (spamDomains.includes(domain)) {
                alert('Please use a permanent email address.');
                return false;
            }
        }
        
        return true;
    }</script>
