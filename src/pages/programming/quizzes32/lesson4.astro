        // Quiz data with correct answers
        const quizData = {
            correctAnswers: {
                q1: 'D', // Both HIGH/LOW and 1/0 are correct
                q2: 'B', // pinMode(pin, OUTPUT)
                q3: 'D', // Both HIGH and 1 are correct
                q4: 'B', // Ensure defined state
                q5: 'B', // digitalRead(pin)
                q6: 'C', // 5V
                q7: 'B', // Pin reads LOW when pressed
                q8: 'B'  // Turn on LED when button pressed with pull-up
            },
            questionText: {
                q1: "What are the two possible states of a digital signal in Arduino?",
                q2: "Which function is used to configure a pin as an output in Arduino?",
                q3: "To turn on an LED connected to pin 13, which command would you use?",
                q4: "What is the purpose of a pull-up resistor in digital input circuits?",
                q5: "Which function is used to read the state of a digital input pin?",
                q6: "In a 5V Arduino system, what voltage represents a HIGH digital state?",
                q7: "When using INPUT_PULLUP mode, what happens when a button is pressed?",
                q8: "What will this code do: if (digitalRead(2) == LOW) { digitalWrite(13, HIGH); }",
                q9: "Explain why you need a current-limiting resistor when connecting an LED to an Arduino pin. What could happen without it?",
                q10: "Describe how you would implement button debouncing in software. Why is debouncing necessary?"
            }
        };

        document.getElementById('quizForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const studentName = document.getElementById('quiz4StudentName').value;
            const studentEmail = document.getElementById('quiz4StudentEmail').value;
            
            if (!studentName || !studentEmail) {
                alert('Please fill in your name and email address.');
                return;
            }

            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting...';
            
            const formData = new FormData(this);
            const results = [];
            let score = 0;
            const totalQuestions = 8; // Multiple choice questions only for scoring
            
            // Check multiple choice answers (q1-q8)
            for (let i = 1; i <= 8; i++) {
                const questionKey = `q${i}`;
                const userAnswer = formData.get(questionKey);
                const correctAnswer = quizData.correctAnswers[questionKey];
                const isCorrect = userAnswer === correctAnswer;
                
                if (isCorrect) score++;
                
                results.push({
                    question: quizData.questionText[questionKey],
                    userAnswer: userAnswer || 'No answer provided',
                    correctAnswer: correctAnswer,
                    isCorrect: isCorrect
                });
            }
            
            // Add short answer questions
            results.push({
                question: quizData.questionText.q9,
                studentAnswer: formData.get('q9') || 'No answer provided',
                isShortAnswer: true
            });
            
            results.push({
                question: quizData.questionText.q10,
                studentAnswer: formData.get('q10') || 'No answer provided',
                isShortAnswer: true
            });
            
            const percentage = Math.round((score / totalQuestions) * 100);
            
            // Build detailed message
            let message = `WEEK 4 QUIZ RESULTS - Digital I/O Basics\n\n`;
            message += `Student: ${studentName}\n`;
            message += `Email: ${studentEmail}\n`;
            message += `Score: ${score}/${totalQuestions} (${percentage}%)\n\n`;
            
            message += `DETAILED RESULTS:\n`;
            message += `==================\n\n`;
            
            results.forEach((result, index) => {
                if (result.isShortAnswer) {
                    message += `${result.question}:\n`;
                    message += `Answer: ${result.studentAnswer}\n\n`;
                } else {
                    const status = result.isCorrect ? '? CORRECT' : '? INCORRECT';
                    message += `Q${index + 1}: ${result.question}\n`;
                    message += `Student Answer: ${result.userAnswer}\n`;
                    message += `Correct Answer: ${result.correctAnswer}\n`;
                    message += `Status: ${status}\n\n`;
                }
            });
            
            message += `PERFORMANCE ANALYSIS:\n`;
            message += `====================\n`;
            if (percentage >= 90) {
                message += `?? EXCELLENT! Outstanding understanding of digital I/O concepts.\n`;
                message += `Student demonstrates mastery of pinMode, digitalWrite, digitalRead, and pull-up resistors.\n`;
            } else if (percentage >= 80) {
                message += `?? VERY GOOD! Strong grasp of digital I/O fundamentals.\n`;
                message += `Student shows solid understanding with minor areas for review.\n`;
            } else if (percentage >= 70) {
                message += `?? GOOD! Basic understanding of digital concepts with room for improvement.\n`;
                message += `Recommend additional practice with button debouncing and circuit analysis.\n`;
            } else if (percentage >= 60) {
                message += `?? NEEDS IMPROVEMENT. Some understanding but requires more practice.\n`;
                message += `Focus on digital signal states, pin configuration, and basic I/O functions.\n`;
            } else {
                message += `?? REQUIRES ATTENTION! Limited understanding of digital I/O concepts.\n`;
                message += `Recommend reviewing lesson materials and hands-on practice with circuits.\n`;
            }
            
            message += `\nNext Steps: Practice with digital circuits and prepare for Week 5: Analog Inputs & Sensors\n`;
            message += `\nSubmitted: ${new Date().toLocaleString()}\n`;
            
            // Display results to student
            let grade = 'F';
            if (percentage >= 90) grade = 'A';
            else if (percentage >= 80) grade = 'B';
            else if (percentage >= 70) grade = 'C';
            else if (percentage >= 60) grade = 'D';
            
            const resultsHTML = `
                <div style="text-align: center; margin-bottom: 1rem;">
                    <div style="font-size: 2rem; font-weight: bold; color: #4a148c;">${score}/${totalQuestions} (${percentage}%)</div>
                    <div style="font-size: 1.5rem; font-weight: bold; color: #4a148c;">Grade: ${grade}</div>
                    <div style="margin-top: 1rem; padding: 1rem; background: #e8f5e8; border-radius: 6px; color: #2e7d32; font-weight: bold;">
                        ?? Week 4: Digital I/O Basics
                    </div>
                </div>
                <div style="text-align: left;">
                    ${results.map((r, index) => {
                        if (r.isShortAnswer) {
                            return `
                                <div style="margin-bottom: 1rem; padding: 1rem; background: #f0f9ff; border-radius: 6px;">
                                    <strong>${r.question}:</strong><br>
                                    <strong>Your answer:</strong> ${r.studentAnswer}
                                </div>
                            `;
                        } else {
                            return `
                                <div style="margin-bottom: 1rem; padding: 1rem; background: ${r.isCorrect ? '#e8f5e8' : '#ffeaea'}; border-radius: 6px;">
                                    <strong>Question ${index + 1}:</strong> ${r.isCorrect ? '?' : '?'}<br>
                                    <strong>Your answer:</strong> ${r.userAnswer}<br>
                                    <strong>Correct answer:</strong> ${r.correctAnswer}
                                </div>
                            `;
                        }
                    }).join('')}
                </div>
            `;
            
            document.getElementById('resultsContent').innerHTML = resultsHTML;
            document.getElementById('quizResults').style.display = 'block';
            
            // Scroll to results
            document.getElementById('quizResults').scrollIntoView({ behavior: 'smooth' });
            
