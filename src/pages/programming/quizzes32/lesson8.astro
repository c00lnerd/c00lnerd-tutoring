                alert('Please use a permanent email address.');
                return false;
            }
        }
        
        return true;
    }
        // Quiz data with correct answers
        const quizData = {
            correctAnswers: {
                q1: 'B', // 5V
                q2: 'B', // 14
                q3: 'C', // 7-12V
                q4: 'B', // Pins 3, 5, 6, 9, 10, 11
                q5: 'B', // ATmega328P
                q6: 'B', // 40mA
                q7: 'B', // They provide plug-and-play functionality without complex wiring
                q8: 'C'  // Arduino Mega 2560
            },
            questionText: {
                q1: "What is the operating voltage of Arduino Uno?",
                q2: "How many digital I/O pins does Arduino Uno have?",
                q3: "What is the recommended external power input voltage range for Arduino Uno?",
                q4: "Which pins on Arduino Uno support PWM output?",
                q5: "What microcontroller does Arduino Uno use?",
                q6: "What is the maximum current that each Arduino pin can safely source or sink?",
                q7: "What is the main advantage of using Arduino shields?",
                q8: "Which Arduino model is best suited for projects requiring many I/O pins?",
                q9: "Explain three important safety considerations when powering an Arduino board. Include voltage limits, current limits, and polarity concerns.",
                q10: "You're designing a wearable fitness tracker that needs to be very small and monitor heart rate, steps, and temperature. Which Arduino board would you choose and why? Consider size, power consumption, and I/O requirements."
            }
        };

        document.getElementById('quizForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const studentName = document.getElementById('quiz8StudentName').value;
            const studentEmail = document.getElementById('quiz8StudentEmail').value;
            
            if (!studentName || !studentEmail) {
                alert('Please fill in your name and email address.');
                return;
            }

            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting...';
            
            const formData = new FormData(this);
            const results = [];
            let score = 0;
            const totalQuestions = 8; // Multiple choice questions only for scoring
            
            // Check multiple choice answers (q1-q8)
            for (let i = 1; i <= 8; i++) {
                const questionKey = `q${i}`;
                const userAnswer = formData.get(questionKey);
                const correctAnswer = quizData.correctAnswers[questionKey];
                const isCorrect = userAnswer === correctAnswer;
                
                if (isCorrect) score++;
                
                results.push({
                    question: quizData.questionText[questionKey],
                    userAnswer: userAnswer || 'No answer provided',
                    correctAnswer: correctAnswer,
                    isCorrect: isCorrect
                });
            }
            
            // Add short answer questions
            results.push({
                question: quizData.questionText.q9,
                studentAnswer: formData.get('q9') || 'No answer provided',
                isShortAnswer: true
            });
            
            results.push({
                question: quizData.questionText.q10,
                studentAnswer: formData.get('q10') || 'No answer provided',
                isShortAnswer: true
            });
            
            const percentage = Math.round((score / totalQuestions) * 100);
            
            // Build detailed message
            let message = `WEEK 8 QUIZ RESULTS - Introduction to Arduino Hardware\n\n`;
            message += `Student: ${studentName}\n`;
            message += `Email: ${studentEmail}\n`;
            message += `Score: ${score}/${totalQuestions} (${percentage}%)\n\n`;
            
            message += `DETAILED RESULTS:\n`;
            message += `==================\n\n`;
            
            results.forEach((result, index) => {
                if (result.isShortAnswer) {
                    message += `${result.question}:\n`;
                    message += `Answer: ${result.studentAnswer}\n\n`;
                } else {
                    const status = result.isCorrect ? '? CORRECT' : '? INCORRECT';
                    message += `Q${index + 1}: ${result.question}\n`;
                    message += `Student Answer: ${result.userAnswer}\n`;
                    message += `Correct Answer: ${result.correctAnswer}\n`;
                    message += `Status: ${status}\n\n`;
                }
            });
            
            message += `PERFORMANCE ANALYSIS:\n`;
            message += `====================\n`;
            if (percentage >= 90) {
                message += `?? EXCELLENT! Outstanding understanding of Arduino hardware and components.\n`;
                message += `Student demonstrates mastery of board specifications, power requirements, and hardware selection.\n`;
            } else if (percentage >= 80) {
                message += `?? VERY GOOD! Strong grasp of Arduino hardware fundamentals.\n`;
                message += `Student shows solid understanding with minor areas for review.\n`;
            } else if (percentage >= 70) {
                message += `?? GOOD! Basic understanding of Arduino hardware with room for improvement.\n`;
                message += `Recommend additional practice with board specifications and power calculations.\n`;
            } else if (percentage >= 60) {
                message += `?? NEEDS IMPROVEMENT. Some understanding but requires more practice.\n`;
                message += `Focus on Arduino pin configurations, voltage requirements, and safety considerations.\n`;
            } else {
                message += `?? REQUIRES ATTENTION! Limited understanding of Arduino hardware concepts.\n`;
                message += `Recommend reviewing lesson materials and hands-on exploration of Arduino boards.\n`;
            }
            
            message += `\nNext Steps: Prepare for hands-on hardware projects and Week 9: Basic Sensors\n`;
            message += `\nSubmitted: ${new Date().toLocaleString()}\n`;
            
            // Display results to student
            let grade = 'F';
            if (percentage >= 90) grade = 'A';
            else if (percentage >= 80) grade = 'B';
            else if (percentage >= 70) grade = 'C';
            else if (percentage >= 60) grade = 'D';
            
            const resultsHTML = `
                <div style="text-align: center; margin-bottom: 1rem;">
                    <div style="font-size: 2rem; font-weight: bold; color: #ea580c;">${score}/${totalQuestions} (${percentage}%)</div>
                    <div style="font-size: 1.5rem; font-weight: bold; color: #ea580c;">Grade: ${grade}</div>
                    <div style="margin-top: 1rem; padding: 1rem; background: #fed7aa; border-radius: 6px; color: #ea580c; font-weight: bold;">
                        ?? Week 8: Introduction to Arduino Hardware
                    </div>
                </div>
                <div style="text-align: left;">
                    ${results.map((r, index) => {
                        if (r.isShortAnswer) {
                            return `
                                <div style="margin-bottom: 1rem; padding: 1rem; background: #f0f9ff; border-radius: 6px;">
                                    <strong>${r.question}:</strong><br>
                                    <strong>Your answer:</strong> ${r.studentAnswer}
                                </div>
                            `;
                        } else {
                            return `
                                <div style="margin-bottom: 1rem; padding: 1rem; background: ${r.isCorrect ? '#e8f5e8' : '#ffeaea'}; border-radius: 6px;">
                                    <strong>Question ${index + 1}:</strong> ${r.isCorrect ? '?' : '?'}<br>
                                    <strong>Your answer:</strong> ${r.userAnswer}<br>
                                    <strong>Correct answer:</strong> ${r.correctAnswer}
                                </div>
                            `;
                        }
                    }).join('')}
                </div>
            `;
            
            document.getElementById('resultsContent').innerHTML = resultsHTML;
            document.getElementById('quizResults').style.display = 'block';
            
            // Scroll to results
            document.getElementById('quizResults').scrollIntoView({ behavior: 'smooth' });
            
            // Send email using EmailJS
            // Check if EmailJS is available
            if (typeof window.emailjs === 'undefined') {
                alert('Email service is not available. Please refresh the page and try again.');
                return;
            }
            
            // Initialize EmailJS right before sending
            window.emailjs.init('ct_s19oZHppLy9BlW');
            
            window.emailjs.send('service_kaw1xkh', 'template_io02xtm', {
                to_email: 'chuck@c00lnerd.com',
                from_name: 'C00lnerd Quiz System',
                from_email: 'chuck@c00lnerd.com',
                
                message: message,
                subject: `Week 8 Arduino Quiz - ${studentName} (${percentage}%)`
            }).then(function(response) {
                console.log('Quiz results sent successfully!', response.status, response.text);
                alert('Quiz results sent successfully!');
                
                // Log to Google Sheets
                console.log('Logging quiz results to Google Sheets...');
                fetch('https://script.google.com/macros/s/AKfycbyiA4c14AqtPjr6T8OUXQkGoJ4C3QQnK6WHCdCa2xBDKx1SZreL0Y-sk70YJoa0OzME8w/exec', {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        studentName: studentName,
                        studentEmail: studentEmail,
                        week: 'Week 8',
                        topic: 'Introduction to Arduino Hardware',
                        score: score,
                        totalPoints: totalQuestions,
                        percentage: percentage,
                        grade: percentage >= 90 ? 'A' : percentage >= 80 ? 'B' : percentage >= 70 ? 'C' : percentage >= 60 ? 'D' : 'F',
                        timestamp: new Date().toISOString()
                    })
                })
                .then(() => console.log('Quiz results logged to Google Sheets successfully!'))
                .catch(error => console.log('Note: CORS error expected in localhost - Google Sheets logging will work in production:', error));
                
            }, function(error) {
                console.log('Failed to send quiz results...', error);
                alert('There was an issue sending your quiz results. Please contact your instructor.');
            });
        });
    </script>
</Layout>


