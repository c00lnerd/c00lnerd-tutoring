---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Week 2 Quiz: Arduino IDE & First Programs">
    <div style="max-width: 800px; margin: 0 auto; padding: 2rem;">
        <div class="container mx-auto px-4 max-w-4xl">
            <!-- Header -->
            <div class="text-center mb-8">
                <div class="flex items-center justify-center mb-4">
                    <div class="bg-green-500 text-white rounded-full w-16 h-16 flex items-center justify-center font-bold text-2xl mr-4">Q2</div>
                    <div class="text-left">
                        <h1 class="text-3xl font-bold text-gray-800">Week 2 Quiz: Arduino IDE & First Programs</h1>
                        <p class="text-gray-600">Test your understanding of Arduino IDE and program structure</p>
                        <p class="text-sm text-blue-600 font-medium">32-Week Course • Semester 1</p>
                    </div>
                </div>
            </div>

            <!-- Quiz Instructions -->
            <div class="bg-white rounded-xl shadow-lg p-6 mb-8">
                <h2 class="text-2xl font-bold text-gray-800 mb-4">Quiz Instructions</h2>
                <div class="bg-blue-50 p-4 rounded-lg">
                    <ul class="space-y-2 text-blue-800">
                        <li>• This quiz covers material from Week 2: Arduino IDE & First Programs</li>
                        <li>• Answer all questions to the best of your ability</li>
                        <li>• Your responses will be emailed to your instructor for review</li>
                        <li>• Take your time and think carefully about each answer</li>
                        <li>• You can review the lesson material if needed before submitting</li>
                    </ul>
                </div>
            </div>

            <!-- Quiz Form -->
            <form id="quizForm" autocomplete="off" class="space-y-8">
                <!-- Student Information -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-4">Student Information</h3>
                    <div class="grid md:grid-cols-2 gap-4">
                        <div>
                            <label for="quiz2StudentName" class="block text-sm font-medium text-gray-700 mb-2">Full Name</label>
                            <input type="text" id="quiz2StudentName" name="studentName" autocomplete="off" required 
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                        <div>
                            <label for="quiz2StudentEmail" class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
                            <input type="email" id="quiz2StudentEmail" name="studentEmail" autocomplete="off" required 
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                    </div>
                </div>

                <!-- Question 1 -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 1: Arduino IDE Components</h3>
                    <p class="text-gray-600 mb-4">Which component of the Arduino IDE is used to display compilation and upload status?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="A" class="mr-3">
                            <span>A) Code Editor</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="B" class="mr-3">
                            <span>B) Message Area</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="C" class="mr-3">
                            <span>C) Menu Bar</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="D" class="mr-3">
                            <span>D) Toolbar</span>
                        </label>
                    </div>
                </div>

                <!-- Question 2 -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 2: setup() Function</h3>
                    <p class="text-gray-600 mb-4">How many times does the setup() function run when an Arduino program starts?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="A" class="mr-3">
                            <span>A) Never</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="B" class="mr-3">
                            <span>B) Once</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="C" class="mr-3">
                            <span>C) Twice</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="D" class="mr-3">
                            <span>D) Continuously</span>
                        </label>
                    </div>
                </div>

                <!-- Question 3 -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 3: loop() Function</h3>
                    <p class="text-gray-600 mb-4">What happens in the loop() function?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="A" class="mr-3">
                            <span>A) It runs once and then stops</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="B" class="mr-3">
                            <span>B) It contains the main program logic and runs continuously</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="C" class="mr-3">
                            <span>C) It only runs when a button is pressed</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="D" class="mr-3">
                            <span>D) It initializes the Arduino board</span>
                        </label>
                    </div>
                </div>

                <!-- Question 4 -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 4: Serial Communication</h3>
                    <p class="text-gray-600 mb-4">Which function is used to start serial communication in Arduino?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="A" class="mr-3">
                            <span>A) Serial.print()</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="B" class="mr-3">
                            <span>B) Serial.begin()</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="C" class="mr-3">
                            <span>C) Serial.start()</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="D" class="mr-3">
                            <span>D) Serial.open()</span>
                        </label>
                    </div>
                </div>

                <!-- Question 5 -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 5: Program Structure</h3>
                    <p class="text-gray-600 mb-4">In what order should these elements appear in an Arduino program?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="A" class="mr-3">
                            <span>A) loop(), setup(), global variables</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="B" class="mr-3">
                            <span>B) setup(), global variables, loop()</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="C" class="mr-3">
                            <span>C) global variables, setup(), loop()</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="D" class="mr-3">
                            <span>D) The order doesn't matter</span>
                        </label>
                    </div>
                </div>

                <!-- Question 6 -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 6: Debugging</h3>
                    <p class="text-gray-600 mb-4">What is the primary purpose of the Serial Monitor in Arduino programming?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="A" class="mr-3">
                            <span>A) To upload code to the Arduino</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="B" class="mr-3">
                            <span>B) To debug programs and display output from the Arduino</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="C" class="mr-3">
                            <span>C) To select the correct Arduino board</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="D" class="mr-3">
                            <span>D) To save Arduino programs</span>
                        </label>
                    </div>
                </div>

                <!-- Question 7 - Short Answer -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 7: Code Analysis</h3>
                    <p class="text-gray-600 mb-4">Explain what this line of code does: <code>Serial.println("Hello, World!");</code></p>
                    <textarea name="q7" rows="3" 
                              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                              placeholder="Write your answer here..."></textarea>
                </div>

                <!-- Question 8 - Short Answer -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Question 8: Personal Program</h3>
                    <p class="text-gray-600 mb-4">Describe the Arduino program you created for the hands-on activity. What theme did you choose and what does your program do?</p>
                    <textarea name="q8" rows="4" 
                              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                              placeholder="Write your answer here..."></textarea>
                </div>

                <!-- Submit Button -->

            <!-- Submit Button -->
            <div class="text-center">
                <button type="submit" id="submitBtn" 
                        class="bg-green-500 hover:bg-green-600 text-white px-8 py-3 rounded-lg font-medium transition-colors duration-200"
                        style="background-color: #10b981; color: white; padding: 12px 32px; border-radius: 8px; font-weight: 500; border: none; cursor: pointer; transition: background-color 0.2s;">
                    Submit Quiz
                </button>
            </div>
        </form>

        <!-- Quiz Results Display -->
        <div id="quizResults" style="display: none;" class="max-w-4xl mx-auto px-4 py-8">
            <div class="bg-white rounded-lg shadow-lg p-8">
                <h2 class="text-2xl font-bold text-center mb-6 text-purple-800">📊 Your Quiz Results</h2>
                <div id="resultsContent"></div>
                <div class="text-center mt-6">
                    <p class="text-gray-600">These results have been automatically sent to your instructor.</p>
                </div>
            </div>
        </div>

        <div class="max-w-4xl mx-auto px-4 py-8">
            <!-- Navigation -->
            <div class="flex justify-between items-center mt-8">
                <div>
                    <a href="/programming/lessons32/week2" style="background-color: #6b7280; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #4b5563; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#4b5563'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#6b7280'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                        ← Back to Week 2 Lesson
                    </a>
                </div>
                <div>
                    <a href="/programming/lessons32/week3" style="background-color: #2563eb; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #1d4ed8; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#1d4ed8'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#2563eb'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                        Next: Week 3 Lesson →
                    </a>
                </div>
            </div>
        </div>
    </main>

    <!-- EmailJS Script -->
    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
    <script>
        // Initialize EmailJS
        (function(){
            emailjs.init('ct_s19oZHppLy9BlW');
        })();

        // Quiz data with correct answers
        const quizData = {
            correctAnswers: {
                q1: 'B', // Message Area displays compilation status
                q2: 'B', // setup() runs once
                q3: 'B', // loop() contains main logic and runs continuously
                q4: 'B', // Serial.begin() starts serial communication
                q5: 'C', // Correct order: global variables, setup(), loop()
                q6: 'B'  // Serial Monitor is for debugging and display
            },
            questionText: {
                q1: 'Arduino IDE Components',
                q2: 'setup() Function',
                q3: 'loop() Function',
                q4: 'Serial Communication',
                q5: 'Program Structure',
                q6: 'Debugging',
                q7: 'Code Analysis',
                q8: 'Personal Program'
            }
        };

        document.getElementById('quizForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting...';
            
            // Get form data
            const formData = new FormData(this);
            const studentName = document.getElementById('quiz2StudentName').value;
            const studentEmail = document.getElementById('quiz2StudentEmail').value;
            
            // Calculate score and build results
            let score = 0;
            let totalQuestions = 6; // Multiple choice questions only
            let results = [];
            
            // Check multiple choice answers
            for (let i = 1; i <= 6; i++) {
                const questionKey = `q${i}`;
                const studentAnswer = formData.get(questionKey);
                const correctAnswer = quizData.correctAnswers[questionKey];
                const isCorrect = studentAnswer === correctAnswer;
                
                if (isCorrect) score++;
                
                results.push({
                    question: quizData.questionText[questionKey],
                    studentAnswer: studentAnswer || 'No answer',
                    correctAnswer: correctAnswer,
                    isCorrect: isCorrect
                });
            }
            
            // Add short answer questions
            results.push({
                question: quizData.questionText.q7,
                studentAnswer: formData.get('q7') || 'No answer provided',
                isShortAnswer: true
            });
            
            results.push({
                question: quizData.questionText.q8,
                studentAnswer: formData.get('q8') || 'No answer provided',
                isShortAnswer: true
            });
            
            const percentage = Math.round((score / totalQuestions) * 100);
            
            // Build detailed message
            let message = `WEEK 2 QUIZ RESULTS - Arduino IDE & First Programs\n\n`;
            message += `Student: ${studentName}\n`;
            message += `Email: ${studentEmail}\n`;
            message += `Score: ${score}/${totalQuestions} (${percentage}%)\n\n`;
            
            message += `DETAILED RESULTS:\n`;
            message += `==================\n\n`;
            
            results.forEach((result, index) => {
                if (result.isShortAnswer) {
                    message += `${result.question}:\n`;
                    message += `Answer: ${result.studentAnswer}\n\n`;
                } else {
                    const status = result.isCorrect ? '✓ CORRECT' : '✗ INCORRECT';
                    message += `Q${index + 1}: ${result.question}\n`;
                    message += `Student Answer: ${result.studentAnswer}\n`;
                    message += `Correct Answer: ${result.correctAnswer}\n`;
                    message += `Status: ${status}\n\n`;
                }
            });
            
            // Performance analysis with emoji feedback
            message += `PERFORMANCE ANALYSIS:\n`;
            message += `=====================\n`;
            if (percentage >= 90) {
                message += `🌟 EXCELLENT! Outstanding mastery of Arduino IDE and program structure.\n`;
                message += `The student demonstrates strong technical skills and is ready for advanced programming concepts.\n`;
            } else if (percentage >= 80) {
                message += `🎯 VERY GOOD! Solid understanding of IDE navigation and program fundamentals.\n`;
                message += `The student shows good technical comprehension and coding readiness.\n`;
            } else if (percentage >= 70) {
                message += `👍 GOOD! Basic IDE and programming concepts understood, with some areas for practice.\n`;
                message += `Recommend additional hands-on coding practice and IDE exploration.\n`;
            } else if (percentage >= 60) {
                message += `📚 NEEDS IMPROVEMENT! Some understanding shown, but key concepts need reinforcement.\n`;
                message += `Suggest reviewing lesson materials and practicing with the Arduino IDE.\n`;
            } else {
                message += `🔄 REQUIRES ATTENTION! Limited understanding of IDE and programming fundamentals.\n`;
                message += `Recommend one-on-one instruction and additional practice with basic concepts.\n`;
            }
            
            message += `\nNext Steps: Practice with Arduino IDE and prepare for Week 3: Variables & Data Types\n`;
            message += `\nSubmitted: ${new Date().toLocaleString()}\n`;
            
            // Display results to student
            let grade = 'F';
            if (percentage >= 90) grade = 'A';
            else if (percentage >= 80) grade = 'B';
            else if (percentage >= 70) grade = 'C';
            else if (percentage >= 60) grade = 'D';
            
            const resultsHTML = `
                <div style="text-align: center; margin-bottom: 1rem;">
                    <div style="font-size: 2rem; font-weight: bold; color: #4a148c;">${score}/${totalQuestions} (${percentage}%)</div>
                    <div style="font-size: 1.5rem; font-weight: bold; color: #4a148c;">Grade: ${grade}</div>
                    <div style="margin-top: 1rem; padding: 1rem; background: #e8f5e8; border-radius: 6px; color: #2e7d32; font-weight: bold;">
                        💻 Week 2: Arduino IDE Mastery
                    </div>
                </div>
                <div style="text-align: left;">
                    ${results.map((r, index) => {
                        if (r.isShortAnswer) {
                            return `
                                <div style="margin-bottom: 1rem; padding: 1rem; background: #f0f9ff; border-radius: 6px;">
                                    <strong>${r.question}:</strong><br>
                                    <strong>Your answer:</strong> ${r.studentAnswer}
                                </div>
                            `;
                        } else {
                            return `
                                <div style="margin-bottom: 1rem; padding: 1rem; background: ${r.isCorrect ? '#e8f5e8' : '#ffeaea'}; border-radius: 6px;">
                                    <strong>Question ${index + 1}:</strong> ${r.isCorrect ? '✓' : '✗'}<br>
                                    <strong>Your answer:</strong> ${r.studentAnswer}<br>
                                    <strong>Correct answer:</strong> ${r.correctAnswer}
                                </div>
                            `;
                        }
                    }).join('')}
                </div>
            `;
            
            document.getElementById('resultsContent').innerHTML = resultsHTML;
            document.getElementById('quizResults').style.display = 'block';
            
            // Scroll to results
            document.getElementById('quizResults').scrollIntoView({ behavior: 'smooth' });
            
            // Send email using EmailJS
            // Initialize EmailJS right before sending
            emailjs.init('ct_s19oZHppLy9BlW');
            
            emailjs.send('service_ot1jg6s', 'template_io02xtm', {
                to_email: 'chuck@c00lnerd.com',
                from_name: 'C00lnerd Quiz System',
                from_email: 'chuck@c00lnerd.com',
                message: message,
                subject: `Week 2 Arduino Quiz - ${studentName} (${percentage}%)`
            }).then(function(response) {
                console.log('Quiz results sent successfully!', response.status, response.text);
                alert('Quiz results sent successfully!');
                
                // Log to Google Sheets
                console.log('Logging quiz results to Google Sheets...');
                fetch('https://script.google.com/macros/s/AKfycbyiA4c14AqtPjr6T8OUXQkGoJ4C3QQnK6WHCdCa2xBDKx1SZreL0Y-sk70YJoa0OzME8w/exec', {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        studentName: studentName,
                        studentEmail: studentEmail,
                        week: 'Week 2',
                        topic: 'Arduino IDE & Programming Basics',
                        score: score,
                        totalPoints: 8,
                        percentage: percentage,
                        grade: percentage >= 90 ? 'A' : percentage >= 80 ? 'B' : percentage >= 70 ? 'C' : percentage >= 60 ? 'D' : 'F',
                        timestamp: new Date().toISOString()
                    })
                })
                .then(() => console.log('Quiz results logged to Google Sheets successfully!'))
                .catch(error => console.log('Note: CORS error expected in localhost - Google Sheets logging will work in production:', error));
                
            }, function(error) {
                console.log('Failed to send quiz results...', error);
                alert('There was an issue sending your quiz results. Please contact your instructor.');
            });
        });
    </script>
</Layout>


