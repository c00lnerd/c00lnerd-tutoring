---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Lesson 11 Quiz: Smart Servo Control - C00lnerd Tutoring">
    <div style="max-width: 800px; margin: 0 auto; padding: 2rem;">
        
            <!-- Header -->
            <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 2rem; border-radius: 10px; margin-bottom: 2rem; text-align: center;">
                <h1 style="font-size: 2rem; font-weight: bold; margin: 0;">Lesson 11 Quiz: Smart Servo Control</h1>
                <p class="text-xl text-gray-600">Test your understanding of non-blocking timing, smooth servo motion, and serial commands</p>
                <div class="mt-4 p-4 bg-purple-100 rounded-lg">
                    <p class="text-purple-800 font-medium">⏱️ 10 questions covering millis() timing, coordinated motion, serial commands, and servo wiring</p>
                </div>
            </div>

            <!-- Student Information -->
            <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
                <h2 class="text-2xl font-bold text-purple-800 mb-6">Student Information</h2>
                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <label for="quiz11StudentName" class="block text-sm font-medium text-gray-700 mb-2">Full Name</label>
                        <input type="text" id="quiz11StudentName" name="studentName" required 
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500">
                    </div>
                    <div>
                        <label for="quiz11StudentEmail" class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
                        <input type="email" id="quiz11StudentEmail" name="studentEmail" required 
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500">
                    </div>
                </div>
            </div>

            <!-- Quiz Questions -->
            <form id="quizForm" autocomplete="off" class="space-y-8">
                <!-- Question 1 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 1: The Problem with delay()</h3>
                    <p class="text-gray-700 mb-4">Why does <code>delay()</code> cause problems in a two-servo robot program?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="A" class="mr-3">
                            <span>A) It uses too much program memory</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="B" class="mr-3">
                            <span>B) It freezes the entire chip, so buttons, serial input, and the other servo all have to wait</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="C" class="mr-3">
                            <span>C) It makes the servo signal too fast</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="D" class="mr-3">
                            <span>D) It can only be used once per program</span>
                        </label>
                    </div>
                </div>

                <!-- Question 2 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 2: Servo Wiring</h3>
                    <p class="text-gray-700 mb-4">A typical SG90 servo has three wires. Which is the correct set?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="A" class="mr-3">
                            <span>A) TX, RX, GND</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="B" class="mr-3">
                            <span>B) Signal, 5V (power), GND</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="C" class="mr-3">
                            <span>C) SDA, SCL, 5V</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="D" class="mr-3">
                            <span>D) IN1, IN2, ENA</span>
                        </label>
                    </div>
                </div>

                <!-- Question 3 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 3: The millis() Clock</h3>
                    <p class="text-gray-700 mb-4">What does <code>millis()</code> return?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="A" class="mr-3">
                            <span>A) The current value on the pin you pass it</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="B" class="mr-3">
                            <span>B) The number of seconds since the board was powered on</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="C" class="mr-3">
                            <span>C) The number of milliseconds since the program started</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="D" class="mr-3">
                            <span>D) The amount of free RAM on the chip</span>
                        </label>
                    </div>
                </div>

                <!-- Question 4 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 4: INPUT_PULLUP</h3>
                    <p class="text-gray-700 mb-4">When using <code>INPUT_PULLUP</code> for the button on A2, where should the button connect?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="A" class="mr-3">
                            <span>A) Button to 5V (HIGH)</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="B" class="mr-3">
                            <span>B) Button to GND (LOW when pressed)</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="C" class="mr-3">
                            <span>C) Button between two analog pins</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="D" class="mr-3">
                            <span>D) Button to the servo signal wire</span>
                        </label>
                    </div>
                </div>

                <!-- Question 5 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 5: Power Planning</h3>
                    <p class="text-gray-700 mb-4">What is the best explanation for why an Arduino might reset when a servo moves?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="A" class="mr-3">
                            <span>A) The servo signal pin is too high frequency</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="B" class="mr-3">
                            <span>B) The servo draws bursts of current and the Arduino 5V voltage dips</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="C" class="mr-3">
                            <span>C) Servos require 12V instead of 5V</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="D" class="mr-3">
                            <span>D) The potentiometer on A0 interferes with USB power</span>
                        </label>
                    </div>
                </div>

                <!-- Question 6 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 6: Shared Ground</h3>
                    <p class="text-gray-700 mb-4">If you power servos from an external 5V supply, what must you also connect?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="A" class="mr-3">
                            <span>A) External 5V to Arduino VIN</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="B" class="mr-3">
                            <span>B) External supply GND to Arduino GND (shared ground)</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="C" class="mr-3">
                            <span>C) External supply to the USB data pins</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="D" class="mr-3">
                            <span>D) Nothing else — grounds don’t matter</span>
                        </label>
                    </div>
                </div>

                <!-- Question 7 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 7: Smooth Motion</h3>
                    <p class="text-gray-700 mb-4">In our smooth-motion code, how does each servo reach its target angle?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q7" value="A" class="mr-3">
                            <span>A) It jumps straight to the target in one write</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q7" value="B" class="mr-3">
                            <span>B) The Servo library eases it automatically</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q7" value="C" class="mr-3">
                            <span>C) The target is written directly to the servo every loop</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q7" value="D" class="mr-3">
                            <span>D) It steps one degree closer on every timed interval</span>
                        </label>
                    </div>
                </div>

                <!-- Question 8 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 8: Serial Commands</h3>
                    <p class="text-gray-700 mb-4">In our serial command language, what does typing <code>E45</code> into the Serial Monitor do?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q8" value="A" class="mr-3">
                            <span>A) Sets the elbow servo target to 45°</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q8" value="B" class="mr-3">
                            <span>B) Moves the servo on pin 4 to 5°</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q8" value="C" class="mr-3">
                            <span>C) Prints an error 45 times</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q8" value="D" class="mr-3">
                            <span>D) Sets the servo speed to 45 degrees per second</span>
                        </label>
                    </div>
                </div>

                <!-- Question 9: Short Answer -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 9: Targets vs. Movement</h3>
                    <p class="text-gray-700 mb-4">In our program, serial commands and buttons only change the <em>target</em> angles — a separate timed section actually writes to the servos. Why is splitting "decide the target" from "move the servo" a good design?</p>
                    <textarea name="q9" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500" 
                              placeholder="Write your answer here..."></textarea>
                </div>

                <!-- Question 10: Short Answer -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 10: Adding a Pose</h3>
                    <p class="text-gray-700 mb-4">Describe how you would add a new preset pose called "WAVE" (base 130°, elbow 70°) to the poses array, and what command a user would type to run it.</p>
                    <textarea name="q10" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500" 
                              placeholder="Write your answer here..."></textarea>
                </div>

                <!-- Submit Button -->
                <div class="text-center">
                    <button type="submit" id="submitBtn" 
                            style="background-color: #7c3aed; color: white; padding: 12px 32px; border-radius: 8px; font-weight: 500; border: none; cursor: pointer; transition: background-color 0.2s;">
                        Submit Quiz
                    </button>
                </div>
            </form>
        </div>

        <!-- Quiz Results Display -->
        <div id="quizResults" style="display: none;" class="max-w-4xl mx-auto px-4 py-8">
            <div class="bg-white rounded-lg shadow-lg p-8">
                <h2 class="text-2xl font-bold text-center mb-6 text-purple-800">?? Your Quiz Results</h2>
                <div id="resultsContent"></div>
                <div class="text-center mt-6">
                    <p class="text-gray-600">These results have been automatically sent to your instructor.</p>
                </div>
            </div>
        </div>

        <div class="max-w-4xl mx-auto px-4 py-8">
            <!-- Navigation -->
            <div class="flex justify-between items-center mt-8">
                <div>
                    <a href="/programming/lessons32/lesson11" style="background-color: #6b7280; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #4b5563; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#4b5563'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#6b7280'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                        ← Back to Lesson 11
                    </a>
                </div>
                <div>
                    <a href="/programming/lessons32/lesson12" style="background-color: #2563eb; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #1d4ed8; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#1d4ed8'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#2563eb'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                        Next: Lesson 12 →
                    </a>
                </div>
            </div>
        </div>
    </main>

    <!-- EmailJS Script -->
    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js" is:inline></script>
    <script is:inline>
window.onload = function() { generateCaptcha(); };

    // CAPTCHA variables
    let captchaAnswer = 0;

    function generateCaptcha() {
        const num1 = Math.floor(Math.random() * 10) + 1;
        const num2 = Math.floor(Math.random() * 10) + 1;
        captchaAnswer = num1 + num2;
        const questionElement = document.getElementById('captcha-question');
        if (questionElement) {
            questionElement.textContent = num1 + " + " + num2;
        }
    }

    function validateCaptcha() {
        const userAnswer = parseInt(document.getElementById('captcha').value);
        const errorDiv = document.getElementById('captcha-error');
        
        if (userAnswer !== captchaAnswer) {
            if (errorDiv) errorDiv.style.display = 'block';
            generateCaptcha(); // Generate new question
            document.getElementById('captcha').value = '';
            return false;
        }
        
        if (errorDiv) errorDiv.style.display = 'none';
        return true;
    }
    
    // Security validation function
    function validateSecurity() {
        // Check honeypot field (should be empty)
        const honeypot = document.getElementById('website');
        if (honeypot && honeypot.value) {
            console.log('Spam bot detected via honeypot');
            alert('Security check failed. Please try again.');
            return false;
        }
        
        // Rate limiting check
        const lastSubmission = localStorage.getItem('lastQuizStart');
        const now = Date.now();
        if (lastSubmission && (now - parseInt(lastSubmission)) < 30000) { // 30 second cooldown
            alert('Please wait 30 seconds between quiz attempts.');
            return false;
        }
        localStorage.setItem('lastQuizStart', now.toString());
        
        // Validate CAPTCHA
        if (!validateCaptcha()) {
            return false;
        }
        
        // Email validation and domain filtering
        const emailInput = document.getElementById('email');
        if (emailInput && emailInput.value) {
            const email = emailInput.value;
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                alert('Please enter a valid email address.');
                return false;
            }
            
            // Block common spam domains
            const spamDomains = ['tempmail.org', '10minutemail.com', 'guerrillamail.com', 'mailinator.com', 'throwaway.email'];
            const domain = email.split('@')[1].toLowerCase();
            if (spamDomains.includes(domain)) {
                alert('Please use a permanent email address.');
                return false;
            }
        }
        
        return true;
    }
        // Quiz data with correct answers
        const quizData = {
            correctAnswers: {
                q1: 'B', // delay() freezes the whole chip
                q2: 'B', // Signal, 5V, GND
                q3: 'C', // Milliseconds since program started
                q4: 'B', // Button to GND
                q5: 'B', // Current bursts / voltage dip
                q6: 'B', // Shared ground
                q7: 'D', // Steps one degree per timed interval
                q8: 'A'  // Sets elbow target to 45°
            },
            questionText: {
                q1: "Why does delay() cause problems in a two-servo robot program?",
                q2: "A typical SG90 servo has three wires. Which is the correct set?",
                q3: "What does millis() return?",
                q4: "When using INPUT_PULLUP for the button on A2, where should the button connect?",
                q5: "What is the best explanation for why an Arduino might reset when a servo moves?",
                q6: "If you power servos from an external 5V supply, what must you also connect?",
                q7: "In our smooth-motion code, how does each servo reach its target angle?",
                q8: "In our serial command language, what does typing E45 into the Serial Monitor do?",
                q9: "In our program, serial commands and buttons only change the target angles — a separate timed section actually writes to the servos. Why is splitting 'decide the target' from 'move the servo' a good design?",
                q10: "Describe how you would add a new preset pose called 'WAVE' (base 130°, elbow 70°) to the poses array, and what command a user would type to run it."
            }
        };

        document.getElementById('quizForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const studentName = document.getElementById('quiz11StudentName').value;
            const studentEmail = document.getElementById('quiz11StudentEmail').value;
            
            if (!studentName || !studentEmail) {
                alert('Please fill in your name and email address.');
                return;
            }

            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting...';
            
            const formData = new FormData(this);
            const results = [];
            let score = 0;
            const totalQuestions = 8; // Multiple choice questions only for scoring
            
            // Check multiple choice answers (q1-q8)
            for (let i = 1; i <= 8; i++) {
                const questionKey = `q${i}`;
                const userAnswer = formData.get(questionKey);
                const correctAnswer = quizData.correctAnswers[questionKey];
                const isCorrect = userAnswer === correctAnswer;
                
                if (isCorrect) score++;
                
                results.push({
                    question: quizData.questionText[questionKey],
                    userAnswer: userAnswer || 'No answer provided',
                    correctAnswer: correctAnswer,
                    isCorrect: isCorrect
                });
            }
            
            // Add short answer questions
            results.push({
                question: quizData.questionText.q9,
                studentAnswer: formData.get('q9') || 'No answer provided',
                isShortAnswer: true
            });
            
            results.push({
                question: quizData.questionText.q10,
                studentAnswer: formData.get('q10') || 'No answer provided',
                isShortAnswer: true
            });
            
            const percentage = Math.round((score / totalQuestions) * 100);
            
            // Build detailed message
            let message = `LESSON 11 QUIZ RESULTS - Smart Servo Control\n\n`;
            message += `Student: ${studentName}\n`;
            message += `Email: ${studentEmail}\n`;
            message += `Score: ${score}/${totalQuestions} (${percentage}%)\n\n`;
            
            message += `DETAILED RESULTS:\n`;
            message += `==================\n\n`;
            
            results.forEach((result, index) => {
                if (result.isShortAnswer) {
                    message += `${result.question}:\n`;
                    message += `Answer: ${result.studentAnswer}\n\n`;
                } else {
                    const status = result.isCorrect ? '? CORRECT' : '? INCORRECT';
                    message += `Q${index + 1}: ${result.question}\n`;
                    message += `Student Answer: ${result.userAnswer}\n`;
                    message += `Correct Answer: ${result.correctAnswer}\n`;
                    message += `Status: ${status}\n\n`;
                }
            });
            
            message += `PERFORMANCE ANALYSIS:\n`;
            message += `====================\n`;
            if (percentage >= 90) {
                message += `?? EXCELLENT! Outstanding understanding of non-blocking timing and servo control.\n`;
                message += `Student demonstrates mastery of millis() patterns, smooth motion, and serial commands.\n`;
            } else if (percentage >= 80) {
                message += `?? VERY GOOD! Strong grasp of smart servo control fundamentals.\n`;
                message += `Student shows solid understanding with minor areas for review.\n`;
            } else if (percentage >= 70) {
                message += `?? GOOD! Basic understanding of timing and servo control with room for improvement.\n`;
                message += `Recommend additional practice with the millis() pattern and serial parsing.\n`;
            } else if (percentage >= 60) {
                message += `?? NEEDS IMPROVEMENT. Some understanding but requires more practice.\n`;
                message += `Focus on non-blocking timing, target vs. movement separation, and wiring basics.\n`;
            } else {
                message += `?? REQUIRES ATTENTION! Limited understanding of servo control concepts.\n`;
                message += `Recommend reviewing lesson materials and re-running the smart servo controller sketch.\n`;
            }
            
            message += `\nNext Steps: Lesson 12 begins the miniAuto car. Keep the smart servo sketch — it becomes the robot arm's control software when the printed parts arrive.\n`;
            message += `\nSubmitted: ${new Date().toLocaleString()}\n`;
            
            // Display results to student
            let grade = 'F';
            if (percentage >= 90) grade = 'A';
            else if (percentage >= 80) grade = 'B';
            else if (percentage >= 70) grade = 'C';
            else if (percentage >= 60) grade = 'D';
            
            const resultsHTML = `
                <div style="text-align: center; margin-bottom: 1rem;">
                    <div style="font-size: 2rem; font-weight: bold; color: #7c3aed;">${score}/${totalQuestions} (${percentage}%)</div>
                    <div style="font-size: 1.5rem; font-weight: bold; color: #7c3aed;">Grade: ${grade}</div>
                    <div style="margin-top: 1rem; padding: 1rem; background: #ede9fe; border-radius: 6px; color: #7c3aed; font-weight: bold;">
                        ?? Week 11: Smart Servo Control
                    </div>
                </div>
                <div style="text-align: left;">
                    ${results.map((r, index) => {
                        if (r.isShortAnswer) {
                            return `
                                <div style="margin-bottom: 1rem; padding: 1rem; background: #f0f9ff; border-radius: 6px;">
                                    <strong>${r.question}:</strong><br>
                                    <strong>Your answer:</strong> ${r.studentAnswer}
                                </div>
                            `;
                        } else {
                            return `
                                <div style="margin-bottom: 1rem; padding: 1rem; background: ${r.isCorrect ? '#e8f5e8' : '#ffeaea'}; border-radius: 6px;">
                                    <strong>Question ${index + 1}:</strong> ${r.isCorrect ? '?' : '?'}<br>
                                    <strong>Your answer:</strong> ${r.userAnswer}<br>
                                    <strong>Correct answer:</strong> ${r.correctAnswer}
                                </div>
                            `;
                        }
                    }).join('')}
                </div>
            `;
            
            document.getElementById('resultsContent').innerHTML = resultsHTML;
            document.getElementById('quizResults').style.display = 'block';
            
            // Scroll to results
            document.getElementById('quizResults').scrollIntoView({ behavior: 'smooth' });
            
            // Send email using EmailJS
            // Check if EmailJS is available
            if (typeof (window as any).emailjs === 'undefined') {
                console.log('Email service unavailable; relying on Google Sheets logging.');
                return;
            }
            
            // Initialize EmailJS right before sending
            (window as any).emailjs.init('ct_s19oZHppLy9BlW');
            
