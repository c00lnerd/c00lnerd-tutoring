---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Lesson 15 Quiz: The Gripper - C00lnerd Tutoring">
    <div style="max-width: 800px; margin: 0 auto; padding: 2rem;">
        
            <!-- Header -->
            <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 2rem; border-radius: 10px; margin-bottom: 2rem; text-align: center;">
                <h1 style="font-size: 2rem; font-weight: bold; margin: 0;">Lesson 15 Quiz: The Gripper</h1>
                <p class="text-xl text-gray-600">Test your understanding of the fourth servo, the 3-mode state machine, and per-joint limits</p>
                <div class="mt-4 p-4 bg-purple-100 rounded-lg">
                    <p class="text-purple-800 font-medium">🤏 10 questions covering the gripper, mode cycling, and pick-and-place thinking</p>
                </div>
            </div>

            <!-- Student Information -->
            <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
                <h2 class="text-2xl font-bold text-purple-800 mb-6">Student Information</h2>
                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <label for="quiz15StudentName" class="block text-sm font-medium text-gray-700 mb-2">Full Name</label>
                        <input type="text" id="quiz15StudentName" name="studentName" required 
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500">
                    </div>
                    <div>
                        <label for="quiz15StudentEmail" class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
                        <input type="email" id="quiz15StudentEmail" name="studentEmail" required 
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500">
                    </div>
                </div>
            </div>

            <!-- Quiz Questions -->
            <form id="quizForm" autocomplete="off" class="space-y-8">
                <!-- Question 1 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 1: One Servo, Two Fingers</h3>
                    <p class="text-gray-700 mb-4">Our two-finger gripper needs only one servo channel. Why?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="A" class="mr-3">
                            <span>A) One finger is passive and never moves</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="B" class="mr-3">
                            <span>B) A gear/linkage couples both fingers to the same horn — the hardware collapses them into one degree of freedom</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="C" class="mr-3">
                            <span>C) SG90s can output two independent signals</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q1" value="D" class="mr-3">
                            <span>D) The second finger is software-mirrored</span>
                        </label>
                    </div>
                </div>

                <!-- Question 2 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 2: The Mode Machine Grows</h3>
                    <p class="text-gray-700 mb-4">Why did <code>bool elbowMode</code> have to become <code>int armMode</code>?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="A" class="mr-3">
                            <span>A) Ints are faster on the Uno</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="B" class="mr-3">
                            <span>B) A boolean only holds two states; three control pairs need a variable that can count 0, 1, 2</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="C" class="mr-3">
                            <span>C) The Servo library requires int state variables</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q2" value="D" class="mr-3">
                            <span>D) The OLED can't print booleans</span>
                        </label>
                    </div>
                </div>

                <!-- Question 3 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 3: The Wraparound</h3>
                    <p class="text-gray-700 mb-4">What does <code>armMode = (armMode + 1) % NUM_MODES;</code> do when armMode is already 2?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="A" class="mr-3">
                            <span>A) Sets armMode to 3, which the if-chain ignores</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="B" class="mr-3">
                            <span>B) Triggers a compile error</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="C" class="mr-3">
                            <span>C) Wraps back to 0 — the modulo (remainder) of 3 divided by 3 is 0</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q3" value="D" class="mr-3">
                            <span>D) Stays at 2 until the stick is centered</span>
                        </label>
                    </div>
                </div>

                <!-- Question 4 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 4: Per-Joint Limits</h3>
                    <p class="text-gray-700 mb-4">Why does the gripper get <code>GRIP_OPEN</code>/<code>GRIP_CLOSED</code> instead of sharing the arm's 20–160° range?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="A" class="mr-3">
                            <span>A) The Servo library requires different constants per servo</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="B" class="mr-3">
                            <span>B) It's just a style preference</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="C" class="mr-3">
                            <span>C) Grippers can only reach 90°</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q4" value="D" class="mr-3">
                            <span>D) The gripper's linkage has its own mechanical travel — driving it past its stops stalls the servo against the mechanism</span>
                        </label>
                    </div>
                </div>

                <!-- Question 5 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 5: Homing That Actually Homes</h3>
                    <p class="text-gray-700 mb-4">In Lesson 14, homing just set the angle variables — the servo moved on its next armed write. What changed in Lesson 15's <code>homeAll()</code>?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="A" class="mr-3">
                            <span>A) It calls delay() so the servos have time</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="B" class="mr-3">
                            <span>B) It writes all four servos immediately — otherwise a disarmed joint would hold its old angle after "home"</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="C" class="mr-3">
                            <span>C) It detaches and reattaches the servos</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q5" value="D" class="mr-3">
                            <span>D) It recalibrates the joystick first</span>
                        </label>
                    </div>
                </div>

                <!-- Question 6 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 6: Power at Four Servos</h3>
                    <p class="text-gray-700 mb-4">The supply spec from Lesson 14 was chosen with this lesson in mind. What's the real concern now?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="A" class="mr-3">
                            <span>A) Four servos need four separate supplies</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="B" class="mr-3">
                            <span>B) The gripper needs 12V while the arm uses 5V</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="C" class="mr-3">
                            <span>C) Nothing changes — USB still works</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q6" value="D" class="mr-3">
                            <span>D) Several SG90s can spike past 2.5A together — especially a gripper stalled on an object — so we need the regulated 5V / 3A+ supply and shared ground</span>
                        </label>
                    </div>
                </div>

                <!-- Question 7 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 7: The Name Table</h3>
                    <p class="text-gray-700 mb-4">What does <code>modeName[armMode]</code> buy us over an if/else chain?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q7" value="A" class="mr-3">
                            <span>A) Nothing — it's just shorter to type</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q7" value="B" class="mr-3">
                            <span>B) A ternary can't hold three options, and an if/else chain becomes a bug farm as modes grow — the array lookup scales cleanly</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q7" value="C" class="mr-3">
                            <span>C) Arrays use less RAM than if statements</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q7" value="D" class="mr-3">
                            <span>D) The OLED library requires it</span>
                        </label>
                    </div>
                </div>

                <!-- Question 8 -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 8: Mode Awareness</h3>
                    <p class="text-gray-700 mb-4">You push the stick and the gripper opens when you meant to lift the shoulder. What's the fix AND the prevention?</p>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="q8" value="A" class="mr-3">
                            <span>A) Rewire the servos; the wires are swapped</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q8" value="B" class="mr-3">
                            <span>B) Press A2 to cycle back to BASE+SHLDR — and get in the habit of reading the mode on line 1 of the OLED BEFORE pushing the stick</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q8" value="C" class="mr-3">
                            <span>C) Re-upload the sketch; a variable got corrupted</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="q8" value="D" class="mr-3">
                            <span>D) Flip the joystick over; it's upside-down</span>
                        </label>
                    </div>
                </div>

                <!-- Question 9: Short Answer -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 9: Pick-and-Place Sequence</h3>
                    <p class="text-gray-700 mb-4">Describe the complete sequence of stick moves and A2 mode presses to: drive over an object, open the gripper, lower the arm, close on the object, lift, rotate to a new spot, and set it down. Where can things go wrong?</p>
                    <textarea name="q9" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500" 
                              placeholder="Write your answer here..."></textarea>
                </div>

                <!-- Question 10: Short Answer -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Question 10: Gripper on Click vs Stick</h3>
                    <p class="text-gray-700 mb-4">The lesson's challenge suggests making SW click toggle open/closed instead of putting the gripper on the Y-axis. Trade off the two schemes: which gives finer control, which is faster mid-task, and what happens to homing in each design?</p>
                    <textarea name="q10" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500" 
                              placeholder="Write your answer here..."></textarea>
                </div>

                <!-- Submit Button -->
                <div class="text-center">
                    <button type="submit" id="submitBtn" 
                            style="background-color: #7c3aed; color: white; padding: 12px 32px; border-radius: 8px; font-weight: 500; border: none; cursor: pointer; transition: background-color 0.2s;">
                        Submit Quiz
                    </button>
                </div>
            </form>
        </div>

        <!-- Quiz Results Display -->
        <div id="quizResults" style="display: none;" class="max-w-4xl mx-auto px-4 py-8">
            <div class="bg-white rounded-lg shadow-lg p-8">
                <h2 class="text-2xl font-bold text-center mb-6 text-purple-800">🎯 Your Quiz Results</h2>
                <div id="resultsContent"></div>
                <div class="text-center mt-6">
                    <p class="text-gray-600">These results have been automatically sent to your instructor.</p>
                </div>
            </div>
        </div>

        <div class="max-w-4xl mx-auto px-4 py-8">
            <!-- Navigation -->
            <div class="flex justify-between items-center mt-8">
                <div>
                    <a href="/programming/lessons32/lesson15" style="background-color: #6b7280; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #4b5563; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#4b5563'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#6b7280'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                        ← Back to Lesson 15
                    </a>
                </div>
                <div>
                    <a href="/programming/lessons32/lesson16" style="background-color: #2563eb; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #1d4ed8; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#1d4ed8'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#2563eb'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                        Next: Lesson 16 →
                    </a>
                </div>
            </div>
        </div>
    </main>

    <!-- EmailJS Script -->
    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js" is:inline></script>
    <script is:inline>
        // Quiz data with correct answers
        const quizData = {
            correctAnswers: {
                q1: 'B', // Linkage = one degree of freedom
                q2: 'B', // bool holds only 2 states
                q3: 'C', // modulo wraps 2+1 -> 0
                q4: 'D', // gripper has its own mechanical travel
                q5: 'B', // write all four immediately
                q6: 'D', // stalled gripper spikes current
                q7: 'B', // array scales, if-chain doesn't
                q8: 'B'  // cycle mode + read OLED first
            },
            questionText: {
                q1: "Our two-finger gripper needs only one servo channel. Why?",
                q2: "Why did bool elbowMode have to become int armMode?",
                q3: "What does armMode = (armMode + 1) % NUM_MODES; do when armMode is already 2?",
                q4: "Why does the gripper get GRIP_OPEN/GRIP_CLOSED instead of sharing the arm's 20-160 range?",
                q5: "In Lesson 14 homing just set variables. What changed in Lesson 15's homeAll()?",
                q6: "The supply spec from Lesson 14 was chosen with this lesson in mind. What's the real concern now?",
                q7: "What does modeName[armMode] buy us over an if/else chain?",
                q8: "You push the stick and the gripper opens when you meant to lift the shoulder. What's the fix AND the prevention?",
                q9: "Describe the complete sequence of stick moves and A2 mode presses to pick up and set down an object. Where can things go wrong?",
                q10: "Trade off gripper-on-click vs gripper-on-Y-axis: finer control, speed mid-task, and what happens to homing in each design?"
            }
        };

        document.getElementById('quizForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const studentName = document.getElementById('quiz15StudentName').value;
            const studentEmail = document.getElementById('quiz15StudentEmail').value;
            
            if (!studentName || !studentEmail) {
                alert('Please fill in your name and email address.');
                return;
            }

            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting...';
            
            const formData = new FormData(this);
            const results = [];
            let score = 0;
            const totalQuestions = 8; // Multiple choice questions only for scoring
            
            // Check multiple choice answers (q1-q8)
            for (let i = 1; i <= 8; i++) {
                const questionKey = `q${i}`;
                const userAnswer = formData.get(questionKey);
                const correctAnswer = quizData.correctAnswers[questionKey];
                const isCorrect = userAnswer === correctAnswer;
                
                if (isCorrect) score++;
                
                results.push({
                    question: quizData.questionText[questionKey],
                    userAnswer: userAnswer || 'No answer provided',
                    correctAnswer: correctAnswer,
                    isCorrect: isCorrect
                });
            }
            
            // Add short answer questions
            results.push({
                question: quizData.questionText.q9,
                studentAnswer: formData.get('q9') || 'No answer provided',
                isShortAnswer: true
            });
            
            results.push({
                question: quizData.questionText.q10,
                studentAnswer: formData.get('q10') || 'No answer provided',
                isShortAnswer: true
            });
            
            const percentage = Math.round((score / totalQuestions) * 100);
            
            // Build detailed message
            let message = `LESSON 15 QUIZ RESULTS - The Gripper\n\n`;
            message += `Student: ${studentName}\n`;
            message += `Email: ${studentEmail}\n`;
            message += `Score: ${score}/${totalQuestions} (${percentage}%)\n\n`;
            
            message += `DETAILED RESULTS:\n`;
            message += `==================\n\n`;
            
            results.forEach((result, index) => {
                if (result.isShortAnswer) {
                    message += `${result.question}:\n`;
                    message += `Answer: ${result.studentAnswer}\n\n`;
                } else {
                    const status = result.isCorrect ? 'CORRECT' : 'INCORRECT';
                    message += `Q${index + 1}: ${result.question}\n`;
                    message += `Student Answer: ${result.userAnswer}\n`;
                    message += `Correct Answer: ${result.correctAnswer}\n`;
                    message += `Status: ${status}\n\n`;
                }
            });
            
            message += `PERFORMANCE ANALYSIS:\n`;
            message += `====================\n`;
            if (percentage >= 90) {
                message += `EXCELLENT! Outstanding understanding of state machines and end-effector control.\n`;
                message += `Student demonstrates mastery of mode cycling, per-joint limits, and servo power.\n`;
            } else if (percentage >= 80) {
                message += `VERY GOOD! Strong grasp of the gripper integration.\n`;
                message += `Student shows solid understanding with minor areas for review.\n`;
            } else if (percentage >= 70) {
                message += `GOOD! Basic understanding of the 3-mode machine with room for improvement.\n`;
                message += `Recommend additional practice with modulo cycling and joint limits.\n`;
            } else if (percentage >= 60) {
                message += `NEEDS IMPROVEMENT. Some understanding but requires more practice.\n`;
                message += `Focus on why mode exists (4 joints, 2 axes) and why the gripper has its own range.\n`;
            } else {
                message += `REQUIRES ATTENTION! Limited understanding of multi-mode control.\n`;
                message += `Recommend reviewing lesson materials and practicing the mode cycle.\n`;
            }
            
            message += `\nNext Steps: The arm is complete — four joints, fully piloted. Lesson 16 builds on this machine.\n`;
            message += `\nSubmitted: ${new Date().toLocaleString()}\n`;
            
            // Display results to student
            let grade = 'F';
            if (percentage >= 90) grade = 'A';
            else if (percentage >= 80) grade = 'B';
            else if (percentage >= 70) grade = 'C';
            else if (percentage >= 60) grade = 'D';
            
            const resultsHTML = `
                <div style="text-align: center; margin-bottom: 1rem;">
                    <div style="font-size: 2rem; font-weight: bold; color: #7c3aed;">${score}/${totalQuestions} (${percentage}%)</div>
                    <div style="font-size: 1.5rem; font-weight: bold; color: #7c3aed;">Grade: ${grade}</div>
                    <div style="margin-top: 1rem; padding: 1rem; background: #ede9fe; border-radius: 6px; color: #7c3aed; font-weight: bold;">
                        🤏 Week 15: The Gripper
                    </div>
                </div>
                <div style="text-align: left;">
                    ${results.map((r, index) => {
                        if (r.isShortAnswer) {
                            return `
                                <div style="margin-bottom: 1rem; padding: 1rem; background: #f0f9ff; border-radius: 6px;">
                                    <strong>${r.question}:</strong><br>
                                    <strong>Your answer:</strong> ${r.studentAnswer}
                                </div>
                            `;
                        } else {
                            return `
                                <div style="margin-bottom: 1rem; padding: 1rem; background: ${r.isCorrect ? '#e8f5e8' : '#ffeaea'}; border-radius: 6px;">
                                    <strong>Question ${index + 1}:</strong> ${r.isCorrect ? '✅' : '❌'}<br>
                                    <strong>Your answer:</strong> ${r.userAnswer}<br>
                                    <strong>Correct answer:</strong> ${r.correctAnswer}
                                </div>
                            `;
                        }
                    }).join('')}
                </div>
            `;
            
            document.getElementById('resultsContent').innerHTML = resultsHTML;
            document.getElementById('quizResults').style.display = 'block';
            
            // Scroll to results
            document.getElementById('quizResults').scrollIntoView({ behavior: 'smooth' });
            
            // Send email using EmailJS
            // Check if EmailJS is available
            if (typeof (window as any).emailjs === 'undefined') {
                console.log('Email service unavailable; relying on Google Sheets logging.');
                return;
            }
            
            // Initialize EmailJS right before sending
            (window as any).emailjs.init('ct_s19oZHppLy9BlW');
            
            const sheetsPayload = JSON.stringify({
                studentName: studentName,
                studentEmail: studentEmail,
                week: 'Week 15',
                topic: 'The Gripper (Servo #4 + 3-Mode State Machine)',
                score: score,
                totalPoints: totalQuestions,
                percentage: percentage,
                grade: percentage >= 90 ? 'A' : percentage >= 80 ? 'B' : percentage >= 70 ? 'C' : percentage >= 60 ? 'D' : 'F',
                timestamp: new Date().toISOString()
            });

            const logToSheets = function() {
                console.log('Logging quiz results to Google Sheets...');
                return fetch('https://script.google.com/macros/s/AKfycbxJORcOZtpcCKh-ZRK6mAFsv-TXvroqJUjB22unDmTiRySX3Mylt8rX-FeMCgd_T47qPA/exec', {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: sheetsPayload
                })
                .then(() => console.log('Quiz results logged to Google Sheets successfully!'))
                .catch(error => console.log('Note: CORS error expected in localhost - Google Sheets logging will work in production:', error));
            };

            (window as any).emailjs.send('service_kaw1xkh', 'template_io02xtm', {
                to_email: 'chuck@c00lnerd.com',
                from_name: 'C00lnerd Quiz System',
                from_email: 'chuck@c00lnerd.com',
                
                message: message,
                subject: `Lesson 15 Gripper Quiz - ${studentName} (${percentage}%)`
            }).then(function(response) {
                console.log('Quiz results sent successfully!', response.status, response.text);
                alert('Quiz results sent successfully!');
                logToSheets();
            }, function(error) {
                console.log('Failed to send quiz results...', error);
                logToSheets();
                alert('Quiz submitted successfully! Email is temporarily unavailable, but your results were saved to the grade log.');
            });
        });
    </script>
</Layout>
