                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-4">
                        <a href="/programming.html" class="text-purple-600 hover:text-purple-800 font-medium">
                            ← Back to Programming
                        </a>
                        <div class="text-gray-300">|</div>
                        <h1 class="text-2xl font-bold text-gray-900">Python Course</h1>
                    </div>
                    <div class="text-sm text-gray-500">
                        Lesson 3 of 8
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="max-w-4xl mx-auto px-4 py-8">
            <div class="bg-white rounded-xl shadow-lg p-8">
                <!-- Lesson Header -->
                <div class="mb-8">
                    <div class="flex items-center mb-4">
                        <div class="bg-purple-100 p-3 rounded-lg mr-4">
                            <i class="fas fa-comments text-purple-600 text-2xl"></i>
                        </div>
                        <div>
                            <h1 class="text-3xl font-bold text-gray-900">Input and Output</h1>
                            <p class="text-gray-600 mt-2">Learn how to get information from users and display results</p>
                        </div>
                    </div>
                </div>

                <!-- Learning Objectives -->
