        <pre><code class="language-python">import numpy as np
import matplotlib.pyplot as plt
from matplotlib.widgets import Slider, Button
import tkinter as tk
from tkinter import ttk
import threading

class InteractiveFractalGenerator:
    def __init__(self):
        self.setup_gui()
        self.mandelbrot_params = {
            'zoom': 1.0,
            'center_x': -0.5,
            'center_y': 0.0,
            'max_iter': 100,
            'colormap': 'hot'
        }
        
    def setup_gui(self):
        """Create the interactive GUI"""
        self.root = tk.Tk()
        self.root.title("Interactive Fractal Art Generator")
        self.root.geometry("400x600")
        
        # Create control panel
        control_frame = ttk.Frame(self.root, padding="10")
        control_frame.pack(fill=tk.BOTH, expand=True)
        
        # Title
        title_label = ttk.Label(control_frame, text="🌀 Fractal Art Generator", 
                               font=("Arial", 16, "bold"))
        title_label.pack(pady=10)
        
        # Fractal type selection
        ttk.Label(control_frame, text="Fractal Type:").pack(anchor=tk.W)
        self.fractal_type = tk.StringVar(value="Mandelbrot")
        fractal_combo = ttk.Combobox(control_frame, textvariable=self.fractal_type,
                                   values=["Mandelbrot", "Julia", "Burning Ship", "Dragon Curve"])
        fractal_combo.pack(fill=tk.X, pady=5)
        
        # Zoom control
        ttk.Label(control_frame, text="Zoom Level:").pack(anchor=tk.W, pady=(10,0))
        self.zoom_var = tk.DoubleVar(value=1.0)
        zoom_scale = ttk.Scale(control_frame, from_=0.1, to=100.0, 
                              variable=self.zoom_var, orient=tk.HORIZONTAL)
        zoom_scale.pack(fill=tk.X, pady=5)
        
        # Center X control
        ttk.Label(control_frame, text="Center X:").pack(anchor=tk.W, pady=(10,0))
        self.center_x_var = tk.DoubleVar(value=-0.5)
        center_x_scale = ttk.Scale(control_frame, from_=-2.0, to=2.0,
                                  variable=self.center_x_var, orient=tk.HORIZONTAL)
        center_x_scale.pack(fill=tk.X, pady=5)
        
        # Center Y control
        ttk.Label(control_frame, text="Center Y:").pack(anchor=tk.W, pady=(10,0))
        self.center_y_var = tk.DoubleVar(value=0.0)
        center_y_scale = ttk.Scale(control_frame, from_=-2.0, to=2.0,
                                  variable=self.center_y_var, orient=tk.HORIZONTAL)
        center_y_scale.pack(fill=tk.X, pady=5)
        
        # Iterations control
        ttk.Label(control_frame, text="Detail Level (Iterations):").pack(anchor=tk.W, pady=(10,0))
        self.iterations_var = tk.IntVar(value=100)
        iter_scale = ttk.Scale(control_frame, from_=10, to=500,
                              variable=self.iterations_var, orient=tk.HORIZONTAL)
        iter_scale.pack(fill=tk.X, pady=5)
        
        # Color scheme
        ttk.Label(control_frame, text="Color Scheme:").pack(anchor=tk.W, pady=(10,0))
        self.colormap_var = tk.StringVar(value="hot")
        color_combo = ttk.Combobox(control_frame, textvariable=self.colormap_var,
                                 values=["hot", "plasma", "viridis", "cool", "rainbow"])
        color_combo.pack(fill=tk.X, pady=5)
        
        # Generate button
        generate_btn = ttk.Button(control_frame, text="🎨 Generate Fractal", 
                                command=self.generate_fractal)
        generate_btn.pack(pady=20, fill=tk.X)
        
        # Save button
        save_btn = ttk.Button(control_frame, text="💾 Save Image", 
                            command=self.save_fractal)
        save_btn.pack(pady=5, fill=tk.X)
        
        # Info display
        self.info_text = tk.Text(control_frame, height=8, width=40)
        self.info_text.pack(pady=10, fill=tk.BOTH, expand=True)
        
        self.info_text.insert(tk.END, "🌟 Welcome to Fractal Art Generator!\n\n")
        self.info_text.insert(tk.END, "Adjust the controls and click 'Generate Fractal' to create beautiful mathematical art.\n\n")
        self.info_text.insert(tk.END, "Try different fractal types and zoom levels to explore infinite complexity!\n")
    
    def mandelbrot_set(self, width=800, height=600):
        """Generate the Mandelbrot set"""
        # Get current parameters
        zoom = self.zoom_var.get()
        center_x = self.center_x_var.get()
        center_y = self.center_y_var.get()
        max_iter = self.iterations_var.get()
        
        # Create coordinate arrays
        x_min, x_max = center_x - 2/zoom, center_x + 2/zoom
        y_min, y_max = center_y - 1.5/zoom, center_y + 1.5/zoom
        
        x = np.linspace(x_min, x_max, width)
        y = np.linspace(y_min, y_max, height)
        X, Y = np.meshgrid(x, y)
        
        # Complex plane
        C = X + 1j*Y
        Z = np.zeros_like(C)
        
        # Mandelbrot iteration
        fractal = np.zeros(C.shape)
        
        for i in range(max_iter):
            # Find points that haven't diverged
            mask = np.abs(Z) <= 2
            
            # Update Z for non-diverged points
            Z[mask] = Z[mask]**2 + C[mask]
            
            # Update fractal array
            fractal[mask] = i
        
        return fractal
    
    def julia_set(self, width=800, height=600):
        """Generate a Julia set"""
        # Julia set parameters
        c_real = self.center_x_var.get()
        c_imag = self.center_y_var.get()
        c = complex(c_real, c_imag)
        
        zoom = self.zoom_var.get()
        max_iter = self.iterations_var.get()
        
        # Create coordinate arrays
        x = np.linspace(-2/zoom, 2/zoom, width)
        y = np.linspace(-1.5/zoom, 1.5/zoom, height)
        X, Y = np.meshgrid(x, y)
        
        # Initial Z values
        Z = X + 1j*Y
        
        # Julia iteration
        fractal = np.zeros(Z.shape)
        
        for i in range(max_iter):
            mask = np.abs(Z) <= 2
            Z[mask] = Z[mask]**2 + c
            fractal[mask] = i
        
        return fractal
    
    def burning_ship(self, width=800, height=600):
        """Generate the Burning Ship fractal"""
        zoom = self.zoom_var.get()
        center_x = self.center_x_var.get()
        center_y = self.center_y_var.get()
        max_iter = self.iterations_var.get()
        
        x_min, x_max = center_x - 2/zoom, center_x + 2/zoom
        y_min, y_max = center_y - 1.5/zoom, center_y + 1.5/zoom
        
        x = np.linspace(x_min, x_max, width)
        y = np.linspace(y_min, y_max, height)
        X, Y = np.meshgrid(x, y)
        
        C = X + 1j*Y
        Z = np.zeros_like(C)
        fractal = np.zeros(C.shape)
        
        for i in range(max_iter):
            mask = np.abs(Z) <= 2
            # Burning ship uses absolute values
            Z[mask] = (np.abs(np.real(Z[mask])) + 1j*np.abs(np.imag(Z[mask])))**2 + C[mask]
            fractal[mask] = i
        
        return fractal
    
    def generate_fractal(self):
        """Generate and display the selected fractal"""
        fractal_type = self.fractal_type.get()
        
        self.info_text.insert(tk.END, "Generating " + fractal_type + " fractal...\n")
        self.root.update()
        
        # Generate fractal data
        if fractal_type == "Mandelbrot":
            fractal_data = self.mandelbrot_set()
        elif fractal_type == "Julia":
            fractal_data = self.julia_set()
        elif fractal_type == "Burning Ship":
            fractal_data = self.burning_ship()
        else:
            fractal_data = self.mandelbrot_set()  # Default
        
        # Create the plot
        plt.figure(figsize=(10, 8))
        plt.imshow(fractal_data, extent=[-2, 2, -1.5, 1.5], 
                  cmap=self.colormap_var.get(), origin='lower')
        plt.colorbar(label='Iterations')
        plt.title(fractal_type + " Fractal - Zoom: " + str(round(self.zoom_var.get(), 2)))
        plt.xlabel('Real')
        plt.ylabel('Imaginary')
        
        # Store for saving
        self.current_fractal = fractal_data
        
        plt.show()
        
        self.info_text.insert(tk.END, "Fractal generated successfully!\n")
        self.info_text.see(tk.END)
    
    def save_fractal(self):
        """Save the current fractal as an image"""
        if hasattr(self, 'current_fractal'):
            filename = "fractal_art_" + self.fractal_type.get().lower() + ".png"
            plt.figure(figsize=(12, 9))
            plt.imshow(self.current_fractal, cmap=self.colormap_var.get(), origin='lower')
            plt.axis('off')  # Remove axes for clean image
            plt.savefig(filename, dpi=300, bbox_inches='tight')
            plt.close()
            
            self.info_text.insert(tk.END, "Saved as " + filename + "\n")
            self.info_text.see(tk.END)
        else:
            self.info_text.insert(tk.END, "Generate a fractal first!\n")
    
    def run(self):
        """Start the interactive fractal generator"""
        print("🌀 Starting Interactive Fractal Generator")
        print("Use the GUI controls to explore fractals!")
        self.root.mainloop()

def main():
    """Main function"""
    generator = InteractiveFractalGenerator()
    generator.run()

if __name__ == "__main__":
    main()</code></pre>
