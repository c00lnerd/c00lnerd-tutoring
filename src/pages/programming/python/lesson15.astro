    <div class="code-section">
      <h2>🎨 The Mathematical Art Generator</h2>
      <p>Let's start by creating our mathematical art generator. This code translates the beautiful p5.js pattern into Python:</p>

      <div class="code-block">
        <div class="code-header">
          <span class="filename">mathematical_art.py</span>
          <button class="copy-btn" onclick="copyCode(this)">Copy</button>
        </div>
        <pre><code class="language-python">import turtle
import math
import time

def setup_canvas():
    """Set up our drawing canvas"""
    screen = turtle.Screen()
    screen.bgcolor("black")
    screen.setup(800, 800)
    screen.title("Mathematical Art Generator")
    
    # Create our drawing turtle
    artist = turtle.Turtle()
    artist.speed(0)  # Fastest drawing
    artist.color("white")
    artist.pensize(1)
    
    return screen, artist

def mathematical_pattern(artist, x, y, t):
    """
    The mathematical formula that creates our beautiful pattern
    This is based on parametric equations using trigonometry
    """
    # These are the mathematical formulas that create the pattern
    k = x / 8 - 25
    e = y / 8 - 25
    
    # Calculate the distance from center (magnitude)
    d = 5 * math.cos(math.sqrt(k*k + e*e) / 3)
    
    # Create the complex pattern using trigonometry
    q = x / 2 + k / math.atan(9 * math.cos(e)) * math.sin(d * 4 - t)
    pattern_x = math.sin(d/3 - t/8) + 200
    pattern_y = (y/3 + d + q) / 2 * math.cos(d/3) + 200
    
    return pattern_x, pattern_y

def draw_mathematical_art(artist, frame_time):
    """Draw one frame of our mathematical art"""
    artist.clear()
    artist.penup()
    
    # Create the pattern by sampling points across the canvas
    for y in range(99, 300, 3):  # Step by 3 for faster drawing
        for x in range(99, 300, 3):
            # Calculate the pattern position using our mathematical formula
            pattern_x, pattern_y = mathematical_pattern(artist, x, y, frame_time)
            
            # Move to the calculated position and draw a point
            artist.goto(pattern_x - 400, pattern_y - 400)  # Center the pattern
            artist.pendown()
            artist.forward(1)  # Draw a small point
            artist.penup()

def create_animated_art():
    """Create an animated mathematical art piece"""
    screen, artist = setup_canvas()
    
    print("🎨 Creating Mathematical Art...")
    print("Press 'q' to quit, 's' to save a frame")
    
    # Animation loop
    t = 0
    while True:
        try:
            # Draw the current frame
            draw_mathematical_art(artist, t)
            
            # Update time for animation
            t += math.pi / 60  # Smooth animation
            
            # Update the screen
            screen.update()
            
            # Small delay for smooth animation
            time.sleep(0.05)
            
        except turtle.Terminator:
            break
    
    screen.exitonclick()

if __name__ == "__main__":
    create_animated_art()</code></pre>
