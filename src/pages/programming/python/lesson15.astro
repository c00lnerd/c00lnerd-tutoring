        <pre><code class="language-python">import turtle
import math
import random
import colorsys

class MathematicalArtist:
    def __init__(self):
        self.setup_canvas()
        self.t = 0
        self.color_mode = 0
        self.pattern_style = 0
        
    def setup_canvas(self):
        """Set up our enhanced drawing canvas"""
        self.screen = turtle.Screen()
        self.screen.bgcolor("black")
        self.screen.setup(900, 900)
        self.screen.title("Enhanced Mathematical Art Generator")
        self.screen.tracer(0)  # Turn off animation for faster drawing
        
        # Create our artist turtle
        self.artist = turtle.Turtle()
        self.artist.speed(0)
        self.artist.hideturtle()
        self.artist.pensize(1)
        
        # Set up keyboard controls
        self.screen.onkey(self.change_colors, "c")
        self.screen.onkey(self.change_pattern, "p")
        self.screen.onkey(self.save_art, "s")
        self.screen.onkey(self.quit_program, "q")
        self.screen.listen()
        
        print("🎨 Enhanced Mathematical Art Generator")
        print("Controls:")
        print("  'c' - Change color scheme")
        print("  'p' - Change pattern style") 
        print("  's' - Save current frame")
        print("  'q' - Quit")
    
    def get_rainbow_color(self, value):
        """Generate rainbow colors based on a value"""
        hue = (value + self.t * 10) % 360 / 360
        rgb = colorsys.hsv_to_rgb(hue, 1.0, 1.0)
        return rgb
    
    def mathematical_pattern_v1(self, x, y, t):
        """Original mathematical pattern"""
        k = x / 8 - 25
        e = y / 8 - 25
        d = 5 * math.cos(math.sqrt(k*k + e*e) / 3)
        q = x / 2 + k / (math.atan(9 * math.cos(e)) + 0.1) * math.sin(d * 4 - t)
        pattern_x = math.sin(d/3 - t/8) + 200
        pattern_y = (y/3 + d + q) / 2 * math.cos(d/3) + 200
        return pattern_x, pattern_y
    
    def mathematical_pattern_v2(self, x, y, t):
        """Alternative mathematical pattern - spiral mandala"""
        center_x, center_y = 200, 200
        dx = x - center_x
        dy = y - center_y
        
        r = math.sqrt(dx*dx + dy*dy)
        angle = math.atan2(dy, dx)
        
        # Create spiral pattern
        spiral = r * 0.1 + t
        new_r = r + 20 * math.sin(spiral) * math.cos(angle * 8)
        new_angle = angle + math.sin(r * 0.02 + t) * 0.5
        
        pattern_x = center_x + new_r * math.cos(new_angle)
        pattern_y = center_y + new_r * math.sin(new_angle)
        
        return pattern_x, pattern_y
    
    def mathematical_pattern_v3(self, x, y, t):
        """Third pattern - flower mandala"""
        center_x, center_y = 200, 200
        dx = x - center_x
        dy = y - center_y
        
        r = math.sqrt(dx*dx + dy*dy)
        angle = math.atan2(dy, dx)
        
        # Create flower-like pattern
        petals = 8
        petal_size = 30 * math.sin(angle * petals + t)
        wave = 15 * math.sin(r * 0.05 + t * 2)
        
        pattern_x = x + petal_size * math.cos(angle) + wave * math.cos(angle + t)
        pattern_y = y + petal_size * math.sin(angle) + wave * math.sin(angle + t)
        
        return pattern_x, pattern_y
    
    def get_current_pattern(self, x, y, t):
        """Get the current pattern based on style selection"""
        if self.pattern_style == 0:
            return self.mathematical_pattern_v1(x, y, t)
        elif self.pattern_style == 1:
            return self.mathematical_pattern_v2(x, y, t)
        else:
            return self.mathematical_pattern_v3(x, y, t)
    
    def draw_mathematical_art(self):
        """Draw one frame of our enhanced mathematical art"""
        self.artist.clear()
        
        # Draw the pattern
        for y in range(50, 350, 4):  # Adjusted range and step
            for x in range(50, 350, 4):
                # Calculate pattern position
                pattern_x, pattern_y = self.get_current_pattern(x, y, self.t)
                
                # Set color based on current color mode
                if self.color_mode == 0:
                    # Rainbow colors
                    distance = math.sqrt((x-200)**2 + (y-200)**2)
                    color = self.get_rainbow_color(distance)
                    self.artist.color(color)
                elif self.color_mode == 1:
                    # White on black (classic)
                    self.artist.color("white")
                elif self.color_mode == 2:
                    # Random colors
                    self.artist.color(random.random(), random.random(), random.random())
                else:
                    # Gradient based on position
                    intensity = (x + y) / 600
                    self.artist.color(intensity, intensity * 0.5, 1 - intensity)
                
                # Draw the point
                self.artist.penup()
                self.artist.goto(pattern_x - 450, pattern_y - 450)  # Center the pattern
                self.artist.pendown()
                self.artist.forward(2)
        
        # Update the screen
        self.screen.update()
    
    def change_colors(self):
        """Change color scheme"""
        self.color_mode = (self.color_mode + 1) % 4
        color_names = ["Rainbow", "Classic White", "Random Colors", "Gradient"]
        print(f"🎨 Color scheme: {color_names[self.color_mode]}")
    
    def change_pattern(self):
        """Change pattern style"""
        self.pattern_style = (self.pattern_style + 1) % 3
        pattern_names = ["Original Mandala", "Spiral Mandala", "Flower Mandala"]
        print(f"🌀 Pattern style: {pattern_names[self.pattern_style]}")
    
    def save_art(self):
        """Save the current frame as an image"""
        filename = f"mathematical_art_{int(self.t * 100)}.eps"
        self.screen.getcanvas().postscript(file=filename)
        print(f"💾 Saved artwork as {filename}")
    
    def quit_program(self):
        """Quit the program"""
        print("👋 Thanks for creating mathematical art!")
        self.screen.bye()
    
    def animate(self):
        """Main animation loop"""
        try:
            while True:
                self.draw_mathematical_art()
                self.t += math.pi / 120  # Slower, smoother animation
                
        except turtle.Terminator:
            pass

def main():
    """Main function to run the enhanced mathematical art generator"""
    artist = MathematicalArtist()
    artist.animate()

if __name__ == "__main__":
    main()</code></pre>
