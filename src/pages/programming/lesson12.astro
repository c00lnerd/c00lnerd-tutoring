        <div class="relative">
          <pre class="bg-gray-100 p-4 rounded text-sm overflow-x-auto"><code>import turtle
import math

def draw_tree(t, branch_length, angle, depth):
    """
    Draw a fractal tree using recursion
    
    Parameters:
    t - turtle object
    branch_length - length of current branch
    angle - angle between branches
    depth - how many levels deep to go
    """
    
    # Base case - stop if branch is too small or depth is 0
    if branch_length < 5 or depth == 0:
        return
    
    # Draw the current branch
    t.forward(branch_length)
    
    # Save current position and heading
    current_pos = t.position()
    current_heading = t.heading()
    
    # Draw left branch (recursive call)
    t.left(angle)
    draw_tree(t, branch_length * 0.7, angle, depth - 1)
    
    # Return to trunk and draw right branch
    t.goto(current_pos)
    t.setheading(current_heading)
    t.right(angle)
    draw_tree(t, branch_length * 0.7, angle, depth - 1)
    
    # Return to original position and heading
    t.goto(current_pos)
    t.setheading(current_heading)

# Set up the drawing
def create_fractal_tree():
    # Create screen and turtle
    screen = turtle.Screen()
    screen.bgcolor("black")
    screen.title("Fractal Tree - Nature's Mathematics")
    screen.setup(800, 600)
    
    # Create turtle
    tree_turtle = turtle.Turtle()
    tree_turtle.speed(0)  # Fastest drawing
    tree_turtle.color("green")
    tree_turtle.pensize(2)
    
    # Position turtle at bottom center, pointing up
    tree_turtle.goto(0, -250)
    tree_turtle.setheading(90)  # Point straight up
    
    # Draw the fractal tree
    draw_tree(tree_turtle, 100, 30, 8)
    
    # Keep window open
    screen.exitonclick()

# Run the program
if __name__ == "__main__":
    create_fractal_tree()</code></pre>
