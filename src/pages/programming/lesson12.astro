  .copy-btn {
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .copy-btn:hover {
    opacity: 1;
  }

  .relative:hover .copy-btn {
    opacity: 1;
  }
</style>

<script is:inline>
  function copyCode(button) {
    const codeBlock = button.parentElement.querySelector('code');
    const text = codeBlock.textContent;
    
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(text).then(() => {
        showCopyFeedback(button);
      }).catch(() => {
        fallbackCopyTextToClipboard(text, button);
      });
    } else {
      fallbackCopyTextToClipboard(text, button);
    }
  }

  function fallbackCopyTextToClipboard(text, button) {
    const textArea = document.createElement("textarea");
    textArea.value = text;
    textArea.style.top = "0";
    textArea.style.left = "0";
    textArea.style.position = "fixed";

    document.body.appendChild(textArea);
    textArea.focus();
    textArea.select();

    try {
      document.execCommand('copy');
      showCopyFeedback(button);
    } catch (err) {
      console.error('Fallback: Oops, unable to copy', err);
    }

    document.body.removeChild(textArea);
  }

  function showCopyFeedback(button) {
    const originalText = button.innerHTML;
    button.innerHTML = '✅ Copied!';
    button.style.backgroundColor = '#10b981';
    
    setTimeout(() => {
      button.innerHTML = originalText;
      button.style.backgroundColor = '';
    }, 2000);
  }

  function openFractalDemo() {
    // Simple approach: use window.location.origin to get base URL
    const baseUrl = window.location.origin; // http://localhost:8001
    const fractalUrl = baseUrl + '/simulations/interactive/fractal-tree.html';
    
    console.log('Current URL:', window.location.href);
    console.log('Base URL:', baseUrl);
    console.log('Opening fractal demo at:', fractalUrl);
    
    // Open in new tab
    window.open(fractalUrl, '_blank');
  }
</script>
