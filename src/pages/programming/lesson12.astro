        <div class="flex justify-between items-center mb-4">
          <h3 class="text-xl font-bold text-green-600">Complete Fractal Tree Code</h3>
          <a href="#" onclick="openFractalDemo(); return false;" class="bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition-colors text-sm font-semibold">
            🌐 Try Interactive JS Version
          </a>
