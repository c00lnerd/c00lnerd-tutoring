---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Week 6 Quiz: Lists and Data Structures">
    <main style="min-height: 100vh; background: linear-gradient(135deg, #e0f2fe 0%, #b3e5fc 100%); padding: 3rem 0;">
        <div style="max-width: 800px; margin: 0 auto; padding: 0 1rem;">
            <!-- Header -->
            <div style="text-align: center; margin-bottom: 2rem;">
                <div style="display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
                    <div style="background: #0288d1; color: white; border-radius: 50%; width: 4rem; height: 4rem; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.5rem; margin-right: 1rem;">Q6</div>
                    <div style="text-align: left;">
                        <h1 style="font-size: 2rem; font-weight: bold; color: var(--black); margin: 0;">Week 6 Quiz</h1>
                        <p style="color: var(--gray); margin: 0;">Lists and Data Structures</p>
                    </div>
                </div>
            </div>

            <!-- Quiz Form -->
            <div style="background: white; border-radius: 12px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); padding: 2rem;">
                <form id="week6Quiz" style="display: flex; flex-direction: column; gap: 2rem;">
                    <!-- Student Info -->
                    <div style="background: var(--gray-light); padding: 1.5rem; border-radius: 8px;">
                        <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--black); margin-bottom: 1rem;">Student Information</h3>
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem;">
                            <div>
                                <label style="display: block; font-weight: 500; color: var(--black); margin-bottom: 0.5rem;">Name:</label>
                                <input type="text" id="studentName" style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 6px; font-size: 1rem;" required>
                            </div>
                            <div>
                                <label style="display: block; font-weight: 500; color: var(--black); margin-bottom: 0.5rem;">Email:</label>
                                <input type="email" id="studentEmail" style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 6px; font-size: 1rem;" required>
                            </div>
                        </div>
                    </div>

                    <!-- Question 1 -->
                    <div style="border-left: 4px solid #0288d1; padding-left: 1.5rem;">
                        <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--black); margin-bottom: 0.75rem;">Question 1: Multiple Choice (2 points)</h3>
                        <p style="color: var(--gray); margin-bottom: 1rem;">How do you create an empty list in Python?</p>
                        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q1" value="a" style="margin-right: 0.75rem;">
                                <span>A) list = {}</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q1" value="b" style="margin-right: 0.75rem;">
                                <span>B) list = []</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q1" value="c" style="margin-right: 0.75rem;">
                                <span>C) list = ()</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q1" value="d" style="margin-right: 0.75rem;">
                                <span>D) list = ""</span>
                            </label>
                        </div>
                    </div>

                    <!-- Question 2 -->
                    <div style="border-left: 4px solid #0288d1; padding-left: 1.5rem;">
                        <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--black); margin-bottom: 0.75rem;">Question 2: Multiple Choice (2 points)</h3>
                        <p style="color: var(--gray); margin-bottom: 1rem;">What will <code>my_list[1]</code> return if <code>my_list = ['apple', 'banana', 'cherry']</code>?</p>
                        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q2" value="a" style="margin-right: 0.75rem;">
                                <span>A) 'apple'</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q2" value="b" style="margin-right: 0.75rem;">
                                <span>B) 'banana'</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q2" value="c" style="margin-right: 0.75rem;">
                                <span>C) 'cherry'</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q2" value="d" style="margin-right: 0.75rem;">
                                <span>D) Error</span>
                            </label>
                        </div>
                    </div>

                    <!-- Question 3 -->
                    <div style="border-left: 4px solid #0288d1; padding-left: 1.5rem;">
                        <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--black); margin-bottom: 0.75rem;">Question 3: Short Answer (3 points)</h3>
                        <p style="color: var(--gray); margin-bottom: 1rem;">Write code to add the item 'orange' to the end of a list called 'fruits':</p>
                        <textarea id="q3" name="q3" rows="3" style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 6px; font-family: monospace; font-size: 0.9rem;" placeholder="Type your Python code here..."></textarea>
                    </div>

                    <!-- Question 4 -->
                    <div style="border-left: 4px solid #0288d1; padding-left: 1.5rem;">
                        <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--black); margin-bottom: 0.75rem;">Question 4: True/False (2 points)</h3>
                        <p style="color: var(--gray); margin-bottom: 1rem;">Lists in Python can contain different data types (strings, numbers, booleans) in the same list.</p>
                        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q4" value="true" style="margin-right: 0.75rem;">
                                <span>True</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q4" value="false" style="margin-right: 0.75rem;">
                                <span>False</span>
                            </label>
                        </div>
                    </div>

                    <!-- Question 5 -->
                    <div style="border-left: 4px solid #0288d1; padding-left: 1.5rem;">
                        <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--black); margin-bottom: 0.75rem;">Question 5: Multiple Choice (1 point)</h3>
                        <p style="color: var(--gray); margin-bottom: 1rem;">Which method removes the last item from a list?</p>
                        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q5" value="a" style="margin-right: 0.75rem;">
                                <span>A) remove()</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q5" value="b" style="margin-right: 0.75rem;">
                                <span>B) pop()</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q5" value="c" style="margin-right: 0.75rem;">
                                <span>C) delete()</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q5" value="d" style="margin-right: 0.75rem;">
                                <span>D) clear()</span>
                            </label>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <div style="text-align: center; margin-top: 2rem;">
                        <button type="submit" style="background: #0288d1; color: white; padding: 1rem 2rem; border: none; border-radius: 8px; font-size: 1.1rem; font-weight: 600; cursor: pointer; transition: background-color 0.2s;">
                            Submit Quiz
                        </button>
                    </div>
                </form>

                <!-- Results Display -->
                <div id="quizResults" style="display: none; margin-top: 2rem; padding: 1.5rem; background: #eff6ff; border-radius: 8px;">
                    <h3 style="font-size: 1.25rem; font-weight: bold; color: #1e40af; margin-bottom: 1rem;">Quiz Results</h3>
                    <div id="scoreDisplay" style="font-size: 1.1rem; margin-bottom: 1rem;"></div>
                    <div id="feedback" style="color: var(--gray);"></div>
                </div>
            </div>

            <!-- Navigation -->
            <div style="display: flex; flex-direction: column; gap: 1rem; margin-top: 2rem; align-items: center;">
                <a href="/programming/lessons/week6" style="
                    background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
                    color: white;
                    padding: 0.75rem 1.5rem;
                    border-radius: 8px;
                    text-decoration: none;
                    font-weight: 600;
                    min-width: 200px;
                    text-align: center;
                    transition: all 0.3s ease;
                    box-shadow: 0 2px 4px rgba(59, 130, 246, 0.3);
                " onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 8px rgba(59, 130, 246, 0.4)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 2px 4px rgba(59, 130, 246, 0.3)'">
                    ← Back to Lesson
                </a>
                <a href="/programming/semester1" style="
                    background: linear-gradient(135deg, #6b7280 0%, #4b5563 100%);
                    color: white;
                    padding: 0.75rem 1.5rem;
                    border-radius: 8px;
                    text-decoration: none;
                    font-weight: 600;
                    min-width: 200px;
                    text-align: center;
                    transition: all 0.3s ease;
                    box-shadow: 0 2px 4px rgba(107, 114, 128, 0.3);
                " onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 8px rgba(107, 114, 128, 0.4)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 2px 4px rgba(107, 114, 128, 0.3)'">
                    Semester Overview
                </a>
                <a href="/programming/lessons/week7" style="
                    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
                    color: white;
                    padding: 0.75rem 1.5rem;
                    border-radius: 8px;
                    text-decoration: none;
                    font-weight: 600;
                    min-width: 200px;
                    text-align: center;
                    transition: all 0.3s ease;
                    box-shadow: 0 2px 4px rgba(16, 185, 129, 0.3);
                " onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 8px rgba(16, 185, 129, 0.4)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 2px 4px rgba(16, 185, 129, 0.3)'">
                    Next Lesson →
                </a>
            </div>
        </div>
    </main>

    <script>
window.onload = function() { generateCaptcha(); };
        // Quiz answers and scoring
        const correctAnswers = {
            q1: 'b',  // list = []
            q2: 'b',  // 'banana'
            q4: 'true',  // lists can contain different data types
            q5: 'b'   // pop()
        };

        const totalPoints = 10;

        document.getElementById('week6Quiz').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const studentName = document.getElementById('studentName').value;
            const studentEmail = document.getElementById('studentEmail').value;
            
            if (!studentName || !studentEmail) {
                alert('Please fill in your name and email.');
                return;
            }

            let score = 0;
            let feedback = [];

            // Check multiple choice answers
            Object.keys(correctAnswers).forEach(questionId => {
                const selectedAnswer = document.querySelector(`input[name="${questionId}"]:checked`);
                if (selectedAnswer && selectedAnswer.value === correctAnswers[questionId]) {
                    score += questionId === 'q1' || questionId === 'q2' || questionId === 'q4' ? 2 : 1;
                    feedback.push(`✓ Question ${questionId.slice(1)}: Correct`);
                } else {
                    feedback.push(`✗ Question ${questionId.slice(1)}: Incorrect`);
                }
            });

            // Check short answer (Q3) - basic validation
            const q3Answer = document.getElementById('q3').value.toLowerCase().trim();
            if (q3Answer.includes('fruits.append') && q3Answer.includes('orange')) {
                score += 3;
                feedback.push('✓ Question 3: Correct - Good use of append() method');
            } else {
                feedback.push('✗ Question 3: Missing key elements (fruits.append and orange)');
            }

            const percentage = Math.round((score / totalPoints) * 100);
            
            // Display results
            document.getElementById('scoreDisplay').innerHTML = `
                <strong>Score: ${score}/${totalPoints} (${percentage}%)</strong>
            `;
            
            document.getElementById('feedback').innerHTML = feedback.join('<br>');
            document.getElementById('quizResults').style.display = 'block';

            // Prepare quiz data for submission
            const quizData = {
                studentName: studentName,
                studentEmail: studentEmail,
                week: 6,
                topic: 'Lists and Data Structures',
                score: score,
                totalPoints: totalPoints,
                percentage: percentage,
                answers: {
                    q1: document.querySelector('input[name="q1"]:checked')?.value || 'No answer',
                    q2: document.querySelector('input[name="q2"]:checked')?.value || 'No answer',
                    q3: document.getElementById('q3').value || 'No answer',
                    q4: document.querySelector('input[name="q4"]:checked')?.value || 'No answer',
                    q5: document.querySelector('input[name="q5"]:checked')?.value || 'No answer'
                },
                submittedAt: new Date().toISOString()
            };

            // Submit to teacher via EmailJS
            submitQuizResults(quizData);
        });

        function submitQuizResults(quizData) {
            const formattedMessage = `WEEK 6 QUIZ RESULTS - LISTS AND DATA STRUCTURES

Student Information:
• Name: ${quizData.studentName}
• Email: ${quizData.studentEmail}

Quiz Performance:
• Score: ${quizData.score}/${quizData.totalPoints} (${quizData.percentage}%)
• Topic: ${quizData.topic}
• Submission Date: ${new Date(quizData.submittedAt).toLocaleString()}

Student Responses:
• Q1 (Creating Lists): ${quizData.answers.q1} ${quizData.answers.q1 === 'b' ? '✓' : '✗'}
• Q2 (List Indexing): ${quizData.answers.q2} ${quizData.answers.q2 === 'b' ? '✓' : '✗'}
• Q3 (Append Method): ${quizData.answers.q3}
• Q4 (Mixed Data Types): ${quizData.answers.q4} ${quizData.answers.q4 === 'true' ? '✓' : '✗'}
• Q5 (Pop Method): ${quizData.answers.q5} ${quizData.answers.q5 === 'b' ? '✓' : '✗'}

Performance Analysis:
${quizData.percentage >= 80 ? '🎉 Excellent! Student demonstrates strong understanding of lists and data structures.' : 
  quizData.percentage >= 70 ? '👍 Good work! Student grasps list concepts but may need practice with methods and indexing.' :
  quizData.percentage >= 60 ? '⚠️ Satisfactory. Student understands basics but needs more practice with list operations.' :
  '📚 Needs improvement. Recommend additional review of list creation, indexing, and methods.'}`;

            // Send email using the working inline format
            emailjs.send('service_ot1jg6s', 'template_io02xtm', {
                to_email: 'chuck@c00lnerd.com',
                from_name: quizData.studentName,
                from_email: quizData.studentEmail,
                message: formattedMessage,
                subject: `Week 6 Programming Quiz - ${quizData.studentName}`
            })
            .then(function(response) {
                console.log('Quiz results sent successfully!', response.status, response.text);
            }, function(error) {
                console.log('Failed to send quiz results...', error);
            });
        }

        // Initialize EmailJS
        emailjs.init("ct_s19oZHppLy9BlW");
    // CAPTCHA variables
    let captchaAnswer = 0;
    
    function generateCaptcha() {
        const num1 = Math.floor(Math.random() * 10) + 1;
        const num2 = Math.floor(Math.random() * 10) + 1;
        captchaAnswer = num1 + num2;
        const questionElement = document.getElementById('captcha-question');
        if (questionElement) {
            questionElement.textContent = num1 + " + " + num2 + ;
        }
    }
    
    function validateCaptcha() {
        const userAnswer = parseInt(document.getElementById('captcha').value);
        const errorDiv = document.getElementById('captcha-error');
        
        if (userAnswer !== captchaAnswer) {
            if (errorDiv) errorDiv.style.display = 'block';
            generateCaptcha(); // Generate new question
            document.getElementById('captcha').value = '';
            return false;
        }
        
        if (errorDiv) errorDiv.style.display = 'none';
        return true;
    }
    
    // Security validation function
    function validateSecurity() {
        // Check honeypot field (should be empty)
        const honeypot = document.getElementById('website');
        if (honeypot && honeypot.value) {
            console.log('Spam bot detected via honeypot');
            alert('Security check failed. Please try again.');
            return false;
        }
        
        // Rate limiting check
        const lastSubmission = localStorage.getItem('lastQuizStart');
        const now = Date.now();
        if (lastSubmission && (now - parseInt(lastSubmission)) < 30000) { // 30 second cooldown
            alert('Please wait 30 seconds between quiz attempts.');
            return false;
        }
        localStorage.setItem('lastQuizStart', now.toString());
        
        // Validate CAPTCHA
        if (!validateCaptcha()) {
            return false;
        }
        
        // Email validation and domain filtering
        const emailInput = document.getElementById('email');
        if (emailInput && emailInput.value) {
            const email = emailInput.value;
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                alert('Please enter a valid email address.');
                return false;
            }
            
            // Block common spam domains
            const spamDomains = ['tempmail.org', '10minutemail.com', 'guerrillamail.com', 'mailinator.com', 'throwaway.email'];
            const domain = email.split('@')[1].toLowerCase();
            if (spamDomains.includes(domain)) {
                alert('Please use a permanent email address.');
                return false;
            }
        }
        
        return true;
    }
    </script>
</Layout>
