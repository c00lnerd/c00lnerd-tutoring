---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Week 15 Quiz: miniAuto Remote Control and Communication">
    <main style="min-height: 100vh; background: linear-gradient(135deg, #e8eaf6 0%, #9c27b0 100%); padding: 3rem 0;">
        <div style="max-width: 800px; margin: 0 auto; padding: 0 1rem;">
            <!-- Header -->
            <div style="text-align: center; margin-bottom: 2rem;">
                <div style="display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
                    <div style="background: #6a1b9a; color: white; border-radius: 50%; width: 4rem; height: 4rem; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.5rem; margin-right: 1rem;">Q15</div>
                    <div style="text-align: left;">
                        <h1 style="font-size: 2rem; font-weight: bold; color: var(--black); margin: 0;">Week 15 Quiz</h1>
                        <p style="color: var(--gray); margin: 0;">miniAuto Remote Control and Communication</p>
                    </div>
                </div>
            </div>

            <!-- Quiz Form -->
            <div style="background: white; border-radius: 12px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); padding: 2rem;">
                <form id="week15Quiz" style="display: flex; flex-direction: column; gap: 2rem;">
                    <!-- Student Info -->
                    <div style="background: var(--gray-light); padding: 1.5rem; border-radius: 8px;">
                        <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--black); margin-bottom: 1rem;">Student Information</h3>
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem;">
                            <div>
                                <label style="display: block; font-weight: 500; color: var(--black); margin-bottom: 0.5rem;">Name:</label>
                                <input type="text" id="studentName" style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 6px; font-size: 1rem;" required>
                            </div>
                            <div>
                                <label style="display: block; font-weight: 500; color: var(--black); margin-bottom: 0.5rem;">Email:</label>
                                <input type="email" id="studentEmail" style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 6px; font-size: 1rem;" required>
                            </div>
                        </div>
                    </div>

                    <!-- Question 1 -->
                    <div style="border-left: 4px solid #6a1b9a; padding-left: 1.5rem;">
                        <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--black); margin-bottom: 0.75rem;">Question 1: Multiple Choice (2 points)</h3>
                        <p style="color: var(--gray); margin-bottom: 1rem;">Which wireless communication protocol is commonly used for remote control of the miniAuto car?</p>
                        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q1" value="a" style="margin-right: 0.75rem;">
                                <span>A) Bluetooth</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q1" value="b" style="margin-right: 0.75rem;">
                                <span>B) Wi-Fi</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q1" value="c" style="margin-right: 0.75rem;">
                                <span>C) Both Bluetooth and Wi-Fi</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q1" value="d" style="margin-right: 0.75rem;">
                                <span>D) Infrared</span>
                            </label>
                        </div>
                    </div>

                    <!-- Question 2 -->
                    <div style="border-left: 4px solid #6a1b9a; padding-left: 1.5rem;">
                        <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--black); margin-bottom: 0.75rem;">Question 2: Multiple Choice (2 points)</h3>
                        <p style="color: var(--gray); margin-bottom: 1rem;">What type of mobile app interface is typically used to control the miniAuto car remotely?</p>
                        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q2" value="a" style="margin-right: 0.75rem;">
                                <span>A) Voice commands only</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q2" value="b" style="margin-right: 0.75rem;">
                                <span>B) Virtual joystick and buttons</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q2" value="c" style="margin-right: 0.75rem;">
                                <span>C) Text-based commands</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q2" value="d" style="margin-right: 0.75rem;">
                                <span>D) Gesture recognition only</span>
                            </label>
                        </div>
                    </div>

                    <!-- Question 3 -->
                    <div style="border-left: 4px solid #6a1b9a; padding-left: 1.5rem;">
                        <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--black); margin-bottom: 0.75rem;">Question 3: Short Answer (3 points)</h3>
                        <p style="color: var(--gray); margin-bottom: 1rem;">Explain how serial communication works between the miniAuto car and a remote device (mention baud rate and data format):</p>
                        <textarea id="q3" name="q3" rows="4" style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 6px; font-size: 0.9rem;" placeholder="Explain serial communication process..."></textarea>
                    </div>

                    <!-- Question 4 -->
                    <div style="border-left: 4px solid #6a1b9a; padding-left: 1.5rem;">
                        <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--black); margin-bottom: 0.75rem;">Question 4: True/False (2 points)</h3>
                        <p style="color: var(--gray); margin-bottom: 1rem;">The miniAuto car can send real-time sensor data back to the controlling device for monitoring.</p>
                        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q4" value="true" style="margin-right: 0.75rem;">
                                <span>True</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q4" value="false" style="margin-right: 0.75rem;">
                                <span>False</span>
                            </label>
                        </div>
                    </div>

                    <!-- Question 5 -->
                    <div style="border-left: 4px solid #6a1b9a; padding-left: 1.5rem;">
                        <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--black); margin-bottom: 0.75rem;">Question 5: Multiple Choice (1 point)</h3>
                        <p style="color: var(--gray); margin-bottom: 1rem;">What is the typical range for Bluetooth communication with the miniAuto car?</p>
                        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q5" value="a" style="margin-right: 0.75rem;">
                                <span>A) 1-2 meters</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q5" value="b" style="margin-right: 0.75rem;">
                                <span>B) 10-15 meters</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q5" value="c" style="margin-right: 0.75rem;">
                                <span>C) 50-100 meters</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q5" value="d" style="margin-right: 0.75rem;">
                                <span>D) 500+ meters</span>
                            </label>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <div style="text-align: center; margin-top: 2rem;">
                        <button type="submit" style="background: #6a1b9a; color: white; padding: 1rem 2rem; border: none; border-radius: 8px; font-size: 1.1rem; font-weight: 600; cursor: pointer; transition: background-color 0.2s;">
                            Submit Quiz
                        </button>
                    </div>
                </form>

                <!-- Results Display -->
                <div id="quizResults" style="display: none; margin-top: 2rem; padding: 1.5rem; background: #e8eaf6; border-radius: 8px;">
                    <h3 style="font-size: 1.25rem; font-weight: bold; color: #4a148c; margin-bottom: 1rem;">Quiz Results</h3>
                    <div id="resultsContent"></div>
                </div>
            </div>

            <!-- Navigation -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 2rem;">
                <a href="/programming/lessons/week15" style="background: #6a1b9a; color: white; padding: 0.75rem 1.5rem; border-radius: 6px; text-decoration: none; transition: background-color 0.2s;">
                    ← Back to Lesson
                </a>
                <a href="/programming/semester1" style="background: var(--accent); color: white; padding: 0.75rem 1.5rem; border-radius: 6px; text-decoration: none; transition: background-color 0.2s;">
                    Semester Overview
                </a>
                <a href="/programming/lessons/week16" style="background: var(--accent-dark); color: white; padding: 0.75rem 1.5rem; border-radius: 6px; text-decoration: none; transition: background-color 0.2s;">
                    Next Lesson →
                </a>
            </div>
        </div>
    </main>

    <script is:inline>
window.onload = function() { generateCaptcha(); };
    // CAPTCHA variables
    let captchaAnswer = 0;
    
    function generateCaptcha() {
        const num1 = Math.floor(Math.random() * 10) + 1;
        const num2 = Math.floor(Math.random() * 10) + 1;
        captchaAnswer = num1 + num2;
        const questionElement = document.getElementById('captcha-question');
        if (questionElement) {
            questionElement.textContent = num1 + " + " + num2;
        }
    }
    
    function validateCaptcha() {
        const userAnswer = parseInt(document.getElementById('captcha').value);
        const errorDiv = document.getElementById('captcha-error');
        
        if (userAnswer !== captchaAnswer) {
            if (errorDiv) errorDiv.style.display = 'block';
            generateCaptcha(); // Generate new question
            document.getElementById('captcha').value = '';
            return false;
        }
        
        if (errorDiv) errorDiv.style.display = 'none';
        return true;
    }
    
    // Security validation function
    function validateSecurity() {
        // Check honeypot field (should be empty)
        const honeypot = document.getElementById('website');
        if (honeypot && honeypot.value) {
            console.log('Spam bot detected via honeypot');
            alert('Security check failed. Please try again.');
            return false;
        }
        
        // Rate limiting check
        const lastSubmission = localStorage.getItem('lastQuizStart');
        const now = Date.now();
        if (lastSubmission && (now - parseInt(lastSubmission)) < 30000) { // 30 second cooldown
            alert('Please wait 30 seconds between quiz attempts.');
            return false;
        }
        localStorage.setItem('lastQuizStart', now.toString());
        
        // Validate CAPTCHA
        if (!validateCaptcha()) {
            return false;
        }
        
        // Email validation and domain filtering
        const emailInput = document.getElementById('email');
        if (emailInput && emailInput.value) {
            const email = emailInput.value;
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                alert('Please enter a valid email address.');
                return false;
            }
            
            // Block common spam domains
            const spamDomains = ['tempmail.org', '10minutemail.com', 'guerrillamail.com', 'mailinator.com', 'throwaway.email'];
            const domain = email.split('@')[1].toLowerCase();
            if (spamDomains.includes(domain)) {
                alert('Please use a permanent email address.');
                return false;
            }
        }
        
        return true;
    }
        // Quiz answers and scoring
        const correctAnswers = {
            q1: 'c', // Both Bluetooth and Wi-Fi
            q2: 'b', // Virtual joystick and buttons
            q4: 'true', // Real-time sensor data
            q5: 'b'  // 10-15 meters for Bluetooth
        };

        const questionPoints = {
            q1: 2,
            q2: 2,
            q3: 3,
            q4: 2,
            q5: 1
        };

        // Load saved email
        document.addEventListener('DOMContentLoaded', function() {
            const savedEmail = localStorage.getItem('studentEmail');
            if (savedEmail) {
                document.getElementById('studentEmail').value = savedEmail;
            }
        });

        document.getElementById('week15Quiz').addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Save email to localStorage
            const email = document.getElementById('studentEmail').value;
            localStorage.setItem('studentEmail', email);
            
            // Calculate score
            let score = 0;
            let totalPoints = 10;
            let results = [];
            
            // Check multiple choice and true/false questions
            for (let qNum in correctAnswers) {
                const userAnswer = document.querySelector(`input[name="${qNum}"]:checked`)?.value;
                const isCorrect = userAnswer === correctAnswers[qNum];
                
                if (isCorrect) {
                    score += questionPoints[qNum];
                }
                
                results.push({
                    question: qNum,
                    userAnswer: userAnswer || 'No answer',
                    correctAnswer: correctAnswers[qNum],
                    isCorrect: isCorrect,
                    points: isCorrect ? questionPoints[qNum] : 0
                });
            }
            
            // Handle Question 3 (short answer) - give partial credit
            const q3Answer = document.getElementById('q3').value.toLowerCase();
            let q3Points = 0;
            let keyComponents = 0;
            
            if (q3Answer.includes('serial') || q3Answer.includes('uart')) keyComponents++;
            if (q3Answer.includes('baud') || q3Answer.includes('9600') || q3Answer.includes('115200')) keyComponents++;
            if (q3Answer.includes('data') || q3Answer.includes('byte') || q3Answer.includes('bit')) keyComponents++;
            if (q3Answer.includes('transmit') || q3Answer.includes('receive') || q3Answer.includes('communication')) keyComponents++;
            
            if (keyComponents >= 3) {
                q3Points = 3;
            } else if (keyComponents >= 2) {
                q3Points = 2;
            } else if (keyComponents >= 1) {
                q3Points = 1;
            }
            
            score += q3Points;
            results.push({
                question: 'q3',
                userAnswer: document.getElementById('q3').value || 'No answer',
                correctAnswer: 'Should mention serial/UART communication, baud rate (like 9600 or 115200), and data transmission format',
                isCorrect: q3Points === 3,
                points: q3Points
            });
            
            // Display results
            const percentage = Math.round((score / totalPoints) * 100);
            let grade = 'F';
            if (percentage >= 90) grade = 'A';
            else if (percentage >= 80) grade = 'B';
            else if (percentage >= 70) grade = 'C';
            else if (percentage >= 60) grade = 'D';
            
            const resultsHTML = `
                <div style="text-align: center; margin-bottom: 1rem;">
                    <div style="font-size: 2rem; font-weight: bold; color: #4a148c;">${score}/${totalPoints} (${percentage}%)</div>
                    <div style="font-size: 1.5rem; font-weight: bold; color: #4a148c;">Grade: ${grade}</div>
                </div>
                <div style="text-align: left;">
                    ${results.map(r => `
                        <div style="margin-bottom: 1rem; padding: 1rem; background: ${r.isCorrect ? '#e8f5e8' : '#ffeaea'}; border-radius: 6px;">
                            <strong>Question ${r.question.toUpperCase()}:</strong> ${r.isCorrect ? '✓' : '✗'} (${r.points} points)<br>
                            <strong>Your answer:</strong> ${r.userAnswer}<br>
                            <strong>Correct answer:</strong> ${r.correctAnswer}
                        </div>
                    `).join('')}
                </div>
            `;
            
            document.getElementById('resultsContent').innerHTML = resultsHTML;
            document.getElementById('quizResults').style.display = 'block';
            
            // Scroll to results
            document.getElementById('quizResults').scrollIntoView({ behavior: 'smooth' });
            
            // Send email notification
            const quizData = {
                studentName: document.getElementById('studentName').value,
                studentEmail: document.getElementById('studentEmail').value,
                week: 'Week 15',
                topic: 'miniAuto Remote Control and Communication',
                score: score,
                totalPoints: totalPoints,
                percentage: percentage,
                grade: grade,
                results: results
            };
            
            // EmailJS configuration
            emailjs.init('ct_s19oZHppLy9BlW');
            
            emailjs.send('service_ot1jg6s', 'template_io02xtm', {
                to_email: 'chuck@c00lnerd.com',
                from_name: quizData.studentName,
                from_email: quizData.studentEmail,
                message: `WEEK 15 QUIZ RESULTS - ADVANCED MINIAUTO FEATURES

Student Information:
• Name: ${quizData.studentName}
• Email: ${quizData.studentEmail}

Quiz Performance:
• Score: ${quizData.score}/${quizData.totalPoints} (${quizData.percentage}%)
• Topic: ${quizData.topic}
• Submission Date: ${new Date().toLocaleString()}

Student Responses:
${quizData.results.map(r => `• Question ${r.question.toUpperCase()}: ${r.userAnswer} ${r.isCorrect ? '✓' : '✗'}`).join('\n')}

Performance Analysis:
${quizData.percentage >= 80 ? '🎉 Excellent! Student demonstrates strong understanding of advanced robotics features including line following, computer vision, and gripper control.' : 
  quizData.percentage >= 70 ? '👍 Good work! Student grasps advanced miniAuto concepts but may need practice with PID control, camera programming, and complex autonomous behaviors.' :
  quizData.percentage >= 60 ? '⚠️ Satisfactory. Student understands basics but needs more practice with sensor fusion, vision algorithms, and mission-based programming.' :
  '📚 Needs improvement. Recommend additional review of advanced robotics concepts, computer vision fundamentals, and autonomous system design.'}`,
                subject: `Week 15 Programming Quiz - ${quizData.studentName}`
            }).then(function(response) {
                console.log('Email sent successfully:', response);
            }).catch(function(error) {
                console.error('Email send failed:', error);
            });
        });
    </script>

    <!-- EmailJS SDK -->
    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js">
window.onload = function() { generateCaptcha(); };
    }
    
    function validateCaptcha() {
        const userAnswer = parseInt(document.getElementById('captcha').value);
        const errorDiv = document.getElementById('captcha-error');
        
        if (userAnswer !== captchaAnswer) {
            if (errorDiv) errorDiv.style.display = 'block';
            generateCaptcha(); // Generate new question
            document.getElementById('captcha').value = '';
            return false;
        }
        
        if (errorDiv) errorDiv.style.display = 'none';
        return true;
    }
    
    // Security validation function
    function validateSecurity() {
        // Check honeypot field (should be empty)
        const honeypot = document.getElementById('website');
        if (honeypot && honeypot.value) {
            console.log('Spam bot detected via honeypot');
            alert('Security check failed. Please try again.');
            return false;
        }
        
        // Rate limiting check
        const lastSubmission = localStorage.getItem('lastQuizStart');
        const now = Date.now();
        if (lastSubmission && (now - parseInt(lastSubmission)) < 30000) { // 30 second cooldown
            alert('Please wait 30 seconds between quiz attempts.');
            return false;
        }
        localStorage.setItem('lastQuizStart', now.toString());
        
        // Validate CAPTCHA
        if (!validateCaptcha()) {
            return false;
        }
        
        // Email validation and domain filtering
        const emailInput = document.getElementById('email');
        if (emailInput && emailInput.value) {
            const email = emailInput.value;
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                alert('Please enter a valid email address.');
                return false;
            }
            
            // Block common spam domains
            const spamDomains = ['tempmail.org', '10minutemail.com', 'guerrillamail.com', 'mailinator.com', 'throwaway.email'];
            const domain = email.split('@')[1].toLowerCase();
            if (spamDomains.includes(domain)) {
                alert('Please use a permanent email address.');
                return false;
            }
        }
        
        return true;
    }</script>
</Layout>
