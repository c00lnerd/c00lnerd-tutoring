---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Week 14 Quiz: miniAuto AI Vision and Advanced Features">
    <main style="min-height: 100vh; background: linear-gradient(135deg, #f3e5f5 0%, #ba68c8 100%); padding: 3rem 0;">
        <div style="max-width: 800px; margin: 0 auto; padding: 0 1rem;">
            <!-- Header -->
            <div style="text-align: center; margin-bottom: 2rem;">
                <div style="display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
                    <div style="background: #7b1fa2; color: white; border-radius: 50%; width: 4rem; height: 4rem; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.5rem; margin-right: 1rem;">Q14</div>
                    <div style="text-align: left;">
                        <h1 style="font-size: 2rem; font-weight: bold; color: var(--black); margin: 0;">Week 14 Quiz</h1>
                        <p style="color: var(--gray); margin: 0;">miniAuto AI Vision and Advanced Features</p>
                    </div>
                </div>
            </div>

            <!-- Quiz Form -->
            <div style="background: white; border-radius: 12px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); padding: 2rem;">
                <form id="week14Quiz" style="display: flex; flex-direction: column; gap: 2rem;">
                    <!-- Student Info -->
                    <div style="background: var(--gray-light); padding: 1.5rem; border-radius: 8px;">
                        <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--black); margin-bottom: 1rem;">Student Information</h3>
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem;">
                            <div>
                                <label style="display: block; font-weight: 500; color: var(--black); margin-bottom: 0.5rem;">Name:</label>
                                <input type="text" id="studentName" style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 6px; font-size: 1rem;" required>
                            </div>
                            <div>
                                <label style="display: block; font-weight: 500; color: var(--black); margin-bottom: 0.5rem;">Email:</label>
                                <input type="email" id="studentEmail" style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 6px; font-size: 1rem;" required>
                            </div>
                        </div>
                    </div>

                    <!-- Question 1 -->
                    <div style="border-left: 4px solid #7b1fa2; padding-left: 1.5rem;">
                        <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--black); margin-bottom: 0.75rem;">Question 1: Multiple Choice (2 points)</h3>
                        <p style="color: var(--gray); margin-bottom: 1rem;">What type of camera module is typically used in the miniAuto car for AI vision tasks?</p>
                        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q1" value="a" style="margin-right: 0.75rem;">
                                <span>A) USB webcam</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q1" value="b" style="margin-right: 0.75rem;">
                                <span>B) ESP32-CAM module</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q1" value="c" style="margin-right: 0.75rem;">
                                <span>C) Raspberry Pi camera</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q1" value="d" style="margin-right: 0.75rem;">
                                <span>D) Smartphone camera</span>
                            </label>
                        </div>
                    </div>

                    <!-- Question 2 -->
                    <div style="border-left: 4px solid #7b1fa2; padding-left: 1.5rem;">
                        <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--black); margin-bottom: 0.75rem;">Question 2: Multiple Choice (2 points)</h3>
                        <p style="color: var(--gray); margin-bottom: 1rem;">Which AI vision feature allows the miniAuto car to recognize and follow colored objects?</p>
                        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q2" value="a" style="margin-right: 0.75rem;">
                                <span>A) Face detection</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q2" value="b" style="margin-right: 0.75rem;">
                                <span>B) Color tracking</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q2" value="c" style="margin-right: 0.75rem;">
                                <span>C) Motion detection</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q2" value="d" style="margin-right: 0.75rem;">
                                <span>D) Edge detection</span>
                            </label>
                        </div>
                    </div>

                    <!-- Question 3 -->
                    <div style="border-left: 4px solid #7b1fa2; padding-left: 1.5rem;">
                        <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--black); margin-bottom: 0.75rem;">Question 3: Short Answer (3 points)</h3>
                        <p style="color: var(--gray); margin-bottom: 1rem;">Describe how the miniAuto car uses computer vision to navigate autonomously (mention at least 2 key components):</p>
                        <textarea id="q3" name="q3" rows="4" style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 6px; font-size: 0.9rem;" placeholder="Describe autonomous navigation using computer vision..."></textarea>
                    </div>

                    <!-- Question 4 -->
                    <div style="border-left: 4px solid #7b1fa2; padding-left: 1.5rem;">
                        <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--black); margin-bottom: 0.75rem;">Question 4: True/False (2 points)</h3>
                        <p style="color: var(--gray); margin-bottom: 1rem;">The miniAuto car can be programmed to recognize and respond to hand gestures using its camera.</p>
                        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q4" value="true" style="margin-right: 0.75rem;">
                                <span>True</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q4" value="false" style="margin-right: 0.75rem;">
                                <span>False</span>
                            </label>
                        </div>
                    </div>

                    <!-- Question 5 -->
                    <div style="border-left: 4px solid #7b1fa2; padding-left: 1.5rem;">
                        <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--black); margin-bottom: 0.75rem;">Question 5: Multiple Choice (1 point)</h3>
                        <p style="color: var(--gray); margin-bottom: 1rem;">What is the primary advantage of using AI vision over traditional sensors for robot navigation?</p>
                        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q5" value="a" style="margin-right: 0.75rem;">
                                <span>A) Lower cost</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q5" value="b" style="margin-right: 0.75rem;">
                                <span>B) Faster processing</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q5" value="c" style="margin-right: 0.75rem;">
                                <span>C) Rich environmental information and object recognition</span>
                            </label>
                            <label style="display: flex; align-items: center;">
                                <input type="radio" name="q5" value="d" style="margin-right: 0.75rem;">
                                <span>D) Less power consumption</span>
                            </label>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <div style="text-align: center; margin-top: 2rem;">
                        <button type="submit" style="background: #7b1fa2; color: white; padding: 1rem 2rem; border: none; border-radius: 8px; font-size: 1.1rem; font-weight: 600; cursor: pointer; transition: background-color 0.2s;">
                            Submit Quiz
                        </button>
                    </div>
                </form>

                <!-- Results Display -->
                <div id="quizResults" style="display: none; margin-top: 2rem; padding: 1.5rem; background: #f3e5f5; border-radius: 8px;">
                    <h3 style="font-size: 1.25rem; font-weight: bold; color: #4a148c; margin-bottom: 1rem;">Quiz Results</h3>
                    <div id="resultsContent"></div>
                </div>
            </div>

            <!-- Navigation -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 2rem;">
                <a href="/programming/lessons/week14" style="background: #7b1fa2; color: white; padding: 0.75rem 1.5rem; border-radius: 6px; text-decoration: none; transition: background-color 0.2s;">
                    ← Back to Lesson
                </a>
                <a href="/programming/semester1" style="background: var(--accent); color: white; padding: 0.75rem 1.5rem; border-radius: 6px; text-decoration: none; transition: background-color 0.2s;">
                    Semester Overview
                </a>
                <a href="/programming/lessons/week15" style="background: var(--accent-dark); color: white; padding: 0.75rem 1.5rem; border-radius: 6px; text-decoration: none; transition: background-color 0.2s;">
                    Next Lesson →
                </a>
            </div>
        </div>
    </main>

    <script is:inline>
        // Quiz answers and scoring
        const correctAnswers = {
            q1: 'b', // ESP32-CAM module
            q2: 'b', // Color tracking
            q4: 'true', // Hand gesture recognition
            q5: 'c'  // Rich environmental information and object recognition
        };

        const questionPoints = {
            q1: 2,
            q2: 2,
            q3: 3,
            q4: 2,
            q5: 1
        };

        // Load saved email
        document.addEventListener('DOMContentLoaded', function() {
            const savedEmail = localStorage.getItem('studentEmail');
            if (savedEmail) {
                document.getElementById('studentEmail').value = savedEmail;
            }
        });

        document.getElementById('week14Quiz').addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Save email to localStorage
            const email = document.getElementById('studentEmail').value;
            localStorage.setItem('studentEmail', email);
            
            // Calculate score
            let score = 0;
            let totalPoints = 10;
            let results = [];
            
            // Check multiple choice and true/false questions
            for (let qNum in correctAnswers) {
                const userAnswer = document.querySelector(`input[name="${qNum}"]:checked`)?.value;
                const isCorrect = userAnswer === correctAnswers[qNum];
                
                if (isCorrect) {
                    score += questionPoints[qNum];
                }
                
                results.push({
                    question: qNum,
                    userAnswer: userAnswer || 'No answer',
                    correctAnswer: correctAnswers[qNum],
                    isCorrect: isCorrect,
                    points: isCorrect ? questionPoints[qNum] : 0
                });
            }
            
            // Handle Question 3 (short answer) - give partial credit
            const q3Answer = document.getElementById('q3').value.toLowerCase();
            let q3Points = 0;
            let keyComponents = 0;
            
            if (q3Answer.includes('camera') || q3Answer.includes('vision')) keyComponents++;
            if (q3Answer.includes('sensor') || q3Answer.includes('ultrasonic')) keyComponents++;
            if (q3Answer.includes('color') || q3Answer.includes('tracking')) keyComponents++;
            if (q3Answer.includes('obstacle') || q3Answer.includes('detection')) keyComponents++;
            if (q3Answer.includes('navigation') || q3Answer.includes('autonomous')) keyComponents++;
            
            if (keyComponents >= 3) {
                q3Points = 3;
            } else if (keyComponents >= 2) {
                q3Points = 2;
            } else if (keyComponents >= 1) {
                q3Points = 1;
            }
            
            score += q3Points;
            results.push({
                question: 'q3',
                userAnswer: document.getElementById('q3').value || 'No answer',
                correctAnswer: 'Should mention camera/vision system, sensors for obstacle detection, color tracking, or autonomous navigation algorithms',
                isCorrect: q3Points === 3,
                points: q3Points
            });
            
            // Display results
            const percentage = Math.round((score / totalPoints) * 100);
            let grade = 'F';
            if (percentage >= 90) grade = 'A';
            else if (percentage >= 80) grade = 'B';
            else if (percentage >= 70) grade = 'C';
            else if (percentage >= 60) grade = 'D';
            
            const resultsHTML = `
                <div style="text-align: center; margin-bottom: 1rem;">
                    <div style="font-size: 2rem; font-weight: bold; color: #4a148c;">${score}/${totalPoints} (${percentage}%)</div>
                    <div style="font-size: 1.5rem; font-weight: bold; color: #4a148c;">Grade: ${grade}</div>
                </div>
                <div style="text-align: left;">
                    ${results.map(r => `
                        <div style="margin-bottom: 1rem; padding: 1rem; background: ${r.isCorrect ? '#e8f5e8' : '#ffeaea'}; border-radius: 6px;">
                            <strong>Question ${r.question.toUpperCase()}:</strong> ${r.isCorrect ? '✓' : '✗'} (${r.points} points)<br>
                            <strong>Your answer:</strong> ${r.userAnswer}<br>
                            <strong>Correct answer:</strong> ${r.correctAnswer}
                        </div>
                    `).join('')}
                </div>
            `;
            
            document.getElementById('resultsContent').innerHTML = resultsHTML;
            document.getElementById('quizResults').style.display = 'block';
            
            // Scroll to results
            document.getElementById('quizResults').scrollIntoView({ behavior: 'smooth' });
            
            // Send email notification
            const quizData = {
                studentName: document.getElementById('studentName').value,
                studentEmail: document.getElementById('studentEmail').value,
                week: 'Week 14',
                topic: 'miniAuto AI Vision and Advanced Features',
                score: score,
                totalPoints: totalPoints,
                percentage: percentage,
                grade: grade,
                results: results
            };
            
            // EmailJS configuration
            emailjs.init('ct_s19oZHppLy9BlW');
            
            emailjs.send('service_ot1jg6s', 'template_io02xtm', {
                to_email: 'chuck@c00lnerd.com',
                from_name: quizData.studentName,
                from_email: quizData.studentEmail,
                message: `WEEK 14 QUIZ RESULTS - BASIC MINIAUTO PROGRAMMING

Student Information:
• Name: ${quizData.studentName}
• Email: ${quizData.studentEmail}

Quiz Performance:
• Score: ${quizData.score}/${quizData.totalPoints} (${quizData.percentage}%)
• Topic: ${quizData.topic}
• Submission Date: ${new Date().toLocaleString()}

Student Responses:
${quizData.results.map(r => `• Question ${r.question.toUpperCase()}: ${r.userAnswer} ${r.isCorrect ? '✓' : '✗'}`).join('\n')}

Performance Analysis:
${quizData.percentage >= 80 ? '🎉 Excellent! Student demonstrates strong understanding of autonomous navigation and multi-sensor programming.' : 
  quizData.percentage >= 70 ? '👍 Good work! Student grasps miniAuto programming fundamentals but may need practice with state machines and sensor integration.' :
  quizData.percentage >= 60 ? '⚠️ Satisfactory. Student understands basics but needs more practice with advanced navigation algorithms and decision-making logic.' :
  '📚 Needs improvement. Recommend additional review of miniAuto library functions, autonomous behaviors, and robotics programming concepts.'}`,
                subject: `Week 14 Programming Quiz - ${quizData.studentName}`
            }).then(function(response) {
                console.log('Email sent successfully:', response);
            }).catch(function(error) {
                console.error('Email send failed:', error);
            });
        });
    </script>

    <!-- EmailJS SDK -->
    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
</Layout>
