  // Check for button press
  if (lastButtonState == HIGH && currentButtonState == LOW) {
    buttonPressed = true;
    Serial.println("Button pressed - Playing sound");
  }
  
  if (buttonPressed) {
    // Play a simple beep pattern
    playBeepPattern();
    buttonPressed = false;
