<code>{`// Multi-Sensor Integration System
#include <Wire.h>

// Ultrasonic sensor pins
const int trigPin = 9;
const int echoPin = 10;

// Temperature sensor (analog)
const int tempPin = A0;

// I2C accelerometer (example addresses)
const int ACCEL_ADDRESS = 0x53;

// Sensor data structure
struct SensorData {
  float distance;      // cm
  float temperature;   // Celsius
  int accelX, accelY, accelZ;  // acceleration values
  unsigned long timestamp;
};

void setup() {
  // Initialize serial communication
  Serial.begin(9600);
  
  // Initialize ultrasonic sensor
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);
  
  // Initialize I2C for accelerometer
  Wire.begin();
  
  // Initialize accelerometer (device-specific)
  initAccelerometer();
  
  Serial.println("Multi-Sensor System Initialized");
  Serial.println("Distance(cm), Temp(C), AccelX, AccelY, AccelZ");
}

void loop() {
  SensorData data;
  
  // Read all sensors
  data.distance = readUltrasonic();
  data.temperature = readTemperature();
  readAccelerometer(&data.accelX, &data.accelY, &data.accelZ);
  data.timestamp = millis();
  
  // Display sensor data
  displaySensorData(data);
  
  // Analyze sensor fusion
  analyzeSensorFusion(data);
  
  delay(500);  // Update every 500ms
}

float readUltrasonic() {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  
  long duration = pulseIn(echoPin, HIGH);
  float distance = duration * 0.0343 / 2;
  
  // Validate reading
  if (distance < 2 || distance > 400) {
    return -1;  // Invalid reading
  }
  return distance;
}

float readTemperature() {
  int sensorValue = analogRead(tempPin);
  // Convert to temperature (example for TMP36)
  float voltage = sensorValue * (5.0 / 1023.0);
  float temperature = (voltage - 0.5) * 100;
  return temperature;
}

void initAccelerometer() {
  // Example initialization for ADXL345
  Wire.beginTransmission(ACCEL_ADDRESS);
  Wire.write(0x2D);  // Power control register
  Wire.write(0x08);  // Enable measurement mode
  Wire.endTransmission();
}

void readAccelerometer(int* x, int* y, int* z) {
  Wire.beginTransmission(ACCEL_ADDRESS);
  Wire.write(0x32);  // Start reading from X-axis data register
  Wire.endTransmission();
  
  Wire.requestFrom(ACCEL_ADDRESS, 6);  // Request 6 bytes
  
  if (Wire.available() >= 6) {
    *x = Wire.read() | (Wire.read() << 8);
    *y = Wire.read() | (Wire.read() << 8);
    *z = Wire.read() | (Wire.read() << 8);
  }
}

void displaySensorData(SensorData data) {
  Serial.print(data.distance);
  Serial.print(", ");
  Serial.print(data.temperature);
  Serial.print(", ");
  Serial.print(data.accelX);
  Serial.print(", ");
  Serial.print(data.accelY);
  Serial.print(", ");
  Serial.println(data.accelZ);
}

void analyzeSensorFusion(SensorData data) {
  // Example sensor fusion logic
  
  // Detect motion using accelerometer
  int totalAccel = abs(data.accelX) + abs(data.accelY) + abs(data.accelZ);
  bool isMoving = totalAccel > 1000;  // Threshold for movement
  
  // Combine with distance for obstacle detection
  if (data.distance > 0 && data.distance < 20 && isMoving) {
    Serial.println("WARNING: Moving toward obstacle!");
  }
  
  // Temperature-based alerts
  if (data.temperature > 30) {
    Serial.println("ALERT: High temperature detected");
  }
  
  // Multi-sensor status
  if (data.distance > 0 && !isMoving && data.temperature < 25) {
    Serial.println("STATUS: All systems normal");
  }
}`}</code>
