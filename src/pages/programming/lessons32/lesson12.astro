                            <li><strong>Front Left Motor:</strong> PWM Pin 5, Direction Pin 4</li>
                            <li><strong>Front Right Motor:</strong> PWM Pin 6, Direction Pin 7</li>
                            <li><strong>Rear Left Motor:</strong> PWM Pin 9, Direction Pin 8</li>
                            <li><strong>Rear Right Motor:</strong> PWM Pin 10, Direction Pin 11</li>
                        </ul>
                    </div>
                </div>
