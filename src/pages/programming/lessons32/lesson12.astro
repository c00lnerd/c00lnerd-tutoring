            <!-- Section 1: Ultrasonic Sensor Fundamentals -->
            <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
                <h2 class="text-2xl font-bold text-cyan-800 mb-6">🔊 Section 1: Ultrasonic Sensor Fundamentals</h2>
                
                <div style="margin-bottom: 1.5rem;">
                    <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">How Ultrasonic Sensors Work</h3>
                    <p style="color: #4a5568; line-height: 1.6; margin-bottom: 1rem;">
                        Ultrasonic sensors use high-frequency sound waves to measure distance. They work like 
                        sonar systems - sending out sound pulses and measuring the time for echoes to return.
                    </p>
                    
                    <div style="background: #edf2f7; padding: 1.5rem; border-radius: 8px; margin-bottom: 1.5rem;">
                        <h4 style="color: #2d3748; font-weight: bold; margin-bottom: 1rem;">HC-SR04 Specifications:</h4>
                        <ul style="list-style: none; padding: 0; margin: 0; color: #4a5568; line-height: 1.8;">
                            <li><strong>Range:</strong> 2cm to 400cm</li>
                            <li><strong>Accuracy:</strong> ±3mm</li>
                            <li><strong>Frequency:</strong> 40kHz ultrasonic</li>
                            <li><strong>Distance Formula:</strong> Distance = (Time × 0.0343) ÷ 2</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Section 2: Basic Distance Measurement -->
            <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
                <h2 class="text-2xl font-bold text-cyan-800 mb-6">📏 Section 2: Basic Distance Measurement</h2>
                
                <div style="margin-bottom: 1.5rem;">
                    <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">Simple Distance Reading</h3>
                    <p style="color: #4a5568; line-height: 1.6; margin-bottom: 1rem;">
                        Basic program to read distance from an HC-SR04 sensor:
                    </p>
                    
                    <div style="position: relative;">
                        <button onclick="copyCode(this)" style="position: absolute; top: 8px; right: 8px; background-color: #2563eb; color: white; border: none; padding: 4px 8px; border-radius: 4px; cursor: pointer; font-size: 12px; z-index: 10;">📋 Copy</button>
                        <pre style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 6px; overflow-x: auto; font-family: 'Courier New', monospace; margin: 1rem 0;"><code>{`// Basic HC-SR04 Distance Measurement
const int trigPin = 9;    // Trigger pin
const int echoPin = 10;   // Echo pin

long duration;
int distance;

void setup() {
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);
  Serial.begin(9600);
  Serial.println("HC-SR04 Distance Sensor");
}

void loop() {
  // Clear trigger
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  
  // Send 10µs pulse
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  
  // Read echo duration
  duration = pulseIn(echoPin, HIGH);
  
  // Calculate distance
  distance = duration * 0.0343 / 2;
  
  Serial.print("Distance: ");
  Serial.print(distance);
  Serial.println(" cm");
  
  delay(500);
}`}</code></pre>
                    </div>
                </div>
            </div>

            <!-- Section 3: Obstacle Detection -->
            <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
                <h2 class="text-2xl font-bold text-cyan-800 mb-6">🚧 Section 3: Obstacle Detection</h2>
                
