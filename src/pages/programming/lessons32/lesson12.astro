                    <p style="color: #4a5568; line-height: 1.6; margin-bottom: 1rem;">
                        First, let's set up the basic motor control functions for the miniAuto:
                    </p>
                    
                    <div style="position: relative;">
                        <button onclick="copyCode(this)" style="position: absolute; top: 8px; right: 8px; background-color: #2563eb; color: white; border: none; padding: 4px 8px; border-radius: 4px; cursor: pointer; font-size: 12px; z-index: 10;">📋 Copy</button>
                        <pre style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 6px; overflow-x: auto; font-family: 'Courier New', monospace; margin: 1rem 0;"><code>{`// miniAuto Basic Movement Setup
// Motor pin definitions
const int FL_PWM = 5;   // Front Left PWM
const int FL_DIR = 4;   // Front Left Direction
const int FR_PWM = 6;   // Front Right PWM  
const int FR_DIR = 7;   // Front Right Direction
const int RL_PWM = 9;   // Rear Left PWM
const int RL_DIR = 8;   // Rear Left Direction
const int RR_PWM = 10;  // Rear Right PWM
const int RR_DIR = 11;  // Rear Right Direction

void setup() {
  // Set all motor pins as outputs
  pinMode(FL_PWM, OUTPUT);
  pinMode(FL_DIR, OUTPUT);
  pinMode(FR_PWM, OUTPUT);
  pinMode(FR_DIR, OUTPUT);
  pinMode(RL_PWM, OUTPUT);
  pinMode(RL_DIR, OUTPUT);
  pinMode(RR_PWM, OUTPUT);
  pinMode(RR_DIR, OUTPUT);
  
  Serial.begin(9600);
  Serial.println("miniAuto Movement System Ready");
  
  // Stop all motors initially
  stopMotors();
}

void stopMotors() {
  analogWrite(FL_PWM, 0);
  analogWrite(FR_PWM, 0);
  analogWrite(RL_PWM, 0);
  analogWrite(RR_PWM, 0);
}`}</code></pre>
                    </div>
                </div>
