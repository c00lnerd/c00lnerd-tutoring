                    <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">Obstacle Detection System</h3>
                    <p style="color: #4a5568; line-height: 1.6; margin-bottom: 1rem;">
                        Combine sensors with LEDs and buzzers for obstacle alerts:
                    </p>
                    
                    <div style="position: relative;">
                        <button onclick="copyCode(this)" style="position: absolute; top: 8px; right: 8px; background-color: #2563eb; color: white; border: none; padding: 4px 8px; border-radius: 4px; cursor: pointer; font-size: 12px; z-index: 10;">📋 Copy</button>
                        <pre style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 6px; overflow-x: auto; font-family: 'Courier New', monospace; margin: 1rem 0;"><code>{`// Obstacle Detection System
const int trigPin = 9;
const int echoPin = 10;
const int redLED = 13;
const int yellowLED = 12;
const int greenLED = 11;
const int buzzer = 8;

void setup() {
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);
  pinMode(redLED, OUTPUT);
  pinMode(yellowLED, OUTPUT);
  pinMode(greenLED, OUTPUT);
  pinMode(buzzer, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  int distance = getDistance();
  
  // Turn off all LEDs
  digitalWrite(redLED, LOW);
  digitalWrite(yellowLED, LOW);
  digitalWrite(greenLED, LOW);
  noTone(buzzer);
  
  if (distance <= 10) {
    // DANGER
    digitalWrite(redLED, HIGH);
    tone(buzzer, 1000);
    Serial.println("DANGER - Very close!");
  } else if (distance <= 30) {
    // WARNING
    digitalWrite(yellowLED, HIGH);
    tone(buzzer, 500);
    Serial.println("WARNING - Obstacle detected");
  } else {
    // SAFE
    digitalWrite(greenLED, HIGH);
    Serial.println("SAFE - Path clear");
  }
  
  delay(200);
}

int getDistance() {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  
  long duration = pulseIn(echoPin, HIGH);
  return duration * 0.0343 / 2;
}`}</code></pre>
                    </div>
                </div>
