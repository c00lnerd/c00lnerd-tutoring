<code>{`// Obstacle Avoidance Program
#include "Ultrasound.h"

Ultrasound ultrasound;                // Ultrasound sensor object
const static uint8_t keyPin = 3;     // Button pin
const static uint8_t pwm_min = 50;   // Minimum PWM value
const static uint8_t motorpwmPin[4] = {10, 9, 6, 11};        // Motor PWM pins
const static uint8_t motordirectionPin[4] = {12, 8, 7, 13};  // Motor direction pins
bool keyState;                        // Button state detection
bool taskStart = 0;                   // Task start flag
uint16_t dis;                         // Distance variable

void setup() {
  Serial.begin(9600);                 // Initialize serial communication
  Serial.setTimeout(500);             // Set serial timeout
  pinMode(keyPin, INPUT);             // Configure button as input
  Motor_Init();                       // Initialize motors
  printf("2");                        // Debug output
}

void loop() {
  keyState = analogRead(keyPin);      // Read button state
  printf("111");                      // Debug output
  
  if(!keyState) taskStart = 1;        // Start task when button pressed
  
  if(taskStart) {
    ultrasonic_distance();            // Update RGB LED
    dis = ultrasonic_distance();      // Get distance reading
    
    Velocity_Controller(0, 100, 0, 0); // Move forward by default
    
    // Obstacle avoidance logic
    while(dis < 300) {
      dis = ultrasonic_distance();    // Keep checking distance
      Velocity_Controller(0, 0, -100, 0); // Turn right to avoid obstacle
    }
  }
}

// Ultrasonic distance measurement with RGB control
uint16_t ultrasonic_distance(){
  uint8_t s;
  uint16_t distance = Filter();       // Get filtered distance
  Serial.print("Distance: ");
  Serial.print(distance);
  Serial.println(" mm");
  
  // RGB LED feedback based on distance
  if (distance > 0 && distance <= 80){
    ultrasound.Breathing(1, 0, 0, 1, 0, 0);  // Red breathing light
  }
  else if (distance > 80 && distance <= 180){
    s = map(distance, 80, 180, 0, 255);
    ultrasound.Color((255-s), 0, 0, (255-s), 0, 0);  // Red gradient
  }
  else if (distance > 180 && distance <= 320){
    s = map(distance, 180, 320, 0, 255);
    ultrasound.Color(0, 0, s, 0, 0, s);  // Blue gradient
  }
  else if (distance > 320 && distance <= 500){
    s = map(distance, 320, 500, 0, 255);
    ultrasound.Color(0, s, 255-s, 0, s, 255-s);  // Green gradient
  }
  else if (distance > 500){
    ultrasound.Color(0, 255, 0, 0, 255, 0);  // Solid green
  }
  
  return distance;
}

// Motor initialization function
void Motor_Init(){
  for(int i = 0; i < 4; i++){
    pinMode(motorpwmPin[i], OUTPUT);
    pinMode(motordirectionPin[i], OUTPUT);
  }
}

// Velocity controller for mecanum wheel movement
void Velocity_Controller(uint16_t angle, uint8_t velocity, int8_t rot, bool drift) {
  int8_t velocity_0, velocity_1, velocity_2, velocity_3;
  float speed = 1;
  
  angle += 90;
  float rad = angle * PI / 180;
  
  if (rot == 0) speed = 1;            // Speed factor
  else speed = 0.5;
  
  velocity /= sqrt(2);
  
  if (drift) {
    velocity_0 = (velocity * sin(rad) - velocity * cos(rad)) * speed;
    velocity_1 = (velocity * sin(rad) + velocity * cos(rad)) * speed;
    velocity_2 = (velocity * sin(rad) - velocity * cos(rad)) * speed - rot * speed * 2;
    velocity_3 = (velocity * sin(rad) + velocity * cos(rad)) * speed + rot * speed * 2;
  } else {
    velocity_0 = (velocity * sin(rad) - velocity * cos(rad)) * speed + rot * speed;
    velocity_1 = (velocity * sin(rad) + velocity * cos(rad)) * speed - rot * speed;
    velocity_2 = (velocity * sin(rad) - velocity * cos(rad)) * speed - rot * speed;
    velocity_3 = (velocity * sin(rad) + velocity * cos(rad)) * speed + rot * speed;
  }
  
  Motors_Set(velocity_0, velocity_1, velocity_2, velocity_3);
}

// Motor control function with PWM
void Motors_Set(int8_t Motor_0, int8_t Motor_1, int8_t Motor_2, int8_t Motor_3) {
  int8_t pwm_set[4];
  int8_t motors[4] = {Motor_0, Motor_1, Motor_2, Motor_3};
  bool direction[4] = {1, 0, 0, 1};   // Forward direction mapping
  
  for(uint8_t i = 0; i < 4; ++i) {
    if(motors[i] < 0) direction[i] = !direction[i];
    else direction[i] = direction[i];
    
    if(motors[i] == 0) pwm_set[i] = 0;
    else pwm_set[i] = map(abs(motors[i]), 0, 100, pwm_min, 255);
    
    digitalWrite(motordirectionPin[i], direction[i]);
    analogWrite(motorpwmPin[i], pwm_set[i]);
  }
}`}</code>
