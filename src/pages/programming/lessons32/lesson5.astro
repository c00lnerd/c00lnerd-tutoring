---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Lesson 5: Arduino Hardware Basics">
    <main class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 py-12">
        <div class="container mx-auto px-4 max-w-4xl">
            <div class="text-center mb-8">
                <div class="flex items-center justify-center mb-4">
                    <div class="bg-blue-500 text-white rounded-full w-16 h-16 flex items-center justify-center font-bold text-2xl mr-4">5</div>
                    <div class="text-left">
                        <h1 class="text-3xl font-bold text-gray-800">Lesson 5: Arduino Hardware Basics</h1>
                        <p class="text-gray-600">Learn the parts, connections, and safety habits that make Arduino projects work</p>
                        <p class="text-sm text-blue-600 font-medium">32-Lesson Course • Semester 1</p>
                    </div>
                </div>
            </div>

            <div class="bg-blue-50 border-l-4 border-blue-500 p-4 rounded-lg mb-8">
                <p class="text-blue-900 font-medium">Lesson 4 taught you how functions organize code. In Lesson 5, you will connect that code to the real Arduino board, the breadboard, LEDs, buttons, resistors, and jumper wires.</p>
            </div>

            <section class="bg-white rounded-xl shadow-lg p-8 mb-8">
                <h2 class="text-2xl font-bold text-blue-600 mb-4">Learning Objectives</h2>
                <div class="grid md:grid-cols-2 gap-8">
                    <div>
                        <h3 class="text-xl font-semibold text-gray-800 mb-3">By the end of this lesson, you will:</h3>
                        <ul class="space-y-3 text-gray-700">
                            <li>Identify the main hardware parts used in simple Arduino projects</li>
                            <li>Understand the job of the Arduino board, breadboard, resistor, LED, button, and jumper wire</li>
                            <li>Read a very simple circuit layout and build it carefully</li>
                            <li>Use safe wiring habits before uploading code</li>
                            <li>Connect hardware ideas to code you already know from earlier lessons</li>
                        </ul>
                    </div>
                    <div>
                        <h3 class="text-xl font-semibold text-gray-800 mb-3">Key ideas:</h3>
                        <ul class="space-y-3 text-gray-700">
                            <li>Power and ground make the circuit possible</li>
                            <li>Components each have a specific job</li>
                            <li>Resistors protect parts by limiting current</li>
                            <li>Digital pins can send or read simple HIGH and LOW signals</li>
                            <li>Careful wiring prevents confusing bugs</li>
                        </ul>
                    </div>
                </div>
            </section>

            <section class="bg-white rounded-xl shadow-lg p-8 mb-8">
                <h2 class="text-2xl font-bold text-blue-600 mb-4">What Hardware Do We Need?</h2>
                <p class="text-gray-700 mb-4">Before a program can blink an LED or read a button, the Arduino needs real parts connected correctly. Think of the code as instructions and the hardware as the parts that carry out those instructions.</p>
                <div class="grid md:grid-cols-2 gap-6">
                    <div class="bg-slate-50 p-5 rounded-lg">
                        <h3 class="text-lg font-semibold text-gray-800 mb-2">Arduino Uno</h3>
                        <p class="text-gray-700">The Arduino board runs your program. It sends power, reads inputs, and controls outputs through its pins.</p>
                    </div>
                    <div class="bg-slate-50 p-5 rounded-lg">
                        <h3 class="text-lg font-semibold text-gray-800 mb-2">Breadboard</h3>
                        <p class="text-gray-700">A breadboard lets you connect parts without soldering. It helps you build and change circuits quickly.</p>
                    </div>
                    <div class="bg-slate-50 p-5 rounded-lg">
                        <h3 class="text-lg font-semibold text-gray-800 mb-2">Jumper Wires</h3>
                        <p class="text-gray-700">These wires carry electricity between the Arduino, breadboard, and components.</p>
                    </div>
                    <div class="bg-slate-50 p-5 rounded-lg">
                        <h3 class="text-lg font-semibold text-gray-800 mb-2">LED</h3>
                        <p class="text-gray-700">An LED lights up when current flows the correct way through it. It is one of the easiest outputs to test.</p>
                    </div>
                    <div class="bg-slate-50 p-5 rounded-lg">
                        <h3 class="text-lg font-semibold text-gray-800 mb-2">Resistor</h3>
                        <p class="text-gray-700">A resistor limits current. Without one, you can damage an LED or stress an Arduino pin.</p>
                    </div>
                    <div class="bg-slate-50 p-5 rounded-lg">
                        <h3 class="text-lg font-semibold text-gray-800 mb-2">Pushbutton</h3>
                        <p class="text-gray-700">A pushbutton gives you a simple input. Pressed and not pressed become values your program can read.</p>
                    </div>
                </div>
            </section>

            <section class="bg-white rounded-xl shadow-lg p-8 mb-8">
                <h2 class="text-2xl font-bold text-blue-600 mb-4">Power, Ground, and Pins</h2>
                <p class="text-gray-700 mb-4">Most beginner wiring problems come from forgetting one of these three things: a power connection, a ground connection, or the correct pin number in the code.</p>
                <div class="grid md:grid-cols-3 gap-4 mb-6">
                    <div class="bg-green-50 border border-green-200 p-4 rounded-lg">
                        <h3 class="text-lg font-semibold text-green-800 mb-2">5V</h3>
                        <p class="text-green-900">Provides power to parts that need voltage from the board.</p>
                    </div>
                    <div class="bg-gray-100 border border-gray-300 p-4 rounded-lg">
                        <h3 class="text-lg font-semibold text-gray-800 mb-2">GND</h3>
                        <p class="text-gray-700">Ground gives electricity a return path. Many circuits fail if ground is missing.</p>
                    </div>
                    <div class="bg-blue-50 border border-blue-200 p-4 rounded-lg">
                        <h3 class="text-lg font-semibold text-blue-800 mb-2">Digital Pins</h3>
                        <p class="text-blue-900">Pins like `2`, `7`, or `13` can be used for simple on/off signals.</p>
                    </div>
                </div>
                <div class="bg-amber-50 border-l-4 border-amber-400 p-4 rounded-lg text-amber-900">
                    Match your code to your wiring. If the LED wire is on pin `8`, your code should not say `13`.
                </div>
            </section>

            <section class="bg-white rounded-xl shadow-lg p-8 mb-8">
                <h2 class="text-2xl font-bold text-blue-600 mb-4">LED Safety and Resistors</h2>
                <p class="text-gray-700 mb-4">LEDs are polarized, which means direction matters. The longer leg is usually the positive side. The shorter leg is usually the negative side. A resistor should be in series with the LED to limit current.</p>
                <div class="bg-red-50 border-l-4 border-red-400 p-4 rounded-lg mb-6">
                    <h3 class="text-lg font-semibold text-red-800 mb-2">Safety rule</h3>
                    <p class="text-red-900">Do not connect an LED directly from an Arduino output pin to ground without a resistor.</p>
                </div>
                <div class="grid md:grid-cols-2 gap-6">
                    <div class="bg-slate-50 p-5 rounded-lg">
                        <h3 class="text-lg font-semibold text-gray-800 mb-2">Common resistor values</h3>
                        <ul class="space-y-2 text-gray-700">
                            <li>`220Ω` for a bright, common LED setup</li>
                            <li>`330Ω` for a slightly dimmer but very safe setup</li>
                            <li>Either value is a good beginner choice</li>
                        </ul>
                    </div>
                    <div class="bg-slate-50 p-5 rounded-lg">
                        <h3 class="text-lg font-semibold text-gray-800 mb-2">Simple LED path</h3>
                        <p class="text-gray-700">Arduino pin → resistor → LED → ground</p>
                    </div>
                </div>
            </section>

            <section class="bg-white rounded-xl shadow-lg p-8 mb-8">
                <h2 class="text-2xl font-bold text-blue-600 mb-4">Your First Real Hardware Output</h2>
                <p class="text-gray-700 mb-4">This example uses an external LED. It is very similar to the built-in blink idea, but now you are practicing wiring too.</p>
                <div class="bg-blue-50 p-4 rounded-lg mb-4 text-blue-900">
                    Wiring: connect a jumper wire from digital pin `8` to a resistor, then to the long leg of the LED. Connect the short leg of the LED to ground.
                </div>
                <div class="relative">
                    <button onclick="copyCode(this)" class="absolute top-2 right-2 bg-blue-600 hover:bg-blue-700 text-white text-xs px-2 py-1 rounded transition-colors duration-200">
                        📋 Copy
                    </button>
                    <pre style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 6px; overflow-x: auto; font-family: 'Courier New', monospace; margin: 1rem 0;"><code>{`const int ledPin = 8;

void setup() {
  pinMode(ledPin, OUTPUT);
}

void loop() {
  digitalWrite(ledPin, HIGH);
  delay(1000);
  digitalWrite(ledPin, LOW);
  delay(1000);
}`}</code></pre>
                </div>
                <p class="text-gray-700">If the LED does not blink, check three things first: resistor present, LED direction correct, and wire actually on pin `8`.</p>
            </section>

            <section class="bg-white rounded-xl shadow-lg p-8 mb-8">
                <h2 class="text-2xl font-bold text-blue-600 mb-4">Reading a Button</h2>
                <p class="text-gray-700 mb-4">An Arduino program becomes much more interesting when it can read an input. A pushbutton lets your code react to something happening in the real world.</p>
                <div class="bg-slate-50 p-5 rounded-lg mb-4">
                    <h3 class="text-lg font-semibold text-gray-800 mb-2">What the button does</h3>
                    <p class="text-gray-700">When you press the button, the circuit changes state. Your code can read that state with `digitalRead()` and decide what to do next.</p>
                </div>
                <div class="bg-blue-50 p-4 rounded-lg mb-4 text-blue-900">
                    Beginner setup: use a button on digital pin `2` and an LED on pin `8`. A common approach is to use `INPUT_PULLUP` so you do not need an extra pull-down resistor.
                </div>
                <div class="relative">
                    <button onclick="copyCode(this)" class="absolute top-2 right-2 bg-blue-600 hover:bg-blue-700 text-white text-xs px-2 py-1 rounded transition-colors duration-200">
                        📋 Copy
                    </button>
                    <pre style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 6px; overflow-x: auto; font-family: 'Courier New', monospace; margin: 1rem 0;"><code>{`const int ledPin = 8;
const int buttonPin = 2;

void setup() {
  pinMode(ledPin, OUTPUT);
  pinMode(buttonPin, INPUT_PULLUP);
}

void loop() {
  int buttonState = digitalRead(buttonPin);

  if (buttonState == LOW) {
    digitalWrite(ledPin, HIGH);
  } else {
    digitalWrite(ledPin, LOW);
  }
}`}</code></pre>
                </div>
                <p class="text-gray-700">With `INPUT_PULLUP`, pressed usually reads as `LOW` and not pressed usually reads as `HIGH`. That feels backward at first, so read the code carefully.</p>
            </section>

            <section class="bg-white rounded-xl shadow-lg p-8 mb-8">
                <h2 class="text-2xl font-bold text-blue-600 mb-4">Using Functions with Hardware</h2>
                <p class="text-gray-700 mb-4">Lesson 4 introduced functions. Now you can use them to make hardware programs easier to read. Instead of putting every line inside `loop()`, you can break the program into clear jobs.</p>
                <div class="relative">
                    <button onclick="copyCode(this)" class="absolute top-2 right-2 bg-blue-600 hover:bg-blue-700 text-white text-xs px-2 py-1 rounded transition-colors duration-200">
                        📋 Copy
                    </button>
                    <pre style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 6px; overflow-x: auto; font-family: 'Courier New', monospace; margin: 1rem 0;"><code>{`const int ledPin = 8;
const int buttonPin = 2;

void setup() {
  pinMode(ledPin, OUTPUT);
  pinMode(buttonPin, INPUT_PULLUP);
}

void loop() {
  checkButton();
}

void checkButton() {
  int buttonState = digitalRead(buttonPin);

  if (buttonState == LOW) {
    turnLedOn();
  } else {
    turnLedOff();
  }
}

void turnLedOn() {
  digitalWrite(ledPin, HIGH);
}

void turnLedOff() {
  digitalWrite(ledPin, LOW);
}`}</code></pre>
                </div>
                <p class="text-gray-700">This code does the same job, but the function names explain the program much more clearly.</p>
            </section>

            <section class="bg-white rounded-xl shadow-lg p-8 mb-8">
                <h2 class="text-2xl font-bold text-blue-600 mb-4">Hardware Checklist Before Uploading</h2>
                <div class="grid md:grid-cols-2 gap-6">
                    <div class="bg-green-50 p-5 rounded-lg">
                        <h3 class="text-lg font-semibold text-green-800 mb-3">Check your circuit</h3>
                        <ul class="space-y-2 text-green-900">
                            <li>Ground connected where it should be</li>
                            <li>Power wire in the correct rail or pin</li>
                            <li>LED facing the correct direction</li>
                            <li>Resistor included with the LED</li>
                            <li>Button placed across the breadboard gap correctly</li>
                        </ul>
                    </div>
                    <div class="bg-amber-50 p-5 rounded-lg">
                        <h3 class="text-lg font-semibold text-amber-800 mb-3">Check your code</h3>
                        <ul class="space-y-2 text-amber-900">
                            <li>Pin numbers match the wires</li>
                            <li>`pinMode()` is set correctly</li>
                            <li>`digitalWrite()` is only used on output pins</li>
                            <li>`digitalRead()` is used for the button pin</li>
                            <li>Functions have clear names and do one small job</li>
                        </ul>
                    </div>
                </div>
            </section>

            <section class="bg-white rounded-xl shadow-lg p-8 mb-8">
                <h2 class="text-2xl font-bold text-blue-600 mb-4">Hands-On Activity: Build a Button-Controlled LED</h2>
                <p class="text-gray-700 mb-4">Build a simple circuit where pressing a button turns on an LED. Then improve the code by organizing it with functions.</p>
                <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded-lg mb-6">
                    <h3 class="text-lg font-semibold text-yellow-800 mb-2">Required parts</h3>
                    <ul class="space-y-2 text-yellow-900">
                        <li>Arduino Uno</li>
                        <li>Breadboard</li>
                        <li>1 LED</li>
                        <li>1 resistor (`220Ω` or `330Ω`)</li>
                        <li>1 pushbutton</li>
                        <li>Jumper wires</li>
                    </ul>
                </div>
                <div class="bg-slate-50 p-5 rounded-lg mb-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Activity steps</h3>
                    <ol class="space-y-2 text-gray-700 list-decimal list-inside">
                        <li>Place the LED and resistor on the breadboard</li>
                        <li>Wire the LED to digital pin `8` and ground</li>
                        <li>Place the button on the breadboard</li>
                        <li>Wire the button to digital pin `2` and ground</li>
                        <li>Use `INPUT_PULLUP` in the code</li>
                        <li>Test the circuit</li>
                        <li>Refactor the program using functions like `checkButton()`, `turnLedOn()`, and `turnLedOff()`</li>
                    </ol>
                </div>
                <div class="bg-blue-50 p-4 rounded-lg text-blue-900">
                    Extension: make the LED blink three times when the button is pressed by writing a new function such as `blinkLedThreeTimes()`.
                </div>
            </section>

            <section class="bg-white rounded-xl shadow-lg p-8 mb-8">
                <h2 class="text-2xl font-bold text-blue-600 mb-4">Assessment and Homework</h2>
                <div class="grid md:grid-cols-2 gap-8 mb-6">
                    <div>
                        <h3 class="text-xl font-semibold text-gray-800 mb-3">Lesson 5 quiz topics</h3>
                        <ul class="space-y-2 text-gray-700">
                            <li>Main Arduino hardware parts</li>
                            <li>Power, ground, and digital pins</li>
                            <li>LED direction and resistor purpose</li>
                            <li>Button input basics</li>
                            <li>Using functions in simple hardware programs</li>
                        </ul>
                    </div>
                    <div>
                        <h3 class="text-xl font-semibold text-gray-800 mb-3">Homework ideas</h3>
                        <ul class="space-y-2 text-gray-700">
                            <li>Rebuild the button-controlled LED from memory</li>
                            <li>Label the job of each part in your circuit</li>
                            <li>Write one version of the code without functions and one with functions</li>
                            <li>Practice checking wiring before every upload</li>
                        </ul>
                    </div>
                </div>
                <div class="bg-green-50 p-4 rounded-lg text-green-900">
                    Success in hardware work comes from patience. When something fails, check the wiring, the resistor, the LED direction, and the pin numbers before changing lots of code.
                </div>
            </section>

            <div class="flex justify-between items-center mt-8">
                <div>
                    <a href="/programming/lessons32/Lesson4" style="background-color: #6b7280; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #4b5563; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#4b5563'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#6b7280'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                        ← Previous: Lesson 4
                    </a>
                </div>
                <div class="text-center">
                    <a href="/programming/quizzes32/Lesson5" style="background-color: #7c3aed; color: white; padding: 10px 16px; border-radius: 6px; text-decoration: none; font-weight: 500; border: 2px solid #6d28d9; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#6d28d9'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#7c3aed'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                        Take Quiz 📝
                    </a>
                </div>
                <div>
                    <a href="/programming/lessons32/Lesson6" style="background-color: #2563eb; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #1d4ed8; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#1d4ed8'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#2563eb'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                        Next: Lesson 6 →
                    </a>
                </div>
            </div>
        </div>
    </main>
</Layout>

<script>
declare global {
    interface Window {
        copyCode: (button: HTMLButtonElement) => void;
    }
}

const lesson5Window = window as Window & typeof globalThis;

lesson5Window.copyCode = function(button: HTMLButtonElement) {
    try {
        const parentElement = button.parentElement;
        if (!parentElement) {
            showCopyFeedback(button, false);
            return;
        }

        const codeElement = parentElement.querySelector('code');
        if (!codeElement) {
            showCopyFeedback(button, false);
            return;
        }

        const codeText = codeElement.textContent || codeElement.innerText;

        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(codeText).then(() => {
                showCopyFeedback(button, true);
            }).catch(() => {
                fallbackCopy(codeText, button);
            });
        } else {
            fallbackCopy(codeText, button);
        }
    } catch (err) {
        showCopyFeedback(button, false);
    }
};

function fallbackCopy(text: string, button: HTMLButtonElement) {
    try {
        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.position = 'absolute';
        textarea.style.left = '-9999px';
        textarea.style.top = '0';
        textarea.setAttribute('readonly', '');
        document.body.appendChild(textarea);

        textarea.select();
        textarea.setSelectionRange(0, 99999);

        const successful = document.execCommand('copy');
        document.body.removeChild(textarea);

        showCopyFeedback(button, successful);
    } catch (err) {
        showCopyFeedback(button, false);
    }
}

function showCopyFeedback(button: HTMLButtonElement, success: boolean) {
    const originalText = button.textContent;
    const originalBg = button.style.backgroundColor;

    if (success) {
        button.textContent = '✅ Copied!';
        button.style.backgroundColor = '#10b981';
    } else {
        button.textContent = '❌ Failed';
        button.style.backgroundColor = '#dc2626';
    }

    setTimeout((): void => {
        button.textContent = originalText;
        button.style.backgroundColor = originalBg || '#2563eb';
    }, 2000);
}
</script>
