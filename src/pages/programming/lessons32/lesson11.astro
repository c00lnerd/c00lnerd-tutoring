---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Lesson 11: miniAuto Assembly and Construction - C00lnerd Tutoring">
    <div style="max-width: 1000px; margin: 0 auto; padding: 2rem;">
        
        <!-- Header -->
        <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 3rem; border-radius: 15px; margin-bottom: 2rem; text-align: center;">
            <h1 style="font-size: 2.5rem; font-weight: bold; margin: 0 0 1rem 0;">Lesson 11: miniAuto Assembly and Construction</h1>
            <p style="font-size: 1.2rem; margin: 0 0 1rem 0; opacity: 0.9;">Building Your Complete Arduino Robot Car</p>
            <div style="background: rgba(255,255,255,0.1); padding: 1rem; border-radius: 8px; margin-top: 1.5rem;">
                <p style="margin: 0 0 0.5rem 0; font-weight: 600;">📖 Official Assembly Guide:</p>
                <a href="https://wiki.hiwonder.com/projects/miniAuto/en/latest/index.html" target="_blank" style="color: #fbbf24; text-decoration: underline; font-weight: 500;">Hiwonder miniAuto Wiki Documentation →</a>
            </div>
        </div>

        <!-- Learning Objectives -->
        <div style="background: white; padding: 2rem; border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-bottom: 2rem;">
            <h2 style="color: #667eea; font-size: 1.8rem; font-weight: bold; margin-bottom: 1.5rem;">🎯 Learning Objectives</h2>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
                <div>
                    <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">Assembly Goals:</h3>
                    <ul style="list-style: none; padding: 0; margin: 0; color: #4a5568; line-height: 1.8;">
                        <li>• Assemble complete miniAuto robot car</li>
                        <li>• Connect all sensors and actuators</li>
                        <li>• Test individual components</li>
                        <li>• Troubleshoot common issues</li>
                    </ul>
                </div>
                <div>
                    <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">Skills Developed:</h3>
                    <ul style="list-style: none; padding: 0; margin: 0; color: #4a5568; line-height: 1.8;">
                        <li>• Mechanical assembly</li>
                        <li>• Electrical wiring</li>
                        <li>• System integration</li>
                        <li>• Problem-solving</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Section 1: Parts Inventory -->
        <div style="background: white; padding: 2rem; border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-bottom: 2rem;">
            <h2 style="color: #667eea; font-size: 1.8rem; font-weight: bold; margin-bottom: 1.5rem;">📦 Section 1: Parts Inventory</h2>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
                <div style="background: #e6fffa; padding: 1.5rem; border-radius: 8px;">
                    <h4 style="color: #2d3748; font-weight: bold; margin-bottom: 1rem;">Electronic Components:</h4>
                    <ul style="list-style: none; padding: 0; margin: 0; color: #4a5568; line-height: 1.8;">
                        <li>• Arduino Uno microcontroller</li>
                        <li>• Motor driver board</li>
                        <li>• Ultrasonic sensor (HC-SR04)</li>
                        <li>• IMU sensor (gyroscope/accelerometer)</li>
                        <li>• Jumper wires and connectors</li>
                        <li>• Battery pack and holder</li>
                    </ul>
                </div>
                <div style="background: #fff7ed; padding: 1.5rem; border-radius: 8px;">
                    <h4 style="color: #2d3748; font-weight: bold; margin-bottom: 1rem;">Mechanical Parts:</h4>
                    <ul style="list-style: none; padding: 0; margin: 0; color: #4a5568; line-height: 1.8;">
                        <li>• Chassis frame (acrylic or metal)</li>
                        <li>• 4x Mecanum wheels</li>
                        <li>• 4x DC motors with encoders</li>
                        <li>• Screws, bolts, and spacers</li>
                        <li>• Motor mounting brackets</li>
                        <li>• Sensor mounting hardware</li>
                    </ul>
                </div>
            </div>

            <div style="background: #f0f9ff; padding: 1.5rem; border-radius: 8px; margin-top: 1.5rem;">
                <h4 style="color: #2d3748; font-weight: bold; margin-bottom: 1rem;">🔧 Required Tools:</h4>
                <ul style="list-style: none; padding: 0; margin: 0; color: #4a5568; line-height: 1.8;">
                    <li>• Phillips head screwdriver</li>
                    <li>• Hex keys (Allen wrenches) - various sizes</li>
                    <li>• Small pliers</li>
                    <li>• Wire strippers (if needed)</li>
                    <li>• Anti-static wrist strap (recommended)</li>
                </ul>
            </div>
        </div>

        <!-- Official Documentation -->
        <div style="background: white; padding: 2rem; border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-bottom: 2rem;">
            <h2 style="color: #667eea; font-size: 1.8rem; font-weight: bold; margin-bottom: 1.5rem;">📚 Official Documentation</h2>
            
            <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 1.5rem; border-radius: 8px; margin-bottom: 1.5rem;">
                <div style="display: flex; align-items: center; margin-bottom: 1rem;">
                    <div style="background: white; border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; margin-right: 1rem;">
                        <span style="font-size: 1.5rem;">🔗</span>
                    </div>
                    <div>
                        <h3 style="color: white; font-size: 1.2rem; font-weight: bold; margin: 0;">Hiwonder miniAuto Wiki</h3>
                        <p style="color: rgba(255,255,255,0.9); margin: 0; font-size: 0.9rem;">Complete assembly and programming guide</p>
                    </div>
                </div>
                <a href="https://wiki.hiwonder.com/projects/miniAuto/en/latest/index.html" target="_blank" style="color: #fbbf24; text-decoration: underline; font-weight: 500; font-size: 1.1rem;">
                    Visit Official Documentation →
                </a>
            </div>

            <div style="background: #f8fafc; padding: 1.5rem; border-radius: 8px;">
                <h4 style="color: #2d3748; font-weight: bold; margin-bottom: 1rem;">What you'll find in the official docs:</h4>
                <ul style="list-style: none; padding: 0; margin: 0; color: #4a5568; line-height: 1.8;">
                    <li>📋 Detailed assembly instructions with photos</li>
                    <li>🔌 Complete wiring diagrams</li>
                    <li>💻 Ready-to-use Arduino code samples</li>
                    <li>🔧 Troubleshooting guide for common issues</li>
                    <li>🚀 Advanced project examples</li>
                </ul>
            </div>
        </div>

        <!-- Section 2: Assembly Process -->
        <div style="background: white; padding: 2rem; border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-bottom: 2rem;">
            <h2 style="color: #667eea; font-size: 1.8rem; font-weight: bold; margin-bottom: 1.5rem;">🔧 Section 2: Assembly Process</h2>
            
            <div style="margin-bottom: 1.5rem;">
                <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">Step 1: Chassis Preparation</h3>
                <div style="background: #e6fffa; padding: 1.5rem; border-radius: 8px; margin-bottom: 1rem;">
                    <ol style="color: #4a5568; line-height: 1.8; margin: 0; padding-left: 1.5rem;">
                        <li>Unpack all components and verify against parts list</li>
                        <li>Identify the main chassis frame and mounting holes</li>
                        <li>Remove any protective film from acrylic parts</li>
                        <li>Organize screws and hardware by size</li>
                    </ol>
                </div>
            </div>

            <div style="margin-bottom: 1.5rem;">
                <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">Step 2: Motor Installation</h3>
                <div style="background: #fff7ed; padding: 1.5rem; border-radius: 8px; margin-bottom: 1rem;">
                    <ol style="color: #4a5568; line-height: 1.8; margin: 0; padding-left: 1.5rem;">
                        <li>Attach motor mounting brackets to chassis</li>
                        <li>Secure DC motors to mounting brackets</li>
                        <li>Ensure motors are properly aligned</li>
                        <li>Attach Mecanum wheels to motor shafts</li>
                        <li>Verify wheels rotate freely without obstruction</li>
                    </ol>
                </div>
            </div>

            <div style="margin-bottom: 1.5rem;">
                <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">Step 3: Electronics Mounting</h3>
                <div style="background: #f0f9ff; padding: 1.5rem; border-radius: 8px; margin-bottom: 1rem;">
                    <ol style="color: #4a5568; line-height: 1.8; margin: 0; padding-left: 1.5rem;">
                        <li>Mount Arduino Uno to designated mounting points</li>
                        <li>Install motor driver board near Arduino</li>
                        <li>Mount ultrasonic sensor at front of chassis</li>
                        <li>Install IMU sensor in stable location</li>
                        <li>Secure battery pack in designated compartment</li>
                    </ol>
                </div>
            </div>
        </div>

        <!-- Section 3: Wiring and Connections -->
        <div style="background: white; padding: 2rem; border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-bottom: 2rem;">
            <h2 style="color: #667eea; font-size: 1.8rem; font-weight: bold; margin-bottom: 1.5rem;">🔌 Section 3: Wiring and Connections</h2>
            
            <div style="background: #fef2f2; padding: 1.5rem; border-radius: 8px; margin-bottom: 1.5rem; border-left: 4px solid #dc2626;">
                <h4 style="color: #dc2626; font-weight: bold; margin-bottom: 0.5rem;">⚠️ Safety First!</h4>
                <p style="color: #4a5568; margin: 0; line-height: 1.6;">
                    Always disconnect power before making any connections. Double-check polarity before connecting batteries or power supplies.
                </p>
            </div>

            <div style="margin-bottom: 1.5rem;">
                <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">Power Connections</h3>
                <div style="background: #e6fffa; padding: 1.5rem; border-radius: 8px;">
                    <ul style="list-style: none; padding: 0; margin: 0; color: #4a5568; line-height: 1.8;">
                        <li>• Connect battery pack to motor driver power input</li>
                        <li>• Connect Arduino power from motor driver 5V output</li>
                        <li>• Ensure all ground connections are secure</li>
                        <li>• Verify voltage levels before powering on</li>
                    </ul>
                </div>
            </div>

            <div style="margin-bottom: 1.5rem;">
                <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">Motor Connections</h3>
                <div style="background: #fff7ed; padding: 1.5rem; border-radius: 8px;">
                    <ul style="list-style: none; padding: 0; margin: 0; color: #4a5568; line-height: 1.8;">
                        <li>• Connect motor wires to driver outputs (A1, A2, B1, B2)</li>
                        <li>• Connect PWM control pins to Arduino digital pins</li>
                        <li>• Connect direction control pins to Arduino digital pins</li>
                        <li>• Test each motor individually before final assembly</li>
                    </ul>
                </div>
            </div>

            <div style="margin-bottom: 1.5rem;">
                <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">Sensor Connections</h3>
                <div style="background: #f0f9ff; padding: 1.5rem; border-radius: 8px;">
                    <ul style="list-style: none; padding: 0; margin: 0; color: #4a5568; line-height: 1.8;">
                        <li>• Connect ultrasonic sensor Trig and Echo pins</li>
                        <li>• Connect IMU sensor via I2C (SDA, SCL)</li>
                        <li>• Ensure sensor power connections (VCC, GND)</li>
                        <li>• Route wires to avoid interference with moving parts</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Section 4: Testing and Troubleshooting -->
        <div style="background: white; padding: 2rem; border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-bottom: 2rem;">
            <h2 style="color: #667eea; font-size: 1.8rem; font-weight: bold; margin-bottom: 1.5rem;">🧪 Section 4: Testing and Troubleshooting</h2>
            
            <div style="margin-bottom: 1.5rem;">
                <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">Initial Testing Checklist</h3>
                <div style="background: #e6fffa; padding: 1.5rem; border-radius: 8px;">
                    <ul style="list-style: none; padding: 0; margin: 0; color: #4a5568; line-height: 1.8;">
                        <li>✅ Visual inspection of all connections</li>
                        <li>✅ Power-on test (LEDs and indicators)</li>
                        <li>✅ Individual motor function test</li>
                        <li>✅ Sensor reading verification</li>
                        <li>✅ Communication test (Arduino to sensors)</li>
                        <li>✅ Mechanical movement test</li>
                    </ul>
                </div>
            </div>

            <div style="margin-bottom: 1.5rem;">
                <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">Common Issues and Solutions</h3>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div style="background: #fef2f2; padding: 1rem; border-radius: 8px;">
                        <h4 style="color: #dc2626; font-weight: bold; margin-bottom: 0.5rem;">Problem: Motors not turning</h4>
                        <p style="color: #4a5568; margin: 0; font-size: 0.9rem;">Check power connections, verify motor driver wiring, test with simple code</p>
                    </div>
                    <div style="background: #fef2f2; padding: 1rem; border-radius: 8px;">
                        <h4 style="color: #dc2626; font-weight: bold; margin-bottom: 0.5rem;">Problem: Sensors not responding</h4>
                        <p style="color: #4a5568; margin: 0; font-size: 0.9rem;">Verify power and signal connections, check pin assignments in code</p>
                    </div>
                    <div style="background: #fef2f2; padding: 1rem; border-radius: 8px;">
                        <h4 style="color: #dc2626; font-weight: bold; margin-bottom: 0.5rem;">Problem: Robot moves erratically</h4>
                        <p style="color: #4a5568; margin: 0; font-size: 0.9rem;">Check wheel alignment, verify motor directions, calibrate sensors</p>
                    </div>
                    <div style="background: #fef2f2; padding: 1rem; border-radius: 8px;">
                        <h4 style="color: #dc2626; font-weight: bold; margin-bottom: 0.5rem;">Problem: Power issues</h4>
                        <p style="color: #4a5568; margin: 0; font-size: 0.9rem;">Check battery charge, verify voltage levels, inspect power connections</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Assessment & Next Steps -->
        <div style="background: white; padding: 2rem; border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-bottom: 2rem;">
            <h2 style="color: #667eea; font-size: 1.8rem; font-weight: bold; margin-bottom: 1.5rem;">📝 Assessment & Next Steps</h2>
            
            <div style="margin-bottom: 1.5rem;">
                <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">Assembly Verification</h3>
                <div style="background: #f8fafc; padding: 1.5rem; border-radius: 8px;">
                    <p style="color: #4a5568; line-height: 1.6; margin-bottom: 1rem;">
                        Before proceeding to programming, ensure your miniAuto is properly assembled:
                    </p>
                    <ul style="list-style: none; padding: 0; margin: 0; color: #4a5568; line-height: 1.8;">
                        <li>🔧 All screws are tightened securely</li>
                        <li>🔌 All electrical connections are correct</li>
                        <li>⚡ Power system functions properly</li>
                        <li>🎯 Components are properly aligned</li>
                        <li>🔄 Wheels rotate freely</li>
                        <li>📡 Sensors are mounted securely</li>
                    </ul>
                </div>
            </div>

            <div style="background: #e6fffa; padding: 1.5rem; border-radius: 8px; margin-bottom: 1.5rem;">
                <h4 style="color: #2d3748; font-weight: bold; margin-bottom: 1rem;">🎯 Preparation for Week 12</h4>
                <p style="color: #4a5568; line-height: 1.6; margin: 0;">
                    With your miniAuto fully assembled, you're ready to begin programming! In Week 12, we'll learn how to control the Mecanum wheels for omnidirectional movement, implement sensor reading, and create your first autonomous behaviors.
                </p>
            </div>

            <div style="text-center">
                <a href="/programming/quizzes32/lesson11" style="background-color: #7c3aed; color: white; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #6d28d9; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#6d28d9'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#7c3aed'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                    Take Lesson 11 Quiz →
                </a>
            </div>
        </div>

        <!-- Navigation -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 2rem;">
            <div>
                <a href="/programming/lessons32/lesson10" style="background-color: #6b7280; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #4b5563; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#4b5563'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#6b7280'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                    ← Previous: Lesson 10
                </a>
            </div>
            <div>
                <a href="/programming/" style="background-color: #059669; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #047857; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#047857'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#059669'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                    Course Overview
                </a>
            </div>
            <div>
                <a href="/programming/lessons32/lesson12" style="background-color: #2563eb; color: white; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 2px solid #1d4ed8; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.2s; display: inline-block;" onmouseover="this.style.backgroundColor='#1d4ed8'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)'" onmouseout="this.style.backgroundColor='#2563eb'; this.style.transform='translateY(0px)'; this.style.boxShadow='0 4px 6px -1px rgba(0, 0, 0, 0.1)'">
                    Next: Lesson 12 →
                </a>
            </div>
        </div>
    </div>
</Layout>
