            <!-- Section 1: DC Motor Fundamentals -->
            <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
                <h2 style="color: #667eea; font-size: 1.8rem; font-weight: bold; margin-bottom: 1rem;">⚙️ Section 1: DC Motor Fundamentals</h2>
                
                <div style="margin-bottom: 1.5rem;">
                    <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">Understanding DC Motors</h3>
                    <p style="color: #4a5568; line-height: 1.6; margin-bottom: 1rem;">
                        DC (Direct Current) motors convert electrical energy into mechanical rotation. 
                        Unlike servos which move to specific positions, DC motors provide continuous 
                        rotation and are perfect for wheels, fans, pumps, and other applications requiring motion.
                    </p>
                    
                    <div style="background: #edf2f7; padding: 1.5rem; border-radius: 8px; margin-bottom: 1.5rem;">
                        <h4 style="color: #2d3748; font-weight: bold; margin-bottom: 1rem;">DC Motor Characteristics:</h4>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
                            <div>
                                <h5 class="font-medium text-blue-700 mb-1">Electrical Properties:</h5>
                                <ul class="text-blue-600 text-sm space-y-1">
                                    <li>• Voltage: 3V, 5V, 6V, 12V common</li>
                                    <li>• Current: Varies with load (50mA-2A+)</li>
                                    <li>• Speed proportional to voltage</li>
                                    <li>• Direction controlled by polarity</li>
                                </ul>
                            </div>
                            <div>
                                <h5 class="font-medium text-blue-700 mb-1">Mechanical Properties:</h5>
                                <ul class="text-blue-600 text-sm space-y-1">
                                    <li>• RPM: Revolutions per minute</li>
                                    <li>• Torque: Rotational force</li>
                                    <li>• Efficiency: Power conversion ratio</li>
                                    <li>• Load characteristics: Speed vs torque</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <div style="margin-bottom: 1.5rem;">
                    <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">Why We Need Motor Drivers</h3>
                    <p style="color: #4a5568; line-height: 1.6; margin-bottom: 1rem;">
                        Arduino pins can only provide 40mA of current, but most DC motors need much more. 
                        Motor drivers act as amplifiers, using Arduino's control signals to switch higher 
                        current from external power supplies.
                    </p>
                    
                    <div style="background: #fef2f2; padding: 1.5rem; border-radius: 8px; margin-bottom: 1.5rem;">
                        <h4 style="color: #2d3748; font-weight: bold; margin-bottom: 1rem;">⚠️ Direct Connection Problems:</h4>
                        <ul style="list-style: none; padding: 0; margin: 0; color: #4a5568; line-height: 1.8;">
                            <li><strong>Insufficient Current:</strong> Arduino can't provide enough power</li>
                            <li><strong>Voltage Drop:</strong> Motor won't reach full speed</li>
                            <li><strong>Damage Risk:</strong> Excessive current can damage Arduino</li>
                            <li><strong>Back EMF:</strong> Motor generates voltage when stopping</li>
                            <li><strong>No Direction Control:</strong> Can't reverse motor easily</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Section 2: Motor Driver Circuits -->
            <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
                <h2 style="color: #667eea; font-size: 1.8rem; font-weight: bold; margin-bottom: 1rem;">🔌 Section 2: Motor Driver Circuits</h2>
                
                <div style="margin-bottom: 1.5rem;">
                    <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">H-Bridge Motor Control</h3>
                    <p style="color: #4a5568; line-height: 1.6; margin-bottom: 1rem;">
                        An H-bridge is a circuit that allows voltage to be applied across a motor in either 
                        direction, enabling both forward and reverse rotation. It's called an H-bridge because 
                        the circuit diagram resembles the letter "H".
                    </p>
                    
                    <div style="background: #e6fffa; padding: 1.5rem; border-radius: 8px; margin-bottom: 1.5rem;">
                        <h4 style="color: #2d3748; font-weight: bold; margin-bottom: 1rem;">H-Bridge Operation States:</h4>
                        <ul style="list-style: none; padding: 0; margin: 0; color: #4a5568; line-height: 1.8;">
                            <li><strong>Forward:</strong> Top-left and bottom-right switches closed</li>
                            <li><strong>Reverse:</strong> Top-right and bottom-left switches closed</li>
                            <li><strong>Brake:</strong> Both bottom switches closed (short motor)</li>
                            <li><strong>Coast:</strong> All switches open (motor freewheels)</li>
                        </ul>
                    </div>
                </div>

                <div style="margin-bottom: 1.5rem;">
                    <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">L298N Motor Driver</h3>
                    <p style="color: #4a5568; line-height: 1.6; margin-bottom: 1rem;">
                        The L298N is a popular dual H-bridge motor driver IC that can control two DC motors 
                        or one stepper motor. It includes built-in protection and can handle up to 2A per channel.
                    </p>
                    
                    <div style="position: relative;">
                        <button onclick="copyCode(this)" style="position: absolute; top: 8px; right: 8px; background-color: #2563eb; color: white; border: none; padding: 4px 8px; border-radius: 4px; cursor: pointer; font-size: 12px; z-index: 10;">📋 Copy</button>
                        <pre style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 6px; overflow-x: auto; font-family: 'Courier New', monospace; margin: 1rem 0;"><code>{`// L298N Motor Driver Control Example
// Motor A connections
const int motorA_pin1 = 2;    // Direction control
const int motorA_pin2 = 3;    // Direction control  
const int motorA_enable = 9;  // Speed control (PWM)

// Motor B connections
const int motorB_pin1 = 4;    // Direction control
const int motorB_pin2 = 5;    // Direction control
const int motorB_enable = 10; // Speed control (PWM)

void setup() {
  // Set motor control pins as outputs
  pinMode(motorA_pin1, OUTPUT);
  pinMode(motorA_pin2, OUTPUT);
  pinMode(motorA_enable, OUTPUT);
  pinMode(motorB_pin1, OUTPUT);
  pinMode(motorB_pin2, OUTPUT);
  pinMode(motorB_enable, OUTPUT);
  
  Serial.begin(9600);
  Serial.println("L298N Motor Driver Test");
}

void loop() {
  // Test Motor A forward
  Serial.println("Motor A Forward");
  motorA_forward(200);  // Speed 0-255
  delay(2000);
  
  // Test Motor A reverse
  Serial.println("Motor A Reverse");
  motorA_reverse(150);
  delay(2000);
  
  // Stop Motor A
  Serial.println("Motor A Stop");
  motorA_stop();
  delay(1000);
}

void motorA_forward(int speed) {
  digitalWrite(motorA_pin1, HIGH);
  digitalWrite(motorA_pin2, LOW);
  analogWrite(motorA_enable, speed);
}

void motorA_reverse(int speed) {
  digitalWrite(motorA_pin1, LOW);
  digitalWrite(motorA_pin2, HIGH);
  analogWrite(motorA_enable, speed);
}

void motorA_stop() {
  digitalWrite(motorA_pin1, LOW);
  digitalWrite(motorA_pin2, LOW);
  analogWrite(motorA_enable, 0);
}`}</code></pre>
                    </div>
                </div>
            </div>

            <!-- Section 3: Speed and Direction Control -->
            <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
                <h2 style="color: #667eea; font-size: 1.8rem; font-weight: bold; margin-bottom: 1rem;">🎛️ Section 3: Speed and Direction Control</h2>
                
                <div style="margin-bottom: 1.5rem;">
                    <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">PWM Speed Control</h3>
                    <p style="color: #4a5568; line-height: 1.6; margin-bottom: 1rem;">
                        Motor speed is controlled using PWM (Pulse Width Modulation) on the enable pins. 
                        Higher PWM values result in higher average voltage and faster motor speed.
                    </p>
                    
                    <div style="position: relative;">
                        <button onclick="copyCode(this)" style="position: absolute; top: 8px; right: 8px; background-color: #2563eb; color: white; border: none; padding: 4px 8px; border-radius: 4px; cursor: pointer; font-size: 12px; z-index: 10;">📋 Copy</button>
                        <pre style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 6px; overflow-x: auto; font-family: 'Courier New', monospace; margin: 1rem 0;"><code>{`// Interactive Motor Speed Control
const int motorPin1 = 2;
const int motorPin2 = 3;
const int enablePin = 9;
const int potPin = A0;        // Potentiometer for speed
const int directionPin = 7;   // Button for direction

int motorSpeed = 0;
bool motorDirection = true;   // true = forward, false = reverse
bool lastButtonState = HIGH;

void setup() {
  pinMode(motorPin1, OUTPUT);
  pinMode(motorPin2, OUTPUT);
  pinMode(enablePin, OUTPUT);
  pinMode(directionPin, INPUT_PULLUP);
  
  Serial.begin(9600);
  Serial.println("Interactive Motor Control");
  Serial.println("Turn pot for speed, press button to change direction");
}

void loop() {
  // Read speed from potentiometer
  int potValue = analogRead(potPin);
  motorSpeed = map(potValue, 0, 1023, 0, 255);
  
  // Check direction button
  bool currentButtonState = digitalRead(directionPin);
  if (lastButtonState == HIGH && currentButtonState == LOW) {
    motorDirection = !motorDirection;
    Serial.print("Direction changed to: ");
    Serial.println(motorDirection ? "Forward" : "Reverse");
    delay(50); // Debounce
  }
  lastButtonState = currentButtonState;
  
  // Control motor based on direction and speed
  if (motorDirection) {
    // Forward
    digitalWrite(motorPin1, HIGH);
    digitalWrite(motorPin2, LOW);
  } else {
    // Reverse
    digitalWrite(motorPin1, LOW);
    digitalWrite(motorPin2, HIGH);
  }
  
  // Set speed
  analogWrite(enablePin, motorSpeed);
  
  // Display status
  Serial.print("Speed: ");
  Serial.print(motorSpeed);
  Serial.print(" | Direction: ");
  Serial.print(motorDirection ? "Forward" : "Reverse");
  Serial.print(" | Percentage: ");
  Serial.print((motorSpeed * 100) / 255);
  Serial.println("%");
  
  delay(100);
}`}</code></pre>
                    </div>
                </div>

                <div style="margin-bottom: 1.5rem;">
                    <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">Motor Control Functions</h3>
                    <p style="color: #4a5568; line-height: 1.6; margin-bottom: 1rem;">
                        Create reusable functions for common motor operations:
                    </p>
                    
                    <div style="position: relative;">
                        <button onclick="copyCode(this)" style="position: absolute; top: 8px; right: 8px; background-color: #2563eb; color: white; border: none; padding: 4px 8px; border-radius: 4px; cursor: pointer; font-size: 12px; z-index: 10;">📋 Copy</button>
                        <pre style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 6px; overflow-x: auto; font-family: 'Courier New', monospace; margin: 1rem 0;"><code>{`// Motor Control Function Library
class DCMotor {
  private:
    int pin1, pin2, enablePin;
    
  public:
    DCMotor(int p1, int p2, int en) {
      pin1 = p1;
      pin2 = p2;
      enablePin = en;
      pinMode(pin1, OUTPUT);
      pinMode(pin2, OUTPUT);
      pinMode(enablePin, OUTPUT);
    }
    
    void forward(int speed) {
      digitalWrite(pin1, HIGH);
      digitalWrite(pin2, LOW);
      analogWrite(enablePin, constrain(speed, 0, 255));
    }
    
    void reverse(int speed) {
      digitalWrite(pin1, LOW);
      digitalWrite(pin2, HIGH);
      analogWrite(enablePin, constrain(speed, 0, 255));
    }
    
    void stop() {
      digitalWrite(pin1, LOW);
      digitalWrite(pin2, LOW);
      analogWrite(enablePin, 0);
    }
    
    void brake() {
      digitalWrite(pin1, HIGH);
      digitalWrite(pin2, HIGH);
      analogWrite(enablePin, 255);
    }
};

// Create motor objects
DCMotor leftMotor(2, 3, 9);
DCMotor rightMotor(4, 5, 10);

void setup() {
  Serial.begin(9600);
  Serial.println("DC Motor Class Demo");
}

void loop() {
  // Move both motors forward
  leftMotor.forward(200);
  rightMotor.forward(200);
  delay(2000);
  
  // Turn right (left motor forward, right motor reverse)
  leftMotor.forward(150);
  rightMotor.reverse(150);
  delay(1000);
  
  // Stop both motors
  leftMotor.stop();
  rightMotor.stop();
  delay(1000);
}`}</code></pre>
