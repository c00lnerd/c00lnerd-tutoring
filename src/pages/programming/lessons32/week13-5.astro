---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Week 13.5: miniAuto Car Assembly - C00lnerd Tutoring">
    <div style="max-width: 1000px; margin: 0 auto; padding: 2rem;">
        
        <!-- Header -->
        <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 3rem; border-radius: 15px; margin-bottom: 2rem; text-align: center;">
            <h1 style="font-size: 2.5rem; font-weight: bold; margin: 0 0 1rem 0;">Week 13.5: miniAuto Car Assembly</h1>
            <p style="font-size: 1.2rem; margin: 0 0 1rem 0; opacity: 0.9;">Building Your Complete Arduino Robot Car</p>
            <div style="background: rgba(255,255,255,0.1); padding: 1rem; border-radius: 8px; margin-top: 1.5rem;">
                <p style="margin: 0 0 0.5rem 0; font-weight: 600;">📖 Official Assembly Guide:</p>
                <a href="https://docs.hiwonder.com/projects/miniAuto/en/latest/docs/1.getting_ready.html" target="_blank" style="color: #fbbf24; text-decoration: underline; font-weight: 500;">Hiwonder miniAuto Section 1.3 - Hardware Assembly →</a>
            </div>
        </div>

        <!-- Learning Objectives -->
        <div style="background: white; padding: 2rem; border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-bottom: 2rem;">
            <h2 style="color: #667eea; font-size: 1.8rem; font-weight: bold; margin-bottom: 1.5rem;">🎯 Learning Objectives</h2>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
                <div>
                    <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">Assembly Goals:</h3>
                    <ul style="list-style: none; padding: 0; margin: 0; color: #4a5568; line-height: 1.8;">
                        <li>• Assemble complete miniAuto robot car</li>
                        <li>• Connect all sensors and actuators</li>
                        <li>• Test individual components</li>
                        <li>• Troubleshoot common issues</li>
                    </ul>
                </div>
                <div>
                    <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">Skills Developed:</h3>
                    <ul style="list-style: none; padding: 0; margin: 0; color: #4a5568; line-height: 1.8;">
                        <li>• Mechanical assembly</li>
                        <li>• Electrical wiring</li>
                        <li>• System integration</li>
                        <li>• Problem-solving</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Section 1: Parts Inventory -->
        <div style="background: white; padding: 2rem; border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-bottom: 2rem;">
            <h2 style="color: #667eea; font-size: 1.8rem; font-weight: bold; margin-bottom: 1.5rem;">📦 Section 1: Parts Inventory</h2>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
                <div style="background: #f0f9ff; padding: 1.5rem; border-radius: 8px;">
                    <h4 style="color: #2d3748; font-weight: bold; margin-bottom: 1rem;">Mechanical Components:</h4>
                    <ul style="list-style: none; padding: 0; margin: 0; color: #4a5568; line-height: 1.8;">
                        <li>• Chassis frame</li>
                        <li>• 4x DC motors with wheels</li>
                        <li>• Motor brackets</li>
                        <li>• Screws and spacers</li>
                        <li>• Battery holder</li>
                    </ul>
                </div>
                
                <div style="background: #e6fffa; padding: 1.5rem; border-radius: 8px;">
                    <h4 style="color: #2d3748; font-weight: bold; margin-bottom: 1rem;">Electronic Components:</h4>
                    <ul style="list-style: none; padding: 0; margin: 0; color: #4a5568; line-height: 1.8;">
                        <li>• Arduino Uno</li>
                        <li>• Motor driver (L298N)</li>
                        <li>• Ultrasonic sensor</li>
                        <li>• IMU sensor</li>
                        <li>• Jumper wires</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Section 2: Assembly Steps -->
        <div style="background: white; padding: 2rem; border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-bottom: 2rem;">
            <h2 style="color: #667eea; font-size: 1.8rem; font-weight: bold; margin-bottom: 1.5rem;">🏗️ Section 2: Assembly Steps</h2>
            
            <div style="background: #f7fafc; padding: 1.5rem; border-radius: 8px; margin-bottom: 1.5rem;">
                <h4 style="color: #2d3748; font-weight: bold; margin-bottom: 1rem;">Step-by-Step Assembly:</h4>
                <ol style="list-style: decimal; padding-left: 1.5rem; margin: 0; color: #4a5568; line-height: 1.8;">
                    <li>Mount motors to chassis with brackets</li>
                    <li>Attach wheels to motor shafts</li>
                    <li>Install Arduino mounting plate</li>
                    <li>Secure battery compartment</li>
                    <li>Mount ultrasonic sensor at front</li>
                    <li>Connect all wiring per diagram</li>
                </ol>
            </div>
        </div>

        <!-- Section 3: Wiring Diagram -->
        <div style="background: white; padding: 2rem; border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-bottom: 2rem;">
            <h2 style="color: #667eea; font-size: 1.8rem; font-weight: bold; margin-bottom: 1.5rem;">⚡ Section 3: Wiring Connections</h2>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
                <div style="background: #e6fffa; padding: 1.5rem; border-radius: 8px;">
                    <h4 style="color: #2d3748; font-weight: bold; margin-bottom: 1rem;">Motor Driver Pins:</h4>
                    <ul style="list-style: none; padding: 0; margin: 0; color: #4a5568; line-height: 1.8;">
                        <li>• ENA → Pin 3</li>
                        <li>• IN1 → Pin 4</li>
                        <li>• IN2 → Pin 5</li>
                        <li>• IN3 → Pin 6</li>
                        <li>• IN4 → Pin 7</li>
                        <li>• ENB → Pin 8</li>
                    </ul>
                </div>
                
                <div style="background: #fffbeb; padding: 1.5rem; border-radius: 8px;">
                    <h4 style="color: #2d3748; font-weight: bold; margin-bottom: 1rem;">Sensor Pins:</h4>
                    <ul style="list-style: none; padding: 0; margin: 0; color: #4a5568; line-height: 1.8;">
                        <li>• Ultrasonic Trig → Pin 9</li>
                        <li>• Ultrasonic Echo → Pin 10</li>
                        <li>• IMU SDA → A4</li>
                        <li>• IMU SCL → A5</li>
                        <li>• Power: 5V and GND</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Section 4: Testing -->
        <div style="background: white; padding: 2rem; border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-bottom: 2rem;">
            <h2 style="color: #667eea; font-size: 1.8rem; font-weight: bold; margin-bottom: 1.5rem;">🧪 Section 4: Component Testing</h2>
            
            <div style="background: #f7fafc; padding: 1.5rem; border-radius: 8px;">
                <h4 style="color: #2d3748; font-weight: bold; margin-bottom: 1rem;">Basic Motor Test:</h4>
                <pre style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 6px; overflow-x: auto; font-family: 'Courier New', monospace;"><code>${`// Test motor functionality
const int ENA = 3, IN1 = 4, IN2 = 5;

void setup() {
  Serial.begin(9600);
  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
}

void loop() {
  // Forward
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  analogWrite(ENA, 150);
  delay(2000);
  
  // Stop
  analogWrite(ENA, 0);
  delay(1000);
}`}</code></pre>
            </div>
        </div>

        <!-- Assembly Checklist -->
        <div style="background: white; padding: 2rem; border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-bottom: 2rem;">
            <h2 style="color: #667eea; font-size: 1.8rem; font-weight: bold; margin-bottom: 1.5rem;">✅ Assembly Verification</h2>
            
            <div style="background: #f8fafc; padding: 1.5rem; border-radius: 8px;">
                <h4 style="color: #2d3748; font-weight: bold; margin-bottom: 1rem;">Pre-Programming Checklist:</h4>
                <ul style="list-style: none; padding: 0; margin: 0; color: #4a5568; line-height: 1.8;">
                    <li>• ✓ Chassis is sturdy and wheels spin freely</li>
                    <li>• ✓ All components securely mounted</li>
                    <li>• ✓ Wiring matches reference diagram</li>
                    <li>• ✓ Power system test passes</li>
                    <li>• ✓ Motors respond to commands</li>
                    <li>• ✓ Sensors provide readings</li>
                    <li>• ✓ Ready for Week 14 programming!</li>
                </ul>
            </div>
        </div>

        <!-- Navigation -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 2rem;">
            <div>
                <a href="/programming/lessons32/week13" style="background-color: #6b7280; color: white; padding: 16px 32px; border-radius: 12px; text-decoration: none; font-weight: 600; transition: all 0.2s;">
                    ← Week 13: Communication Protocols
                </a>
            </div>
            <div style="text-align: center;">
                <span style="color: #6b7280; font-weight: 600;">Assembly Complete!</span>
            </div>
            <div>
                <a href="/programming/lessons32/week14" style="background-color: #10b981; color: white; padding: 16px 32px; border-radius: 12px; text-decoration: none; font-weight: 600; transition: all 0.2s;">
                    Week 14: Programming miniAuto →
                </a>
            </div>
        </div>
    </div>
</Layout>
