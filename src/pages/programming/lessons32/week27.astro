        <!-- Assessment & Homework -->
        <div style="background: white; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); padding: 2rem; margin-bottom: 2rem;">
            <h2 style="color: #667eea; margin-bottom: 1.5rem; font-size: 1.8rem; font-weight: bold;">📝 Assessment & Homework</h2>
            
