            <!-- Section 1: Introduction to Sensors -->
            <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
                <h2 class="text-2xl font-bold text-blue-800 mb-6">🌡️ Section 1: Introduction to Sensors</h2>
                
                <div style="margin-bottom: 1.5rem;">
                    <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">What are Sensors?</h3>
                    <p style="color: #4a5568; line-height: 1.6; margin-bottom: 1rem;">
                        Sensors are devices that detect and measure physical properties from the environment 
                        and convert them into electrical signals that Arduino can understand. They are the 
                        "eyes and ears" of your Arduino projects.
                    </p>
                    
                    <div style="background: #e6fffa; padding: 1.5rem; border-radius: 8px; margin-bottom: 1.5rem;">
                        <h4 style="color: #2d3748; font-weight: bold; margin-bottom: 1rem;">Sensor Categories:</h4>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
                            <div>
                                <h5 class="font-medium text-green-700 mb-1">Digital Sensors:</h5>
                                <ul class="text-green-600 text-sm space-y-1">
                                    <li>• Output HIGH (1) or LOW (0)</li>
                                    <li>• Examples: buttons, switches, motion detectors</li>
                                    <li>• Simple on/off or true/false readings</li>
                                </ul>
                            </div>
                            <div>
                                <h5 class="font-medium text-green-700 mb-1">Analog Sensors:</h5>
                                <ul class="text-green-600 text-sm space-y-1">
                                    <li>• Output variable voltage (0-5V)</li>
                                    <li>• Examples: temperature, light, pressure sensors</li>
                                    <li>• Provide continuous range of values</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 2: Ultrasonic Distance Sensor (HC-SR04) -->
            <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
                <h2 class="text-2xl font-bold text-blue-800 mb-6">� Section 2: Ultrasonic Distance Sensor (HC-SR04)</h2>
                
                <div style="margin-bottom: 1.5rem;">
                    <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">How it works</h3>
                    <p style="color: #4a5568; line-height: 1.6; margin-bottom: 1rem;">
                        The HC-SR04 measures distance by sending an ultrasonic "ping" and timing how long it takes for
                        the echo to return. Arduino measures that time and converts it into distance.
                    </p>

                    <div style="background: #fff5f5; padding: 1.5rem; border-radius: 8px; border-left: 4px solid #f56565; margin-bottom: 1.5rem;">
                        <h4 style="color: #742a2a; font-weight: bold; margin-bottom: 1rem;">🔌 HC-SR04 Wiring</h4>
                        <div style="background: #fed7d7; padding: 1rem; border-radius: 6px;">
                            <ul style="color: #742a2a; line-height: 1.6; margin-left: 1rem;">
                                <li><strong>VCC → 5V</strong></li>
                                <li><strong>GND → GND</strong></li>
                                <li><strong>TRIG → pin 9</strong></li>
                                <li><strong>ECHO → pin 10</strong></li>
                            </ul>
                        </div>
                    </div>
                    
                    <div style="background: #fff5f5; padding: 1.5rem; border-radius: 8px; border-left: 4px solid #f56565; margin-bottom: 1.5rem;">
                        <h4 style="color: #742a2a; font-weight: bold; margin-bottom: 1rem;">⚠️ Note</h4>
                        <p style="color: #742a2a; margin: 0; line-height: 1.6;">
                            If you get unstable readings, that’s normal. We’ll apply Lesson 8 techniques (thresholds and averaging)
                            in the project section.
                        </p>
                    </div>
                    
                    <div class="relative">
                        <button onclick="copyCode(this)" class="absolute top-2 right-2 bg-blue-600 hover:bg-blue-700 text-white text-xs px-2 py-1 rounded transition-colors duration-200">
                            📋 Copy
                        </button>
                        <pre style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 6px; overflow-x: auto; font-family: 'Courier New', monospace; margin: 1rem 0;"><code>{`// HC-SR04 distance reading example
const int trigPin = 9;
const int echoPin = 10;

void setup() {
  Serial.begin(9600);
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);
}

float getDistanceCm() {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  long durationUs = pulseIn(echoPin, HIGH, 30000);
  if (durationUs == 0) return -1;
  return durationUs * 0.0343f / 2.0f;
}

void loop() {
  float d = getDistanceCm();
  if (d < 0) {
    Serial.println("No echo (out of range)");
  } else {
    Serial.print("Distance: ");
    Serial.print(d);
    Serial.println(" cm");
  }
  delay(100);
}`}</code></pre>
                    </div>
                </div>
            </div>

            <!-- Section 3: Digital Input Devices -->
            <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
                <h2 class="text-2xl font-bold text-blue-800 mb-6">🔘 Section 3: Digital Input Devices</h2>
                
                <div style="margin-bottom: 1.5rem;">
                    <h3 style="color: #2d3748; font-size: 1.3rem; font-weight: bold; margin-bottom: 1rem;">Buttons and Switches</h3>
                    <p style="color: #4a5568; line-height: 1.6; margin-bottom: 1rem;">
                        Buttons and switches let the user control your program. In the Lesson 9 project, the button will be used
                        to toggle modes (like enabling/disabling an alarm).
                    </p>
                    
                    <div style="background: #fff5f5; padding: 1.5rem; border-radius: 8px; border-left: 4px solid #f56565; margin-bottom: 1.5rem;">
                        <h4 style="color: #742a2a; font-weight: bold; margin-bottom: 1rem;">🔌 Button Wiring</h4>
                        
                        <div style="background: #fed7d7; padding: 1rem; border-radius: 6px;">
                            <h5 style="color: #742a2a; font-weight: bold; margin-bottom: 0.5rem;">External Push Button Wiring:</h5>
                            <ul style="color: #742a2a; line-height: 1.6; margin-left: 1rem;">
                                <li><strong>Connect one leg of button to digital pin 2</strong></li>
                                <li><strong>Connect other leg of button to GND</strong></li>
                                <li>No external resistor needed - code uses INPUT_PULLUP</li>
                                <li>The built-in button on the expansion board is connected to reset, not pin 2</li>
                                <li>You'll need an external push button for this exercise</li>
                            </ul>
                        </div>
                    </div>
                </div>
