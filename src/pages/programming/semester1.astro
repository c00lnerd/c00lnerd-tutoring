---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Programming Semester 1 - Lessons">
    <div class="semester-container">
        <div class="header-section">
            <h1>Semester 1: Programming Fundamentals</h1>
            <p class="subtitle">
                16 weeks of structured learning from Python basics to Arduino programming with the miniAuto car
            </p>
        </div>

        <!-- Progress Overview -->
        <div class="overview-card">
            <h2>Semester Overview</h2>
            <div class="overview-grid">
                <div class="phase-card phase-python">
                    <h3>Weeks 1-7</h3>
                    <p>Python Programming Fundamentals</p>
                </div>
                <div class="phase-card phase-arduino">
                    <h3>Weeks 8-13</h3>
                    <p>Arduino Development & Hardware</p>
                </div>
                <div class="phase-card phase-miniauto">
                    <h3>Weeks 14-16</h3>
                    <p>miniAuto Car Integration</p>
                </div>
            </div>
        </div>

        <!-- Weekly Lessons -->
        <div class="lessons-container">
            <div class="lessons-grid">
                <!-- Week 1 -->
                <div class="week-card">
                    <div class="week-header">
                        <div class="week-info">
                            <div class="week-number week-python">1</div>
                            <div class="week-details">
                                <h3>Introduction to Programming & Python</h3>
                                <p>Setting up the development environment and first programs</p>
                            </div>
                        </div>
                        <div class="week-buttons">
                            <a href="/programming/lessons/week1" class="btn btn-lesson">Lesson</a>
                            <a href="/programming/quizzes/week1" class="btn btn-quiz">Quiz</a>
                        </div>
                    </div>
                    <div class="week-topics">
                        <strong>Topics:</strong> What is programming, Python installation, IDLE, first print statements, comments
                    </div>
                </div>

                <!-- Week 2 -->
                <div class="week-card">
                    <div class="week-header">
                        <div class="week-info">
                            <div class="week-number week-python">2</div>
                            <div class="week-details">
                                <h3>Variables and Data Types</h3>
                                <p>Understanding data storage and manipulation</p>
                            </div>
                        </div>
                        <div class="week-buttons">
                            <a href="/programming/lessons/week2" class="btn btn-lesson">Lesson</a>
                            <a href="/programming/quizzes/week2" class="btn btn-quiz">Quiz</a>
                        </div>
                    </div>
                    <div class="week-topics">
                        <strong>Topics:</strong> Variables, integers, floats, strings, booleans, input() function, type conversion
                    </div>
                </div>

                <!-- Week 3 -->
                <div class="week-card">
                    <div class="week-header">
                        <div class="week-info">
                            <div class="week-number week-python">3</div>
                            <div class="week-details">
                                <h3>Conditionals and Decision Making</h3>
                                <p>Making programs that can make decisions</p>
                            </div>
                        </div>
                        <div class="week-buttons">
                            <a href="/programming/lessons/week3" class="btn btn-lesson">Lesson</a>
                            <a href="/programming/quizzes/week3" class="btn btn-quiz">Quiz</a>
                        </div>
                    </div>
                    <div class="week-topics">
                        <strong>Topics:</strong> if, elif, else statements, comparison operators, logical operators, nested conditions
                    </div>
                </div>

                <!-- Week 4 -->
                <div class="week-card">
                    <div class="week-header">
                        <div class="week-info">
                            <div class="week-number week-python">4</div>
                            <div class="week-details">
                                <h3>Loops and Iteration</h3>
                                <p>Repeating actions efficiently</p>
                            </div>
                        </div>
                        <div class="week-buttons">
                            <a href="/programming/lessons/week4" class="btn btn-lesson">Lesson</a>
                            <a href="/programming/quizzes/week4" class="btn btn-quiz">Quiz</a>
                        </div>
                    </div>
                    <div class="week-topics">
                        <strong>Topics:</strong> for loops, while loops, range() function, break and continue, nested loops
                    </div>
                </div>

                <!-- Week 5 -->
                <div class="week-card">
                    <div class="week-header">
                        <div class="week-info">
                            <div class="week-number week-python">5</div>
                            <div class="week-details">
                                <h3>Functions and Modular Programming</h3>
                                <p>Creating reusable code blocks</p>
                            </div>
                        </div>
                        <div class="week-buttons">
                            <a href="/programming/lessons/week5" class="btn btn-lesson">Lesson</a>
                            <a href="/programming/quizzes/week5" class="btn btn-quiz">Quiz</a>
                        </div>
                    </div>
                    <div class="week-topics">
                        <strong>Topics:</strong> Function definition, parameters, return values, scope, lambda functions
                    </div>
                </div>

                <!-- Week 6 -->
                <div class="week-card">
                    <div class="week-header">
                        <div class="week-info">
                            <div class="week-number week-python">6</div>
                            <div class="week-details">
                                <h3>Lists and Data Structures</h3>
                                <p>Working with collections of data</p>
                            </div>
                        </div>
                        <div class="week-buttons">
                            <a href="/programming/lessons/week6" class="btn btn-lesson">Lesson</a>
                            <a href="/programming/quizzes/week6" class="btn btn-quiz">Quiz</a>
                        </div>
                    </div>
                    <div class="week-topics">
                        <strong>Topics:</strong> Lists, indexing, slicing, list methods, tuples, dictionaries
                    </div>
                </div>

                <!-- Week 7 -->
                <div class="week-card">
                    <div class="week-header">
                        <div class="week-info">
                            <div class="week-number week-python">7</div>
                            <div class="week-details">
                                <h3>File Handling and Data Processing</h3>
                                <p>Reading and writing data to files</p>
                            </div>
                        </div>
                        <div class="week-buttons">
                            <a href="/programming/lessons/week7" class="btn btn-lesson">Lesson</a>
                            <a href="/programming/quizzes/week7" class="btn btn-quiz">Quiz</a>
                        </div>
                    </div>
                    <div class="week-topics">
                        <strong>Topics:</strong> File operations, reading/writing text files, CSV processing, error handling
                    </div>
                </div>

                <!-- Week 8 -->
                <div class="week-card week-transition">
                    <div class="week-header">
                        <div class="week-info">
                            <div class="week-number week-arduino">8</div>
                            <div class="week-details">
                                <h3>Introduction to Arduino and Hardware</h3>
                                <p>Transitioning from software to hardware programming</p>
                            </div>
                        </div>
                        <div class="week-buttons">
                            <a href="/programming/lessons/week8" class="btn btn-lesson">Lesson</a>
                            <a href="/programming/quizzes/week8" class="btn btn-quiz">Quiz</a>
                        </div>
                    </div>
                    <div class="week-topics">
                        <strong>Topics:</strong> Arduino IDE setup, C++ basics, microcontrollers, digital vs analog
                    </div>
                </div>

                <!-- Week 9 -->
                <div class="week-card">
                    <div class="week-header">
                        <div class="week-info">
                            <div class="week-number week-arduino">9</div>
                            <div class="week-details">
                                <h3>Digital Inputs/Outputs and LEDs</h3>
                                <p>Controlling and reading digital signals</p>
                            </div>
                        </div>
                        <div class="week-buttons">
                            <a href="/programming/lessons/week9" class="btn btn-lesson">Lesson</a>
                            <a href="/programming/quizzes/week9" class="btn btn-quiz">Quiz</a>
                        </div>
                    </div>
                    <div class="week-topics">
                        <strong>Topics:</strong> digitalWrite(), digitalRead(), LED control, button inputs, pull-up resistors
                    </div>
                </div>

                <!-- Week 10 -->
                <div class="week-card">
                    <div class="week-header">
                        <div class="week-info">
                            <div class="week-number week-arduino">10</div>
                            <div class="week-details">
                                <h3>Analog Sensors and Data Collection</h3>
                                <p>Reading and processing analog sensor data</p>
                            </div>
                        </div>
                        <div class="week-buttons">
                            <a href="/programming/lessons/week10" class="btn btn-lesson">Lesson</a>
                            <a href="/programming/quizzes/week10" class="btn btn-quiz">Quiz</a>
                        </div>
                    </div>
                    <div class="week-topics">
                        <strong>Topics:</strong> analogRead(), sensor calibration, potentiometers, temperature sensors
                    </div>
                </div>

                <!-- Week 11 -->
                <div class="week-card">
                    <div class="week-header">
                        <div class="week-info">
                            <div class="week-number week-arduino">11</div>
                            <div class="week-details">
                                <h3>Motors and Movement Control</h3>
                                <p>Controlling motors for robot movement</p>
                            </div>
                        </div>
                        <div class="week-buttons">
                            <a href="/programming/lessons/week11" class="btn btn-lesson">Lesson</a>
                            <a href="/programming/quizzes/week11" class="btn btn-quiz">Quiz</a>
                        </div>
                    </div>
                    <div class="week-topics">
                        <strong>Topics:</strong> DC motors, servo motors, PWM control, motor drivers, basic movement
                    </div>
                </div>

                <!-- Week 12 -->
                <div class="week-card">
                    <div class="week-header">
                        <div class="week-info">
                            <div class="week-number week-arduino">12</div>
                            <div class="week-details">
                                <h3>Ultrasonic Sensors and Obstacle Detection</h3>
                                <p>Adding sensing capabilities for autonomous behavior</p>
                            </div>
                        </div>
                        <div class="week-buttons">
                            <a href="/programming/lessons/week12" class="btn btn-lesson">Lesson</a>
                            <a href="/programming/quizzes/week12" class="btn btn-quiz">Quiz</a>
                        </div>
                    </div>
                    <div class="week-topics">
                        <strong>Topics:</strong> Ultrasonic sensors, distance measurement, obstacle avoidance algorithms
                    </div>
                </div>

                <!-- Week 13 -->
                <div class="week-card week-transition">
                    <div class="week-header">
                        <div class="week-info">
                            <div class="week-number week-miniauto">13</div>
                            <div class="week-details">
                                <h3>Introduction to miniAuto Platform</h3>
                                <p>Getting familiar with the Hisonder miniAuto car</p>
                            </div>
                        </div>
                        <div class="week-buttons">
                            <a href="/programming/lessons/week13" class="btn btn-lesson">Lesson</a>
                            <a href="/programming/quizzes/week13" class="btn btn-quiz">Quiz</a>
                        </div>
                    </div>
                    <div class="week-topics">
                        <strong>Topics:</strong> miniAuto assembly, setup, default programs, app control
                    </div>
                </div>

                <!-- Week 14 -->
                <div class="week-card">
                    <div class="week-header">
                        <div class="week-info">
                            <div class="week-number week-miniauto">14</div>
                            <div class="week-details">
                                <h3>Basic miniAuto Programming</h3>
                                <p>Programming the miniAuto for basic movements and behaviors</p>
                            </div>
                        </div>
                        <div class="week-buttons">
                            <a href="/programming/lessons/week14" class="btn btn-lesson">Lesson</a>
                            <a href="/programming/quizzes/week14" class="btn btn-quiz">Quiz</a>
                        </div>
                    </div>
                    <div class="week-topics">
                        <strong>Topics:</strong> Motion control, basic navigation, sensor integration, first autonomous program
                    </div>
                </div>

                <!-- Week 15 -->
                <div class="week-card">
                    <div class="week-header">
                        <div class="week-info">
                            <div class="week-number week-miniauto">15</div>
                            <div class="week-details">
                                <h3>Advanced miniAuto Features</h3>
                                <p>Exploring advanced capabilities and AI features</p>
                            </div>
                        </div>
                        <div class="week-buttons">
                            <a href="/programming/lessons/week15" class="btn btn-lesson">Lesson</a>
                            <a href="/programming/quizzes/week15" class="btn btn-quiz">Quiz</a>
                        </div>
                    </div>
                    <div class="week-topics">
                        <strong>Topics:</strong> AI vision games, robotic gripper, wireless control, serial communication
                    </div>
                </div>

                <!-- Week 16 -->
                <div class="week-card week-final">
                    <div class="week-header">
                        <div class="week-info">
                            <div class="week-number week-final">16</div>
                            <div class="week-details">
                                <h3>Final Competition and Showcase</h3>
                                <p>Putting it all together in a road race competition</p>
                            </div>
                        </div>
                        <div class="week-buttons">
                            <a href="/programming/lessons/week16" class="btn btn-lesson">Lesson</a>
                            <a href="/programming/quizzes/week16" class="btn btn-quiz">Quiz</a>
                        </div>
                    </div>
                    <div class="week-topics">
                        <strong>Topics:</strong> Competition preparation, optimization, testing, final presentations
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .semester-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
        }

        .header-section {
            text-align: center;
            margin-bottom: 3rem;
        }

        .header-section h1 {
            font-size: 2.5rem;
            font-weight: bold;
            color: var(--black);
            margin-bottom: 1rem;
        }

        .subtitle {
            font-size: 1.2rem;
            color: var(--gray);
            max-width: 600px;
            margin: 0 auto;
        }

        .overview-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            padding: 2rem;
            margin-bottom: 3rem;
        }

        .overview-card h2 {
            font-size: 1.8rem;
            font-weight: bold;
            color: var(--black);
            margin-bottom: 1.5rem;
        }

        .overview-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1rem;
        }

        .phase-card {
            padding: 1.5rem;
            border-radius: 8px;
            text-align: center;
        }

        .phase-python {
            background-color: #dbeafe;
            border: 1px solid #3b82f6;
        }

        .phase-arduino {
            background-color: #dcfce7;
            border: 1px solid #22c55e;
        }

        .phase-miniauto {
            background-color: #fae8ff;
            border: 1px solid #a855f7;
        }

        .phase-card h3 {
            font-weight: bold;
            margin-bottom: 0.5rem;
        }

        .phase-python h3 {
            color: #1d4ed8;
        }

        .phase-arduino h3 {
            color: #16a34a;
        }

        .phase-miniauto h3 {
            color: #9333ea;
        }

        .phase-card p {
            font-size: 0.9rem;
            margin: 0;
        }

        .phase-python p {
            color: #2563eb;
        }

        .phase-arduino p {
            color: #059669;
        }

        .phase-miniauto p {
            color: #7c3aed;
        }

        .lessons-container {
            max-width: 1000px;
            margin: 0 auto;
        }

        .lessons-grid {
            display: grid;
            gap: 1.5rem;
        }

        .week-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            padding: 1.5rem;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .week-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
        }

        .week-transition {
            border-left: 4px solid var(--accent);
        }

        .week-final {
            border-left: 4px solid #dc2626;
        }

        .week-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .week-info {
            display: flex;
            align-items: center;
        }

        .week-number {
            width: 3rem;
            height: 3rem;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: white;
            margin-right: 1rem;
            font-size: 1.2rem;
        }

        .week-python {
            background-color: #3b82f6;
        }

        .week-arduino {
            background-color: #22c55e;
        }

        .week-miniauto {
            background-color: #a855f7;
        }

        .week-final {
            background-color: #dc2626;
        }

        .week-details h3 {
            font-size: 1.3rem;
            font-weight: bold;
            color: var(--black);
            margin: 0 0 0.5rem 0;
        }

        .week-details p {
            color: var(--gray);
            margin: 0;
        }

        .week-buttons {
            display: flex;
            gap: 0.5rem;
        }

        .btn {
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 500;
            transition: background-color 0.2s;
            border: none;
            cursor: pointer;
        }

        .btn-lesson {
            background-color: var(--accent);
            color: white;
        }

        .btn-lesson:hover {
            background-color: var(--accent-dark);
        }

        .btn-quiz {
            background-color: #22c55e;
            color: white;
        }

        .btn-quiz:hover {
            background-color: #16a34a;
        }

        .week-topics {
            font-size: 0.9rem;
            color: var(--gray);
            padding-top: 1rem;
            border-top: 1px solid #e5e7eb;
        }

        @media (max-width: 768px) {
            .week-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 1rem;
            }

            .week-buttons {
                align-self: stretch;
            }

            .btn {
                flex: 1;
                text-align: center;
            }
        }
    </style>
</Layout>
