---
import Layout from '../layouts/Layout.astro';
---

<Layout 
	title="About Chuck - C00lnerd Tutoring"
	description="Meet Chuck, an experienced STEM educator with an engineering background. Specializing in mathematics, science, and programming instruction for homeschool families."
>

<!-- Navigation Header -->
<nav class="bg-white shadow-lg sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <a href="/" class="text-2xl font-bold text-blue-600">C00lnerd</a>
        </div>
      </div>
      <div class="hidden md:block">
        <div class="ml-10 flex items-baseline space-x-4">
          <a href="/#services" class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium transition-colors">Services</a>
          <a href="/about" class="text-blue-600 px-3 py-2 rounded-md text-sm font-medium">About</a>
          <a href="/#resources" class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium transition-colors">Resources</a>
          <a href="/#contact" class="bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700 transition-colors">Contact</a>
        </div>
      </div>
    </div>
  </div>
</nav>

<!-- Hero Section -->
<section class="bg-gradient-to-br from-blue-50 to-indigo-100 py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
        Meet <span class="text-blue-600">Chuck</span>
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Engineering expertise meets educational passion in comprehensive STEM tutoring
      </p>
    </div>
  </div>
</section>

<!-- Main About Content -->
<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <!-- Profile Image Placeholder -->
      <div class="flex justify-center lg:justify-start">
        <div class="bg-gradient-to-br from-blue-100 to-indigo-200 w-80 h-80 rounded-xl flex items-center justify-center shadow-xl">
          <i class="fas fa-user-tie text-8xl text-blue-600"></i>
        </div>
      </div>
      
      <!-- About Content -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-6">Engineering Background, Educational Heart</h2>
        <div class="prose prose-lg text-gray-700 space-y-6">
          <p>
            With an engineering background and years of hands-on tutoring experience, I bring both deep technical knowledge and proven teaching methods to STEM education. My approach combines rigorous academic standards with engaging, practical applications that help students truly understand complex concepts.
          </p>
          <p>
            I believe that every student can excel in mathematics and science when given the right instruction, encouragement, and tools. My engineering training has taught me to break down complex problems into manageable steps—a skill that translates perfectly to helping students master challenging subjects.
          </p>
          <p>
            As a Christian educator, I integrate faith-based perspectives with academic excellence, helping students see the wonder of God's creation through scientific discovery and mathematical precision.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Qualifications Section -->
<section class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Teaching Qualifications</h2>
      <p class="text-xl text-gray-600">
        Comprehensive expertise across all levels of high school mathematics and science
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Mathematics -->
      <div class="bg-white p-8 rounded-xl shadow-lg">
        <div class="text-center mb-6">
          <i class="fas fa-calculator text-4xl text-blue-600 mb-4"></i>
          <h3 class="text-xl font-bold text-gray-900">Mathematics</h3>
        </div>
        <ul class="space-y-3 text-gray-700">
          <li class="flex items-center">
            <i class="fas fa-check-circle text-blue-600 mr-3"></i>
            <span>Algebra I & II</span>
          </li>
          <li class="flex items-center">
            <i class="fas fa-check-circle text-blue-600 mr-3"></i>
            <span>Precalculus</span>
          </li>
          <li class="flex items-center">
            <i class="fas fa-check-circle text-blue-600 mr-3"></i>
            <span>Calculus I & II</span>
          </li>
          <li class="flex items-center">
            <i class="fas fa-check-circle text-blue-600 mr-3"></i>
            <span>Geometry</span>
          </li>
          <li class="flex items-center">
            <i class="fas fa-check-circle text-blue-600 mr-3"></i>
            <span>Surveying Geometry</span>
          </li>
        </ul>
      </div>

      <!-- Sciences -->
      <div class="bg-white p-8 rounded-xl shadow-lg">
        <div class="text-center mb-6">
          <i class="fas fa-atom text-4xl text-green-600 mb-4"></i>
          <h3 class="text-xl font-bold text-gray-900">Sciences</h3>
        </div>
        <ul class="space-y-3 text-gray-700">
          <li class="flex items-center">
            <i class="fas fa-check-circle text-green-600 mr-3"></i>
            <span>Physics</span>
          </li>
          <li class="flex items-center">
            <i class="fas fa-check-circle text-green-600 mr-3"></i>
            <span>High School Chemistry</span>
          </li>
          <li class="flex items-center">
            <i class="fas fa-check-circle text-green-600 mr-3"></i>
            <span>Physical Science</span>
          </li>
          <li class="flex items-center">
            <i class="fas fa-check-circle text-green-600 mr-3"></i>
            <span>Laboratory Techniques</span>
          </li>
          <li class="flex items-center">
            <i class="fas fa-check-circle text-green-600 mr-3"></i>
            <span>Hands-on Experiments</span>
          </li>
        </ul>
      </div>

      <!-- Specializations -->
      <div class="bg-white p-8 rounded-xl shadow-lg">
        <div class="text-center mb-6">
          <i class="fas fa-cogs text-4xl text-purple-600 mb-4"></i>
          <h3 class="text-xl font-bold text-gray-900">Specializations</h3>
        </div>
        <ul class="space-y-3 text-gray-700">
          <li class="flex items-center">
            <i class="fas fa-check-circle text-purple-600 mr-3"></i>
            <span>Engineering Applications</span>
          </li>
          <li class="flex items-center">
            <i class="fas fa-check-circle text-purple-600 mr-3"></i>
            <span>Programming & Robotics</span>
          </li>
          <li class="flex items-center">
            <i class="fas fa-check-circle text-purple-600 mr-3"></i>
            <span>Curriculum Development</span>
          </li>
          <li class="flex items-center">
            <i class="fas fa-check-circle text-purple-600 mr-3"></i>
            <span>Christian Education</span>
          </li>
          <li class="flex items-center">
            <i class="fas fa-check-circle text-purple-600 mr-3"></i>
            <span>Homeschool Support</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Teaching Philosophy Section -->
<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Teaching Philosophy</h2>
        <p class="text-xl text-gray-600">
          Building confidence through understanding, one concept at a time
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-gradient-to-br from-blue-50 to-indigo-100 p-8 rounded-xl">
          <h3 class="text-xl font-bold text-gray-900 mb-4">
            <i class="fas fa-lightbulb text-blue-600 mr-3"></i>
            Understanding Over Memorization
          </h3>
          <p class="text-gray-700">
            I focus on helping students truly understand concepts rather than just memorizing formulas. This engineering approach builds lasting knowledge and problem-solving skills.
          </p>
        </div>
        
        <div class="bg-gradient-to-br from-green-50 to-emerald-100 p-8 rounded-xl">
          <h3 class="text-xl font-bold text-gray-900 mb-4">
            <i class="fas fa-hands-helping text-green-600 mr-3"></i>
            Personalized Support
          </h3>
          <p class="text-gray-700">
            Every student learns differently. I adapt my teaching methods to match each student's learning style and pace, ensuring no one gets left behind.
          </p>
        </div>
        
        <div class="bg-gradient-to-br from-purple-50 to-violet-100 p-8 rounded-xl">
          <h3 class="text-xl font-bold text-gray-900 mb-4">
            <i class="fas fa-flask text-purple-600 mr-3"></i>
            Hands-on Learning
          </h3>
          <p class="text-gray-700">
            Science and math come alive through experiments, real-world applications, and interactive projects that make abstract concepts tangible.
          </p>
        </div>
        
        <div class="bg-gradient-to-br from-orange-50 to-amber-100 p-8 rounded-xl">
          <h3 class="text-xl font-bold text-gray-900 mb-4">
            <i class="fas fa-heart text-orange-600 mr-3"></i>
            Faith Integration
          </h3>
          <p class="text-gray-700">
            I help students see the beauty of God's creation through scientific discovery, integrating faith and learning in a natural, meaningful way.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Experience Highlights Section -->
<section class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Experience Highlights</h2>
      <p class="text-xl text-gray-600">
        Proven track record of student success and curriculum innovation
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="text-center">
        <div class="bg-blue-600 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
          <i class="fas fa-graduation-cap text-white text-2xl"></i>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">Years of Experience</h3>
        <p class="text-gray-600">Extensive tutoring across all high school STEM subjects</p>
      </div>
      
      <div class="text-center">
        <div class="bg-green-600 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
          <i class="fas fa-book text-white text-2xl"></i>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">Curriculum Developer</h3>
        <p class="text-gray-600">Created comprehensive Physical Science and Programming curricula</p>
      </div>
      
      <div class="text-center">
        <div class="bg-purple-600 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
          <i class="fas fa-users text-white text-2xl"></i>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">Homeschool Advocate</h3>
        <p class="text-gray-600">Supporting families in their educational journey with proven methods</p>
      </div>
      
      <div class="text-center">
        <div class="bg-orange-600 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
          <i class="fas fa-cross text-white text-2xl"></i>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">Faith-Based Education</h3>
        <p class="text-gray-600">Integrating Christian worldview with academic excellence</p>
      </div>
    </div>
  </div>
</section>

<!-- What Students Say Section -->
<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">What Students Say</h2>
      <p class="text-xl text-gray-600">
        Real feedback from students who've experienced the difference
      </p>
    </div>
    
    <div class="max-w-4xl mx-auto">
      <div class="bg-gradient-to-br from-blue-50 to-indigo-100 p-8 rounded-xl shadow-lg">
        <div class="flex items-center mb-6">
          <div class="flex text-yellow-400 text-xl">
            <i class="fas fa-star"></i>
            <i class="fas fa-star"></i>
            <i class="fas fa-star"></i>
            <i class="fas fa-star"></i>
            <i class="fas fa-star"></i>
          </div>
        </div>
        <blockquote class="text-lg text-gray-700 italic mb-6">
          "When I first met Mr. Summers, I thought I was going to have a typical boring year; I was wrong. Not only did we learn with fun experiments using things like an oilers disk, magnets, and lenses, but he made me excited to go to class. He's an all-around cool man that wants to see people succeed and nurture students' intellectual interests. He really does care for students—like when I fell behind, we did some tutoring at Taco Bell. Mr. Summers has made a lifelong impression on me and even my family."
        </blockquote>
        <div class="flex items-center">
          <div class="w-12 h-12 bg-blue-600 rounded-full flex items-center justify-center mr-4">
            <span class="text-white font-bold">JT</span>
          </div>
          <div>
            <p class="font-semibold text-gray-900">JT</p>
            <p class="text-gray-600">Former Student</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Approach Section -->
<section class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">My Approach</h2>
        <p class="text-xl text-gray-600">
          Engineering principles applied to education for maximum student success
        </p>
      </div>
      
      <div class="space-y-8">
        <div class="flex items-start">
          <div class="bg-blue-600 w-12 h-12 rounded-full flex items-center justify-center mr-6 mt-1">
            <span class="text-white font-bold">1</span>
          </div>
          <div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Assess Current Understanding</h3>
            <p class="text-gray-700">I start by understanding where each student is academically and what their learning preferences are.</p>
          </div>
        </div>
        
        <div class="flex items-start">
          <div class="bg-green-600 w-12 h-12 rounded-full flex items-center justify-center mr-6 mt-1">
            <span class="text-white font-bold">2</span>
          </div>
          <div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Build Strong Foundations</h3>
            <p class="text-gray-700">Like engineering, math and science require solid fundamentals. I ensure students master prerequisite concepts before advancing.</p>
          </div>
        </div>
        
        <div class="flex items-start">
          <div class="bg-purple-600 w-12 h-12 rounded-full flex items-center justify-center mr-6 mt-1">
            <span class="text-white font-bold">3</span>
          </div>
          <div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Apply Knowledge Practically</h3>
            <p class="text-gray-700">Students learn best when they can see how concepts apply to real-world situations and hands-on experiments.</p>
          </div>
        </div>
        
        <div class="flex items-start">
          <div class="bg-orange-600 w-12 h-12 rounded-full flex items-center justify-center mr-6 mt-1">
            <span class="text-white font-bold">4</span>
          </div>
          <div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Build Confidence & Independence</h3>
            <p class="text-gray-700">My goal is to develop students who can tackle new problems independently with confidence and systematic thinking.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Call to Action -->
<section class="py-20 bg-blue-600">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
      Ready to Help Your Student Succeed?
    </h2>
    <p class="text-xl text-blue-100 mb-8 max-w-3xl mx-auto">
      Let's discuss your student's goals and create a personalized learning plan that builds both knowledge and confidence.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/#contact" class="bg-white text-blue-600 px-8 py-3 rounded-lg font-semibold hover:bg-gray-100 transition-colors">
        Schedule Free Consultation
      </a>
      <a href="/#resources" class="border-2 border-white text-white px-8 py-3 rounded-lg font-semibold hover:bg-blue-700 transition-colors">
        Explore Resources
      </a>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="bg-gray-900 text-white py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div>
        <h3 class="text-2xl font-bold mb-4">C00lnerd</h3>
        <p class="text-gray-400">
          Expert STEM tutoring for homeschool families and co-ops.
        </p>
      </div>
      <div>
        <h4 class="text-lg font-semibold mb-4">Services</h4>
        <ul class="space-y-2 text-gray-400">
          <li><a href="/classes" class="hover:text-white transition-colors">Physical Science</a></li>
          <li><a href="/programming" class="hover:text-white transition-colors">Programming</a></li>
          <li><a href="/#contact" class="hover:text-white transition-colors">Individual Tutoring</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-lg font-semibold mb-4">Resources</h4>
        <ul class="space-y-2 text-gray-400">
          <li><a href="/practice" class="hover:text-white transition-colors">Practice Tools</a></li>
          <li><a href="/simulations" class="hover:text-white transition-colors">Experiments</a></li>
          <li><a href="/classes" class="hover:text-white transition-colors">Curriculum</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-lg font-semibold mb-4">Contact</h4>
        <ul class="space-y-2 text-gray-400">
          <li>chuck@c00lnerd.com</li>
          <li>Free consultation available</li>
        </ul>
      </div>
    </div>
    <div class="border-t border-gray-800 mt-8 pt-8 text-center text-gray-400">
      <p>&copy; 2024 C00lnerd Tutoring. All rights reserved.</p>
    </div>
  </div>
</footer>

</Layout>
