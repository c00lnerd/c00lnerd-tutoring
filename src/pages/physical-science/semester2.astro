<Layout title="Physical Science - Semester 2 Pacing Guide">
	<h1>Physical Science Semester 2 - Pacing Guide</h1>
	<p class="intro">This page uses day numbers (not dates) so you can align it to your own calendar.</p>

	{pacing.map((mod) => (
		<section class="module">
			<h2>{mod.module}</h2>
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th>Day</th>
							<th>Assignment</th>
						</tr>
					</thead>
					<tbody>
						{mod.days.map((d) => (
							<tr>
								<td class="day">{d.day ?? '—'}</td>
								<td>{d.text}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>
	))}

	<style>
		h1 {
			text-align: center;
			margin: 2rem 0 0.5rem;
		}
		.intro {
			text-align: center;
			margin: 0 0 2rem;
			color: var(--gray);
		}
		.module {
			margin: 2.5rem 0;
		}
		.module h2 {
			margin: 0 0 1rem;
			color: var(--accent);
		}
		.table-wrap {
			overflow-x: auto;
			background: var(--gray-light);
			border-radius: 0.5rem;
			padding: 1rem;
		}
		table {
			width: 100%;
			border-collapse: collapse;
		}
		th,
		td {
			padding: 0.75rem;
			border-bottom: 1px solid rgba(0, 0, 0, 0.08);
			vertical-align: top;
		}
		th {
			text-align: left;
			font-weight: 700;
		}
		.day {
			white-space: nowrap;
			font-weight: 700;
			width: 7rem;
		}
	</style>
</Layout>
