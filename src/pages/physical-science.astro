			<div class="resource-links">
				<a href="/practice/module11_quiz" class="resource-link">Take Quiz</a>
				<a href="/practice/module11_study_guide" class="resource-link">Study Guide</a>
				<a href="/simulations/experiment11_1" class="resource-link">Experiment 11.1</a>
				<a href="/simulations/experiment11_2" class="resource-link">Experiment 11.2</a>
