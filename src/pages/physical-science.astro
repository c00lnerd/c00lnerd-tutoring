			</div>
		</div>
		<div class="resource-card highlight-card">
			<h2>Module 14</h2>
			<p>Chemistry and Physics in the Life Sciences</p>
			<div class="resource-links">
				<a href="/practice/module14_quiz" class="resource-link">Take Quiz</a>
				<a href="/simulations/experiment14_1" class="resource-link">Experiment 14.1</a>
			</div>
		</div>
		<div class="resource-card highlight-card">
			<h2>Module 15</h2>
			<p>Physical Science Research</p>
			<div class="resource-links">
				<a href="/practice/module15_quiz" class="resource-link">Take Quiz</a>
			</div>
		</div>
		<div class="resource-card highlight-card ai-module">
			<h2>Module 15a</h2>
			<p>Safe and Ethical Use of AI in Education</p>
			<div class="ai-badge">
				<span class="badge">🤖 AI Ethics</span>
			</div>
			<div class="resource-links">
				<a href="/modules/module15a" class="resource-link">Study Content</a>
				<a href="/practice/module15a_quiz" class="resource-link">Take Quiz</a>
			</div>
		</div>
	</div>

	<!-- Final Exam Section -->
	<div class="final-exam-section">
		<div class="final-exam-card">
			<h2>🎓 Final Exam</h2>
			<p class="final-exam-description">Comprehensive assessment covering all 15 modules of Physical Science. This is an <strong>open book/notes</strong> exam that tests your understanding of key concepts from your entire journey through physical science.</p>
			<div class="final-exam-details">
				<div class="exam-detail">
					<strong>📚 Format:</strong> Open Book & Notes
				</div>
				<div class="exam-detail">
					<strong>📝 Questions:</strong> 30 Comprehensive Questions
				</div>
				<div class="exam-detail">
					<strong>🎯 Coverage:</strong> All Modules 1-15
				</div>
			</div>
			<div class="final-exam-button">
				<a href="/practice/final_exam" class="final-exam-link">Take Final Exam</a>
			</div>
		</div>
	</div>

	<style>
		h1 {
			text-align: center;
			margin: 2rem 0;
		}
		.resources-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
			gap: 2rem;
			padding: 1rem;
		}
		.resource-card {
			background: var(--gray-light);
			padding: 2rem;
			border-radius: 0.5rem;
			text-align: center;
			transition: transform 0.3s ease, box-shadow 0.3s ease;
		}
		.resource-card:hover {
			transform: translateY(-5px);
			box-shadow: 0 10px 20px rgba(0,0,0,0.1);
		}
		.highlight-card {
			background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
			border: 2px solid var(--accent);
			box-shadow: 0 5px 15px rgba(0,0,0,0.1);
		}
		.resource-card h2 {
			color: var(--accent);
			margin: 0 0 1rem 0;
		}
		.highlight-card h2 {
			color: #2c3e50;
			font-weight: bold;
		}
		.resource-card p {
			color: var(--gray);
			margin: 0 0 1.5rem 0;
			line-height: 1.5;
		}
		.resource-links {
			display: flex;
			flex-wrap: wrap;
			gap: 10px;
			justify-content: center;
		}
		.resource-link {
			display: inline-block;
			background: var(--accent);
			color: white;
			padding: 0.5rem 1.5rem;
			border-radius: 0.25rem;
			text-decoration: none;
			transition: background-color 0.2s, transform 0.2s;
			margin: 5px;
		}
		.resource-link:hover {
			background: var(--accent-dark);
			transform: scale(1.05);
		}

		/* Final Exam Section Styles */
		.final-exam-section {
			margin: 3rem auto;
			max-width: 800px;
			padding: 0 1rem;
		}

		.final-exam-card {
			background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
			color: white;
			padding: 3rem 2rem;
			border-radius: 1rem;
			text-align: center;
			box-shadow: 0 15px 35px rgba(0,0,0,0.2);
			transition: transform 0.3s ease, box-shadow 0.3s ease;
			border: 3px solid #f39c12;
		}

		.final-exam-card:hover {
			transform: translateY(-8px);
			box-shadow: 0 20px 40px rgba(0,0,0,0.3);
		}

		.final-exam-card h2 {
			color: white;
			font-size: 2.5rem;
			margin: 0 0 1rem 0;
			font-weight: bold;
			text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
		}

		.final-exam-description {
			font-size: 1.2rem;
			line-height: 1.6;
			margin: 0 0 2rem 0;
			color: #f8f9fa;
		}

		.final-exam-details {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
			gap: 1rem;
			margin: 2rem 0;
		}

		.exam-detail {
			background: rgba(255,255,255,0.1);
			padding: 1rem;
			border-radius: 0.5rem;
			backdrop-filter: blur(10px);
			border: 1px solid rgba(255,255,255,0.2);
		}

		.final-exam-button {
			margin-top: 2rem;
		}

		.final-exam-link {
			display: inline-block;
			background: #f39c12;
			color: white;
			padding: 1rem 3rem;
			border-radius: 2rem;
			text-decoration: none;
			font-size: 1.3rem;
			font-weight: bold;
			transition: all 0.3s ease;
			text-transform: uppercase;
			letter-spacing: 1px;
			box-shadow: 0 5px 15px rgba(243, 156, 18, 0.4);
		}

		.final-exam-link:hover {
			background: #e67e22;
			transform: scale(1.05);
			box-shadow: 0 8px 25px rgba(243, 156, 18, 0.6);
		}

		@media (max-width: 768px) {
			.final-exam-card {
				padding: 2rem 1rem;
			}
			
			.final-exam-card h2 {
				font-size: 2rem;
			}
			
			.final-exam-description {
				font-size: 1rem;
			}
			
			.final-exam-details {
				grid-template-columns: 1fr;
			}
		}

		/* AI Module Specific Styles */
		.ai-module {
			background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
			color: white;
			border: 2px solid #9b59b6;
		}

		.ai-module h2 {
			color: white;
			text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
		}

		.ai-module p {
			color: #f8f9fa;
		}

		.ai-badge {
			margin: 10px 0;
		}

		.badge {
			display: inline-block;
			background: rgba(255,255,255,0.2);
			color: white;
			padding: 5px 12px;
			border-radius: 20px;
			font-size: 14px;
			font-weight: bold;
			backdrop-filter: blur(10px);
			border: 1px solid rgba(255,255,255,0.3);
			text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
		}

		.ai-module .resource-link {
			background: #9b59b6;
			border: 2px solid rgba(255,255,255,0.3);
		}

		.ai-module .resource-link:hover {
			background: #8e44ad;
			transform: scale(1.05);
			box-shadow: 0 5px 15px rgba(155, 89, 182, 0.4);
		}
		.highlight-card .resource-link {
			background: #3498db;
		}
		.highlight-card .resource-link:hover {
			background: #2980b9;
		}
	</style>
</Layout>
