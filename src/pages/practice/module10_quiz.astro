---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Physical Science Module 10 Quiz">
    <div class="container">
        <h1>Physical Science Module 10 Quiz</h1>
        
        <div class="email-input" id="email-section">
            <label for="email">Enter your email (optional):</label>
            <input type="email" id="email" placeholder="your.email@example.com">
            <div>
                <input type="checkbox" id="save-results" checked>
                <label for="save-results">Save results and send to instructor</label>
            </div>            
            <!-- Anti-Spam CAPTCHA -->
            <div class="captcha-section">
                <label for="captcha">Security Check: What is <span id="captcha-question"></span>?</label>
                <input type="number" id="captcha" placeholder="Enter the answer" required>
                <div id="captcha-error" class="captcha-error" style="display: none;">Incorrect answer. Please try again.</div>
            </div>
            
            <!-- Honeypot field (hidden from users, visible to bots) -->
            <input type="text" id="website" name="website" style="display: none;" tabindex="-1" autocomplete="off">
            <div id="cooldown-timer" class="cooldown-timer" style="display: none;"></div>
            <button class="control-button" id="start-quiz">Start Quiz</button>
        </div>

        <div id="quiz-container" style="display: none;">
            <div class="progress-bar">
                <div class="fill"></div>
            </div>
            <div id="question-number"></div>
            <div id="question-text"></div>
            <div class="options"></div>
            <div id="feedback" class="feedback"></div>
            <div class="controls">
                <button id="prevBtn" class="control-button" onclick="previousQuestion()">Previous Question</button>
                <button id="nextBtn" class="control-button" onclick="nextQuestion()">Next Question</button>
                <button id="submitBtn" class="control-button" onclick="submitQuiz()" style="display: none;">Submit Quiz</button>
            </div>
        </div>

        <div id="results" style="display: none;">
            <h2>Quiz Results</h2>
            <div id="score"></div>
            <div id="email-status" class="email-status"></div>
            <div id="incorrect-answers"></div>
            <div class="result-buttons">
                <button id="download-results" class="control-button">Download Results</button>
                <button id="restart-quiz" class="control-button" onclick="window.location.reload()">Restart Quiz</button>
            </div>
        </div>
    </div>
</Layout>

<style>
    .container {
        max-width: 800px;
        margin: 0 auto;
        padding: 20px;
    }
    .question {
        margin-bottom: 20px;
    }
    #question-number {
        font-size: 18px;
        font-weight: 500;
        margin-bottom: 15px;
    }
    #question-text {
        font-size: 16px;
        margin-bottom: 20px;
    }
    .options {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .option-button {
        padding: 10px 15px;
        border: 1px solid #ddd;
        border-radius: 5px;
        background: white;
        cursor: pointer;
        transition: all 0.2s;
        text-align: left;
    }
    .option-button:hover {
        background: #f5f5f5;
    }
    .option-button.selected {
        background: #e0e0e0;
    }
    .option-button.correct {
        background: #d4edda;
        border-color: #c3e6cb;
        color: #155724;
    }
    .option-button.incorrect {
        background: #f8d7da;
        border-color: #f5c6cb;
        color: #721c24;
    }
    .feedback {
        margin: 20px 0;
        padding: 15px;
        border-radius: 5px;
        display: none;
    }
    .feedback.correct {
        background: #d4edda;
        border-color: #c3e6cb;
        color: #155724;
    }
    .feedback.incorrect {
        background: #f8d7da;
        border-color: #f5c6cb;
        color: #721c24;
    }
    .progress-bar {
        width: 100%;
        height: 10px;
        background: #e0e0e0;
        border-radius: 5px;
        margin-bottom: 20px;
        overflow: hidden;
    }
    .progress-bar .fill {
        height: 100%;
        background: #4caf50;
        width: 0%;
        transition: width 0.3s ease;
    }
    .controls {
        display: flex;
        justify-content: space-between;
        margin-top: 20px;
    }
    .control-button {
        padding: 10px 20px;
        background: #4a6fa5;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background 0.2s;
    }
    .control-button:hover {
        background: #3a5a80;
    }
    .control-button:disabled {
        background: #cccccc;
        cursor: not-allowed;
    }
    .email-input {
        margin-bottom: 30px;
    }
    .email-input label {
        display: block;
        margin-bottom: 5px;
    }
    .email-input input[type="email"] {
        width: 100%;
        padding: 8px;
        margin-bottom: 10px;
        border: 1px solid #ddd;
        border-radius: 4px;
    }
    .result-buttons {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }
    .email-status {
        margin: 10px 0;
        padding: 10px;
        border-radius: 5px;
    }
    .email-status.success {
        background: #d4edda;
        color: #155724;
    }
    .email-status.error {
        background: #f8d7da;
        color: #721c24;
    }
    .captcha-section {
        margin: 15px 0;
        padding: 15px;
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 5px;
    }
    .captcha-section label {
        display: block;
        margin-bottom: 8px;
        font-weight: bold;
        color: #495057;
    }
    .captcha-section input[type="number"] {
        width: 100px;
        padding: 8px;
        border: 1px solid #ced4da;
        border-radius: 3px;
        font-size: 16px;
    }
    .captcha-error {
        color: #dc3545;
        font-size: 0.9em;
        margin-top: 5px;
        font-weight: bold;
    }
    .cooldown-timer {
        margin-top: 10px;
        font-size: 0.95em;
        color: #856404;
        background-color: #fff3cd;
        border: 1px solid #ffeeba;
        border-radius: 4px;
        padding: 8px 12px;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js" is:inline></script>
<script is:inline>
    // CAPTCHA variables
    let captchaAnswer = 0;

    function generateCaptcha() {
        const num1 = Math.floor(Math.random() * 10) + 1;
        const num2 = Math.floor(Math.random() * 10) + 1;
        captchaAnswer = num1 + num2;
        const questionElement = document.getElementById('captcha-question');
        if (questionElement) {
            questionElement.textContent = num1 + " + " + num2;
        }
    }

    function validateCaptcha() {
        const captchaEl = document.getElementById('captcha');
        const errorDiv = document.getElementById('captcha-error');
        if (!captchaEl) return false;

        const userAnswer = parseInt(captchaEl.value);

        if (userAnswer !== captchaAnswer) {
            if (errorDiv) errorDiv.style.display = 'block';
            generateCaptcha();
            captchaEl.value = '';
            return false;
        }

        if (errorDiv) errorDiv.style.display = 'none';
        return true;
    }

    // Security validation function
    let cooldownInterval = null;

    function startCooldown(remainingMs) {
        const cooldownDiv = document.getElementById('cooldown-timer');
        const startButton = document.getElementById('start-quiz');
        if (!cooldownDiv || !startButton) return;

        if (cooldownInterval) {
            clearInterval(cooldownInterval);
            cooldownInterval = null;
        }

        let remainingSeconds = Math.ceil(remainingMs / 1000);
        cooldownDiv.style.display = 'block';
        startButton.disabled = true;

        const updateText = () => {
            if (remainingSeconds <= 0) {
                clearInterval(cooldownInterval);
                cooldownInterval = null;
                cooldownDiv.style.display = 'none';
                startButton.disabled = false;
                return;
            }
            cooldownDiv.textContent = `Please wait ${remainingSeconds} second${remainingSeconds === 1 ? '' : 's'} before starting another quiz attempt.`;
            remainingSeconds--;
        };

        updateText();
        cooldownInterval = setInterval(updateText, 1000);
    }

    function validateSecurity() {
        // Check honeypot field (should be empty)
        const honeypot = document.getElementById('website');
        if (honeypot && honeypot.value) {
            console.log('Spam bot detected via honeypot');
            alert('Security check failed. Please try again.');
            return false;
        }
        
        // Rate limiting check
        const lastSubmission = localStorage.getItem('lastQuizStart');
        const now = Date.now();
        if (lastSubmission) {
            const elapsed = now - parseInt(lastSubmission);
            if (elapsed < 30000) { // 30 second cooldown
                const remaining = 30000 - elapsed;
                startCooldown(remaining);
                alert('Please wait 30 seconds between quiz attempts.');
                return false;
            }
        }
        localStorage.setItem('lastQuizStart', now.toString());
        
        // Validate CAPTCHA
        if (!validateCaptcha()) {
            return false;
        }
        
        // Email validation and domain filtering
        const emailInput = document.getElementById('email');
        if (emailInput && emailInput.value) {
            const email = emailInput.value;
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                alert('Please enter a valid email address.');
                return false;
            }
            
            // Block common spam domains
            const spamDomains = ['tempmail.org', '10minutemail.com', 'guerrillamail.com', 'mailinator.com', 'throwaway.email'];
            const domain = email.split('@')[1].toLowerCase();
            if (spamDomains.includes(domain)) {
                alert('Please use a permanent email address.');
                return false;
            }
        }
        
        return true;
    }

    // Wait for EmailJS to load before initializing
    window.onload = function() {
        try {
            emailjs.init("ct_s19oZHppLy9BlW");
        } catch (err) {
            console.error('Error initializing EmailJS:', err);
        }
    };

    // Utility function to shuffle array and track original indices
    function shuffleAnswers(question) {
        const originalOptions = [...question.options];
        const correctAnswerIndex = question.correctAnswer;
        
        // Create array of indices
        const indices = originalOptions.map((_, index) => index);
        
        // Fisher-Yates shuffle
        for (let i = indices.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [indices[i], indices[j]] = [indices[j], indices[i]];
        }
        
        // Apply shuffle to options and find new correct answer index
        const shuffledOptions = indices.map(i => originalOptions[i]);
        const newCorrectAnswerIndex = indices.indexOf(correctAnswerIndex);
        
        return {
            ...question,
            options: shuffledOptions,
            correctAnswer: newCorrectAnswerIndex,
            originalOrder: indices
        };
    }

    // Initialize randomized questions when quiz starts
    function initializeQuiz() {
        // Shuffle answers for each question
        window.questions = originalQuestions.map(question => shuffleAnswers(question));
        
        // Initialize quiz state after questions are randomized
        window.currentQuestion = 0;
        window.userAnswers = new Array(window.questions.length).fill(null);
