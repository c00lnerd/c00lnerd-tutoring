    // Quiz state
    window.currentQuestion = 0;
    window.userAnswers = new Array(originalQuestions.length).fill(null);
    window.questionAttempts = new Array(originalQuestions.length).fill(0);
    window.quizStarted = false;

    // Initialize when DOM is loaded
    document.addEventListener('DOMContentLoaded', function() {
        const startButton = document.getElementById('start-quiz');
        const emailInput = document.getElementById('email');
        const captchaInput = document.getElementById('captcha');
        const downloadButton = document.getElementById('download-results');
        
        // Load saved email if exists
        const savedEmail = localStorage.getItem('studentEmail');
        if (savedEmail) {
            emailInput.value = savedEmail;
        }

        generateCaptcha();
        
        // Start quiz button
        startButton.addEventListener('click', function() {
            if (!validateSecurity()) return;

            const email = emailInput?.value || '';
            const saveResults = document.getElementById('save-results').checked;

            if (email) localStorage.setItem('studentEmail', email);

            window.userEmail = email;
            window.saveResults = saveResults;
            
            // Initialize quiz with randomized answers
            initializeQuiz();
            
            document.getElementById('email-section').style.display = 'none';
            document.getElementById('quiz-container').style.display = 'block';
            
            showQuestion();
            updateProgressBar();
        });

        function handleStartKeydown(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                startButton.click();
            }
        }

        if (emailInput) emailInput.addEventListener('keydown', handleStartKeydown);
        if (captchaInput) captchaInput.addEventListener('keydown', handleStartKeydown);
        
        // Download results button
        downloadButton.addEventListener('click', function() {
            downloadResults();
        });
    });

    // Show question by index
    function showQuestion(index = window.currentQuestion || 0) {
        const question = window.questions[index];
        const questionNumber = document.getElementById('question-number');
        const questionText = document.getElementById('question-text');
        const options = document.querySelector('.options');
        const feedback = document.getElementById('feedback');
        const prevButton = document.getElementById('prevBtn');
        const nextButton = document.getElementById('nextBtn');
        const submitButton = document.getElementById('submitBtn');
        
        // Update progress bar
        const progressBar = document.querySelector('.progress-bar .fill');
        progressBar.style.width = `${((index + 1) / window.questions.length) * 100}%`;
        
        // Set question text
        questionNumber.textContent = `Question ${index + 1} of ${window.questions.length}`;
        questionText.textContent = question.question;
        
        // Clear options and feedback
        options.innerHTML = '';
        feedback.style.display = 'none';
        
        // Add options
        question.options.forEach((option, optionIndex) => {
            const button = document.createElement('button');
            button.className = 'option-button';
            button.textContent = option;
            
            // Mark selected if previously answered
            if (window.userAnswers[index] === optionIndex) {
                button.classList.add('selected');
            }
            
            button.addEventListener('click', function() {
                selectAnswer(optionIndex);
            });
            
            options.appendChild(button);
        });
        
        // Update button visibility
        prevButton.style.display = index > 0 ? 'block' : 'none';
        nextButton.style.display = index < window.questions.length - 1 ? 'block' : 'none';
        submitButton.style.display = index === window.questions.length - 1 ? 'block' : 'none';
        
        // Update current question index
        window.currentQuestion = index;
    }

    function updateProgressBar() {
        const progressBar = document.querySelector('.progress-bar .fill');
        if (!progressBar) return;
        const index = window.currentQuestion || 0;
        progressBar.style.width = `${((index + 1) / window.questions.length) * 100}%`;
    }

    function selectAnswer(selectedIndex) {
        const options = document.querySelectorAll('.option-button');
        const feedback = document.getElementById('feedback');
        const currentQuestion = window.questions[window.currentQuestion];
        
        // Increment attempt counter
        window.questionAttempts[window.currentQuestion]++;
        
        // Update user answer
        window.userAnswers[window.currentQuestion] = selectedIndex;
        
        // Clear previous selections
        options.forEach(option => {
            option.classList.remove('selected', 'correct', 'incorrect');
        });
        
        // Mark selected option
        options[selectedIndex].classList.add('selected');
        
        // Show feedback
        const isCorrect = selectedIndex === currentQuestion.correctAnswer;
        feedback.textContent = isCorrect ? 
            'Correct! ' + currentQuestion.reference : 
            'Incorrect. ' + currentQuestion.reference;
        feedback.className = 'feedback ' + (isCorrect ? 'correct' : 'incorrect');
        feedback.style.display = 'block';
        
        // Mark correct/incorrect
        options[selectedIndex].classList.add(isCorrect ? 'correct' : 'incorrect');
        if (!isCorrect) {
            options[currentQuestion.correctAnswer].classList.add('correct');
        }
        
        // Keep consistent with other modules - no auto-advance
        // User manually clicks Next button for consistent UX
    }

    function previousQuestion() {
        if (window.currentQuestion > 0) {
            showQuestion(window.currentQuestion - 1);
        }
    }

    function nextQuestion() {
        if (window.currentQuestion < window.questions.length - 1) {
            showQuestion(window.currentQuestion + 1);
        }
    }

    function submitQuiz() {
        const score = window.userAnswers.reduce((total, answer, index) => {
            return total + (answer === window.questions[index].correctAnswer ? 1 : 0);
        }, 0);

        const percentage = Math.round((score / window.questions.length) * 100);
        
        // Hide quiz container
        document.getElementById('quiz-container').style.display = 'none';
        
        // Show results
        document.getElementById('results').style.display = 'block';
        document.getElementById('score').innerHTML = `
            <h3>Your Score: ${score}/${window.questions.length} (${percentage}%)</h3>
        `;
        
        // Show incorrect answers
        showIncorrectAnswers();
        
        // Send results if enabled
        if (window.saveResults) {
            sendResultsEmail(window.userEmail || localStorage.getItem('studentEmail') || 'Not provided', score, percentage);
        }
    }

    function showIncorrectAnswers() {
        const incorrectAnswersDiv = document.getElementById('incorrect-answers');
        let incorrectHTML = '<h3>Questions to Review:</h3>';
        
        window.questions.forEach((question, index) => {
            const userAnswer = window.userAnswers[index];
            const isCorrect = userAnswer === question.correctAnswer;
            
            if (!isCorrect) {
                incorrectHTML += `
                    <div class="incorrect-item">
                        <p><strong>Question ${index + 1}:</strong> ${question.question}</p>
                        <p><strong>Your Answer:</strong> ${userAnswer !== null ? question.options[userAnswer] : 'Not answered'}</p>
                        <p><strong>Correct Answer:</strong> ${question.options[question.correctAnswer]}</p>
                        <p><strong>${question.reference}</strong></p>
                    </div>
                `;
            }
        });
        
        incorrectAnswersDiv.innerHTML = incorrectHTML;
    }

    function sendResultsEmail(email, score, percentage) {
        const emailStatus = document.getElementById('email-status');
        emailStatus.textContent = 'Sending results...';
        emailStatus.className = 'email-status';
        
        // Initialize EmailJS
        if (typeof emailjs !== 'undefined') {
            // Prepare results data and format email message similar to Module 6
            const incorrectQuestions = window.questions
                .map((question, index) => {
                    const userAnswer = window.userAnswers[index];
                    if (userAnswer !== question.correctAnswer) {
                        return {
                            question: question.question,
                            userAnswer: userAnswer !== null ? question.options[userAnswer] : 'Not answered',
                            correctAnswer: question.options[question.correctAnswer],
                            reference: question.reference
                        };
                    }
                    return null;
                })
                .filter(q => q !== null);

            let emailMessage = `Physical Science Module 10 Quiz Results\n\n`;
            emailMessage += `Student: ${email}\n`;
            emailMessage += `Quiz: Module 10\n`;
            emailMessage += `Score: ${score}/${window.questions.length} (${percentage}%)\n`;
            emailMessage += `Percentage: ${percentage}%\n`;
            emailMessage += `Date: ${new Date().toLocaleString()}\n\n`;
            
            if (incorrectQuestions.length > 0) {
                emailMessage += "Incorrect Answers:\n\n";
                incorrectQuestions.forEach((item, index) => {
                    emailMessage += `${index + 1}. ${item.question}\n`;
                    emailMessage += `   Your answer: ${item.userAnswer}\n`;
                    emailMessage += `   Correct answer: ${item.correctAnswer}\n\n`;
                });
            } else {
                emailMessage += "Perfect score! All answers were correct.\n";
            }

            // Post to Google Sheets first
            const sheetsData = {
                timestamp: new Date().toISOString(),
                studentEmail: email,
                quizTitle: 'Physical Science Module 10 Quiz',
                score: score,
                totalQuestions: window.questions.length,
                percentage: percentage.toString(),
                incorrectCount: window.questions.length - score,
                timeCompleted: new Date().toLocaleString()
            };

            fetch('https://script.google.com/macros/s/AKfycbwCTsWga539iU8vd7NrWNyldtB9X70BFPoK2tlTOxwhtIS0jNFOV4j1x1mve1hq-Z_B/exec', {
                method: 'POST',
                mode: 'no-cors',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(sheetsData)
            }).then(() => {
                console.log('Google Sheets: Request sent');
            }).catch(error => {
                console.error('Google Sheets: Error logging data:', error);
            });

            // Send EmailJS notification to instructor with standardized format
            const updatedTemplateParams = {
                from_name: 'Physical Science Quiz System',
                to_email: 'Chuck@c00lnerd.com',
                student_email: email || 'Not provided',
                to_name: 'Instructor',
                subject: 'Physical Science Module 10 Quiz Results',
                submission_date: new Date().toLocaleString(),
                message: emailMessage,
                reply_to: email || 'Chuck@c00lnerd.com'
            };

            emailjs
                .send('service_ot1jg6s', 'template_0nxqbk8', updatedTemplateParams)
                .then(() => {
                    emailStatus.textContent = '✓ Results sent successfully to instructor!';
                    emailStatus.className = 'email-status success';
                })
                .catch(error => {
                    console.error('Error sending results:', error);
                    emailStatus.textContent = '✗ Failed to send results via EmailJS. Please try again or contact your instructor.';
                    emailStatus.className = 'email-status error';
                });
        } else {
            emailStatus.textContent = 'Email service not available. Please download your results and send them to your instructor.';
            emailStatus.className = 'email-status error';
        }
    }

    function downloadResults() {
        const score = window.userAnswers.reduce((total, answer, index) => {
            return total + (answer === window.questions[index].correctAnswer ? 1 : 0);
        }, 0);
        
        const percentage = Math.round((score / window.questions.length) * 100);
        
        // Prepare results data
        const resultsData = {
            student_email: localStorage.getItem('studentEmail') || 'Not provided',
            score: score,
            total_questions: window.questions.length,
            percentage: percentage,
            date: new Date().toLocaleString(),
            questions: window.questions.map((question, index) => {
                const userAnswer = window.userAnswers[index];
                return {
                    question: question.question,
                    user_answer: userAnswer !== null ? question.options[userAnswer] : 'Not answered',
                    correct_answer: question.options[question.correctAnswer],
                    is_correct: userAnswer === question.correctAnswer,
                    reference: question.reference
                };
            })
        };
        
        // Convert to JSON string
        const resultsJSON = JSON.stringify(resultsData, null, 2);
        
        // Create download link
        const blob = new Blob([resultsJSON], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'module10_quiz_results.json';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    }
</script>
