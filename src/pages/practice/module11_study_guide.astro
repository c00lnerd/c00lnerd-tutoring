            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-weight: bold;
        }
        
        .solid {
            border: 3px solid #333;
        }
        
        .dashed {
            border: 3px dashed #333;
        }
        
        .positive {
            background-color: #ffcccc;
            color: #e74c3c;
        }
        
        .negative {
            background-color: #cce5ff;
            color: #3498db;
        }
        
        .circuit-diagram {
            text-align: center;
            margin: 20px 0;
