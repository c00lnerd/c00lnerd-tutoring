---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Physical Science Module 13 Quiz">
    <div class="container">
        <h1>Physical Science Module 13 Quiz: Earth's Atmosphere and Beyond</h1>
        
        <div class="email-input" id="email-section">
            <label for="email">Enter your email (optional):</label>
            <input type="email" id="email" placeholder="your.email@example.com">
            <div>
                <input type="checkbox" id="save-results" checked>
                <label for="save-results">Save results and send to instructor</label>
            </div>            
            <!-- Anti-Spam CAPTCHA -->
            <div class="captcha-section">
                <label for="captcha">ðŸ”’ Security Check: What is <span id="captcha-question"></span>?</label>
                <input type="number" id="captcha" placeholder="Enter the answer" required>
                <div id="captcha-error" class="captcha-error" style="display: none;">Incorrect answer. Please try again.</div>
            </div>
            
            <!-- Honeypot field (hidden from users, visible to bots) -->
            <input type="text" id="website" name="website" style="display: none;" tabindex="-1" autocomplete="off">
            <button class="control-button" id="start-quiz">Start Quiz</button>
        </div>

        <div id="quiz-container" style="display: none;">
            <div class="progress-bar">
                <div class="fill" id="progress"></div>
            </div>
            <div id="question-number"></div>
            <div id="question-text"></div>
            <div class="options" id="options"></div>
            <div id="feedback" class="feedback"></div>
            <div class="controls">
                <button id="prevBtn" class="control-button" onclick="previousQuestion()">Previous Question</button>
                <button id="nextBtn" class="control-button" onclick="nextQuestion()">Next Question</button>
                <button id="submitBtn" class="control-button" onclick="submitQuiz()" style="display: none;">Submit Quiz</button>
            </div>
        </div>

        <div id="results" style="display: none;">
            <h2>Quiz Results</h2>
            <div id="score"></div>
            <div id="email-status" class="email-status"></div>
            <div id="incorrect-answers"></div>
            <div class="result-buttons">
                <button id="download-results" class="control-button">Download Results</button>
                <button id="restart-quiz" class="control-button" onclick="window.location.reload()">Restart Quiz</button>
            </div>
        </div>
    </div>

    <!-- Load EmailJS before initializing -->
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js" is:inline></script>
    <script type="text/javascript" is:inline>
        // Wait for EmailJS to load before initializing
        window.onload = function() {
            if (typeof emailjs !== 'undefined') {
                emailjs.init("ct_s19oZHppLy9BlW");
    // CAPTCHA variables
    let captchaAnswer = 0;
    
    function generateCaptcha() {
        const num1 = Math.floor(Math.random() * 10) + 1;
        const num2 = Math.floor(Math.random() * 10) + 1;
        captchaAnswer = num1 + num2;
        const questionElement = document.getElementById('captcha-question');
        if (questionElement) {
            questionElement.textContent = num1 + " + " + num2;
        }
    }
    
    function validateCaptcha() {
        const userAnswer = parseInt(document.getElementById('captcha').value);
        const errorDiv = document.getElementById('captcha-error');
        
        if (userAnswer !== captchaAnswer) {
            if (errorDiv) errorDiv.style.display = 'block';
            generateCaptcha(); // Generate new question
            document.getElementById('captcha').value = '';
            return false;
        }
        
        if (errorDiv) errorDiv.style.display = 'none';
        return true;
    }
    
    // Security validation function
    function validateSecurity() {
        // Check honeypot field (should be empty)
        const honeypot = document.getElementById('website');
        if (honeypot && honeypot.value) {
            console.log('Spam bot detected via honeypot');
            alert('Security check failed. Please try again.');
            return false;
        }
        
        // Rate limiting check
        const lastSubmission = localStorage.getItem('lastQuizStart');
        const now = Date.now();
        if (lastSubmission && (now - parseInt(lastSubmission)) < 30000) { // 30 second cooldown
            alert('Please wait 30 seconds between quiz attempts.');
            return false;
        }
        localStorage.setItem('lastQuizStart', now.toString());
        
        // Validate CAPTCHA
        if (!validateCaptcha()) {
            return false;
        }
        
        // Email validation and domain filtering
        const emailInput = document.getElementById('email');
        if (emailInput && emailInput.value) {
            const email = emailInput.value;
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                alert('Please enter a valid email address.');
                return false;
            }
            
            // Block common spam domains
            const spamDomains = ['tempmail.org', '10minutemail.com', 'guerrillamail.com', 'mailinator.com', 'throwaway.email'];
            const domain = email.split('@')[1].toLowerCase();
            if (spamDomains.includes(domain)) {
                alert('Please use a permanent email address.');
                return false;
            }
        }
        
        return true;
    }
                console.log("EmailJS initialized successfully");
            } else {
                console.error("EmailJS failed to load");
            }
        };
    </script>

    <script is:inline>
        // Utility function to shuffle array and track original indices
        function shuffleAnswers(question) {
            const originalOptions = [...question.options];
            const correctAnswerIndex = question.correctAnswer;
            
            // Create array of indices
            const indices = originalOptions.map((_, index) => index);
            
            // Fisher-Yates shuffle
            for (let i = indices.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [indices[i], indices[j]] = [indices[j], indices[i]];
            }
            
            // Apply shuffle to options and find new correct answer index
            const shuffledOptions = indices.map(i => originalOptions[i]);
            const newCorrectAnswerIndex = indices.indexOf(correctAnswerIndex);
            
            return {
                ...question,
                options: shuffledOptions,
                correctAnswer: newCorrectAnswerIndex,
                originalOrder: indices
            };
        }

        // Initialize randomized questions when quiz starts
        function initializeQuiz() {
            // Shuffle answers for each question
            window.questions = originalQuestions.map(question => shuffleAnswers(question));
            
            // Initialize quiz state after questions are randomized
            window.currentQuestion = 0;
            window.userAnswers = new Array(window.questions.length).fill(null);
            window.questionAttempts = new Array(window.questions.length).fill(0);
            
            console.log('Module 13 quiz initialized with randomized answers');
        }

        // Define questions first
        const originalQuestions = [
            {
                question: "What is the main component of Earth's atmosphere by percentage?",
                options: ["Oxygen at approximately 21% of the atmosphere", "Nitrogen comprising about 78% of Earth's atmosphere", "Carbon Dioxide which is a trace gas in the atmosphere", "Argon which makes up less than 1% of the atmosphere"],
                correctAnswer: 1,
                explanation: "Nitrogen makes up about 78.08% of Earth's atmosphere by volume."
            },
            {
                question: "What percentage of Earth's atmosphere is oxygen?",
                options: ["10.5%", "20.95%", "30.2%", "45.7%"],
                correctAnswer: 1,
                explanation: "Oxygen makes up about 20.95% of Earth's atmosphere by volume."
            },
            {
                question: "Which of the following is NOT a function of Earth's atmosphere?",
                options: ["Providing oxygen for respiration", "Protecting from meteoroids", "Creating fossil fuels", "Enabling sound transmission"],
                correctAnswer: 2,
                explanation: "While the atmosphere provides oxygen, protects from meteoroids, and enables sound transmission, it does not create fossil fuels. Fossil fuels are formed from ancient organic matter buried under sediment."
            },
            {
                question: "What process is responsible for the water cycle in Earth's atmosphere?",
                options: ["Photosynthesis", "Respiration", "Evaporation and condensation", "Nuclear fusion"],
                correctAnswer: 2,
                explanation: "The water cycle involves water evaporating from Earth's surface, rising as water vapor, cooling and condensing into clouds, and then falling as precipitation."
            },
            {
                question: "What is the greenhouse effect?",
                options: ["The process by which plants grow in a greenhouse", "The warming of Earth's surface due to certain gases trapping heat", "The cooling effect of ice caps", "The process of ozone depletion"],
                correctAnswer: 1,
                explanation: "The greenhouse effect is the process by which certain gases (like CO2, water vapor, and methane) trap heat radiating from Earth, warming the atmosphere."
            },
            {
                question: "Which gas is primarily responsible for the greenhouse effect?",
                options: ["Nitrogen", "Oxygen", "Carbon dioxide", "Argon"],
                correctAnswer: 2,
                explanation: "While water vapor is the most abundant greenhouse gas, carbon dioxide plays a critical role in regulating Earth's temperature through the greenhouse effect."
            },
            {
                question: "Why is Earth's atmosphere important for sound?",
                options: ["It creates sound", "It provides a medium for sound waves to travel through", "It amplifies sound", "It converts sound to light"],
                correctAnswer: 1,
                explanation: "Sound requires a medium to travel through, and the gases in our atmosphere provide that medium. Without atmosphere, we wouldn't hear birds singing, people laughing, or most other sounds."
            },
            {
                question: "What would happen to Earth's temperature without the atmosphere?",
                options: ["It would remain the same", "It would be slightly warmer", "It would be similar to the moon's—boiling hot during the day and freezing cold at night", "It would be consistently cold"],
                correctAnswer: 2,
                explanation: "Without our atmosphere, Earth's surface would be similar to the moon's—boiling hot during the day and freezing cold at night, as there would be no gases to moderate temperature."
            },
            {
                question: "What percentage of carbon dioxide is present in Earth's atmosphere?",
                options: ["0.037%", "0.93%", "5.2%", "12.8%"],
                correctAnswer: 0,
                explanation: "Carbon dioxide makes up only about 0.037% of Earth's atmosphere by volume, yet it plays a crucial role in regulating temperature."
            },
            {
                question: "Which of the following is NOT a way the atmosphere protects life on Earth?",
                options: ["Filtering harmful UV radiation", "Burning up most meteoroids", "Providing oxygen for respiration", "Creating magnetic fields"],
                correctAnswer: 3,
                explanation: "Earth's magnetic field, not the atmosphere, protects us from solar wind and cosmic radiation. The atmosphere does filter UV radiation, burn up meteoroids, and provide oxygen."
            }
        ];

        // Quiz state
        window.currentQuestion = 0;
        window.userAnswers = new Array(originalQuestions.length).fill(null);
        window.userEmail = '';
        window.saveResults = false;

        // Load saved email when page loads
        document.addEventListener('DOMContentLoaded', function() {
            const savedEmail = localStorage.getItem('studentEmail');
            if (savedEmail) {
                document.getElementById('email').value = savedEmail;
            }
        });

        // Start quiz function
        document.getElementById('start-quiz').addEventListener('click', function() {
            const email = document.getElementById('email').value;
            const saveResults = document.getElementById('save-results').checked;
            
            window.userEmail = email;
            window.saveResults = saveResults;
            
            initializeQuiz();
            
            document.getElementById('email-section').style.display = 'none';
            document.getElementById('quiz-container').style.display = 'block';
            
            window.quizStarted = true;
            showQuestion();
        });

        function showQuestion() {
            const question = window.questions[window.currentQuestion];
            document.getElementById('question-number').textContent = `Question ${window.currentQuestion + 1} of ${window.questions.length}`;
            document.getElementById('question-text').textContent = question.question;
            
            const optionsContainer = document.getElementById('options');
            optionsContainer.innerHTML = '';
            
            question.options.forEach((option, index) => {
                const button = document.createElement('button');
                button.className = 'option-button';
                button.textContent = option;
                button.onclick = () => selectAnswer(index);
                optionsContainer.appendChild(button);
            });
            
            // Update progress bar
            const progress = ((window.currentQuestion + 1) / window.questions.length) * 100;
            document.getElementById('progress').style.width = `${progress}%`;
            
            // Show/hide navigation buttons
            document.getElementById('prevBtn').style.display = window.currentQuestion > 0 ? 'inline-block' : 'none';
            document.getElementById('nextBtn').style.display = 'none';
            document.getElementById('submitBtn').style.display = 'none';
            
            // Hide feedback
            document.getElementById('feedback').style.display = 'none';
            
            // Restore previous answer if exists
            if (window.userAnswers[window.currentQuestion] !== null) {
                const buttons = document.querySelectorAll('.option-button');
                buttons[window.userAnswers[window.currentQuestion]].classList.add('selected');
                showFeedback();
            }
        }

        function selectAnswer(selectedIndex) {
            const options = document.querySelectorAll('.option-button');
            const feedback = document.getElementById('feedback');
            const currentQuestion = window.questions[window.currentQuestion];
            
            // Clear previous selections
            options.forEach(btn => btn.classList.remove('selected', 'correct', 'incorrect'));
            
            // Mark selected answer
            options[selectedIndex].classList.add('selected');
            window.userAnswers[window.currentQuestion] = selectedIndex;
            
            // Show feedback
            const isCorrect = selectedIndex === currentQuestion.correctAnswer;
            feedback.className = `feedback ${isCorrect ? 'correct' : 'incorrect'}`;
            feedback.innerHTML = isCorrect ? 
                `<p>Correct! ${currentQuestion.explanation}</p>` : 
                `<p>Incorrect. The correct answer is: ${currentQuestion.options[currentQuestion.correctAnswer]}. ${currentQuestion.explanation}</p>`;
            feedback.style.display = 'block';
            
            // Mark correct and incorrect answers
            options[currentQuestion.correctAnswer].classList.add('correct');
            if (!isCorrect) {
                options[selectedIndex].classList.add('incorrect');
            }
            
            // Show navigation buttons
            if (window.currentQuestion < window.questions.length - 1) {
                document.getElementById('nextBtn').style.display = 'inline-block';
            } else {
                document.getElementById('submitBtn').style.display = 'inline-block';
            }
        }

        function showFeedback() {
            const feedback = document.getElementById('feedback');
            const currentQuestion = window.questions[window.currentQuestion];
            const selectedIndex = window.userAnswers[window.currentQuestion];
            
            if (selectedIndex === null) return;
            
            const isCorrect = selectedIndex === currentQuestion.correctAnswer;
            feedback.className = `feedback ${isCorrect ? 'correct' : 'incorrect'}`;
            feedback.innerHTML = isCorrect ? 
                `<p>Correct! ${currentQuestion.explanation}</p>` : 
                `<p>Incorrect. The correct answer is: ${currentQuestion.options[currentQuestion.correctAnswer]}. ${currentQuestion.explanation}</p>`;
            feedback.style.display = 'block';
            
            // Show navigation buttons
            if (window.currentQuestion < window.questions.length - 1) {
                document.getElementById('nextBtn').style.display = 'inline-block';
            } else {
                document.getElementById('submitBtn').style.display = 'inline-block';
            }
        }

        function nextQuestion() {
            if (window.currentQuestion < window.questions.length - 1) {
                window.currentQuestion++;
                showQuestion();
            }
        }

        function previousQuestion() {
            if (window.currentQuestion > 0) {
                window.currentQuestion--;
                showQuestion();
            }
        }

        function submitQuiz() {
            // Ensure userAnswers is initialized
            if (!window.userAnswers) {
                window.userAnswers = new Array(window.questions.length).fill(null);
            }
            
            let score = 0;
            for (let i = 0; i < window.questions.length; i++) {
                if (window.userAnswers[i] === window.questions[i].correctAnswer) {
                    score++;
                }
            }
            
            const percentage = Math.round((score / window.questions.length) * 100);
            
            document.getElementById('quiz-container').style.display = 'none';
            document.getElementById('results').style.display = 'block';
            
            document.getElementById('score').innerHTML = `<h3>Your Score: ${score} out of ${window.questions.length} (${percentage}%)</h3>`;
            
            showFinalResults();
            
            if (window.saveResults && window.userEmail) {
                sendResultsToInstructor(score, percentage);
            }
        }

        function showFinalResults() {
            const detailedResults = document.getElementById('incorrect-answers');
            let resultsHTML = '<h3>Detailed Results:</h3>';

            window.questions.forEach((question, index) => {
                const userAnswer = window.userAnswers[index];
                const isCorrect = userAnswer === question.correctAnswer;
                
                resultsHTML += `
                    <div class="result-item ${isCorrect ? 'correct' : 'incorrect'}">
                        <p><strong>Question ${index + 1}:</strong> ${question.question}</p>
                        <p><strong>Your answer:</strong> ${userAnswer !== null ? question.options[userAnswer] : 'Not answered'}</p>
                        <p><strong>Correct answer:</strong> ${question.options[question.correctAnswer]}</p>
                        <p><strong>Explanation:</strong> ${question.explanation}</p>
                    </div>
                `;
            });

            detailedResults.innerHTML = resultsHTML;
        }

        function sendResultsToInstructor(score, percentage) {
            localStorage.setItem('studentEmail', window.userEmail);
            
            // Format email message like other working quizzes
            let emailMessage = `Physical Science Module 13 Quiz Results\n\n`;
            emailMessage += `Student: ${window.userEmail}\n`;
            emailMessage += `Quiz: Earth's Atmosphere and Beyond\n`;
            emailMessage += `Score: ${score}/${window.questions.length} (${percentage}%)\n`;
            emailMessage += `Percentage: ${percentage}%\n`;
            emailMessage += `Date: ${new Date().toLocaleString()}\n\n`;
            
            // Add incorrect answers details
            const incorrectAnswers = window.userAnswers.reduce((incorrect, answer, index) => {
                if (answer !== window.questions[index].correctAnswer) {
                    incorrect.push({
                        question: window.questions[index].question,
                        userAnswer: (answer !== null && answer !== undefined) ? window.questions[index].options[answer] : 'Not answered',
                        correctAnswer: window.questions[index].options[window.questions[index].correctAnswer],
                        attempts: window.questionAttempts[index] || 0
                    });
                }
                return incorrect;
            }, []);
            
            if (incorrectAnswers.length > 0) {
                emailMessage += "Incorrect Answers:\n\n";
                incorrectAnswers.forEach((item, index) => {
                    emailMessage += `${index + 1}. ${item.question}\n`;
                    emailMessage += `   Your answer: ${item.userAnswer}\n`;
                    emailMessage += `   Correct answer: ${item.correctAnswer}\n`;
                    emailMessage += `   Attempts: ${item.attempts}\n\n`;
                });
            } else {
                emailMessage += "Perfect score! All answers were correct.\n";
            }
            
            const templateParams = {
                to_email: window.userEmail,
                message: emailMessage,
                score: score,
                total: window.questions.length,
                percentage: percentage
            };
            
            if (typeof emailjs !== 'undefined') {
                // Post to Google Sheets first
                const sheetsData = {
                    timestamp: new Date().toISOString(),
                    studentEmail: window.userEmail,
                    quizTitle: 'Physical Science Module 13 Quiz',
                    score: score,
                    totalQuestions: window.questions.length,
                    percentage: percentage.toString(),
                    incorrectCount: window.questions.length - score,
                    timeCompleted: new Date().toLocaleString()
                };

                try {
                    fetch('https://script.google.com/macros/s/AKfycbyyLBmUPqcnnH7204B8-FjK8JGXRjF4HFTJaA9LB9gzpHPWf1up45iEjrLik3DiXfsxaA/exec', {
                        method: 'POST',
                        mode: 'no-cors',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify(sheetsData)
                    }).then(() => {
                        console.log('Google Sheets: Data logged successfully');
                    }).catch(error => {
                        console.error('Google Sheets: Error logging data:', error);
                    });
                } catch (error) {
                    console.error('Google Sheets: Error logging data:', error);
                }

                // Send EmailJS notification to instructor with standardized format
                const updatedTemplateParams = {
                    from_name: 'Physical Science Quiz System',
                    student_email: window.userEmail,
                    to_name: 'Instructor',
                    subject: 'Physical Science Module 13 Quiz Results',
                    submission_date: new Date().toLocaleString(),
                    message: emailMessage,
                    reply_to: window.userEmail
                };

                emailjs.send('service_ot1jg6s', 'template_0nxqbk8', updatedTemplateParams)
                    .then(function(response) {
                        console.log('SUCCESS!', response.status, response.text);
                        document.getElementById('email-status').innerHTML = '<p class="success">✅ Results sent to instructor via email! ✅ Data logged to Google Sheets</p>';
                    }, function(error) {
                        console.log('FAILED...', error);
                        document.getElementById('email-status').innerHTML = '<p class="error">Failed to send results. Please try again.</p>';
                    });
            }
        }

        function generateEmailDetails() {
            let details = '';
            window.questions.forEach((question, index) => {
                const userAnswer = window.userAnswers[index];
                const isCorrect = userAnswer === question.correctAnswer;
                details += `Question ${index + 1}: ${isCorrect ? 'Correct' : 'Incorrect'}\n`;
                details += `Your answer: ${userAnswer !== null ? question.options[userAnswer] : 'Not answered'}\n`;
                details += `Correct answer: ${question.options[question.correctAnswer]}\n\n`;
            });
            return details;
        }
    </script>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
            background-color: #f5f5f5;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            background-color: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
        }

        h1 {
            color: #2c3e50;
            text-align: center;
            margin-bottom: 30px;
            font-size: 28px;
        }

        .email-input {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 30px;
            text-align: center;
        }

        .email-input label {
            display: block;
            margin-bottom: 10px;
            font-weight: bold;
            color: #2c3e50;
        }

        .email-input input[type="email"] {
            width: 100%;
            max-width: 400px;
            padding: 12px;
            margin-bottom: 15px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 16px;
        }

        .email-input div {
            margin-bottom: 15px;
        }

        .email-input input[type="checkbox"] {
            margin-right: 8px;
        }

        .control-button {
            background-color: #3498db;
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 16px;
            transition: background-color 0.3s;
            margin: 5px;
        }

        .control-button:hover {
            background-color: #2980b9;
        }

        .progress-bar {
            width: 100%;
            height: 20px;
            background-color: #ecf0f1;
            border-radius: 10px;
            margin-bottom: 20px;
            overflow: hidden;
        }

        .progress-bar .fill {
            height: 100%;
            background-color: #27ae60;
            transition: width 0.3s ease;
            border-radius: 10px;
        }

        #question-number {
            font-size: 18px;
            color: #7f8c8d;
            margin-bottom: 10px;
        }

        #question-text {
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 20px;
            color: #2c3e50;
            line-height: 1.4;
        }

        .options {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 20px;
        }

        .option-button {
            display: block;
            width: 100%;
            padding: 15px 20px;
            margin-bottom: 8px;
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            cursor: pointer;
            font-size: 16px;
            text-align: left;
            transition: all 0.2s;
            box-sizing: border-box;
        }

        .option-button:hover {
            background-color: #e9ecef;
            border-color: #adb5bd;
        }

        .option-button.selected {
            background-color: #d4edda;
            border-color: #28a745;
            color: #155724;
        }

        .option-button.correct {
            background-color: #d4edda;
            border-color: #28a745;
            color: #155724;
        }

        .option-button.incorrect {
            background-color: #f8d7da;
            border-color: #dc3545;
            color: #721c24;
        }

        .feedback {
            margin: 20px 0;
            padding: 15px;
            border-radius: 8px;
            display: none;
        }

        .feedback.correct {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
            display: block;
        }

        .feedback.incorrect {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
            display: block;
        }

        .controls {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
        }

        #results {
            text-align: center;
        }

        #score {
            font-size: 24px;
            font-weight: bold;
            margin: 20px 0;
            color: #2c3e50;
        }

        .result-buttons {
            margin: 20px 0;
        }

        .result-item {
            background-color: #f8f9fa;
            padding: 15px;
            margin-bottom: 15px;
            border-radius: 8px;
            text-align: left;
        }

        .result-item.correct {
            border-left: 4px solid #27ae60;
        }

        .result-item.incorrect {
            border-left: 4px solid #e74c3c;
        }

        .email-status .success {
            color: #27ae60;
            background: #d4edda;
            padding: 10px;
            border-radius: 6px;
        }

        .email-status .error {
            color: #e74c3c;
            background: #f8d7da;
            padding: 10px;
