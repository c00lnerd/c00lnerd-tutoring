---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Physical Science Module 14 Quiz">
    <div class="container">
        <h1>Physical Science Module 14 Quiz</h1>
        <p class="subtitle">Chemistry and Physics in the Life Sciences</p>
        
        <div class="email-input" id="email-section">
            <label for="email">Enter your email (optional):</label>
            <input type="email" id="email" placeholder="your.email@example.com">
            <div>
                <input type="checkbox" id="save-results" checked>
                <label for="save-results">Save results and send to instructor</label>
            </div>            
            <!-- Anti-Spam CAPTCHA -->
            <div class="captcha-section">
                <label for="captcha">Security Check: What is <span id="captcha-question"></span>?</label>
                <input type="number" id="captcha" placeholder="Enter the answer" required>
                <div id="captcha-error" class="captcha-error" style="display: none;">Incorrect answer. Please try again.</div>
            </div>
            
            <!-- Honeypot field (hidden from users, visible to bots) -->
            <input type="text" id="website" name="website" style="display: none;" tabindex="-1" autocomplete="off">
            <button class="control-button" id="start-quiz" onclick="startQuiz()">Start Quiz</button>
        </div>

        <div id="quiz-container" style="display: none;">
            <div class="progress-bar">
                <div class="fill" id="progress"></div>
            </div>
            <div id="question-number"></div>
            <div id="question-text"></div>
            <div class="options" id="options"></div>
            <div id="feedback" class="feedback"></div>
            <div class="controls">
                <button id="prevBtn" class="control-button" onclick="previousQuestion()" style="display: none;">Previous Question</button>
                <button id="nextBtn" class="control-button" onclick="nextQuestion()" style="display: none;">Next Question</button>
                <button id="submitBtn" class="control-button" onclick="submitQuiz()" style="display: none;">Submit Quiz</button>
            </div>
        </div>

        <div id="results" style="display: none;">
            <h2>Quiz Results</h2>
            <div id="score"></div>
            <div id="email-status" class="email-status"></div>
            <div id="incorrect-answers"></div>
            <div class="result-buttons">
                <button id="download-results" class="control-button">Download Results</button>
                <button id="restart-quiz" class="control-button" onclick="window.location.reload()">Restart Quiz</button>
            </div>
        </div>
    </div>

    <!-- Load EmailJS before initializing -->
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js" is:inline></script>
    <script type="text/javascript" is:inline>
        window.onload = function() {
            try {
                emailjs.init("ct_s19oZHppLy9BlW");
    // CAPTCHA variables
    let captchaAnswer = 0;
    
    function generateCaptcha() {
        const num1 = Math.floor(Math.random() * 10) + 1;
        const num2 = Math.floor(Math.random() * 10) + 1;
        captchaAnswer = num1 + num2;
        const questionElement = document.getElementById('captcha-question');
        if (questionElement) {
            questionElement.textContent = num1 + " + " + num2;
        }
    }
    
    function validateCaptcha() {
        const userAnswer = parseInt(document.getElementById('captcha').value);
        const errorDiv = document.getElementById('captcha-error');
        
        if (userAnswer !== captchaAnswer) {
            if (errorDiv) errorDiv.style.display = 'block';
            generateCaptcha(); // Generate new question
            document.getElementById('captcha').value = '';
            return false;
        }
        
        if (errorDiv) errorDiv.style.display = 'none';
        return true;
    }
    
    // Security validation function
    function validateSecurity() {
        // Check honeypot field (should be empty)
        const honeypot = document.getElementById('website');
        if (honeypot && honeypot.value) {
            console.log('Spam bot detected via honeypot');
            alert('Security check failed. Please try again.');
            return false;
        }
        
        // Rate limiting check
        const lastSubmission = localStorage.getItem('lastQuizStart');
        const now = Date.now();
        if (lastSubmission && (now - parseInt(lastSubmission)) < 30000) { // 30 second cooldown
            alert('Please wait 30 seconds between quiz attempts.');
            return false;
        }
        localStorage.setItem('lastQuizStart', now.toString());
        
        // Validate CAPTCHA
        if (!validateCaptcha()) {
            return false;
        }
        
        // Email validation and domain filtering
        const emailInput = document.getElementById('email');
        if (emailInput && emailInput.value) {
            const email = emailInput.value;
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                alert('Please enter a valid email address.');
                return false;
            }
            
            // Block common spam domains
            const spamDomains = ['tempmail.org', '10minutemail.com', 'guerrillamail.com', 'mailinator.com', 'throwaway.email'];
            const domain = email.split('@')[1].toLowerCase();
            if (spamDomains.includes(domain)) {
                alert('Please use a permanent email address.');
                return false;
            }
        }
        
        return true;
    }
            } catch (error) {
                console.error('Failed to initialize EmailJS:', error);
            }
        }
    </script>

    <script is:inline>
        // Utility function to shuffle array and track original indices
        function shuffleAnswers(question) {
            const originalOptions = [...question.options];
            const correctAnswerIndex = question.correctAnswer;
            
            // Create array of indices
            const indices = originalOptions.map((_, index) => index);
            
            // Fisher-Yates shuffle
            for (let i = indices.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [indices[i], indices[j]] = [indices[j], indices[i]];
            }
            
            // Apply shuffle to options and find new correct answer index
            const shuffledOptions = indices.map(i => originalOptions[i]);
            const newCorrectAnswerIndex = indices.indexOf(correctAnswerIndex);
            
            return {
                ...question,
                options: shuffledOptions,
                correctAnswer: newCorrectAnswerIndex,
                originalOrder: indices
            };
        }

        // Initialize randomized questions when quiz starts
        function initializeQuiz() {
            // Shuffle answers for each question
            window.questions = originalQuestions.map(question => shuffleAnswers(question));
            
            // Initialize quiz state after questions are randomized
            window.currentQuestion = 0;
            window.userAnswers = new Array(window.questions.length).fill(null);
            window.questionAttempts = new Array(window.questions.length).fill(0);
            
            console.log('Module 14 quiz initialized with randomized answers');
        }

        const originalQuestions = [
            {
                question: "What is biochemistry?",
                options: [
                    "The study of chemicals in laboratories and industrial settings",
                    "The study of chemical processes within living organisms",
                    "The study of biological classification",
                    "The study of plant biology only"
                ],
                correctAnswer: 1,
                reference: "Reference: Biochemistry fundamentals"
            },
            {
                question: "What makes carbon special for forming organic compounds?",
                options: [
                    "It is the lightest element",
                    "It can form four covalent bonds and create long chains",
                    "It is the most abundant element",
                    "It only forms simple compounds"
                ],
                correctAnswer: 1,
                reference: "Reference: Carbon chemistry basics"
            },
            {
                question: "Which form of carbon is the hardest natural substance?",
                options: [
                    "Graphite",
                    "Fullerenes", 
                    "Diamond",
                    "Coal"
                ],
                correctAnswer: 2,
                reference: "Reference: Carbon forms"
            },
            {
                question: "What are hydrocarbons?",
                options: [
                    "Compounds containing only hydrogen",
                    "Compounds containing only carbon",
                    "Compounds containing only carbon and hydrogen",
                    "Compounds containing carbon, hydrogen, and oxygen"
                ],
                correctAnswer: 2,
                reference: "Reference: Hydrocarbons"
            },
            {
                question: "What are alkanes?",
                options: [
                    "Hydrocarbons with double bonds",
                    "Hydrocarbons with triple bonds",
                    "Saturated hydrocarbons with only single bonds",
                    "Aromatic hydrocarbons"
                ],
                correctAnswer: 2,
                reference: "Reference: Alkanes"
            },
            {
                question: "What are isomers?",
                options: [
                    "Compounds with different molecular formulas",
                    "Compounds with the same molecular formula but different structures",
                    "Compounds with the same structure but different formulas",
                    "Compounds that are identical in every way"
                ],
                correctAnswer: 1,
                reference: "Reference: Molecular structures and isomers"
            },
            {
                question: "What are the four classes of biochemical compounds?",
                options: [
                    "Proteins, fats, sugars, and vitamins",
                    "Carbohydrates, proteins, lipids, and nucleic acids",
                    "DNA, RNA, proteins, and enzymes",
                    "Sugars, starches, fats, and oils"
                ],
                correctAnswer: 1,
                reference: "Reference: Biochemical compounds"
            },
            {
                question: "What is the equation for photosynthesis?",
                options: [
                    "C₆H₁₂O₆ + 6O₂ → 6CO₂ + 6H₂O + energy",
                    "6CO₂ + 6H₂O + energy → C₆H₁₂O₆ + 6O₂",
                    "6CO₂ + 6O₂ → C₆H₁₂O₆ + 6H₂O",
                    "C₆H₁₂O₆ → 6CO₂ + 6H₂O"
                ],
                correctAnswer: 1,
                reference: "Reference: Photosynthesis equation"
            },
            {
                question: "What role do enzymes play in cells?",
                options: [
                    "They provide energy for reactions",
                    "They act as biological catalysts to speed up reactions",
                    "They store genetic information",
                    "They transport materials"
                ],
                correctAnswer: 1,
                reference: "Reference: Enzymes"
            },
            {
                question: "What does Bernoulli's principle state?",
                options: [
                    "Faster moving fluids have higher pressure",
                    "Faster moving fluids have lower pressure",
                    "All fluids move at the same speed",
                    "Pressure is independent of fluid speed"
                ],
                correctAnswer: 1,
                reference: "Reference: Bernoulli's principle"
            },
            {
                question: "How do airplane wings generate lift?",
                options: [
                    "By pushing air downward only",
                    "By the curved airfoil shape creating pressure differences",
                    "By rotating like helicopter blades",
                    "By heating the air underneath"
                ],
                correctAnswer: 1,
                reference: "Reference: Wing aerodynamics"
            },
            {
                question: "What technology uses Einstein's theories of relativity?",
                options: [
                    "Television broadcasts",
                    "GPS (Global Positioning System)",
                    "Radio communications",
                    "Internet connections"
                ],
                correctAnswer: 1,
                reference: "Reference: GPS and relativity"
            },
            {
                question: "How do forensic scientists use physics in car accident reconstruction?",
                options: [
                    "By measuring tire pressure",
                    "By analyzing skid marks to determine speed and friction",
                    "By checking the radio settings",
                    "By examining the paint color"
                ],
                correctAnswer: 1,
                reference: "Reference: Physics and forensics"
            },
            {
                question: "What does MRI stand for?",
                options: [
                    "Medical Radiology Imaging",
                    "Magnetic Resonance Imaging",
                    "Multiple Ray Imaging",
                    "Molecular Research Imaging"
                ],
                correctAnswer: 1,
                reference: "Reference: MRI"
            },
            {
                question: "How do CT scans work?",
                options: [
                    "Using magnetic fields only",
                    "Using narrow beams of X-rays rotated around the body",
                    "Using sound waves",
                    "Using visible light"
                ],
                correctAnswer: 1,
                reference: "Reference: CT scans"
            },
            {
                question: "What is a monomer?",
                options: [
                    "A large complex molecule",
                    "A small molecule that can be joined with others to form a polymer",
                    "A type of enzyme",
                    "A form of energy"
                ],
                correctAnswer: 1,
                reference: "Reference: Monomers and polymers"
            },
            {
                question: "What are the three types of fossil fuels?",
                options: [
                    "Coal, oil, and natural gas",
                    "Wood, coal, and oil",
                    "Gas, solar, and wind",
                    "Coal, nuclear, and hydro"
                ],
                correctAnswer: 0,
                reference: "Reference: Fossil fuel types"
            },
            {
                question: "What are vitamins?",
                options: [
                    "Inorganic compounds needed for growth",
                    "Organic compounds needed in small amounts for enzyme production",
                    "Large molecules that store energy",
                    "Proteins that speed up reactions"
                ],
                correctAnswer: 1,
                reference: "Reference: Vitamins"
            },
            {
                question: "How do nutritionists use chemistry?",
                options: [
                    "To understand the chemical composition and reactions of nutrients",
                    "To measure food temperature",
                    "To determine food color",
                    "To calculate food weight"
                ],
                correctAnswer: 0,
                reference: "Reference: Nutrition and chemistry"
            },
            {
                question: "What is environmental biophysics?",
                options: [
                    "The study of plant growth only",
                    "Research on how physics applies to environmental and ecological systems",
                    "The study of weather patterns",
                    "The classification of animals"
                ],
                correctAnswer: 1,
                reference: "Reference: Environmental biophysics"
            }
        ];

        // Initialize quiz state - will be initialized by initializeQuiz()
        window.currentQuestion = 0;
        window.quizStarted = false;
        window.userEmail = '';

        // Load saved email
        const savedEmail = localStorage.getItem('userEmail');
        if (savedEmail) {
            document.getElementById('email').value = savedEmail;
        }

        function startQuiz() {
if (!validateSecurity()) return;
            const email = document.getElementById('email').value;
            const saveResults = document.getElementById('save-results').checked;
            
            window.userEmail = email;
            window.saveResults = saveResults;
            
            // Initialize quiz with randomized answers
            initializeQuiz();
            
            document.getElementById('email-section').style.display = 'none';
            document.getElementById('quiz-container').style.display = 'block';
            
            showQuestion();
        }

        function showQuestion() {
            const question = window.questions[window.currentQuestion];
            document.getElementById('question-number').textContent = `Question ${window.currentQuestion + 1} of ${window.questions.length}`;
            document.getElementById('question-text').textContent = question.question;
            
            const optionsContainer = document.getElementById('options');
            optionsContainer.innerHTML = '';
            
            question.options.forEach((option, index) => {
                const button = document.createElement('button');
                button.className = 'option-button';
                button.textContent = option;
                button.onclick = () => selectAnswer(index);
                optionsContainer.appendChild(button);
            });
            
            // Update progress bar
            const progress = ((window.currentQuestion) / window.questions.length) * 100;
            document.getElementById('progress').style.width = progress + '%';
            
            // Show/hide navigation buttons
            document.getElementById('prevBtn').style.display = window.currentQuestion > 0 ? 'inline-block' : 'none';
            document.getElementById('nextBtn').style.display = 'none';
            document.getElementById('submitBtn').style.display = 'none';
            
            // Hide feedback
            document.getElementById('feedback').style.display = 'none';
            
            // Restore previous answer if exists
            if (window.userAnswers[window.currentQuestion] !== null) {
                const buttons = document.querySelectorAll('.option-button');
                buttons[window.userAnswers[window.currentQuestion]].classList.add('selected');
                showFeedback(window.userAnswers[window.currentQuestion]);
            }
        }

        function selectAnswer(optionIndex) {
            const currentAttempts = window.questionAttempts[window.currentQuestion] || 0;
            const question = window.questions[window.currentQuestion];
            const options = document.querySelectorAll('.option-button');
            const feedback = document.getElementById('feedback');
            
            // Clear previous selections
            options.forEach(btn => btn.classList.remove('selected', 'correct', 'incorrect'));
            
            // Mark selected answer
            options[optionIndex].classList.add('selected');
            window.userAnswers[window.currentQuestion] = optionIndex;
            window.questionAttempts[window.currentQuestion] = currentAttempts + 1;
            
            showFeedback(optionIndex);
        }

        function showFeedback(selectedIndex) {
            const question = window.questions[window.currentQuestion];
            const feedback = document.getElementById('feedback');
            const options = document.querySelectorAll('.option-button');
            
            if (selectedIndex === question.correctAnswer) {
                options[selectedIndex].classList.add('correct');
                feedback.innerHTML = `<div class="correct">✓ Correct! ${question.reference}</div>`;
                feedback.className = 'feedback correct';
            } else {
                options[selectedIndex].classList.add('incorrect');
                options[question.correctAnswer].classList.add('correct');
                feedback.innerHTML = `<div class="incorrect">✗ Incorrect. The correct answer is: ${question.options[question.correctAnswer]}<br>${question.reference}</div>`;
                feedback.className = 'feedback incorrect';
            }
            
            feedback.style.display = 'block';
            
            // Show next/submit button
            if (window.currentQuestion < window.questions.length - 1) {
                document.getElementById('nextBtn').style.display = 'inline-block';
            } else {
                document.getElementById('submitBtn').style.display = 'inline-block';
            }
        }

        function nextQuestion() {
            if (window.currentQuestion < window.questions.length - 1) {
                const feedback = document.getElementById('feedback');
                feedback.style.display = 'none';
                window.currentQuestion++;
                showQuestion();
            }
        }

        function previousQuestion() {
            if (window.currentQuestion > 0) {
                window.currentQuestion--;
                showQuestion();
            }
        }

        function submitQuiz() {
            let correctAnswers = 0;
            window.questions.forEach((question, index) => {
                if (window.userAnswers[index] === question.correctAnswer) {
                    correctAnswers++;
                }
            });
            
            const percentage = Math.round((correctAnswers / window.questions.length) * 100);
            
            document.getElementById('quiz-container').style.display = 'none';
            document.getElementById('results').style.display = 'block';
            
            document.getElementById('score').innerHTML = `
                <h3>Your Score: ${correctAnswers}/${window.questions.length} (${percentage}%)</h3>
                <p>Grade: ${getLetterGrade(percentage)}</p>
            `;
            
            showFinalResults();
            
            const saveResults = window.userEmail && window.userEmail.length > 0;
            if (saveResults) {
                sendResultsEmail(correctAnswers, percentage);
            }
        }

        function getLetterGrade(percentage) {
            if (percentage >= 90) return 'A';
            if (percentage >= 80) return 'B';
            if (percentage >= 70) return 'C';
            if (percentage >= 60) return 'D';
            return 'F';
        }

        function showFinalResults() {
            const detailedResults = document.getElementById('incorrect-answers');
            let resultsHTML = '<h3>Detailed Results:</h3>';

            window.questions.forEach((question, index) => {
                const userAnswer = window.userAnswers[index];
                const isCorrect = userAnswer === question.correctAnswer;
                const attempts = window.questionAttempts[index] || 0;
                
                resultsHTML += `
                    <div class="result-item ${isCorrect ? 'correct' : 'incorrect'}">
                        <strong>Question ${index + 1}:</strong> ${question.question}<br>
                        <strong>Your answer:</strong> ${userAnswer !== null ? question.options[userAnswer] : 'Not answered'}<br>
                        ${!isCorrect ? `<strong>Correct answer:</strong> ${question.options[question.correctAnswer]}<br>` : ''}
                        <strong>Attempts:</strong> ${attempts}<br>
                        <em>${question.reference}</em>
                    </div>
                `;
            });

            detailedResults.innerHTML = resultsHTML;
        }

        function sendResultsEmail(correctAnswers, percentage) {
            const emailStatus = document.getElementById('email-status');
            emailStatus.innerHTML = '<p>Sending results to instructor...</p>';
            
            // Format email message like other working quizzes
            let emailMessage = `Physical Science Module 14 Quiz Results\n\n`;
            emailMessage += `Student: ${window.userEmail}\n`;
            emailMessage += `Quiz: Chemistry and Physics in the Life Sciences\n`;
            emailMessage += `Score: ${correctAnswers}/${window.questions.length} (${percentage}%)\n`;
            emailMessage += `Percentage: ${percentage}%\n`;
            emailMessage += `Date: ${new Date().toLocaleString()}\n\n`;
            
            // Add incorrect answers details
            const incorrectAnswers = window.userAnswers.reduce((incorrect, answer, index) => {
                if (answer !== window.questions[index].correctAnswer) {
                    incorrect.push({
                        question: window.questions[index].question,
                        userAnswer: answer !== null ? window.questions[index].options[answer] : 'Not answered',
                        correctAnswer: window.questions[index].options[window.questions[index].correctAnswer],
                        attempts: window.questionAttempts[index] || 0
                    });
                }
                return incorrect;
            }, []);
            
            if (incorrectAnswers.length > 0) {
                emailMessage += "Incorrect Answers:\n\n";
                incorrectAnswers.forEach((item, index) => {
                    emailMessage += `${index + 1}. ${item.question}\n`;
                    emailMessage += `   Your answer: ${item.userAnswer}\n`;
                    emailMessage += `   Correct answer: ${item.correctAnswer}\n`;
                    emailMessage += `   Attempts: ${item.attempts}\n\n`;
                });
            } else {
                emailMessage += "Perfect score! All answers were correct.\n";
            }
            
            const templateParams = {
                to_email: window.userEmail,
                message: emailMessage,
                score: correctAnswers,
                total: window.questions.length,
                percentage: percentage
            };

            // Post to Google Sheets first
            const sheetsData = {
                timestamp: new Date().toISOString(),
                studentEmail: window.userEmail,
                quizTitle: 'Physical Science Module 14 Quiz',
                score: correctAnswers,
                totalQuestions: window.questions.length,
                percentage: percentage.toString(),
                incorrectCount: window.questions.length - correctAnswers,
                timeCompleted: new Date().toLocaleString()
            };

            try {
                fetch('https://script.google.com/macros/s/AKfycbyyLBmUPqcnnH7204B8-FjK8JGXRjF4HFTJaA9LB9gzpHPWf1up45iEjrLik3DiXfsxaA/exec', {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(sheetsData)
                }).then(() => {
                console.log('Google Sheets: Data logged successfully');
            }).catch(error => {
                console.error('Google Sheets: Error logging data:', error);
            });
            } catch (error) {
                console.error('Error sending data to Google Sheets:', error);
            }

            // Send EmailJS notification to instructor with standardized format
            const updatedTemplateParams = {
                from_name: 'Physical Science Quiz System',
                student_email: window.userEmail,
                to_name: 'Instructor',
                subject: 'Physical Science Module 14 Quiz Results',
                submission_date: new Date().toLocaleString(),
                message: emailMessage,
                reply_to: window.userEmail
            };

            emailjs.send('service_ot1jg6s', 'template_0nxqbk8', updatedTemplateParams)
                .then(function(response) {
                    emailStatus.innerHTML = '<p style="color: green;">✅ Results sent to instructor via email! ✅ Data logged to Google Sheets</p>';
                })
                .catch(function(error) {
                    emailStatus.innerHTML = '<p style="color: red;">✗ Failed to send results to instructor.</p>';
                    console.error('EmailJS error:', error);
                });
        }
    </script>

    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
            background-color: white;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            border-radius: 10px;
            margin-top: 20px;
            margin-bottom: 20px;
        }

        h1 {
            color: #2c3e50;
            text-align: center;
            margin-bottom: 10px;
        }

        .subtitle {
            text-align: center;
            color: #7f8c8d;
            font-style: italic;
            margin-bottom: 30px;
        }

        .email-input {
            background-color: #ecf0f1;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .email-input label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }

        .email-input input[type="email"] {
            width: 100%;
            padding: 10px;
            border: 1px solid #bdc3c7;
            border-radius: 4px;
            margin-bottom: 10px;
            box-sizing: border-box;
        }

        .email-input div {
            margin-bottom: 15px;
        }

        .email-input input[type="checkbox"] {
            margin-right: 8px;
        }

        .progress-bar {
            width: 100%;
            height: 20px;
            background-color: #ecf0f1;
            border-radius: 10px;
            margin-bottom: 20px;
            overflow: hidden;
        }

        .progress-bar .fill {
            height: 100%;
            background-color: #3498db;
            transition: width 0.3s ease;
        }

        #question-number {
            font-weight: bold;
            color: #2c3e50;
            margin-bottom: 10px;
        }

        #question-text {
            font-size: 18px;
            margin-bottom: 20px;
            color: #2c3e50;
        }

        .options {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 20px;
        }

        .option-button {
            display: block;
            width: 100%;
            padding: 12px;
            margin-bottom: 10px;
            background-color: #ecf0f1;
            border: 2px solid #bdc3c7;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: left;
        }

        .option-button:hover {
            background-color: #d5dbdb;
            border-color: #95a5a6;
        }

        .option-button.selected {
            background-color: #3498db;
            color: white;
            border-color: #2980b9;
        }

        .option-button.correct {
            background-color: #27ae60 !important;
            color: white !important;
            border-color: #229954 !important;
