            document.getElementById('quiz-container').style.display = 'block';
            
            showQuestion();
            updateProgressBar();
        });

        function showQuestion() {
            const question = window.questions[window.currentQuestion];
            document.getElementById('question-number').textContent = `Question ${window.currentQuestion + 1} of ${window.questions.length}`;
            document.getElementById('question-text').textContent = question.question;
            
            const optionsContainer = document.getElementById('options');
            optionsContainer.innerHTML = '';
            
            question.options.forEach((option, index) => {
                const button = document.createElement('button');
                button.className = 'option-button';
                button.textContent = option;
                button.onclick = () => selectAnswer(index);
                button.style.display = 'block';
                button.style.width = '100%';
                button.style.marginBottom = '10px';
                optionsContainer.appendChild(button);
                
                // Add a line break after each button to ensure vertical stacking
                optionsContainer.appendChild(document.createElement('br'));
            });
            
            // Update progress bar
            const progressFill = document.querySelector('.progress-bar .fill');
            if (progressFill) {
                const progress = ((window.currentQuestion + 1) / window.questions.length) * 100;
                progressFill.style.width = `${progress}%`;
            }
            
            // Show/hide navigation buttons
            document.getElementById('prevBtn').style.display = window.currentQuestion > 0 ? 'inline-block' : 'none';
            document.getElementById('nextBtn').style.display = 'none';
            document.getElementById('submitBtn').style.display = 'none';
            
            // Hide feedback
            document.getElementById('feedback').style.display = 'none';
            
            // Restore previous answer if exists
            if (window.userAnswers[window.currentQuestion] !== null) {
                const buttons = document.querySelectorAll('.option-button');
                buttons[window.userAnswers[window.currentQuestion]].classList.add('selected');
                showFeedback();
            }
        }

        function selectAnswer(optionIndex) {
            const currentAttempts = window.questionAttempts[window.currentQuestion] || 0;
            const question = window.questions[window.currentQuestion];
            const options = document.querySelectorAll('.option-button');
            const feedback = document.getElementById('feedback');
            
            // Clear previous selections
            options.forEach(btn => btn.classList.remove('selected', 'correct', 'incorrect'));
            
            // Mark selected answer
            options[optionIndex].classList.add('selected');
            window.userAnswers[window.currentQuestion] = optionIndex;
            window.questionAttempts[window.currentQuestion] = currentAttempts + 1;
            
            showFeedback();
        }

        function selectAnswer(selectedIndex) {
            const options = document.querySelectorAll('.option-button');
            const feedback = document.getElementById('feedback');
            const currentQuestion = window.questions[window.currentQuestion];
            
            // Clear previous selections and feedback
            options.forEach(btn => btn.classList.remove('selected', 'correct', 'incorrect'));
            feedback.className = 'feedback';
            feedback.style.display = 'none';
            
            // Mark selected answer
            options[selectedIndex].classList.add('selected');
            window.userAnswers[window.currentQuestion] = selectedIndex;
            
            // Show feedback
            const isCorrect = selectedIndex === currentQuestion.correctAnswer;
            feedback.classList.add(isCorrect ? 'correct' : 'incorrect');
            feedback.innerHTML = isCorrect ? 
                `<p>Correct! ${currentQuestion.explanation}</p>` : 
                `<p>Incorrect. The correct answer is: ${currentQuestion.options[currentQuestion.correctAnswer]}. ${currentQuestion.explanation}</p>`;
            feedback.style.display = 'block';
            
            // Mark correct and incorrect answers
            options[currentQuestion.correctAnswer].classList.add('correct');
            if (!isCorrect) {
                options[selectedIndex].classList.add('incorrect');
            }
            
            // Show next button if not last question
            if (window.currentQuestion < window.questions.length - 1) {
                document.getElementById('nextBtn').style.display = 'inline-block';
            } else {
                document.getElementById('submitBtn').style.display = 'inline-block';
            }
        }

        function nextQuestion() {
            if (window.currentQuestion < window.questions.length - 1) {
                // Reset feedback and button states
                const feedback = document.getElementById('feedback');
                feedback.style.display = 'none';
                
                window.currentQuestion++;
                showQuestion();
            }
        }

        function previousQuestion() {
            if (window.currentQuestion > 0) {
                window.currentQuestion--;
                showQuestion();
            }
        }

        function submitQuiz() {
            // Calculate score
            let correct = 0;
            window.questions.forEach((question, index) => {
                if (window.userAnswers[index] === question.correctAnswer) {
                    correct++;
                }
            });
            
            const percentage = Math.round((correct / window.questions.length) * 100);
            
            // Hide quiz container and show results
            document.getElementById('quiz-container').style.display = 'none';
            document.getElementById('results').style.display = 'block';
            
            document.getElementById('score').innerHTML = `
                <h3>Your Score: ${correct}/${window.questions.length} (${percentage}%)</h3>
                <p class="score-message">${getScoreMessage(percentage)}</p>
            `;
            
            // Send email if requested
            if (window.saveResults && window.userEmail) {
                sendResultsEmail(correct, percentage);
            } else {
                document.getElementById('email-status').innerHTML = '<p>Results not sent (email not provided or sending disabled)</p>';
            }
            
            showFinalResults();
            setupDownload(correct, percentage);
        }

        function getScoreMessage(percentage) {
            if (percentage >= 90) return "Excellent work! You have a strong understanding of electricity and magnetism.";
            if (percentage >= 80) return "Good job! You understand most concepts about electromagnetic forces.";
            if (percentage >= 70) return "Not bad! Review the concepts you missed to strengthen your understanding.";
            if (percentage >= 60) return "You're getting there! Consider reviewing the module material.";
            return "Keep studying! Review the module material and try again.";
        }

        function showFinalResults() {
            const detailedResults = document.getElementById('incorrect-answers');
            let resultsHTML = '<h3>Detailed Results:</h3>';

            window.questions.forEach((question, index) => {
                const userAnswer = window.userAnswers[index];
                const isCorrect = userAnswer === question.correctAnswer;
                const attempts = window.questionAttempts[index];
                
                resultsHTML += `
                    <div class="question-result ${isCorrect ? 'correct' : 'incorrect'}">
                        <p><strong>Question ${index + 1}:</strong> ${question.question}</p>
                        <p><strong>Your Answer:</strong> ${question.options[userAnswer] || 'Not answered'}</p>
                        <p><strong>Correct Answer:</strong> ${question.options[question.correct]}</p>
                        <p><strong>Attempts:</strong> ${attempts}</p>
                        ${!isCorrect ? `<p><strong>Explanation:</strong> ${question.explanation}</p>` : ''}
                    </div>
                `;
            });

            detailedResults.innerHTML = resultsHTML;
        }

        function sendResultsEmail(correct, percentage) {
            const emailStatus = document.getElementById('email-status');
            emailStatus.innerHTML = '<p>Sending results...</p>';
            
            // Format email message like other working quizzes
            let emailMessage = `Physical Science Module 11 Quiz Results\n\n`;
            emailMessage += `Student: ${window.userEmail}\n`;
            emailMessage += `Quiz: Electricity and Magnetism\n`;
            emailMessage += `Score: ${correct}/${window.questions.length} (${percentage}%)\n`;
            emailMessage += `Percentage: ${percentage}%\n`;
            emailMessage += `Date: ${new Date().toLocaleString()}\n\n`;
            
            // Add incorrect answers details
            const incorrectAnswers = window.userAnswers.reduce((incorrect, answer, index) => {
                if (answer !== window.questions[index].correctAnswer) {
                    incorrect.push({
                        question: window.questions[index].question,
                        userAnswer: answer !== null ? window.questions[index].options[answer] : 'Not answered',
                        correctAnswer: window.questions[index].options[window.questions[index].correctAnswer],
                        attempts: window.questionAttempts[index] || 0
                    });
                }
                return incorrect;
            }, []);
            
            if (incorrectAnswers.length > 0) {
                emailMessage += "Incorrect Answers:\n\n";
                incorrectAnswers.forEach((item, index) => {
                    emailMessage += `${index + 1}. ${item.question}\n`;
                    emailMessage += `   Your answer: ${item.userAnswer}\n`;
                    emailMessage += `   Correct answer: ${item.correctAnswer}\n`;
                    emailMessage += `   Attempts: ${item.attempts}\n\n`;
                });
            } else {
                emailMessage += "Perfect score! All answers were correct.\n";
            }
            
            const templateParams = {
                to_email: window.userEmail,
                message: emailMessage,
                score: correct,
                total: window.questions.length,
                percentage: percentage
            };

            // Post to Google Sheets first
            const sheetsData = {
                timestamp: new Date().toISOString(),
                studentEmail: window.userEmail,
                quizTitle: 'Physical Science Module 11 Quiz',
                score: correct,
                totalQuestions: window.questions.length,
                percentage: percentage.toString(),
                incorrectCount: window.questions.length - correct,
                timeCompleted: new Date().toLocaleString()
            };

            try {
                fetch('https://script.google.com/macros/s/AKfycbyyLBmUPqcnnH7204B8-FjK8JGXRjF4HFTJaA9LB9gzpHPWf1up45iEjrLik3DiXfsxaA/exec', {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(sheetsData)
                }).then(() => {
                    console.log('Google Sheets: Data logged successfully');
                }).catch(error => {
                    console.error('Google Sheets: Error logging data:', error);
                });
            } catch (error) {
                console.error('Google Sheets: Error logging data:', error);
            }

            // Send EmailJS notification to instructor with standardized format
            const updatedTemplateParams = {
                from_name: 'Physical Science Quiz System',
                student_email: window.userEmail,
                to_name: 'Instructor',
                subject: 'Physical Science Module 11 Quiz Results',
                submission_date: new Date().toLocaleString(),
                message: emailMessage,
                reply_to: window.userEmail
            };

            emailjs.send('service_ot1jg6s', 'template_0nxqbk8', updatedTemplateParams)
                .then(function(response) {
                    console.log('Email sent successfully:', response);
                    emailStatus.innerHTML = '<p class="success">✅ Results sent to instructor via email! ✅ Data logged to Google Sheets</p>';
                }, function(error) {
                    console.error('Email failed:', error);
                    emailStatus.innerHTML = '<p class="error">✗ Failed to send results to instructor.</p>';
                });
        }

        function generateEmailDetails() {
            let details = "Detailed Results:\n\n";
            window.questions.forEach((question, index) => {
                const userAnswer = window.userAnswers[index];
                const isCorrect = userAnswer === question.correctAnswer;
                const attempts = window.questionAttempts[index];
                
                details += `Question ${index + 1}: ${question.question}\n`;
                details += `Student Answer: ${question.options[userAnswer] || 'Not answered'}\n`;
                details += `Correct Answer: ${question.options[question.correct]}\n`;
                details += `Result: ${isCorrect ? 'Correct' : 'Incorrect'}\n`;
                details += `Attempts: ${attempts}\n\n`;
            });
            return details;
        }

        function setupDownload(correct, percentage) {
            document.getElementById('download-results').onclick = function() {
                const content = `Physical Science Module 11 Quiz Results
Electricity and Magnetism

Student Email: ${window.userEmail || 'Not provided'}
Score: ${correct}/${window.questions.length} (${percentage}%)
Date: ${new Date().toLocaleDateString()}

${generateEmailDetails()}`;

                const blob = new Blob([content], { type: 'text/plain' });
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `Module11_Quiz_Results_${new Date().toISOString().split('T')[0]}.txt`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                window.URL.revokeObjectURL(url);
            };
        }
    </script>

