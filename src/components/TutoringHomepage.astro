<!-- Contact Section -->
<section id="contact" class="py-20 bg-blue-600">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Ready to Get Started?</h2>
      <p class="text-xl text-blue-100 max-w-3xl mx-auto">
        Schedule a free consultation to discuss your student's needs and learning goals
      </p>
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div class="bg-white p-8 rounded-xl shadow-xl">
        <h3 class="text-2xl font-bold text-gray-900 mb-6">Contact Information</h3>
        <div class="space-y-4">
          <div class="flex items-center">
            <i class="fas fa-envelope text-blue-600 mr-4 text-xl"></i>
            <div>
              <p class="font-semibold text-gray-900">Email</p>
              <a href="mailto:chuck@c00lnerd.com" class="text-blue-600 hover:underline">chuck@c00lnerd.com</a>
            </div>
          </div>
          <div class="flex items-center">
            <i class="fas fa-calendar text-blue-600 mr-4 text-xl"></i>
            <div>
              <p class="font-semibold text-gray-900">Schedule</p>
              <p class="text-gray-600">Free 30-minute consultation available</p>
            </div>
          </div>
          <div class="flex items-center">
            <i class="fas fa-clock text-blue-600 mr-4 text-xl"></i>
            <div>
              <p class="font-semibold text-gray-900">Response Time</p>
              <p class="text-gray-600">Within 24 hours</p>
            </div>
          </div>
        </div>
      </div>
      
      <div class="bg-white p-8 rounded-xl shadow-xl">
        <h3 class="text-2xl font-bold text-gray-900 mb-6">Send a Message</h3>
        <form id="contactForm" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Name *</label>
            <input type="text" id="contactName" name="name" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Email *</label>
            <input type="email" id="contactEmail" name="email" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Subject</label>
            <select id="contactSubject" name="subject" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
              <option>Physical Science Tutoring</option>
              <option>Programming Classes</option>
              <option>Individual Tutoring</option>
              <option>Curriculum Questions</option>
              <option>Other</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Message *</label>
            <textarea rows="4" id="contactMessage" name="message" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"></textarea>
          </div>
          <div class="flex gap-4">
            <button type="submit" id="submitBtn" class="flex-1 bg-blue-600 text-white py-3 px-6 rounded-lg hover:bg-blue-700 transition-colors font-semibold">
              Send Message
            </button>
            <button type="button" id="emailDirectBtn" class="flex-1 bg-gray-600 text-white py-3 px-6 rounded-lg hover:bg-gray-700 transition-colors font-semibold">
              Email Me Directly
            </button>
          </div>
          <div id="formMessage" class="hidden text-center py-2 rounded-lg"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="bg-gray-900 text-white py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
