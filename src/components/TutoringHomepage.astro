---
// Professional tutoring homepage component
---

<!-- Navigation Header -->
<nav class="bg-white shadow-lg sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <h1 class="text-2xl font-bold text-blue-600">C00lnerd</h1>
        </div>
      </div>
      <div class="hidden md:block">
        <div class="ml-10 flex items-baseline space-x-4">
          <a href="#services" class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium transition-colors">Services</a>
          <a href="/about" class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium transition-colors">About</a>
          <a href="#resources" class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium transition-colors">Resources</a>
          <a href="#contact" class="bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700 transition-colors">Contact</a>
        </div>
      </div>
    </div>
  </div>
</nav>

<!-- Hero Section -->
<section class="bg-gradient-to-br from-blue-50 to-indigo-100 py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
          Expert STEM Tutoring for 
          <span class="text-blue-600">Homeschool Families</span>
        </h1>
        <p class="text-xl text-gray-600 mb-8">
          Proven curriculum in Physical Science and Programming. Personalized instruction that builds confidence and achieves results.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#contact" class="bg-blue-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-blue-700 transition-colors text-center">
            Schedule Free Consultation
          </a>
          <a href="#resources" class="border-2 border-blue-600 text-blue-600 px-8 py-3 rounded-lg font-semibold hover:bg-blue-50 transition-colors text-center">
            Explore Resources
          </a>
        </div>
      </div>
      <div class="flex justify-center">
        <div class="bg-white p-8 rounded-xl shadow-xl">
          <div class="w-64 h-64 bg-gradient-to-br from-blue-100 to-indigo-200 rounded-lg flex items-center justify-center">
            <i class="fas fa-graduation-cap text-6xl text-blue-600"></i>
          </div>
          <div class="mt-4 text-center">
            <p class="text-sm text-gray-600">Professional STEM Education</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Services Section -->
<section id="services" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Tutoring Services</h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Comprehensive STEM education tailored to your student's needs and learning style
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Physical Science -->
      <div class="bg-gradient-to-br from-green-50 to-emerald-100 p-8 rounded-xl shadow-lg hover:shadow-xl transition-shadow">
        <div class="text-center mb-6">
          <i class="fas fa-atom text-4xl text-green-600 mb-4"></i>
          <h3 class="text-2xl font-bold text-gray-900">Physical Science</h3>
        </div>
        <ul class="space-y-3 text-gray-700 mb-6">
          <li class="flex items-center"><i class="fas fa-check text-green-600 mr-2"></i> 15 comprehensive modules</li>
          <li class="flex items-center"><i class="fas fa-check text-green-600 mr-2"></i> Hands-on experiments</li>
          <li class="flex items-center"><i class="fas fa-check text-green-600 mr-2"></i> Interactive quizzes</li>
          <li class="flex items-center"><i class="fas fa-check text-green-600 mr-2"></i> 90-minute weekly sessions</li>
        </ul>
        <a href="/classes" class="block w-full bg-green-600 text-white text-center py-3 rounded-lg font-semibold hover:bg-green-700 transition-colors">
          View Curriculum
        </a>
      </div>

      <!-- Programming -->
      <div class="bg-gradient-to-br from-purple-50 to-violet-100 p-8 rounded-xl shadow-lg hover:shadow-xl transition-shadow">
        <div class="text-center mb-6">
          <i class="fas fa-code text-4xl text-purple-600 mb-4"></i>
          <h3 class="text-2xl font-bold text-gray-900">Programming</h3>
        </div>
        <ul class="space-y-3 text-gray-700 mb-6">
          <li class="flex items-center"><i class="fas fa-check text-purple-600 mr-2"></i> Python & Arduino</li>
          <li class="flex items-center"><i class="fas fa-check text-purple-600 mr-2"></i> miniAuto robotics</li>
          <li class="flex items-center"><i class="fas fa-check text-purple-600 mr-2"></i> 32-week curriculum</li>
          <li class="flex items-center"><i class="fas fa-check text-purple-600 mr-2"></i> Competition projects</li>
        </ul>
        <a href="/programming" class="block w-full bg-purple-600 text-white text-center py-3 rounded-lg font-semibold hover:bg-purple-700 transition-colors">
          View Curriculum
        </a>
      </div>

      <!-- Individual Tutoring -->
      <div class="bg-gradient-to-br from-orange-50 to-amber-100 p-8 rounded-xl shadow-lg hover:shadow-xl transition-shadow">
        <div class="text-center mb-6">
          <i class="fas fa-user-graduate text-4xl text-orange-600 mb-4"></i>
          <h3 class="text-2xl font-bold text-gray-900">Individual Tutoring</h3>
        </div>
        <ul class="space-y-3 text-gray-700 mb-6">
          <li class="flex items-center"><i class="fas fa-check text-orange-600 mr-2"></i> Algebra I & II, Precalculus</li>
          <li class="flex items-center"><i class="fas fa-check text-orange-600 mr-2"></i> Calculus I & II, Geometry</li>
          <li class="flex items-center"><i class="fas fa-check text-orange-600 mr-2"></i> Physics & Chemistry</li>
          <li class="flex items-center"><i class="fas fa-check text-orange-600 mr-2"></i> Engineering background</li>
        </ul>
        <a href="#contact" class="block w-full bg-orange-600 text-white text-center py-3 rounded-lg font-semibold hover:bg-orange-700 transition-colors">
          Schedule Session
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Subject Expertise Section -->
<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Subject Expertise</h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Comprehensive tutoring across all levels of mathematics and science with engineering-level expertise
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <!-- Mathematics -->
      <div class="bg-gradient-to-br from-blue-50 to-indigo-100 p-8 rounded-xl shadow-lg">
        <div class="text-center mb-8">
          <i class="fas fa-calculator text-5xl text-blue-600 mb-4"></i>
          <h3 class="text-2xl font-bold text-gray-900">Mathematics</h3>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-white p-4 rounded-lg shadow">
            <h4 class="font-semibold text-gray-900 mb-2">Algebra</h4>
            <ul class="text-sm text-gray-600 space-y-1">
              <li>• Algebra I</li>
              <li>• Algebra II</li>
            </ul>
          </div>
          <div class="bg-white p-4 rounded-lg shadow">
            <h4 class="font-semibold text-gray-900 mb-2">Advanced Math</h4>
            <ul class="text-sm text-gray-600 space-y-1">
              <li>• Precalculus</li>
              <li>• Calculus I & II</li>
            </ul>
          </div>
          <div class="bg-white p-4 rounded-lg shadow">
            <h4 class="font-semibold text-gray-900 mb-2">Geometry</h4>
            <ul class="text-sm text-gray-600 space-y-1">
              <li>• Standard Geometry</li>
              <li>• Surveying Geometry</li>
            </ul>
          </div>
          <div class="bg-white p-4 rounded-lg shadow">
            <h4 class="font-semibold text-gray-900 mb-2">Applications</h4>
            <ul class="text-sm text-gray-600 space-y-1">
              <li>• Problem Solving</li>
              <li>• Real-world Applications</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Sciences -->
      <div class="bg-gradient-to-br from-green-50 to-emerald-100 p-8 rounded-xl shadow-lg">
        <div class="text-center mb-8">
          <i class="fas fa-atom text-5xl text-green-600 mb-4"></i>
          <h3 class="text-2xl font-bold text-gray-900">Sciences</h3>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-white p-4 rounded-lg shadow">
            <h4 class="font-semibold text-gray-900 mb-2">Physics</h4>
            <ul class="text-sm text-gray-600 space-y-1">
              <li>• Mechanics</li>
              <li>• Electricity & Magnetism</li>
              <li>• Waves & Optics</li>
            </ul>
          </div>
          <div class="bg-white p-4 rounded-lg shadow">
            <h4 class="font-semibold text-gray-900 mb-2">Chemistry</h4>
            <ul class="text-sm text-gray-600 space-y-1">
              <li>• High School Chemistry</li>
              <li>• Chemical Reactions</li>
              <li>• Laboratory Skills</li>
            </ul>
          </div>
          <div class="bg-white p-4 rounded-lg shadow">
            <h4 class="font-semibent text-gray-900 mb-2">Physical Science</h4>
            <ul class="text-sm text-gray-600 space-y-1">
              <li>• Complete Curriculum</li>
              <li>• Hands-on Experiments</li>
              <li>• Interactive Quizzes</li>
            </ul>
          </div>
          <div class="bg-white p-4 rounded-lg shadow">
            <h4 class="font-semibold text-gray-900 mb-2">Engineering</h4>
            <ul class="text-sm text-gray-600 space-y-1">
              <li>• Problem-solving Approach</li>
              <li>• Real-world Applications</li>
              <li>• Technical Background</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- About Section -->
<section id="about" class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">About Chuck</h2>
        <p class="text-lg text-gray-700 mb-6">
          With an engineering background and years of STEM education experience, I bring deep mathematical and scientific knowledge to tutoring. I specialize in making complex concepts accessible and engaging for homeschool students at all levels.
        </p>
        <div class="space-y-4">
          <div class="flex items-center">
            <i class="fas fa-calculator text-blue-600 mr-3"></i>
            <span class="text-gray-700"><strong>Mathematics:</strong> Algebra I & II, Precalculus, Calculus I & II, Geometry</span>
          </div>
          <div class="flex items-center">
            <i class="fas fa-atom text-blue-600 mr-3"></i>
            <span class="text-gray-700"><strong>Sciences:</strong> Physics, Chemistry, Physical Science</span>
          </div>
          <div class="flex items-center">
            <i class="fas fa-cogs text-blue-600 mr-3"></i>
            <span class="text-gray-700"><strong>Engineering Background:</strong> Broad technical knowledge and problem-solving</span>
          </div>
          <div class="flex items-center">
            <i class="fas fa-cross text-blue-600 mr-3"></i>
            <span class="text-gray-700"><strong>Christian Worldview:</strong> Faith-integrated STEM education</span>
          </div>
          <div class="flex items-center">
            <i class="fas fa-home text-blue-600 mr-3"></i>
            <span class="text-gray-700"><strong>Homeschool Advocate:</strong> Supporting families in their educational journey</span>
          </div>
        </div>
      </div>
      <div class="flex justify-center">
        <div class="bg-white p-8 rounded-xl shadow-xl">
          <div class="w-80 h-80 bg-gradient-to-br from-blue-100 to-indigo-200 rounded-lg flex items-center justify-center">
            <i class="fas fa-user-tie text-8xl text-blue-600"></i>
          </div>
          <div class="mt-4 text-center">
            <h3 class="text-xl font-semibold text-gray-900">Chuck</h3>
            <p class="text-gray-600">STEM Education Specialist</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Resources Section -->
<section id="resources" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Educational Resources</h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Access comprehensive curriculum, interactive tools, and practice materials
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6">
      <a href="/classes" class="group bg-gradient-to-br from-blue-50 to-indigo-100 p-6 rounded-xl hover:shadow-lg transition-all">
        <i class="fas fa-book-open text-3xl text-blue-600 mb-4 group-hover:scale-110 transition-transform"></i>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Classes</h3>
        <p class="text-gray-600 text-sm">Complete course modules and lessons</p>
      </a>
      
      <a href="/modules" class="group bg-gradient-to-br from-red-50 to-rose-100 p-6 rounded-xl hover:shadow-lg transition-all">
        <i class="fas fa-atom text-3xl text-red-600 mb-4 group-hover:scale-110 transition-transform"></i>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Physical Science</h3>
        <p class="text-gray-600 text-sm">15 comprehensive science modules</p>
      </a>
      
      <a href="/practice" class="group bg-gradient-to-br from-green-50 to-emerald-100 p-6 rounded-xl hover:shadow-lg transition-all">
        <i class="fas fa-calculator text-3xl text-green-600 mb-4 group-hover:scale-110 transition-transform"></i>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Practice Tools</h3>
        <p class="text-gray-600 text-sm">Interactive problem solvers</p>
      </a>
      
      <a href="/simulations" class="group bg-gradient-to-br from-purple-50 to-violet-100 p-6 rounded-xl hover:shadow-lg transition-all">
        <i class="fas fa-flask text-3xl text-purple-600 mb-4 group-hover:scale-110 transition-transform"></i>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Simulations</h3>
        <p class="text-gray-600 text-sm">Interactive physics simulations</p>
      </a>
      
      <a href="/programming" class="group bg-gradient-to-br from-orange-50 to-amber-100 p-6 rounded-xl hover:shadow-lg transition-all">
        <i class="fas fa-robot text-3xl text-orange-600 mb-4 group-hover:scale-110 transition-transform"></i>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Programming</h3>
        <p class="text-gray-600 text-sm">Coding and robotics curriculum</p>
      </a>
    </div>
  </div>
</section>

