<!-- EmailJS Script -->
<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
<script is:inline>
  // Wait for EmailJS to load before initializing
  function initEmailJS() {
    if (typeof emailjs !== 'undefined') {
      emailjs.init('ct_s19oZHppLy9BlW');
      console.log('EmailJS initialized successfully');
      setupContactForm();
    } else {
      console.log('EmailJS not loaded yet, retrying...');
      setTimeout(initEmailJS, 100);
    }
  }

  // Contact form handler - using EmailJS like the quizzes
  function setupContactForm() {
    console.log('Setting up contact form with EmailJS...');
    const contactForm = document.getElementById('contactForm');
    const submitBtn = document.getElementById('submitBtn');
    const emailDirectBtn = document.getElementById('emailDirectBtn');
    const formMessage = document.getElementById('formMessage');

    // Direct email button handler
    if (emailDirectBtn) {
      emailDirectBtn.addEventListener('click', function() {
        const name = document.getElementById('contactName').value || 'Potential Student';
        const email = document.getElementById('contactEmail').value || '';
        const subject = document.getElementById('contactSubject').value || 'Tutoring Inquiry';
        const message = document.getElementById('contactMessage').value || '';
        
        const mailtoSubject = encodeURIComponent(`Contact Form: ${subject}`);
        const mailtoBody = encodeURIComponent(`Name: ${name}\nEmail: ${email}\nSubject: ${subject}\n\nMessage:\n${message}`);
        const mailtoLink = `mailto:chuck@c00lnerd.com?subject=${mailtoSubject}&body=${mailtoBody}`;
        
        window.location.href = mailtoLink;
      });
    }

    if (contactForm) {
      console.log('Contact form found, adding event listener...');
      contactForm.addEventListener('submit', function(e) {
        console.log('Form submitted!');
        e.preventDefault();
        
        // Get form data in the format that works with your existing templates
        const name = document.getElementById('contactName').value;
        const email = document.getElementById('contactEmail').value;
        const subject = document.getElementById('contactSubject').value;
        const message = document.getElementById('contactMessage').value;
        
        const formData = {
          to_email: 'chuck@c00lnerd.com',
          from_name: name,
          from_email: email,
          subject: `Contact Form: ${subject}`,
          message: `Name: ${name}\nEmail: ${email}\nSubject: ${subject}\n\nMessage:\n${message}`
        };

        // Debug: Log form data
        console.log('Sending contact form data:', formData);

        // Validate required fields
        if (!formData.from_name || !formData.from_email || !formData.message) {
          showMessage('Please fill in all required fields.', 'error');
          return;
        }

        // Show loading state
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';
        submitBtn.classList.add('opacity-75');

        // Send email using EmailJS with contact form template
        console.log('Sending email via EmailJS...');
        
        const emailData = {
          from_name: name,
          from_email: email,
          subject: subject,
          message: message
        };
        
        // Using the new contact form template
        emailjs.send('service_ot1jg6s', 'template_mj3a811', emailData)
          .then(function(response) {
            console.log('Email sent successfully:', response);
            showMessage('Thank you! Your message has been sent successfully. I\'ll get back to you within 24 hours.', 'success');
            contactForm.reset();
          })
          .catch(function(error) {
            console.error('EmailJS send failed:', error);
            showMessage('Sorry, there was an error sending your message. Please try again or email me directly at chuck@c00lnerd.com', 'error');
          })
          .finally(function() {
            // Reset button state
            submitBtn.disabled = false;
            submitBtn.textContent = 'Send Message';
            submitBtn.classList.remove('opacity-75');
          });
      });
    }

    function showMessage(message, type) {
      formMessage.textContent = message;
      formMessage.classList.remove('hidden', 'bg-green-100', 'text-green-700', 'bg-red-100', 'text-red-700');
      
      if (type === 'success') {
        formMessage.classList.add('bg-green-100', 'text-green-700');
      } else {
        formMessage.classList.add('bg-red-100', 'text-red-700');
      }
      
      // Hide message after 5 seconds
      setTimeout(() => {
        formMessage.classList.add('hidden');
      }, 5000);
    }
  }

  // Start the initialization when DOM loads
  document.addEventListener('DOMContentLoaded', function() {
    console.log('DOM loaded, initializing EmailJS...');
    initEmailJS();
  });
  
  // Also log when script loads
  console.log('Contact form script loaded');
</script>
