      </div>
    </div>
    
    <!-- Miscellaneous Interests -->
    <div class="mt-16">
      <div class="text-center mb-12">
        <h3 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">Miscellaneous Interests</h3>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Fascinating interactive demonstrations and educational tools from around the web
